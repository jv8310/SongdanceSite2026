{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "songdance-site",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-04-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "songdance",
      "database_id": "4814ca11-9a75-4feb-8500-533149242bca",
      "migrations_dir": "migrations"
    }
  ],
  // Media bucket — admin-uploaded event card images live here and are
  // served back through the worker at /media/<key>. Create the bucket once
  // with: wrangler r2 bucket create songdance-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "songdance-media"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://site.songdance.co",
    "QUADERNO_ACCOUNT": "songdance",
    "DRIP_REGISTRATION_EVENT": "Completed retreat registration",
    "RESEND_FROM": "Songdance <prayer@mail.songdance.co>",
    "RESEND_INTAKES_FROM": "Songdance <intakes@mail.songdance.co>"
  },
  // Hourly Cron trigger → the worker's `scheduled` handler assesses any
  // intake submissions still stuck at "No assessment" (see
  // src/worker-entrypoint.ts and src/lib/intake/sweep.ts).
  "triggers": {
    "crons": ["0 * * * *"]
  }
  // Secrets (set in Cloudflare dashboard → Workers → Settings → Variables and Secrets,
  // or via `wrangler secret put <NAME>`):
  //   STRIPE_SECRET_KEY
  //   STRIPE_WEBHOOK_SECRET
  //   STRIPE_PUBLISHABLE_KEY
  //   QUADERNO_API_KEY
  //   DRIP_API_TOKEN
  //   DRIP_ACCOUNT_ID
  //   RESEND_API_KEY         (used to send the forgiveness prayer transactionally)
  //   ANTHROPIC_API_KEY      (forgiveness prayer + /intake assessment)
  //   ADMIN_PASSWORD
  //   ADMIN_SESSION_SECRET   (any random 32+ char string)
}
