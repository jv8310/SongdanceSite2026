{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "songdance-site",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-04-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "songdance",
      "database_id": "4814ca11-9a75-4feb-8500-533149242bca",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://site.songdance.co",
    "QUADERNO_ACCOUNT": "songdance",
    "DRIP_REGISTRATION_EVENT": "Completed retreat registration",
    "RESEND_FROM": "Songdance <prayer@mail.songdance.co>"
  }
  // Secrets (set in Cloudflare dashboard → Workers → Settings → Variables and Secrets,
  // or via `wrangler secret put <NAME>`):
  //   STRIPE_SECRET_KEY
  //   STRIPE_WEBHOOK_SECRET
  //   STRIPE_PUBLISHABLE_KEY
  //   QUADERNO_API_KEY
  //   DRIP_API_TOKEN
  //   DRIP_ACCOUNT_ID
  //   RESEND_API_KEY         (used to send the forgiveness prayer transactionally)
  //   ADMIN_PASSWORD
  //   ADMIN_SESSION_SECRET   (any random 32+ char string)
}
