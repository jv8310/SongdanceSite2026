---
import SiteMenu from '../SiteMenu.astro';

interface Props {
  open: boolean;
  datesLabel: string;
}
const { open, datesLabel } = Astro.props;
---

<nav class="fc-nav">
  <div class="fc-nav-inner">
    <a href="#top" class="fc-nav-mark" aria-label="Songdance">
      <img src="/brand/logo-wordmark.svg" alt="Songdance" />
    </a>
    <div class="fc-nav-spacer"></div>
    <div class="fc-nav-meta">
      <span>Live · 4 sessions</span>
      <span class="dot"></span>
      <span>{datesLabel}</span>
    </div>
    <a href="#register" class="fc-nav-cta">{open ? 'Register' : 'The course'}</a>
    <button class="sm-trigger" data-sm-trigger aria-label="Open menu" aria-expanded="false">
      <i class="ph-light ph-list"></i>
    </button>
  </div>
</nav>
<SiteMenu />
