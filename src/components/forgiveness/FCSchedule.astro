---
// The four December sessions, on the visitor's own clock (the page reads their
// edge timezone; forgivenessSessionsIn names the city). The class titles are
// the four-class arc below (FCClasses).
import { FORGIVENESS_SESSION_MINUTES, type ForgivenessSessionView } from '../../lib/courses/forgiveness';

interface Props {
  sessions: ForgivenessSessionView[];
  // The visitor is not on Brussels time: say the hour there too.
  brusselsNote: boolean;
}

const { sessions, brusselsNote } = Astro.props;
---

<section class="fc-schedule" id="schedule">
  <div class="fc-schedule-inner">
    <div class="fc-schedule-head">
      <div class="fc-eyebrow" style="justify-content: center;">When we gather</div>
      <h2 class="fc-h2">Four sessions in <em>December.</em></h2>
      <p class="fc-schedule-sub">
        Each session is {FORGIVENESS_SESSION_MINUTES / 60} hours, live on Zoom{brusselsNote ? ' — 19:00 to 21:00 in Brussels' : ''}.
        Times are shown where you are.
      </p>
    </div>

    <div class="fc-schedule-grid">
      {sessions.map((s) => (
        <article class="fc-schedule-card">
          <div class="fc-schedule-label">Class 0{s.n}</div>
          <div class="fc-schedule-title">{s.title}</div>
          <time class="fc-schedule-date" datetime={s.startsAtUtc}>
            <span class="fc-schedule-day">{s.weekday}</span>
            <span class="fc-schedule-fullday">{s.date}</span>
            <span class="fc-schedule-time">{s.time}</span>
          </time>
        </article>
      ))}
    </div>

    <div class="fc-schedule-replay">
      <div class="fc-schedule-replay-icon" aria-hidden="true">
        <i class="ph-light ph-play-circle"></i>
      </div>
      <div>
        <h3 class="fc-schedule-replay-title">
          Can't join a live session? <em>Come anyway.</em>
        </h3>
        <p class="fc-schedule-replay-body">
          Every class is recorded and posted within 24 hours. <strong>Every participant
          receives lifetime access to the replays</strong> — included, no extra cost,
          no expiry. Watch each session on your own schedule, as many times as
          you wish.
        </p>
      </div>
    </div>
  </div>
</section>
