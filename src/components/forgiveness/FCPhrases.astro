---
const phrases = [
  { said: "I'm sorry", sounded: 'The grief that was never allowed to flow' },
  { said: 'Please forgive me', sounded: 'The surrender of being right' },
  { said: 'Thank you', sounded: 'The gratefulness that arises when the system has finally been heard' },
  { said: 'I love you', sounded: 'The love under everything — met as direct experience, not belief — in its own time' },
];

// Three slow sine lines behind the mantra: the voice, drawn. Each path is two
// viewBox-widths long and slides one width, so the loop has no seam.
const wave = (period: number, amp: number) => {
  let d = `M0 60 Q ${period / 4} ${60 - amp} ${period / 2} 60`;
  for (let x = period; x <= 2400; x += period / 2) d += ` T ${x} 60`;
  return d;
};
const waves = [
  { d: wave(300, 26), cls: 'fc-wave-a' },
  { d: wave(400, 38), cls: 'fc-wave-b' },
  { d: wave(600, 18), cls: 'fc-wave-c' },
];
---

<section class="fc-phrases">
  <div class="fc-phrases-inner">
    <div class="fc-phrases-head">
      <div class="fc-eyebrow">Ho'oponopono, met with sound</div>
      <h2 class="fc-phrases-h2">
        Four phrases. One ancient practice.<br />
        <em>A new way to meet them.</em>
      </h2>
    </div>
    <div class="fc-phrases-voice">
      <svg class="fc-wave" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
        {waves.map((w) => <path d={w.d} class={w.cls} />)}
      </svg>
      <p class="fc-phrases-mantra" data-fc-on>
        <span>I'm sorry.</span> <span>Please forgive me.</span><br />
        <span>Thank you.</span> <span>I love you.</span>
      </p>
    </div>
    <p class="fc-phrases-lead">
      Four phrases from Hawaiian ho'oponopono. Repeated by millions, often as
      mantra. Powerful in their simplicity. In this course, we don't only say
      them.
    </p>
    <p class="fc-phrases-emphasis">We sound them.</p>
    <p class="fc-phrases-lead" style="margin-top: var(--sp-5);">
      Because the body has its own version of each.
    </p>
    <div class="fc-phrases-list">
      {
        phrases.map((p) => (
          <div class="fc-phrase">
            <div class="fc-phrase-said">{p.said}</div>
            <div class="fc-phrase-sounded">{p.sounded}</div>
          </div>
        ))
      }
    </div>
    <p class="fc-phrases-close">Each phrase becomes a doorway. Sounding is the key.</p>
  </div>
</section>
