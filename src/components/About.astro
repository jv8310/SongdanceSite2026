---
---

<section id="about" class="about">
  <h2 class="about-title" data-anim="reveal">A festival in motion</h2>
  <div class="about-grid">
    <article class="card" data-anim="card">
      <h3>Dance</h3>
      <p>Workshops and performances from contemporary, jazz, and folk traditions.</p>
    </article>
    <article class="card" data-anim="card">
      <h3>Music</h3>
      <p>Three stages running across four days with artists from around the world.</p>
    </article>
    <article class="card" data-anim="card">
      <h3>Community</h3>
      <p>Open jams, late-night sessions, and the people who make it all happen.</p>
    </article>
  </div>
</section>

<style>
  .about {
    padding: 6rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .about-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 3rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .card {
    padding: 2rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card h3 {
    margin: 0 0 0.75rem;
    color: var(--accent);
  }

  .card p {
    margin: 0;
    opacity: 0.8;
    line-height: 1.5;
  }
</style>
