---
// The 30-day money-back guarantee — on-page seal + reassurance.
//
// A bespoke line-art "wax-stamp" seal (inline SVG, brand ember) plus the
// guarantee copy. Theme-agnostic on purpose: the seal is drawn in `--ember`,
// which reads on both the dark register cards (12-week / certification /
// journeys) and the light one (grief); the accompanying text uses
// `color: inherit`, and the chip border/fill are `currentColor` tints, so the
// component takes on whatever the surrounding section's text colour is — no
// theme prop to keep in sync. Copy is the single source of truth in
// src/lib/guarantee.ts.
//
// Variants:
//   card   — seal + title + blurb inside a soft bordered chip (register areas)
//   inline — small seal + one line (near a CTA / trust row)
//   seal   — just the medallion (decorative)

import { guarantee } from '../lib/guarantee';

interface Props {
  variant?: 'card' | 'inline' | 'seal';
  size?: number; // seal diameter in px (defaults per variant)
  note?: string; // override the body/line text
  align?: 'center' | 'start';
  class?: string;
}

const {
  variant = 'card',
  size,
  note,
  align = variant === 'card' ? 'start' : 'center',
  class: className = '',
} = Astro.props;

const sealSize = size ?? (variant === 'card' ? 96 : variant === 'inline' ? 40 : 120);
const uid = 'gb-' + Math.random().toString(36).slice(2, 8);
---

<div class={`gb gb--${variant} gb--${align} ${className}`.trim()} data-guarantee>
  <span class="gb-seal" style={`--gb-size:${sealSize}px`} aria-hidden="true">
    <svg viewBox="0 0 112 112" role="img" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Top arch for the curved caption (text-anchor middle @ 50%). -->
        <path id={`${uid}-arc`} fill="none" d="M 19 56 A 37 37 0 0 1 93 56" />
      </defs>

      <!-- Perforated outer ring + solid inner ring: the stamp edge. -->
      <circle class="gb-ring-perf" cx="56" cy="56" r="53" />
      <circle class="gb-ring" cx="56" cy="56" r="47.5" />

      <!-- Curved caption over the top. -->
      <text class="gb-cap">
        <textPath href={`#${uid}-arc`} startOffset="50%" text-anchor="middle">
          MONEY-BACK GUARANTEE
        </textPath>
      </text>

      <!-- Centre: the number + unit. -->
      <text class="gb-num" x="56" y="60" text-anchor="middle">{guarantee.days}</text>
      <text class="gb-unit" x="56" y="74" text-anchor="middle">DAYS</text>

      <!-- A little sound-wave flourish under the number (on brand: sounding). -->
      <path class="gb-wave" d="M 40 84 q 4 -6 8 0 q 4 6 8 0 q 4 -6 8 0 q 4 6 8 0" fill="none" />

      <!-- Small ticks at 3 and 9 o'clock to frame the caption. -->
      <circle class="gb-dot" cx="18.5" cy="56" r="1.4" />
      <circle class="gb-dot" cx="93.5" cy="56" r="1.4" />
    </svg>
  </span>

  {variant !== 'seal' && (
    <div class="gb-text">
      {variant === 'card' && <p class="gb-title">{guarantee.title}</p>}
      <p class="gb-body">{note ?? (variant === 'card' ? guarantee.blurbLong : guarantee.line)}</p>
    </div>
  )}
</div>

<style>
  .gb {
    display: flex;
    gap: 18px;
    align-items: center;
    color: inherit;
  }
  .gb--card {
    padding: 20px 22px;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    border-radius: var(--r-lg, 18px);
    background: color-mix(in srgb, currentColor 5%, transparent);
  }
  .gb--inline {
    gap: 12px;
    align-items: center;
  }
  .gb--seal {
    display: inline-flex;
  }
  .gb--center {
    flex-direction: column;
    text-align: center;
    justify-content: center;
  }
  .gb--start {
    text-align: left;
  }

  .gb-seal {
    flex: 0 0 auto;
    display: inline-block;
    width: var(--gb-size, 96px);
    height: var(--gb-size, 96px);
    line-height: 0;
  }
  .gb-seal svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* The seal itself is always the brand ember, so it reads on light and dark. */
  .gb-ring {
    fill: none;
    stroke: var(--ember, #c9603a);
    stroke-width: 2;
  }
  .gb-ring-perf {
    fill: none;
    stroke: var(--ember, #c9603a);
    stroke-width: 1.4;
    stroke-dasharray: 1.4 3.1;
    stroke-linecap: round;
    opacity: 0.85;
  }
  .gb-cap {
    fill: var(--ember, #c9603a);
    font-family: var(--font-body, sans-serif);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  .gb-num {
    fill: var(--ember, #c9603a);
    font-family: var(--font-display, Georgia, serif);
    font-size: 34px;
    font-weight: 500;
  }
  .gb-unit {
    fill: var(--ember, #c9603a);
    font-family: var(--font-body, sans-serif);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 3.5px;
  }
  .gb-wave {
    stroke: var(--ember, #c9603a);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.7;
  }
  .gb-dot {
    fill: var(--ember, #c9603a);
  }

  .gb-text {
    min-width: 0;
  }
  .gb-title {
    margin: 0 0 6px;
    font-family: var(--font-body, sans-serif);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: inherit;
  }
  .gb-body {
    margin: 0;
    font-family: var(--font-body, sans-serif);
    font-size: 14px;
    line-height: 1.6;
    color: inherit;
    opacity: 0.85;
  }
  .gb--inline .gb-body {
    font-size: 13.5px;
    opacity: 0.9;
  }

  @media (max-width: 560px) {
    .gb--card {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
