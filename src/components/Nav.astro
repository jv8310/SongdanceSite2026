---
// Shared site header. Consistent across the integrated marketing pages.
// Landing pages that don't want a header simply don't render it (see
// SiteLayout's `header` prop) — they surface the same menu through SiteMenu.
// Nav structure follows the content brief §1.
import { courseMenu, coursesAllHref, topLink, tailLinks, navCta } from '../data/nav';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
// On a course page, the mobile drawer's Courses accordion opens by default.
const coursesActive = isActive('/workshop') || path.startsWith('/courses');
---

<nav class="sd-nav" data-anim="nav">
  <div class="sd-nav-inner">
    <a href="/" class="sd-nav-mark" aria-label="Songdance">
      <img src="/brand/logo-wordmark.svg" alt="Songdance" />
    </a>

    <div class="sd-nav-links">
      <a href={topLink.href} class:list={[{ 'is-active': isActive(topLink.href) }]}>{topLink.label}</a>

      <div class="sd-nav-drop" data-nav-drop>
        <button type="button" class:list={['sd-nav-drop-toggle', { 'is-active': isActive('/courses') }]} aria-expanded="false" aria-haspopup="true" data-nav-drop-toggle>
          Courses <i class="ph-light ph-caret-down"></i>
        </button>
        <div class="sd-nav-drop-menu" data-nav-drop-menu>
          {courseMenu.map((sec) => (
            <div class="sd-nav-drop-section">
              <span class="sd-nav-drop-section-title">{sec.title}</span>
              {sec.items.map((c) => (
                <a href={c.href} class:list={[{ 'is-active': isActive(c.href) }]} data-sd-price={c.price}>{c.label}</a>
              ))}
            </div>
          ))}
          <a class="sd-nav-drop-all" href={coursesAllHref}>All courses →</a>
        </div>
      </div>

      {tailLinks.map((l) => (
        <a href={l.href} class:list={[{ 'is-active': isActive(l.href) }]}>{l.label}</a>
      ))}
    </div>

    <a href={navCta.href} class="sd-nav-cta" data-sd-price={navCta.price}>{navCta.label}</a>
    <button class="sd-nav-burger" aria-label="Menu" aria-expanded="false" data-nav-burger>
      <i class="ph-light ph-list"></i>
    </button>
  </div>

  <!-- Mobile drawer: the full structured menu, so phone visitors get the same
       Courses table-of-contents the desktop dropdown shows. -->
  <div class="sd-nav-drawer" data-nav-drawer hidden>
    <a href={topLink.href} class:list={['sd-nav-drawer-link', { 'is-active': isActive(topLink.href) }]}>{topLink.label}</a>

    <button
      type="button"
      class:list={['sd-nav-drawer-link', 'sd-nav-drawer-acc', { 'is-active': coursesActive }]}
      data-drawer-acc
      aria-expanded={coursesActive ? 'true' : 'false'}
      aria-controls="sd-drawer-courses"
    >
      Courses <i class="ph-light ph-caret-down"></i>
    </button>
    <div id="sd-drawer-courses" class:list={['sd-nav-drawer-acc-panel', { 'is-open': coursesActive }]} data-drawer-acc-panel>
      <div class="sd-nav-drawer-acc-inner">
        {courseMenu.map((sec) => (
          <div class="sd-nav-drawer-section">
            <span class="sd-nav-drawer-section-title">{sec.title}</span>
            {sec.items.map((c) => (
              <a href={c.href} class:list={['sd-nav-drawer-sublink', { 'is-active': isActive(c.href) }]} data-sd-price={c.price}>{c.label}</a>
            ))}
          </div>
        ))}
        <a href={coursesAllHref} class="sd-nav-drawer-sublink sd-nav-drawer-all">All courses →</a>
      </div>
    </div>

    {tailLinks.map((l) => (
      <a href={l.href} class:list={['sd-nav-drawer-link', { 'is-active': isActive(l.href) }]}>{l.label}</a>
    ))}

    <a href={navCta.href} class="sd-nav-drawer-cta" data-sd-price={navCta.price}>{navCta.label}</a>
  </div>
</nav>

<script>
  // Desktop dropdown: open on hover (CSS) + click/keyboard (JS, for touch).
  const drop = document.querySelector<HTMLElement>('[data-nav-drop]');
  const dropToggle = document.querySelector<HTMLButtonElement>('[data-nav-drop-toggle]');
  dropToggle?.addEventListener('click', (e) => {
    e.preventDefault();
    const open = drop?.classList.toggle('is-open') ?? false;
    dropToggle.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (drop && !drop.contains(e.target as Node)) {
      drop.classList.remove('is-open');
      dropToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // Mobile drawer: Courses accordion — collapsed until clicked (open by default
  // on a course page).
  const drawerAcc = document.querySelector<HTMLButtonElement>('[data-drawer-acc]');
  const drawerAccPanel = document.querySelector<HTMLElement>('[data-drawer-acc-panel]');
  drawerAcc?.addEventListener('click', () => {
    const isOpen = drawerAccPanel?.classList.toggle('is-open') ?? false;
    drawerAcc.setAttribute('aria-expanded', String(isOpen));
  });

  // Mobile drawer toggle.
  const burger = document.querySelector<HTMLButtonElement>('[data-nav-burger]');
  const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]');
  const icon = burger?.querySelector('i');
  burger?.addEventListener('click', () => {
    if (!drawer) return;
    const open = drawer.hasAttribute('hidden');
    if (open) drawer.removeAttribute('hidden');
    else drawer.setAttribute('hidden', '');
    burger.setAttribute('aria-expanded', String(open));
    if (icon) {
      icon.classList.toggle('ph-list', !open);
      icon.classList.toggle('ph-x', open);
    }
  });
</script>
