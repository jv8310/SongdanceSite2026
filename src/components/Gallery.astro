---
// "From the room" mosaic — three 12-column bands so it always tiles cleanly.
// `pos` sets object-position so faces (which sit high in the frame) aren't
// clipped by the tighter tiles. Images here are kept distinct from the hero,
// work section and lineage portrait so nothing repeats down the page.
const shots = [
  { src: '/media/library/svh-retreat-portrait-smiling-rocks.webp', slot: 'g-a', pos: 'center 30%' },
  { src: '/media/library/svh-retreat-sounding-pink-shirt.webp', slot: 'g-b', pos: 'center 24%' },
  { src: '/media/library/svh-retreat-sounding-hat-rocks.webp', slot: 'g-c', pos: 'center 28%' },
  { src: '/media/library/svh-retreat-sounding-black-vest.webp', slot: 'g-d', pos: 'center 26%' },
  { src: '/media/library/svh-retreat-sounding-shawl.webp', slot: 'g-e', pos: 'center 28%' },
  { src: '/media/library/svh-retreat-sounding-poncho-indoor.webp', slot: 'g-f', pos: 'center 35%' },
  { src: '/media/library/svh-retreat-teaching-jacob-laughing.webp', slot: 'g-g', pos: 'center 40%' },
  { src: '/media/library/svh-retreat-walk-embrace-sunset.webp', slot: 'g-h', pos: 'center 40%' },
];
---

<section class="sd-gallery">
  <div class="sd-gallery-inner">
    <div class="sd-gallery-head" data-anim="reveal">
      <div>
        <div class="sd-eyebrow">From the sessions</div>
        <p class="sd-gallery-quote">
          Breath, voice, and the last of the light. The work, as it actually looks.
        </p>
      </div>
      <div class="sd-gallery-byline">Selected photographs · 2024–25</div>
    </div>
    <div class="sd-gallery-grid">
      {
        shots.map((s) => (
          <figure class={`sd-gallery-item ${s.slot}`} data-anim="gallery-item">
            <img src={s.src} alt="" loading="lazy" style={s.pos ? `object-position:${s.pos}` : undefined} />
          </figure>
        ))
      }
    </div>
  </div>
</section>
