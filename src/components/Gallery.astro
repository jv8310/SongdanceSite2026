---
const shots = [
  { src: '/media/library/svh-retreat-sounding-yellow.jpg', slot: 'g-a' },
  { src: '/media/library/jacob-teaching.jpg', slot: 'g-b' },
  { src: '/media/library/jacob-soft-portrait.jpg', slot: 'g-c' },
  { src: '/media/library/svh-retreat-sounding-teal.jpg', slot: 'g-d' },
  { src: '/media/library/svh-retreat-walk-tree-sunset.jpg', slot: 'g-e' },
];
---

<section class="sd-gallery">
  <div class="sd-gallery-inner">
    <div class="sd-gallery-head" data-anim="reveal">
      <div>
        <div class="sd-eyebrow">From the room</div>
        <p class="sd-gallery-quote">
          Hands, breath, candlelight. The work, as it actually looks.
        </p>
      </div>
      <div class="sd-gallery-byline">Selected frames · 2024–25</div>
    </div>
    <div class="sd-gallery-grid">
      {
        shots.map((s) => (
          <figure class={`sd-gallery-item ${s.slot}`} data-anim="gallery-item">
            <img src={s.src} alt="" loading="lazy" />
          </figure>
        ))
      }
    </div>
  </div>
</section>
