---
// The class curriculum, presented as a self-paced library of modules — each
// title with a one-line text. The page sells the library, not a schedule,
// so there is no date logic here; the prominent promise below the grid
// carries what every module is (fully edited video + thorough manual).
import { SVH_CERT_CLASSES } from '../../lib/courses/svh-cert-classes';
---

<section class="cc-classes" id="classes">
  <div class="cc-classes-inner">
    <div class="cc-classes-head">
      <div class="cc-eyebrow cc-eyebrow--center">The modules</div>
      <h2 class="cc-h2" style="margin-top: var(--sp-4); max-width: 24ch; margin-left: auto; margin-right: auto;">
        The full arc, <em>at your own pace.</em>
      </h2>
    </div>

    <div class="cc-classes-grid">
      {SVH_CERT_CLASSES.map((item) => (
        <article class="cc-card">
          <div class="cc-card-num">Module {String(item.number).padStart(2, '0')}</div>
          <h3 class="cc-card-title">{item.title}</h3>
          <p class="cc-card-blurb">{item.blurb}</p>
        </article>
      ))}
    </div>

    <div class="cc-classes-promise">
      <div class="cc-promise-items">
        <span class="item"><span class="icon" aria-hidden="true">🎬</span> Fully edited video classes</span>
        <span class="dot" aria-hidden="true"></span>
        <span class="item"><span class="icon" aria-hidden="true">📖</span> A thorough written manual per class</span>
      </div>
      <p class="cc-promise-sub">Instant access to all of it, from the moment you join.</p>
    </div>
  </div>
</section>
