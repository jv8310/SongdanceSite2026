---
// The class curriculum, presented as a self-paced library of modules — each
// title with its instant replay. The page sells the library, not a schedule,
// so there is no date logic here; the live field around it is promised
// generally (live sessions and Q&As every month through the end of 2026).
import { SVH_CERT_CLASSES } from '../../lib/courses/svh-cert-classes';
---

<section class="cc-classes" id="classes">
  <div class="cc-classes-inner">
    <div class="cc-classes-head">
      <div class="cc-eyebrow cc-eyebrow--center">The modules</div>
      <h2 class="cc-h2" style="margin-top: var(--sp-4); max-width: 24ch; margin-left: auto; margin-right: auto;">
        The full arc, <em>at your own pace.</em>
      </h2>
    </div>

    <div class="cc-classes-grid">
      {SVH_CERT_CLASSES.map((item) => (
        <article class="cc-card">
          <div class="cc-card-num">Module {String(item.number).padStart(2, '0')}</div>
          <h3 class="cc-card-title">{item.title}</h3>
          <div class="cc-card-status">
            <span class="icon" aria-hidden="true">🎧</span>
            <span class="label">Instant replay</span>
          </div>
        </article>
      ))}
    </div>

    <p class="cc-classes-foot">
      Every module is a full two-hour class with its own detailed written
      manual — instant access from the moment you join, at your own rhythm.
      And the field around the library stays live: sessions and Q&amp;As
      every month through the end of 2026.
    </p>
  </div>
</section>
