---
const includes = [
  { lead: 'The complete class library, instant access', rest: '— every module with a detailed written manual, self-paced from the moment you join.' },
  { lead: 'Weekly live Q&A sessions through end of 2026', rest: 'with Jacob, and occasionally hosted by Karen Evans.' },
  { lead: 'Monthly live deepening sessions', rest: 'with Jacob and the wider community of practitioners — every one recorded into the library.' },
  { lead: 'Hosted practice sessions', rest: 'to give and receive with peers — the quiet heart of the course.' },
  { lead: 'Access to the Somatic Vocal Healing app', rest: 'to record, tag and revisit your own sounds, train your ear, and keep practising between sessions.' },
  { lead: 'Full access to the complete replay library', rest: 'of every class, Q&A and deepening session.' },
  { lead: 'A strong group field', rest: 'that keeps growing.' },
  { lead: 'Feedback from Jacob on your video submission', rest: 'for certification.' },
  { lead: 'Lifetime access to the certification course materials.', rest: '' },
];
---

<section class="cc-includes">
  <div class="cc-includes-inner">
    <div class="cc-includes-head">
      <div class="cc-eyebrow cc-eyebrow--center">What you get when you join</div>
      <h2 class="cc-h2" style="margin-top: var(--sp-4); max-width: 22ch; margin-left: auto; margin-right: auto;">
        Everything you need, <em>and a circle to walk it in.</em>
      </h2>
    </div>
    <ul class="cc-includes-list">
      {includes.map((it) => (
        <li>
          <span class="check" aria-hidden="true">✓</span>
          <span><strong>{it.lead}</strong> {it.rest}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
