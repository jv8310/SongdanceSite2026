    role: 'On the in-person retreat',
  },
];
---

<section class="cc-testimonials">
  <div class="cc-testimonials-inner">
    <div class="cc-testimonials-head">
      <div class="cc-eyebrow cc-eyebrow--center">From people who have travelled this path</div>
      <h2 class="cc-h2" style="margin-top: var(--sp-4); max-width: 24ch; margin-left: auto; margin-right: auto;">
        In their <em>own words.</em>
      </h2>
    </div>

    {items.map((t) => (
      <article class="cc-testimonial">
        <p class="cc-testimonial-body">{t.body}</p>
        <div class="cc-testimonial-by">
          <span class="who">{t.who}</span>
          {t.role}
        </div>
      </article>
    ))}
  </div>
</section>
