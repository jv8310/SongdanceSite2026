---
const stanzas = [
  {
    title: 'Self-paced classes, instant access',
    body: 'A library of two-hour classes, each with its detailed written manual — yours to walk at your own rhythm, from the moment you join.',
  },
  {
    title: 'Weekly Q&A sessions',
    body: 'Through the end of 2026, with Jacob — and occasionally hosted by Karen Evans.',
  },
  {
    title: 'Monthly live deepening sessions',
    body: 'A live two-hour community session each month, bringing together alumni and current students to explore the work at its widest edges.',
  },
  {
    title: 'Hosted practice sessions',
    body: 'Pairing up with other students to give and receive — the quiet heart of this course. Most students say this is where their facilitation actually grows.',
  },
  {
    title: 'A growing global community',
    body: 'Hundreds of people across time zones, with a shared field that is built and rebuilt each week.',
  },
  {
    title: 'Full replay library',
    body: 'Every Q&A, every class, every deepening session. Yours to keep returning to.',
  },
];
---

<section class="cc-structure" id="structure">
  <div class="cc-structure-inner">
    <div class="cc-structure-head">
      <div class="cc-eyebrow cc-eyebrow--center">Structure</div>
      <h2 class="cc-h2" style="margin-top: var(--sp-4); max-width: 24ch; margin-left: auto; margin-right: auto;">
        How the work <em>lives in time.</em>
      </h2>
    </div>
    <div class="cc-structure-grid">
      {stanzas.map((s) => (
        <article class="cc-stanza">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>

    <figure class="cc-structure-figure">
      <img
        src="/media/library/svh-retreat-group-indoor.webp"
        alt="A circle of people gathered on the floor of a round retreat space, sounding together"
        loading="lazy"
      />
      <figcaption>The whole circle, held in one room.</figcaption>
    </figure>
  </div>
</section>
