---
import { COUNTRIES } from '../../lib/countries';
import LaunchOfferCallout from '../promo/LaunchOfferCallout.astro';
import GuaranteeBadge from '../GuaranteeBadge.astro';

const countries = COUNTRIES;
---

<section class="cc-register" id="register">
  <div class="cc-register-inner">
    <div class="cc-eyebrow cc-eyebrow--center">Your place on the path</div>
    <h2 class="cc-register-h2">
      Find your <em>price.</em>
    </h2>
    <p class="cc-register-lead">
      Enter your email to see what fits — whether you're returning to this
      work, currently on the 12-week course, or arriving here for the first
      time.
    </p>

    <LaunchOfferCallout scope="this training" />

    <div class="cc-register-stage" data-cc-stage>
      <form class="cc-register-form" data-cc-email-form>
        <input
          type="email"
          name="email"
          placeholder="Your email"
          autocomplete="email"
          required
        />
        <button type="submit">Check</button>
      </form>
      <p class="cc-register-form-note">
        We'll only use this to show you the right offer. No sign-up, no list.
      </p>
      <div class="cc-register-status" data-cc-status hidden aria-live="polite">
        <span class="cc-register-spinner" aria-hidden="true"></span>
        <span class="cc-register-status-text" data-cc-status-text>Finding your profile…</span>
      </div>
      <p class="cc-register-error" data-cc-error></p>
    </div>

    <div class="cc-register-guarantee" style="margin:26px 0 0;">
      <GuaranteeBadge variant="card" />
    </div>

    <!-- Variant template — cloned and filled in by the script below.
         Hidden in markup, never rendered as-is. -->
    <template data-cc-variant-template>
      <div class="cc-variant">
        <div class="cc-variant-greeting" data-slot="greeting"></div>
        <h3 class="cc-variant-title" data-slot="title"></h3>
        <p class="cc-variant-body" data-slot="body"></p>

        <div data-slot="offer-picker">
          <div class="cc-step-label" data-slot="offer-picker-label">Choose your offer</div>
          <div data-slot="offer-cards" class="cc-offers"></div>
        </div>

        <!-- Post-workshop Song Deck gift: shown only inside the 1-hour window
             after the buyer's live workshop (deck_gift on the status). Its
             countdown replaces the 48h discount countdown while it's live. -->
        <div class="cc-gift" data-slot="gift" hidden>
          <div class="cc-gift-head">
            <span class="cc-gift-pill">Free gift · free global shipping</span>
            <span class="cc-gift-count">
              <i class="ph-light ph-hourglass-medium" aria-hidden="true"></i>
              Gift leaves in <span class="clock" data-slot="gift-clock">--:--</span>
            </span>
          </div>
          <div class="cc-gift-body">
            <img
              class="cc-gift-thumb"
              src="https://songdeck.shop/cdn/shop/files/Open_Box_Mockup.jpg?v=1728399000&width=520"
              alt="The Songdeck box open, showing the illustrated song cards inside"
              loading="lazy"
            />
            <div class="cc-gift-text">
              <p class="cc-gift-title">The Songdeck ships to you — our gift</p>
              <p class="cc-gift-sub">
                To honour your momentum and celebrate your yes: join within the
                hour and the deck is yours. Add your address below and we'll ship
                it to you — free, anywhere in the world.
              </p>
              <ul class="cc-gift-points">
                <li>36 illustrated song cards — each with its own written message</li>
                <li>A QR code on every card: scan it and that card's own song plays</li>
                <li>The free Songdeck app with all 36 songs, mantras and soundscapes</li>
                <li>€44 in the shop — free with your course today</li>
              </ul>
            </div>
          </div>

          <!-- Shipping address for the free deck (optional; verified via Google).
               Left blank → the buyer gets the emailed SVH-BONUS claim link. -->
          <div class="cc-gift-ship" data-slot="gift-ship">
            <div class="cc-gift-ship-label">Ship your free Songdeck to</div>
            <div class="cc-variant-fields">
              <label class="cc-variant-field cc-variant-field--full">
                <span>Recipient name</span>
                <input type="text" name="shipping_name" autocomplete="name" placeholder="Who's it going to?" />
              </label>
              <label class="cc-variant-field cc-variant-field--full">
                <span>Address</span>
                <input type="text" name="shipping_line1" autocomplete="address-line1" placeholder="Street and number" />
              </label>
              <label class="cc-variant-field cc-variant-field--full">
                <span>Apartment, suite, etc. <span class="cc-field-note">— optional</span></span>
                <input type="text" name="shipping_line2" autocomplete="address-line2" />
              </label>
              <label class="cc-variant-field">
                <span>City</span>
                <input type="text" name="shipping_city" autocomplete="address-level2" />
              </label>
              <label class="cc-variant-field">
                <span>Postal code</span>
                <input type="text" name="shipping_postal_code" autocomplete="postal-code" />
              </label>
              <label class="cc-variant-field">
                <span>State / Province <span class="cc-field-note">— optional</span></span>
                <input type="text" name="shipping_region" autocomplete="address-level1" />
              </label>
              <label class="cc-variant-field">
                <span>Country</span>
                <select name="shipping_country" autocomplete="country">
                  <option value="">—</option>
                  {countries.map((c) => (
                    <option value={c.code}>{c.flag} {c.name}</option>
                  ))}
                </select>
              </label>
            </div>
            <div data-slot="gift-verify"></div>
            <p class="cc-gift-ship-note">Optional — leave blank and we'll email you a one-tap claim link instead.</p>
          </div>
        </div>

        <div data-slot="plan-picker" class="cc-plan-picker" style="display:none">
          <div class="cc-step-label">How would you like to pay?</div>
          <div class="cc-plan-options" data-slot="plan-options"></div>
        </div>

        <div data-slot="checkout-form">
          <div class="cc-step-label">Your details</div>

          <div class="cc-variant-emailline">
            <span class="cc-variant-emaillabel">Continuing as</span>
            <span class="cc-variant-email" data-slot="email"></span>
            <button type="button" class="cc-variant-emailchange" data-slot="change-email">change</button>
          </div>

          <div class="cc-variant-fields">
            <label class="cc-variant-field">
              <span>First name</span>
              <input type="text" name="first_name" autocomplete="given-name" required />
            </label>
            <label class="cc-variant-field">
              <span>Last name</span>
              <input type="text" name="last_name" autocomplete="family-name" required />
            </label>
            <label class="cc-variant-field">
              <span>Country</span>
              <input
                type="text"
                name="country_search"
                list="cc-country-list"
                autocomplete="country-name"
                placeholder="Start typing…"
                required
              />
              <input type="hidden" name="country" />
            </label>
            <label class="cc-variant-field">
              <span>Phone</span>
              <div class="cc-phone-grid">
                <select name="phone_country" required aria-label="Phone country">
                  <option value="">—</option>
                  {countries.map((c) => (
                    <option value={c.code} data-dial={c.dial}>{c.flag} +{c.dial}</option>
                  ))}
                </select>
                <input type="tel" name="phone" placeholder="Phone number" autocomplete="tel" required />
              </div>
            </label>
            <label class="cc-variant-field cc-variant-field--full">
              <span>Company <span class="cc-field-note">— optional, for a business invoice</span></span>
              <input
                type="text"
                name="company_name"
                autocomplete="organization"
                placeholder="Your company name"
              />
            </label>
            <label class="cc-variant-field cc-variant-field--full cc-vat-field" data-slot="vat-field" hidden>
              <span>VAT number <span class="cc-field-note">— optional, for EU reverse-charge</span></span>
              <input
                type="text"
                name="vat_number"
                autocomplete="off"
                placeholder="e.g. BE0123456789"
                inputmode="text"
              />
            </label>
          </div>

          <fieldset class="cc-activate-toggle" data-slot="activate-toggle" style="display:none">
            <legend>Activate the certification course</legend>
            <label>
              <input type="radio" name="activate_choice" value="now" />
              <span>
                <strong>Activate right away.</strong>
                <small>Immediate access to the certification materials and the live community, alongside the 12-week foundation.</small>
              </span>
            </label>
            <label>
              <input type="radio" name="activate_choice" value="wait" checked />
              <span>
                <strong>Activate after the 12-week course completes.</strong>
                <small>Walk the foundation first; the certification opens automatically when it's done.</small>
              </span>
            </label>
            <p class="cc-activate-note">You can always email us to activate it sooner.</p>
          </fieldset>

          <label class="cc-consent">
            <input type="checkbox" name="consent_terms" required />
            <span>I agree to the <a href="/terms" target="_blank" rel="noopener">terms and conditions</a>.</span>
          </label>

          <!-- Order bumps (ASJ / Grief add-ons): one-time extras for the products
               the buyer doesn't already own. Populated from status.bumps; ticked
               ones ride the charge as separate line items. -->
          <div class="cc-bumps-wrap" data-slot="bumps-wrap" hidden>
            <div class="cc-step-label">Add to your enrolment</div>
            <div class="cc-bumps" data-slot="bumps"></div>
          </div>

          <div class="cc-checkout-summary" data-slot="summary">
            <span class="cc-checkout-summary-label" data-slot="summary-label"></span>
            <span class="cc-checkout-summary-amount" data-slot="summary-amount"></span>
          </div>
          <p class="cc-checkout-addons" data-slot="bumps-total" hidden></p>

          <button type="button" class="cc-checkout-cta" data-slot="checkout-cta">
            <span>Continue to payment</span>
            <i class="ph-light ph-arrow-right"></i>
          </button>

          <button
            type="button"
            class="cc-checkout-cta"
            data-slot="checkout-paypal"
            hidden
            style="margin-top:10px;background:#ffc439;color:#003087;"
          >
            <span>Pay with <strong>PayPal</strong></span>
          </button>

          <p class="cc-soft-fallback" data-slot="fallback"></p>
          <p class="cc-register-error" data-slot="error"></p>
        </div>

        <div data-slot="portal" style="display:none">
          <div class="cc-activate-now" data-slot="activate-now" hidden>
            <h4 class="cc-activate-now-title">Ready to step into the certification course?</h4>
            <p class="cc-activate-now-body" data-slot="activate-now-body"></p>

            <div class="cc-activate-now-actions" data-slot="activate-now-actions">
              <button type="button" class="cc-activate-now-btn" data-slot="activate-now-btn">
                <span>Activate the certification course now</span>
                <i class="ph-light ph-arrow-right"></i>
              </button>
            </div>

            <div class="cc-activate-confirm" data-slot="activate-confirm" hidden>
              <p class="cc-activate-confirm-body" data-slot="activate-confirm-body"></p>
              <div class="cc-activate-confirm-actions">
                <button type="button" class="cc-activate-now-btn" data-slot="activate-confirm-yes">
                  <span>Yes, activate</span>
                  <i class="ph-light ph-arrow-right"></i>
                </button>
                <button type="button" class="cc-activate-cancel" data-slot="activate-confirm-no">
                  Cancel
                </button>
              </div>
            </div>

            <p class="cc-activate-now-msg" data-slot="activate-now-msg"></p>
          </div>
          <a class="cc-variant-portal" data-slot="portal-link" href="#" target="_blank" rel="noopener">
            Open the course portal <i class="ph-light ph-arrow-up-right"></i>
          </a>
        </div>
      </div>
    </template>

    <datalist id="cc-country-list">
      {countries.map((c) => (
        <option value={c.name} data-code={c.code} data-dial={c.dial}>{c.flag} {c.name}</option>
      ))}
    </datalist>
  </div>
</section>

<script>
  import { COUNTRIES } from '../../lib/countries';
  import { postJsonResilient } from '../../lib/client/resilient-fetch';
  import { launchPromoActive, LAUNCH_PROMO_TAG } from '../../lib/promo';
  import { readCourseUrlDiscount } from '../../lib/courses/discount';
  import {
    prefillShipping,
    wireShippingReset,
    resolveShipping,
  } from '../../lib/client/deck-gift-shipping';

  type Currency =
    | 'EUR' | 'USD' | 'GBP' | 'CAD' | 'CHF'
    | 'AUD' | 'NZD' | 'NOK' | 'SEK' | 'DKK';
  type InstallmentPlan = {
    currency: Currency;
    monthly_cents: number;
    monthly: number;
    total_cents: number;
    total: number;
    count: number;
  };
  type Offer = {
    slug: 'cc-cert' | 'cc-bundle';
    label: string;
    currency: Currency;
    price: number;
    price_cents: number;
    base_price: number;
    save_note: string;
    installments?: InstallmentPlan;     // 3 monthly payments
    installments_6x?: InstallmentPlan;  // 6 monthly payments
    installments_12x?: InstallmentPlan; // 12 monthly payments (hidden by default)
  };
  type Variant = 'B1' | 'B2' | 'G' | 'A' | 'D' | 'E' | 'C';
  // One order bump as returned by /api/courses/subscriber-status (the same
  // ASJ / Grief add-ons the 12-week checkout offers).
  type BumpOffer = {
    slug: string;
    label: string;
    blurb: string;
    points: string[];
    image: string;
    currency: Currency;
    price_cents: number;
    compare_at_cents: number | null;
    drip_tag: string;
  };
  // The Certification path (the `cc-bundle` product), shown as two line items
  // + a combined total. During a live workshop window the whole path is 20%
  // off (both lines); a ?discount=N override only ever touches the 12-week
  // portion. Mirrors CertificationPathPricing on the server.
  type PathPricing = {
    currency: Currency;
    twelve_week_base_cents: number;
    twelve_week_price_cents: number;
    cert_base_price_cents: number;
    cert_price_cents: number;
    total_cents: number;
    total_monthly_cents: number;
    base_total_cents: number;
    base_total_monthly_cents: number;
    installment_count: number;
    total_monthly_6x_cents: number;
    base_total_monthly_6x_cents: number;
    installment_6x_count: number;
    discount: {
      eligible: boolean;
      percent: number;
      // 'german' = the German-12-week-graduate pairing (cert 20% + English
      // 12-week 75%); each line carries its own percent, so the badge/summary
      // compute the two rates from the cents rather than reading `percent`.
      kind: 'pre' | 'post' | 'none' | 'promo' | 'override' | 'german';
      expires_at_ms: number | null;
    };
  };
  type Decision = {
    variant: Variant;
    currency: Currency;
    offers: Offer[];
    twelve_week_week?: number;
    can_activate_now?: boolean;
    course_portal_url?: string;
    path?: PathPricing;
    // Order bumps the buyer doesn't already own (ASJ / Grief), priced in their
    // currency. Offered on both the cert-only and path checkouts.
    bumps?: BumpOffer[];
    // Post-workshop Song Deck gift window (free deck + free shipping, live
    // from the buyer's workshop start until 1h after it ends).
    deck_gift?: { active: boolean; ends_at_ms: number | null };
    first_name?: string;
    last_name?: string;
    country?: string;
    phone?: string;
  };
  type PaymentPlan = 'full' | '3x' | '6x' | '12x';

  let pathCountdownTimer: number | undefined;
  let giftCountdownTimer: number | undefined;

  // Which gateway the next checkout uses. The PayPal button flips it for one
  // submit; everything else stays on Stripe. Captured + reset inside
  // startCheckout so it never leaks into a later checkout.
  let nextProvider: 'stripe' | 'paypal' = 'stripe';

  type CopyFn = (
    week?: number,
    firstName?: string,
  ) => { greeting: string; title: string; body: string };

  // v4: the July 2026 reprice — 12-week at €550, the workshop sale at 20% on
  // the whole path (path total €1,347 → €1,075) — ignore older caches so a
  // stale discounted price can never be shown against the new charge.
  const STORAGE_KEY = 'cc:decision:v4';

  // URL-driven discount, read once through the shared reader so this page and
  // the teaser can never disagree about the price (see readCourseUrlDiscount).
  // `?discount=N` (1–99) strikes through the displayed price and tells the
  // server to charge the discounted amount — the one-time payment and every
  // installment alike. `?adiscount=N` is the owner's secret param: it prices
  // the page the same way at 1–99, and 100 grants a free (complimentary) place
  // the server fulfils without Stripe. The server re-validates both.
  const {
    discountPct,
    adiscountPct,
    shownPct: shownDiscountPct,
    isFreeComp,
  } = readCourseUrlDiscount(window.location.search);

  // The complimentary-place banner for a 100% ?adiscount link. Reused on the
  // email-entry screen AND re-inserted into each rendered variant — the variant
  // render replaces the stage's children, so a one-time insert would be wiped
  // before the buyer ever reaches the form.
  const COMP_BANNER_HTML =
    '<div class="cc-comp-banner" style="margin:0 0 1.25rem;padding:0.85rem 1.1rem;border-radius:12px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.4);color:#065f46;font-size:0.95rem;line-height:1.45;">This link grants a complimentary place — you won’t be charged. Complete the form and confirm; your place is secured at no cost.</div>';

  // The 12-month installment ladder is hidden unless the visitor arrives with
  // `?installment=12`. It's a quieter, longer-financing option offered by
  // hand (e.g. over email) rather than shown to everyone. Any other value
  // leaves it hidden. The server still validates the plan independently.
  function showTwelveMonthPlan(): boolean {
    try {
      const raw = new URLSearchParams(window.location.search).get('installment');
      return raw != null && parseInt(raw, 10) === 12;
    } catch {}
    return false;
  }
  const show12x: boolean = showTwelveMonthPlan();

  function applyDiscountCents(cents: number): number {
    if (shownDiscountPct <= 0) return cents;
    return Math.round((cents * (100 - shownDiscountPct)) / 100);
  }

  const SYMBOLS: Record<Currency, string> = {
    EUR: '€', USD: '$', GBP: '£', CAD: 'CA$', CHF: 'CHF ',
    AUD: 'A$', NZD: 'NZ$', NOK: 'kr ', SEK: 'kr ', DKK: 'kr ',
  };
  function symbolFor(c: Currency): string {
    return SYMBOLS[c] ?? '€';
  }
  function money(amount: number, c: Currency): string {
    return `${symbolFor(c)}${amount.toLocaleString('en-US')}`;
  }
  // Cents-aware formatter. Discounted amounts often aren't whole units
  // (e.g. €349 × 0.9 = €314.10), so we show decimals only when needed.
  function moneyCents(cents: number, c: Currency): string {
    const whole = cents % 100 === 0;
    const amount = (cents / 100).toLocaleString('en-US', {
      minimumFractionDigits: whole ? 0 : 2,
      maximumFractionDigits: whole ? 0 : 2,
    });
    return `${symbolFor(c)}${amount}`;
  }

  const greetingFor = (name?: string, fallback = 'Hi there') =>
    name && name.trim() ? `Hi ${name.trim()}` : fallback;

  const COPY: Record<Variant, CopyFn> = {
    B1: (week, name) => ({
      greeting: greetingFor(name),
      title: `You're already on the path.`,
      body:
        (week
          ? `You're currently in week ${week} of the 12-week course. `
          : `You're currently in the 12-week course. `) +
        `The certification course continues from that foundation — and because you're already inside it, your price reflects what you've already walked.`,
    }),
    B2: (_w, name) => ({
      greeting: greetingFor(name, 'Welcome back'),
      title: `The foundation is set.`,
      body: `You've completed the 12-week course. The certification course continues the work — the full class library with written manuals, hosted practice sessions, weekly live Q&As and monthly deepening sessions through the end of 2026, and the path of becoming a certified practitioner. Fully self-paced: begin the moment you join.`,
    }),
    G: (_w, name) => ({
      greeting: greetingFor(name, 'Welcome back'),
      title: `You've walked the foundation.`,
      body: `You've completed the 12-week course in German — the foundation is already yours. The certification course continues from there, self-paced, the moment you join. If you'd like the English-language 12-week course alongside it, you can add it here at a graduate's price.`,
    }),
    A: (_w, name) => ({
      greeting: greetingFor(name, 'Welcome back'),
      title: `Welcome back.`,
      body: `You've been with this work in its earlier form. The method has grown since — so much has been refined. Most returning students choose the certification course directly. If you'd like to immerse in the renewed method from the very beginning, the bundle includes the full refreshed 12-week foundational course alongside.`,
    }),
    D: (_w, name) => ({
      greeting: greetingFor(name, 'Good to see you'),
      title: `Time to step in fully.`,
      body: `You've found us already — through a workshop, a Q&A, or somewhere on the path. Most participants take the full path. If you feel you already have the foundation through other equivalent training, you can begin with the certification directly.`,
    }),
    E: (_w, name) => ({
      greeting: greetingFor(name, 'Welcome'),
      title: `This is the full path.`,
      body: `The certification course is a deepening journey — fully self-paced, with weekly live Q&As and monthly deepening sessions through the end of 2026. The 12-week course is the foundation it rests on. The full path holds both, and you can begin the moment you join.`,
    }),
    C: (_w, name) => ({
      greeting: greetingFor(name, 'You’re already in'),
      title: `Your place is already held.`,
      body: `You're registered for the certification course. Use the portal link below to find your live calls, replays and materials.`,
    }),
  };

  const stage = document.querySelector<HTMLElement>('[data-cc-stage]')!;
  // Complimentary place (secret ?adiscount=100): show the banner on the
  // email-entry screen. `renderVariant` re-inserts it (and reflects the free
  // price in the cards, summary and CTA) so the cue survives into the form.
  if (isFreeComp) {
    stage.insertAdjacentHTML('afterbegin', COMP_BANNER_HTML);
  }
  const emailForm = stage.querySelector<HTMLFormElement>('[data-cc-email-form]')!;
  const errorEl = stage.querySelector<HTMLElement>('[data-cc-error]')!;
  const noteEl = document.querySelector<HTMLElement>('.cc-register-form-note');
  const statusEl = stage.querySelector<HTMLElement>('[data-cc-status]')!;
  const statusTextEl = statusEl.querySelector<HTMLElement>('[data-cc-status-text]')!;
  const template = document.querySelector<HTMLTemplateElement>(
    '[data-cc-variant-template]',
  )!;

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.classList.add('is-visible');
  }
  function clearError() {
    errorEl.textContent = '';
    errorEl.classList.remove('is-visible');
  }

  // Lookup progress indicator: a spinner + reassuring rotating copy while we
  // talk to the server, so a slow round-trip on mobile reads as "working" and
  // not "broken". The visible status is what the visitor asked for — a little
  // "finding your profile" beat instead of a dead button.
  const PROGRESS_MESSAGES = [
    'Finding your profile…',
    'Checking your place on the path…',
    'Almost there…',
  ];
  let statusRotateTimer: number | undefined;
  function startStatus() {
    clearError();
    statusEl.hidden = false;
    let i = 0;
    statusTextEl.textContent = PROGRESS_MESSAGES[0];
    window.clearInterval(statusRotateTimer);
    statusRotateTimer = window.setInterval(() => {
      i = (i + 1) % PROGRESS_MESSAGES.length;
      statusTextEl.textContent = PROGRESS_MESSAGES[i];
    }, 2200);
  }
  function setStatus(text: string) {
    window.clearInterval(statusRotateTimer);
    statusTextEl.textContent = text;
  }
  function stopStatus() {
    window.clearInterval(statusRotateTimer);
    statusEl.hidden = true;
  }

  function showEmailForm(prefillEmail?: string) {
    stopStatus();
    stage.replaceChildren(emailForm);
    if (noteEl) stage.appendChild(noteEl);
    stage.appendChild(statusEl);
    stage.appendChild(errorEl);
    const input = emailForm.querySelector<HTMLInputElement>('input[name="email"]')!;
    if (prefillEmail) input.value = prefillEmail;
    const btn = emailForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = false;
    btn.textContent = 'Check';
    clearError();
  }

  function saveDecision(email: string, decision: Decision) {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({ email, decision, ts: Date.now() }),
      );
    } catch {}
    window.dispatchEvent(
      new CustomEvent('cc:decision-updated', { detail: { email, decision } }),
    );
  }

  emailForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();
    const data = new FormData(emailForm);
    const email = String(data.get('email') ?? '').trim().toLowerCase();
    if (!email) return;

    const submitBtn = emailForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Checking…';
    startStatus();

    try {
      const res = await postJsonResilient(
        '/api/courses/subscriber-status',
        { email, discount_percent: shownDiscountPct || undefined },
        {
          onAttempt: (attempt) => {
            if (attempt > 1) setStatus('Reconnecting…');
          },
        },
      );
      const body = (await res.json()) as Decision | { error: string };
      if (!res.ok || !('variant' in body)) {
        stopStatus();
        showError(('error' in body && body.error) || 'Something went wrong. Please try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Check';
        return;
      }
      stopStatus();
      saveDecision(email, body);
      renderVariant(email, body);
    } catch {
      stopStatus();
      showError('We had trouble reaching the server — please check your connection and tap Check again.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Check';
    }
  });

  // Best-effort browser geolocation by language + timezone → country code.
  function guessCountry(): string | undefined {
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      const tzMap: Record<string, string> = {
        'Europe/Brussels': 'BE',
        'Europe/Amsterdam': 'NL',
        'Europe/Berlin': 'DE',
        'Europe/Paris': 'FR',
        'Europe/Luxembourg': 'LU',
        'Europe/Vienna': 'AT',
        'Europe/Zurich': 'CH',
        'Europe/Rome': 'IT',
        'Europe/Madrid': 'ES',
        'Europe/Lisbon': 'PT',
        'Europe/Dublin': 'IE',
        'Europe/London': 'GB',
        'Europe/Copenhagen': 'DK',
        'Europe/Stockholm': 'SE',
        'Europe/Oslo': 'NO',
        'Europe/Helsinki': 'FI',
        'Europe/Reykjavik': 'IS',
        'Europe/Warsaw': 'PL',
        'Europe/Prague': 'CZ',
        'Europe/Bratislava': 'SK',
        'Europe/Budapest': 'HU',
        'Europe/Ljubljana': 'SI',
        'Europe/Zagreb': 'HR',
        'Europe/Athens': 'GR',
        'Europe/Bucharest': 'RO',
        'Europe/Sofia': 'BG',
        'Europe/Tallinn': 'EE',
        'Europe/Riga': 'LV',
        'Europe/Vilnius': 'LT',
        'Asia/Nicosia': 'CY',
        'Europe/Malta': 'MT',
        'America/New_York': 'US', 'America/Chicago': 'US',
        'America/Denver': 'US', 'America/Los_Angeles': 'US',
        'America/Phoenix': 'US', 'America/Anchorage': 'US',
        'Pacific/Honolulu': 'US',
        'America/Toronto': 'CA', 'America/Vancouver': 'CA',
        'Australia/Sydney': 'AU', 'Australia/Melbourne': 'AU',
        'Australia/Perth': 'AU',
        'Pacific/Auckland': 'NZ',
        'Asia/Jerusalem': 'IL',
        'Europe/Istanbul': 'TR',
        'Asia/Dubai': 'AE',
        'Africa/Johannesburg': 'ZA',
        'America/Mexico_City': 'MX',
        'America/Sao_Paulo': 'BR',
        'America/Argentina/Buenos_Aires': 'AR',
        'Asia/Tokyo': 'JP',
        'Asia/Seoul': 'KR',
        'Asia/Singapore': 'SG',
        'Asia/Hong_Kong': 'HK',
      };
      if (tzMap[tz]) return tzMap[tz];

      const lang = navigator.language || '';
      const m = lang.match(/-([A-Z]{2})$/i);
      if (m) return m[1].toUpperCase();
    } catch {}
    return undefined;
  }

  // Mirrors COUNTRY_CURRENCY in src/lib/workshops/currency.ts — only the
  // non-EUR markets we hold cert price points for. Everywhere else falls
  // through to EUR.
  const COUNTRY_CURRENCY: Record<string, Currency> = {
    US: 'USD', CA: 'CAD', GB: 'GBP', CH: 'CHF',
    NO: 'NOK', SE: 'SEK', DK: 'DKK', AU: 'AUD', NZ: 'NZD',
  };
  function currencyForCountry(code: string): Currency {
    return COUNTRY_CURRENCY[code.toUpperCase()] ?? 'EUR';
  }

  function renderVariant(email: string, decision: Decision) {
    const fragment = template.content.cloneNode(true) as DocumentFragment;
    const root = fragment.querySelector('.cc-variant') as HTMLElement;
    // Note: `decision` is mutated when the buyer changes country, so we
    // always read `decision.currency` rather than capturing it once.
    if (!decision.currency) decision.currency = 'EUR';

    const copy = COPY[decision.variant](decision.twelve_week_week, decision.first_name);
    (root.querySelector('[data-slot="greeting"]') as HTMLElement).textContent = copy.greeting;
    (root.querySelector('[data-slot="title"]') as HTMLElement).textContent = copy.title;
    (root.querySelector('[data-slot="body"]') as HTMLElement).textContent = copy.body;

    const checkoutForm = root.querySelector('[data-slot="checkout-form"]') as HTMLElement;
    const portalBlock = root.querySelector('[data-slot="portal"]') as HTMLElement;
    const offerPicker = root.querySelector('[data-slot="offer-picker"]') as HTMLElement;
    const planPicker = root.querySelector('[data-slot="plan-picker"]') as HTMLElement;
    const emailSlot = root.querySelector('[data-slot="email"]') as HTMLElement;
    if (emailSlot) emailSlot.textContent = email;

    const changeBtn = root.querySelector('[data-slot="change-email"]') as HTMLButtonElement | null;
    changeBtn?.addEventListener('click', () => {
      try { localStorage.removeItem(STORAGE_KEY); } catch {}
      window.dispatchEvent(new CustomEvent('cc:decision-cleared'));
      showEmailForm(email);
      window.scrollTo({ top: stage.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
    });

    if (decision.variant === 'C') {
      offerPicker.style.display = 'none';
      planPicker.style.display = 'none';
      checkoutForm.style.display = 'none';
      portalBlock.style.display = 'block';
      const portalLink = root.querySelector('[data-slot="portal-link"]') as HTMLAnchorElement;
      if (decision.course_portal_url) portalLink.href = decision.course_portal_url;

      // Mid-12w students see an "Activate now" affordance that bumps their
      // svh_week to 12 on Drip and opens cert access. We show a two-step
      // confirm — "you're on week N, are you sure?" — so nobody skips the
      // foundation by accident.
      const activateBlock = root.querySelector('[data-slot="activate-now"]') as HTMLElement;
      if (decision.can_activate_now) {
        activateBlock.hidden = false;
        // Hide the portal link while activation is pending — they can't use
        // the portal until the Drip automation opens access.
        portalLink.style.display = 'none';
        const week = decision.twelve_week_week;
        const bodyEl = root.querySelector('[data-slot="activate-now-body"]') as HTMLElement;
        bodyEl.textContent = week
          ? `You're currently in week ${week} of the 12-week course. The certification opens automatically when the foundation completes — but if you'd like to start exploring it now, you can open it immediately.`
          : `The certification opens automatically when the 12-week course completes — but if you'd like to start exploring it now, you can open it immediately.`;

        const actions = root.querySelector('[data-slot="activate-now-actions"]') as HTMLElement;
        const confirmBlock = root.querySelector('[data-slot="activate-confirm"]') as HTMLElement;
        const confirmBody = root.querySelector('[data-slot="activate-confirm-body"]') as HTMLElement;
        const startBtn = root.querySelector('[data-slot="activate-now-btn"]') as HTMLButtonElement;
        const yesBtn = root.querySelector('[data-slot="activate-confirm-yes"]') as HTMLButtonElement;
        const noBtn = root.querySelector('[data-slot="activate-confirm-no"]') as HTMLButtonElement;
        const msg = root.querySelector('[data-slot="activate-now-msg"]') as HTMLElement;

        confirmBody.textContent = week
          ? `You're currently on week ${week} of the 12-week course. Are you sure you want to activate and move on to the certification course?`
          : `Are you sure you want to activate and move on to the certification course?`;

        startBtn.addEventListener('click', () => {
          actions.hidden = true;
          confirmBlock.hidden = false;
        });
        noBtn.addEventListener('click', () => {
          confirmBlock.hidden = true;
          actions.hidden = false;
        });
        yesBtn.addEventListener('click', () =>
          activateNow(email, yesBtn, msg, confirmBlock),
        );
      }
      stage.replaceChildren(root);
      return;
    }

    // Complimentary place (?adiscount=100): re-insert the banner into the
    // rendered variant and mark the root, so the price treatment below reads as
    // free rather than payable.
    if (isFreeComp) {
      root.classList.add('cc-variant--free');
      root.insertAdjacentHTML('afterbegin', COMP_BANNER_HTML);
    }

    // Pre-fill form from Drip and/or geolocation
    const firstNameInput = root.querySelector<HTMLInputElement>('[name="first_name"]')!;
    const lastNameInput = root.querySelector<HTMLInputElement>('[name="last_name"]')!;
    const countryInput = root.querySelector<HTMLInputElement>('[name="country_search"]')!;
    const countryHidden = root.querySelector<HTMLInputElement>('[name="country"]')!;
    const phoneCountrySelect = root.querySelector('[name="phone_country"]') as unknown as HTMLSelectElement;
    const phoneInput = root.querySelector<HTMLInputElement>('[name="phone"]')!;
    const companyInput = root.querySelector<HTMLInputElement>('[name="company_name"]')!;
    const vatField = root.querySelector<HTMLElement>('[data-slot="vat-field"]')!;
    const vatInput = root.querySelector<HTMLInputElement>('[name="vat_number"]')!;

    if (decision.first_name) firstNameInput.value = decision.first_name;
    if (decision.last_name) lastNameInput.value = decision.last_name;

    const initialCountry = decision.country || guessCountry();
    if (initialCountry) {
      const match = COUNTRIES.find((c) => c.code === initialCountry.toUpperCase());
      if (match) {
        countryInput.value = match.name;
        countryHidden.value = match.code;
        phoneCountrySelect.value = match.code;
      }
    }
    if (decision.phone) phoneInput.value = decision.phone;

    // Song Deck gift shipping (only visible while the gift window is live):
    // prefill the recipient/country from the billing details and re-verify on
    // any edit. The verify + suggestion flow runs at submit (see startCheckout).
    prefillShipping(root, {
      first: firstNameInput.value,
      last: lastNameInput.value,
      billingCountry: countryHidden.value,
    });
    wireShippingReset(root);

    // VAT field appears as soon as a company name has been entered, so any
    // business can add its VAT number. Keeps the form tidy for the B2C majority.
    const toggleVat = () => {
      const show = companyInput.value.trim().length > 0;
      vatField.hidden = !show;
      if (!show) vatInput.value = '';
    };
    companyInput.addEventListener('input', toggleVat);
    toggleVat();

    // Resolve typed country name → ISO code when user picks/blurs. The
    // resolved code also drives the displayed currency: US → USD, GB → GBP,
    // everywhere else → EUR. We debounce-refresh prices when it changes so
    // typing "United Kingdom" character-by-character doesn't fire 14 fetches.
    // We refresh on any *country* change (not just when the cert currency
    // EUR/USD/GBP flips), because the inline 12-week offer is priced per
    // country across a wider currency set — so its price must follow the
    // exact country the buyer picks, matching what they're charged.
    let currencyRefreshTimer: number | undefined;
    let inFlightCountry: string | null = null;
    let lastCountry = (decision.country || '').toUpperCase();
    async function refreshForCountry(code: string) {
      const target = currencyForCountry(code);
      inFlightCountry = code;
      try {
        const res = await postJsonResilient(
          '/api/courses/subscriber-status',
          {
            email,
            currency: target,
            country: code,
            discount_percent: shownDiscountPct || undefined,
          },
          // Background price refresh — keep it snappy and quiet; on failure we
          // simply leave the existing prices in place.
          { retries: 2, timeoutMs: 8000 },
        );
        const next = (await res.json()) as Decision | { error?: string };
        if (!('offers' in next) || !next.offers) return;
        // Only apply if the buyer hasn't moved on to yet another country
        // while we were waiting.
        if (code !== inFlightCountry) return;
        decision.currency = next.currency;
        decision.offers = next.offers;
        decision.path = (next as Decision).path;
        decision.bumps = (next as Decision).bumps;
        decision.deck_gift = (next as Decision).deck_gift;
        try {
          localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify({ email, decision, ts: Date.now() }),
          );
        } catch {}
        renderOfferCards();
        renderBumps();
        renderGift();
        renderPlanOptions();
        renderSummary();
      } catch {
        // Network blip — leave the existing prices in place.
      } finally {
        if (code === inFlightCountry) inFlightCountry = null;
      }
    }
    function scheduleCurrencyRefresh(code: string) {
      const up = code.toUpperCase();
      if (up === lastCountry) return;
      lastCountry = up;
      window.clearTimeout(currencyRefreshTimer);
      currencyRefreshTimer = window.setTimeout(() => refreshForCountry(up), 250);
    }

    const resolveCountry = () => {
      const typed = countryInput.value.trim().toLowerCase();
      const match = COUNTRIES.find(
        (c) => c.name.toLowerCase() === typed || c.code.toLowerCase() === typed,
      );
      if (match) {
        countryHidden.value = match.code;
        if (!phoneCountrySelect.value) phoneCountrySelect.value = match.code;
        scheduleCurrencyRefresh(match.code);
      } else {
        countryHidden.value = '';
      }
      toggleVat();
    };
    countryInput.addEventListener('change', resolveCountry);
    countryInput.addEventListener('blur', resolveCountry);
    countryInput.addEventListener('input', resolveCountry);

    // Activate toggle: shown when offers include the bundle (slow path) OR
    // when the variant is B1 (mid-12w). It controls whether we set
    // svh_week=Ended (now) or prod_SVH_9m_status=wait at fulfilment time.
    const activateToggle = root.querySelector('[data-slot="activate-toggle"]') as HTMLElement;
    const showActivate =
      decision.variant === 'B1' ||
      decision.offers.some((o) => o.slug === 'cc-bundle');
    if (showActivate) activateToggle.style.display = '';

    // ── Selection state — the single source of truth for the bottom CTA.
    let selectedOfferSlug: Offer['slug'] = decision.offers[0]?.slug ?? 'cc-cert';
    let selectedPlan: PaymentPlan = 'full';

    // ── Order bumps (ASJ / Grief add-ons) ──────────────────────────────────
    // The same eligible add-ons the 12-week checkout offers, on both the cert
    // and path checkouts. Ticked ones are collected from the DOM at submit and
    // ride the charge as separate line items (see /api/courses/checkout).
    const selectedBumps = new Set<string>();
    const bumpsWrap = root.querySelector('[data-slot="bumps-wrap"]') as HTMLElement;
    const bumpsEl = root.querySelector('[data-slot="bumps"]') as HTMLElement;
    const bumpsTotalEl = root.querySelector('[data-slot="bumps-total"]') as HTMLElement;
    function updateBumpsTotal() {
      const list = (decision.bumps ?? []) as BumpOffer[];
      const cur = decision.currency ?? 'EUR';
      const chosen = list.filter((b) => selectedBumps.has(b.slug));
      const total = chosen.reduce((s, b) => s + b.price_cents, 0);
      if (!chosen.length) {
        bumpsTotalEl.hidden = true;
        bumpsTotalEl.textContent = '';
        return;
      }
      bumpsTotalEl.hidden = false;
      bumpsTotalEl.textContent = `+ ${moneyCents(total, cur)} in add-ons, added at checkout`;
    }
    function renderBumps() {
      // Offered whenever the checkout form is live (any variant with offers);
      // variant C (portal only) has no offers, so nothing shows.
      const list = (decision.offers.length ? decision.bumps ?? [] : []) as BumpOffer[];
      const cur = decision.currency ?? 'EUR';
      if (!list.length) {
        bumpsWrap.hidden = true;
        updateBumpsTotal();
        return;
      }
      bumpsWrap.hidden = false;
      bumpsEl.replaceChildren(
        ...list.map((b) => {
          const checked = selectedBumps.has(b.slug);
          const el = document.createElement('label');
          el.className = 'cc-bump' + (checked ? ' cc-bump--selected' : '');
          el.dataset.bumpSlug = b.slug;
          const hasCompare = !!b.compare_at_cents && b.compare_at_cents > b.price_cents;
          const strike = hasCompare
            ? `<s class="cc-bump-was">${moneyCents(b.compare_at_cents as number, cur)}</s> `
            : '';
          const save = hasCompare
            ? Math.round((1 - b.price_cents / (b.compare_at_cents as number)) * 100)
            : 0;
          el.innerHTML =
            `<input type="checkbox" class="cc-bump-check"${checked ? ' checked' : ''} />` +
            `<span class="cc-bump-box" aria-hidden="true"></span>` +
            (b.image ? `<img class="cc-bump-thumb" src="${b.image}" alt="" loading="lazy" />` : '') +
            `<span class="cc-bump-body">` +
              `<span class="cc-bump-head">` +
                `<span class="cc-bump-title">${escapeHtml(b.label)}</span>` +
                `<span class="cc-bump-price">${strike}${moneyCents(b.price_cents, cur)}` +
                  (save ? ` <span class="cc-bump-save">Save ${save}%</span>` : '') +
                `</span>` +
              `</span>` +
              `<span class="cc-bump-points">` +
                b.points.map((p) => `<span class="cc-bump-point">${escapeHtml(p)}</span>`).join('') +
              `</span>` +
              `<span class="cc-bump-blurb">${escapeHtml(b.blurb)}</span>` +
            `</span>`;
          const input = el.querySelector('input') as HTMLInputElement;
          input.addEventListener('change', () => {
            if (input.checked) selectedBumps.add(b.slug);
            else selectedBumps.delete(b.slug);
            el.classList.toggle('cc-bump--selected', input.checked);
            updateBumpsTotal();
          });
          return el;
        }),
      );
      updateBumpsTotal();
    }

    // Offer cards (re-rendered when the buyer changes country and the
    // currency switches). Clicking a card flips selectedOfferSlug.
    const offersEl = root.querySelector('[data-slot="offer-cards"]') as HTMLElement;
    const offerPickerLabel = root.querySelector('[data-slot="offer-picker-label"]') as HTMLElement;
    // Post-workshop Song Deck gift — live right now?
    const giftLive = () => {
      const g = decision.deck_gift;
      return !!(g && g.active && g.ends_at_ms && g.ends_at_ms > Date.now());
    };

    // The path card carries the workshop sale's 48h countdown. Re-armed on
    // each card render; on expiry we re-fetch so the now-full price re-renders.
    // While the Song Deck gift window is live, the gift panel's own 1-hour
    // clock REPLACES this one (the discount itself stays).
    function startPathCountdown() {
      window.clearInterval(pathCountdownTimer);
      const p = decision.path;
      const clockWrap = offersEl.querySelector<HTMLElement>('[data-cd]');
      const clock = offersEl.querySelector<HTMLElement>('[data-clock]');
      if (giftLive()) {
        if (clockWrap) clockWrap.hidden = true;
        return;
      }
      if (clockWrap) clockWrap.hidden = false;
      if (
        !p ||
        !clock ||
        !p.discount.eligible ||
        p.discount.kind !== 'post' ||
        !p.discount.expires_at_ms
      ) {
        return;
      }
      const expires = p.discount.expires_at_ms;
      const tick = () => {
        const left = expires - Date.now();
        if (left <= 0) {
          window.clearInterval(pathCountdownTimer);
          refreshForCountry(lastCountry || decision.country || '');
          return;
        }
        const s = Math.floor(left / 1000);
        const hh = String(Math.floor(s / 3600)).padStart(2, '0');
        const mm = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
        const ss = String(s % 60).padStart(2, '0');
        clock.textContent = `${hh}:${mm}:${ss}`;
      };
      tick();
      pathCountdownTimer = window.setInterval(tick, 1000);
    }

    // The gift panel: shown only while the window is live, ticking down to its
    // close; on expiry we re-fetch, the panel drops away and the 48h discount
    // countdown returns.
    const giftEl = root.querySelector('[data-slot="gift"]') as HTMLElement;
    function renderGift() {
      window.clearInterval(giftCountdownTimer);
      if (!giftEl) return;
      if (!giftLive()) {
        giftEl.hidden = true;
        return;
      }
      giftEl.hidden = false;
      const clock = giftEl.querySelector<HTMLElement>('[data-slot="gift-clock"]')!;
      const ends = decision.deck_gift!.ends_at_ms!;
      const tick = () => {
        const left = ends - Date.now();
        if (left <= 0) {
          window.clearInterval(giftCountdownTimer);
          giftEl.hidden = true;
          refreshForCountry(lastCountry || decision.country || '');
          return;
        }
        const s = Math.floor(left / 1000);
        const hh = String(Math.floor(s / 3600)).padStart(2, '0');
        const mm = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
        const ss = String(s % 60).padStart(2, '0');
        clock.textContent = `${hh}:${mm}:${ss}`;
      };
      tick();
      giftCountdownTimer = window.setInterval(tick, 1000);
    }

    function renderOfferCards() {
      offersEl.replaceChildren();
      if (decision.offers.length <= 1 && offerPickerLabel) {
        offerPickerLabel.textContent = 'Your offer';
      } else if (offerPickerLabel) {
        offerPickerLabel.textContent = 'Choose your offer';
      }
      // If the previously selected slug isn't in the refreshed offer list,
      // fall back to the first card.
      if (!decision.offers.some((o) => o.slug === selectedOfferSlug)) {
        selectedOfferSlug = decision.offers[0]?.slug ?? 'cc-cert';
      }
      decision.offers.forEach((offer, i) => {
        const card = renderOfferCard(
          offer,
          i === 0,
          decision.offers.length > 1,
          decision.path,
        );
        card.dataset.offerSlug = offer.slug;
        // For a complimentary place, annotate each card so its (still-shown)
        // sticker price reads as the value of the gift, not a charge.
        if (isFreeComp) {
          const body = card.querySelector('.cc-offer-body') ?? card;
          const free = document.createElement('div');
          free.className = 'cc-offer-free';
          free.textContent = 'Included free with your invitation';
          free.style.cssText = 'margin-top:.6rem;font-weight:700;color:#065f46;';
          body.appendChild(free);
        }
        card.addEventListener('click', () => {
          selectedOfferSlug = offer.slug;
          offersEl.querySelectorAll<HTMLElement>('.cc-offer').forEach((el) => {
            el.classList.toggle(
              'cc-offer--selected',
              el.dataset.offerSlug === selectedOfferSlug,
            );
          });
          renderPlanOptions();
          renderSummary();
        });
        if (offer.slug === selectedOfferSlug) {
          card.classList.add('cc-offer--selected');
        }
        offersEl.appendChild(card);
      });
      startPathCountdown();
    }
    renderOfferCards();
    renderBumps();
    renderGift();

    // The installment ladder for a given plan on the current offer.
    function ladderFor(offer: Offer, plan: PaymentPlan): InstallmentPlan | undefined {
      if (plan === '3x') return offer.installments;
      if (plan === '6x') return offer.installments_6x;
      if (plan === '12x') return offer.installments_12x;
      return undefined;
    }

    // Payment-plan selector (full vs. 3x vs. 6x). The installment rows only
    // render for the ladders the offer actually carries. Re-renders on offer
    // change.
    const planOptionsEl = root.querySelector('[data-slot="plan-options"]') as HTMLElement;
    function renderPlanOptions() {
      planOptionsEl.replaceChildren();
      // A complimentary place is always a single €0 grant — installment choices
      // are meaningless, so hide the picker entirely.
      if (isFreeComp) {
        planPicker.style.display = 'none';
        selectedPlan = 'full';
        return;
      }
      if (selectedOfferSlug === 'cc-bundle' && decision.path) {
        renderPathPlanOptions(decision.path);
        return;
      }
      const offer = decision.offers.find((o) => o.slug === selectedOfferSlug);
      if (!offer || (!offer.installments && !offer.installments_6x)) {
        planPicker.style.display = 'none';
        selectedPlan = 'full';
        return;
      }
      planPicker.style.display = '';

      const cur = decision.currency!;
      const fullDiscCents = applyDiscountCents(offer.price_cents);

      // If the previously selected plan's ladder isn't available on this
      // offer, fall back to full pay.
      if (selectedPlan !== 'full' && !ladderFor(offer, selectedPlan)) {
        selectedPlan = 'full';
      }

      const full = renderPlanOption({
        value: 'full',
        title: 'Pay in full',
        subtitle: `One payment, full access today.`,
        amountHtml: amountWithStrike(money(offer.price, cur), moneyCents(fullDiscCents, cur)),
      });

      // One installment row per available ladder (3 monthly, then 6 monthly,
      // and 12 monthly only when unlocked via `?installment=12`).
      const installmentRows: HTMLElement[] = [];
      ([
        ['3x', offer.installments],
        ['6x', offer.installments_6x],
        ...(show12x ? [['12x', offer.installments_12x] as const] : []),
      ] as const).forEach(
        ([value, ladder]) => {
          if (!ladder) return;
          const monthlyDiscCents = applyDiscountCents(ladder.monthly_cents);
          const totalDiscCents = monthlyDiscCents * ladder.count;
          installmentRows.push(
            renderPlanOption({
              value,
              title: `Pay in ${ladder.count} monthly installments`,
              subtitle:
                shownDiscountPct > 0
                  ? `${moneyCents(monthlyDiscCents, cur)}/mo for ${ladder.count} months (${moneyCents(totalDiscCents, cur)} total, ${shownDiscountPct}% off). Full access from the first payment.`
                  : `${money(ladder.monthly, cur)}/mo for ${ladder.count} months (${money(ladder.total, cur)} total). Full access from the first payment.`,
              amountHtml: amountWithStrike(
                `${money(ladder.monthly, cur)}/mo`,
                `${moneyCents(monthlyDiscCents, cur)}/mo`,
              ),
            }),
          );
        },
      );

      const allOptions = [full, ...installmentRows];
      allOptions.forEach((el) => {
        el.addEventListener('click', () => {
          selectedPlan = el.dataset.planValue as PaymentPlan;
          planOptionsEl
            .querySelectorAll<HTMLElement>('.cc-plan-option')
            .forEach((opt) =>
              opt.classList.toggle(
                'cc-plan-option--selected',
                opt.dataset.planValue === selectedPlan,
              ),
            );
          renderSummary();
        });
      });

      // Mark the currently selected plan (default: full) as visually selected.
      allOptions.forEach((el) =>
        el.classList.toggle(
          'cc-plan-option--selected',
          el.dataset.planValue === selectedPlan,
        ),
      );
      allOptions.forEach((el) => planOptionsEl.appendChild(el));
    }

    // Plan options for the path: full vs. 3x vs. 6x on the combined total. The
    // 12-week portion is discounted; the certification portion is not. The
    // struck base shows whenever the workshop discount is live.
    function renderPathPlanOptions(p: PathPricing) {
      planPicker.style.display = '';
      const cur = p.currency;
      const full = renderPlanOption({
        value: 'full',
        title: 'Pay in full',
        subtitle: 'One payment — both courses secured today.',
        amountHtml: strikeCents(p.base_total_cents, p.total_cents, cur),
      });
      // One installment row per available tier (3 monthly, then 6 monthly).
      const instRow = (
        value: PaymentPlan,
        count: number,
        monthlyCents: number,
        baseMonthlyCents: number,
      ) =>
        renderPlanOption({
          value,
          title: `Pay in ${count} monthly installments`,
          subtitle: `${moneyCents(monthlyCents, cur)}/mo for ${count} months (${moneyCents(monthlyCents * count, cur)} total). Full access from the first payment.`,
          amountHtml: p.discount.eligible
            ? `<span class="cc-amount-strike">${escapeHtml(moneyCents(baseMonthlyCents, cur))}/mo</span>${escapeHtml(moneyCents(monthlyCents, cur))}/mo`
            : `${escapeHtml(moneyCents(monthlyCents, cur))}/mo`,
        });
      const inst3 = instRow('3x', p.installment_count, p.total_monthly_cents, p.base_total_monthly_cents);
      const inst6 = instRow('6x', p.installment_6x_count, p.total_monthly_6x_cents, p.base_total_monthly_6x_cents);
      const all = [full, inst3, inst6];
      all.forEach((el) => {
        el.addEventListener('click', () => {
          selectedPlan = el.dataset.planValue as PaymentPlan;
          planOptionsEl
            .querySelectorAll<HTMLElement>('.cc-plan-option')
            .forEach((opt) =>
              opt.classList.toggle(
                'cc-plan-option--selected',
                opt.dataset.planValue === selectedPlan,
              ),
            );
          renderSummary();
        });
      });
      full.classList.add('cc-plan-option--selected');
      selectedPlan = 'full';
      all.forEach((el) => planOptionsEl.appendChild(el));
    }

    // Summary line above the CTA: keeps the price visible right where the
    // buyer is about to commit, so there's no "wait, what am I paying?".
    const summaryLabel = root.querySelector('[data-slot="summary-label"]') as HTMLElement;
    const summaryAmount = root.querySelector('[data-slot="summary-amount"]') as HTMLElement;
    function renderSummary() {
      // Complimentary place: strike the would-be price and show "Free".
      if (isFreeComp) {
        const cur = decision.currency!;
        if (selectedOfferSlug === 'cc-bundle' && decision.path) {
          summaryLabel.textContent = 'Certification path — complimentary place';
          summaryAmount.innerHTML = `<span class="cc-amount-strike">${escapeHtml(
            moneyCents(decision.path.total_cents, decision.path.currency),
          )}</span> Free`;
        } else {
          const offer = decision.offers.find((o) => o.slug === selectedOfferSlug);
          summaryLabel.textContent = `${offer?.label ?? 'Your place'} — complimentary place`;
          summaryAmount.innerHTML = offer
            ? `<span class="cc-amount-strike">${escapeHtml(money(offer.price, cur))}</span> Free`
            : 'Free';
        }
        return;
      }
      if (selectedOfferSlug === 'cc-bundle' && decision.path) {
        const p = decision.path;
        const cur = p.currency;
        const off = p.discount.eligible
          ? p.discount.kind === 'german'
            ? ` (12-week ${pctOff(p.twelve_week_base_cents, p.twelve_week_price_cents)}% off · cert ${pctOff(p.cert_base_price_cents, p.cert_price_cents)}% off)`
            : p.discount.kind === 'override'
              ? ` (12-week ${p.discount.percent}% off)`
              : ` (${p.discount.percent}% off)`
          : '';
        if (selectedPlan === '3x' || selectedPlan === '6x') {
          const count = selectedPlan === '6x' ? p.installment_6x_count : p.installment_count;
          const monthly = selectedPlan === '6x' ? p.total_monthly_6x_cents : p.total_monthly_cents;
          const baseMonthly = selectedPlan === '6x' ? p.base_total_monthly_6x_cents : p.base_total_monthly_cents;
          summaryLabel.textContent = `Certification path — ${count} monthly payments${off}`;
          summaryAmount.innerHTML = p.discount.eligible
            ? `<span class="cc-amount-strike">${escapeHtml(moneyCents(baseMonthly, cur))}/mo</span>${escapeHtml(moneyCents(monthly, cur))}/mo`
            : `${escapeHtml(moneyCents(monthly, cur))}/mo`;
        } else {
          summaryLabel.textContent = `Certification path — one-time payment${off}`;
          summaryAmount.innerHTML = strikeCents(p.base_total_cents, p.total_cents, cur);
        }
        return;
      }
      const offer = decision.offers.find((o) => o.slug === selectedOfferSlug);
      if (!offer) return;
      const cur = decision.currency!;
      const ladder = ladderFor(offer, selectedPlan);
      if (selectedPlan !== 'full' && ladder) {
        const monthly = `${money(ladder.monthly, cur)}/mo`;
        const monthlyDisc = `${moneyCents(applyDiscountCents(ladder.monthly_cents), cur)}/mo`;
        summaryLabel.textContent = `${offer.label} — ${ladder.count} monthly payments${
          shownDiscountPct > 0 ? ` (${shownDiscountPct}% off)` : ''
        }`;
        summaryAmount.innerHTML = amountWithStrike(monthly, monthlyDisc);
      } else {
        const full = money(offer.price, cur);
        const fullDisc = moneyCents(applyDiscountCents(offer.price_cents), cur);
        summaryLabel.textContent = `${offer.label} — one-time payment${
          shownDiscountPct > 0 ? ` (${shownDiscountPct}% off)` : ''
        }`;
        summaryAmount.innerHTML = amountWithStrike(full, fullDisc);
      }
    }

    renderPlanOptions();
    renderSummary();

    // Single bottom CTA: collects all the form state + selection state and
    // hands off to /api/courses/checkout.
    const checkoutCta = root.querySelector('[data-slot="checkout-cta"]') as HTMLButtonElement;
    const paypalCta = root.querySelector('[data-slot="checkout-paypal"]') as HTMLButtonElement | null;
    // A complimentary place is fulfilled without a gateway, so relabel the CTA
    // and never offer PayPal. Otherwise reveal PayPal at runtime if it's live
    // (the page is static, so availability can't be known at build time).
    if (isFreeComp) {
      checkoutCta.innerHTML =
        '<span>Confirm your free place</span><i class="ph-light ph-arrow-right"></i>';
    } else {
      fetch('/api/payments/availability')
        .then((r) => r.json())
        .then((d: any) => { if (d && d.paypal && paypalCta) paypalCta.hidden = false; })
        .catch(() => {});
    }
    checkoutCta.addEventListener('click', () =>
      startCheckout(root, email, decision, selectedOfferSlug, selectedPlan, checkoutCta, paypalCta),
    );
    // The PayPal button runs the exact same submission path, just flipping the
    // gateway for that one checkout (full pay or any installment plan — the
    // backend handles both).
    paypalCta?.addEventListener('click', () => {
      nextProvider = 'paypal';
      startCheckout(root, email, decision, selectedOfferSlug, selectedPlan, checkoutCta, paypalCta);
    });

    // Below the cards: soft fallback link copy for A and D variants only.
    const fallback = root.querySelector('[data-slot="fallback"]') as HTMLElement;
    if (decision.variant === 'A' || decision.variant === 'D') {
      fallback.innerHTML =
        'Not sure which path is right? ' +
        '<a href="mailto:info@songdance.co?subject=A%20question%20about%20the%20SVH%20Certification%20Course">Email us</a> ' +
        '— we’ll help you find your way in.';
    }

    stage.replaceChildren(root);
  }

  function renderOfferCard(
    offer: Offer,
    primary: boolean,
    selectable: boolean,
    path?: PathPricing,
  ): HTMLElement {
    const card = document.createElement('button');
    card.type = 'button';
    card.className = 'cc-offer' + (primary ? ' cc-offer--primary' : '');
    if (!selectable) card.classList.add('cc-offer--single');
    const radioMark = selectable
      ? `<span class="cc-offer-radio" aria-hidden="true"></span>`
      : '';

    // The path: two transparent line items + a combined total. During a live
    // workshop window the whole path (both lines) is struck 20% off, with the
    // 48h countdown; an override strikes only the 12-week line.
    if (offer.slug === 'cc-bundle' && path) {
      const cur = path.currency;
      const d = path.discount;
      // The German pairing carries a different rate on each line, so compute
      // both from the cents rather than the single `percent`.
      const twPct = pctOff(path.twelve_week_base_cents, path.twelve_week_price_cents);
      const certPct = pctOff(path.cert_base_price_cents, path.cert_price_cents);
      const twAmt = d.eligible
        ? `<span class="cc-amount-strike">${escapeHtml(moneyCents(path.twelve_week_base_cents, cur))}</span>${escapeHtml(moneyCents(path.twelve_week_price_cents, cur))}`
        : escapeHtml(moneyCents(path.twelve_week_base_cents, cur));
      const badgeText = d.eligible
        ? d.kind === 'german'
          ? `German graduate — 12-week ${twPct}% off · certification ${certPct}% off`
          : d.kind === 'override'
            ? `${d.percent}% off the 12-week`
            : d.kind === 'promo'
              ? `Extended sale — ${d.percent}% off`
              : `Workshop discount — ${d.percent}% off the whole path`
        : '';
      const badge = badgeText
        ? `<div class="cc-offer-badge"><span class="dot" aria-hidden="true"></span><span>${escapeHtml(badgeText)}</span></div>`
        : '';
      const countdown =
        d.eligible && d.kind === 'post' && d.expires_at_ms
          ? `<div class="cc-offer-countdown" data-cd><i class="ph-light ph-hourglass-medium" aria-hidden="true"></i><span>Discount ends in <span class="clock" data-clock>--:--:--</span></span></div>`
          : '';
      card.innerHTML = `
        ${radioMark}
        <div class="cc-offer-body">
          <div class="cc-offer-name">${escapeHtml(offer.label)}</div>
          ${badge}
          <div class="cc-offer-path">
            <div class="cc-offer-pathline">
              <span class="cc-offer-pathline-name">12-Week Course</span>
              <span class="cc-offer-pathline-amt">${twAmt}</span>
            </div>
            <div class="cc-offer-pathline">
              <span class="cc-offer-pathline-name">Certification Course</span>
              <span class="cc-offer-pathline-amt">${strikeCents(path.cert_base_price_cents, path.cert_price_cents, cur)}</span>
            </div>
            <div class="cc-offer-pathtotal">
              <span class="cc-offer-pathtotal-label">Total</span>
              <span class="cc-offer-pathtotal-amt">${strikeCents(path.base_total_cents, path.total_cents, cur)}</span>
            </div>
          </div>
          ${countdown}
          <p class="cc-offer-save">${escapeHtml(offer.save_note)}</p>
        </div>
      `;
      return card;
    }

    // With a discount, the "Your price" row stops being the prominent one —
    // it gets struck through, and a new "After N% off" row takes the spotlight.
    const yourRowClass = shownDiscountPct > 0 ? 'cc-offer-row' : 'cc-offer-row cc-offer-row--your';
    const yourValueClass =
      shownDiscountPct > 0 ? 'cc-offer-row-value cc-offer-strike' : 'cc-offer-row-value cc-offer-your';
    const discountedRow =
      shownDiscountPct > 0
        ? `
          <div class="cc-offer-row cc-offer-row--your">
            <span class="cc-offer-row-label">After ${shownDiscountPct}% off</span>
            <span class="cc-offer-row-value cc-offer-your">${moneyCents(
              applyDiscountCents(offer.price_cents),
              offer.currency,
            )}</span>
          </div>`
        : '';

    // A separate struck "Base price" row only renders while a promo prices the
    // offer under its list (base > price) — with the mid-cohort discount
    // retired, the normal card shows a single "Your price" row.
    const baseRow =
      offer.base_price > offer.price
        ? `
          <div class="cc-offer-row">
            <span class="cc-offer-row-label">Base price</span>
            <span class="cc-offer-row-value cc-offer-base">${money(offer.base_price, offer.currency)}</span>
          </div>`
        : '';
    card.innerHTML = `
      ${radioMark}
      <div class="cc-offer-body">
        <div class="cc-offer-name">${escapeHtml(offer.label)}</div>
        <div class="cc-offer-prices">
          ${baseRow}
          <div class="${yourRowClass}">
            <span class="cc-offer-row-label">Your price</span>
            <span class="${yourValueClass}">${money(offer.price, offer.currency)}</span>
          </div>
          ${discountedRow}
        </div>
        <p class="cc-offer-save">${escapeHtml(offer.save_note)}</p>
      </div>
    `;
    return card;
  }

  function renderPlanOption(opts: {
    value: PaymentPlan;
    title: string;
    subtitle: string;
    amountHtml: string;
  }): HTMLElement {
    const el = document.createElement('button');
    el.type = 'button';
    el.className = 'cc-plan-option';
    el.dataset.planValue = opts.value;
    el.innerHTML = `
      <span class="cc-plan-radio" aria-hidden="true"></span>
      <span class="cc-plan-text">
        <span class="cc-plan-title">${escapeHtml(opts.title)}</span>
        <span class="cc-plan-sub">${escapeHtml(opts.subtitle)}</span>
      </span>
      <span class="cc-plan-amount">${opts.amountHtml}</span>
    `;
    return el;
  }

  // When a discount is active, render the original amount struck through
  // alongside the discounted amount. Otherwise just render the amount.
  function amountWithStrike(original: string, discounted: string): string {
    if (shownDiscountPct === 0) return escapeHtml(original);
    return `<span class="cc-amount-strike">${escapeHtml(original)}</span> ${escapeHtml(discounted)}`;
  }

  // Percent off, from a base + discounted cents pair. Used to label the German
  // pairing's two lines (cert 20% · English 12-week 75%), each computed from its
  // own struck→net figures rather than a single blended `discount.percent`.
  function pctOff(baseCents: number, nowCents: number): number {
    if (baseCents <= 0 || nowCents >= baseCents) return 0;
    return Math.round((1 - nowCents / baseCents) * 100);
  }

  // Strike the base amount before the discounted one, in cents — used by the
  // path (whose discount is the workshop window, independent of ?discount=N).
  function strikeCents(baseCents: number, nowCents: number, cur: Currency): string {
    if (baseCents > nowCents) {
      return `<span class="cc-amount-strike">${escapeHtml(moneyCents(baseCents, cur))}</span>${escapeHtml(moneyCents(nowCents, cur))}`;
    }
    return escapeHtml(moneyCents(nowCents, cur));
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  async function startCheckout(
    root: HTMLElement,
    email: string,
    decision: Decision,
    productSlug: Offer['slug'],
    paymentPlan: PaymentPlan,
    btn: HTMLButtonElement,
    paypalBtn?: HTMLButtonElement | null,
  ) {
    const errorSlot = root.querySelector('[data-slot="error"]') as HTMLElement;
    errorSlot.textContent = '';
    errorSlot.classList.remove('is-visible');

    const get = (name: string) =>
      String(
        (root.querySelector<HTMLInputElement>(`[name="${name}"]`)?.value ??
          '').trim(),
      );

    const first_name = get('first_name');
    const last_name = get('last_name');
    const country = get('country');
    const phone_country = get('phone_country');
    const phone = get('phone');
    const company_name = get('company_name');
    const vat_number = get('vat_number');
    const consentEl = root.querySelector<HTMLInputElement>('[name="consent_terms"]')!;
    const consent_terms = consentEl.checked;

    const fail = (msg: string) => {
      errorSlot.textContent = msg;
      errorSlot.classList.add('is-visible');
      errorSlot.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    if (!first_name || !last_name) return fail('Please add your first and last name.');
    if (!country) return fail('Please select your country from the list.');
    if (!phone_country || !phone) return fail('Please enter a phone number with country code.');
    if (vat_number && !company_name) return fail('Please add your company name to use a VAT number.');
    if (!consent_terms) return fail('Please agree to the terms to continue.');

    // Post-workshop Song Deck gift shipping (optional). While the gift panel is
    // live we collect + Google-verify a shipping address so the free deck order
    // is placed automatically; blank / a Shopify miss falls back to the emailed
    // claim link. A 'pending' result means a "did you mean" suggestion is showing
    // and its buttons will re-invoke this checkout — so we stop here.
    let shippingPayload: Record<string, string | boolean> = {};
    const giftPanel = root.querySelector<HTMLElement>('[data-slot="gift"]');
    if (giftPanel && !giftPanel.hidden) {
      const ship = await resolveShipping(root, {
        billingCountry: country,
        first: first_name,
        last: last_name,
        resubmit: () =>
          startCheckout(root, email, decision, productSlug, paymentPlan, btn, paypalBtn),
      });
      if (ship.status === 'error') return fail(ship.message);
      if (ship.status === 'pending') return;
      if (ship.status === 'ok') shippingPayload = ship.payload;
    }

    // Activate choice is only meaningful for B1 + bundle buyers; default to
    // 'now' when the toggle was never shown so the server has something
    // explicit to record.
    const activateRaw =
      root.querySelector<HTMLInputElement>('[name="activate_choice"]:checked')?.value ??
      'now';
    const activate_choice =
      productSlug === 'cc-bundle' || decision.variant === 'B1'
        ? activateRaw
        : 'now';

    // Capture the chosen gateway for this submit, then reset so the next
    // checkout defaults back to Stripe.
    const provider = nextProvider;
    nextProvider = 'stripe';

    const originalLabel = btn.innerHTML;
    btn.disabled = true;
    if (paypalBtn) paypalBtn.disabled = true;
    btn.innerHTML = isFreeComp
      ? '<span>Confirming your place…</span>'
      : '<span>Opening secure checkout…</span>';
    const restore = () => {
      btn.disabled = false;
      if (paypalBtn) paypalBtn.disabled = false;
      btn.innerHTML = originalLabel;
    };

    // Ticked order bumps (ASJ / Grief) — read from the DOM so the exact set the
    // buyer sees is what's sent. Priced + validated again server-side.
    const bumpSlugs = Array.from(
      root.querySelectorAll('[data-slot="bumps"] .cc-bump'),
    )
      .filter((el) => (el.querySelector('input') as HTMLInputElement | null)?.checked)
      .map((el) => (el as HTMLElement).dataset.bumpSlug)
      .filter((s): s is string => !!s);

    try {
      const res = await postJsonResilient('/api/courses/checkout', {
        product_slug: productSlug,
        payment_plan: paymentPlan,
        currency: decision.currency ?? 'EUR',
        first_name,
        last_name,
        email,
        country,
        phone_country,
        phone,
        company_name: company_name || undefined,
        vat_number: vat_number || undefined,
        activate_choice,
        source_variant: decision.variant,
        consent_terms: true,
        provider,
        ...shippingPayload,
        ...(bumpSlugs.length ? { bumps: bumpSlugs } : {}),
        ...(discountPct > 0 ? { discount_percent: discountPct } : {}),
        ...(adiscountPct > 0 ? { adiscount_percent: adiscountPct } : {}),
      });
      // Always try to parse JSON — the server returns JSON on errors too.
      let body: { checkout_url?: string; error?: string } = {};
      try {
        body = (await res.json()) as typeof body;
      } catch {
        // Server returned non-JSON (very unusual now). Treat as network.
      }
      if (!res.ok || !body.checkout_url) {
        fail(body.error || `Could not start checkout (HTTP ${res.status}). Please try again.`);
        restore();
        return;
      }
      // Meta Pixel: the catalog product is going to checkout (off to Stripe/
      // PayPal next). content_ids = the chosen slug, matching the feed/Pixel.
      const fbq = (window as any).fbq;
      if (fbq) {
        try {
          // The bundle ("path") is the certification course in the catalog.
          fbq('track', 'AddToCart', {
            content_ids: ['cc-cert'],
            content_type: 'product',
            currency: decision.currency ?? 'EUR',
          });
        } catch (e) {}
      }
      window.location.href = body.checkout_url;
    } catch {
      fail('We could not reach the server. Please try again.');
      restore();
    }
  }

  async function activateNow(
    email: string,
    btn: HTMLButtonElement,
    msg: HTMLElement,
    confirmBlock: HTMLElement,
  ) {
    const originalLabel = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span>Activating…</span>';
    msg.textContent = '';
    msg.classList.remove('is-visible', 'is-error');
    try {
      const res = await postJsonResilient('/api/courses/activate-now', { email });
      let body: { ok?: boolean; error?: string } = {};
      try {
        body = (await res.json()) as typeof body;
      } catch {}
      if (!res.ok || !body.ok) {
        msg.textContent = body.error || 'We could not activate the course just now. Please try again.';
        msg.classList.add('is-visible', 'is-error');
        btn.disabled = false;
        btn.innerHTML = originalLabel;
        return;
      }
      // Success: collapse the confirm UI and show a plain confirmation
      // message. Drip will email the portal access details — we don't link
      // here because the portal isn't ready until that automation runs.
      confirmBlock.hidden = true;
      msg.textContent =
        "Activated. You'll receive a confirmation email shortly with everything you need to step into the certification course.";
      msg.classList.add('is-visible');
    } catch {
      msg.textContent = 'We could not reach the server. Please try again.';
      msg.classList.add('is-visible', 'is-error');
      btn.disabled = false;
      btn.innerHTML = originalLabel;
    }
  }

  // Rehydrate on load from localStorage (set by the teaser or a prior visit).
  // Skipped when `?email=` is in the URL — the teaser will auto-submit with
  // that address and dispatch `cc:decision-updated`, and we don't want a
  // stale cached decision to flash in first.
  function hasUrlEmail(): boolean {
    try {
      const raw = new URLSearchParams(window.location.search).get('email');
      return !!(raw && raw.trim());
    } catch {}
    return false;
  }
  // A cached decision priced during the launch sale — the path's 12-week line
  // carries discount.kind 'promo' (with no expiry, so no countdown ever clears
  // it), and/or a cert/bundle offer carries the promo-tagged save_note. Once the
  // sale closes, that pricing is stale: the server no longer honours it and
  // checkout re-derives the current (non-sale) price. So a visitor who checked
  // their email while the sale was live would otherwise keep seeing the struck
  // sale prices + "Extended sale" line from localStorage after it ended.
  function decisionIsPromoPriced(decision: Decision): boolean {
    if (decision?.path?.discount?.kind === 'promo') return true;
    for (const o of decision?.offers ?? []) {
      if (typeof o?.save_note === 'string' && o.save_note.startsWith(LAUNCH_PROMO_TAG)) {
        return true;
      }
    }
    return false;
  }

  // Silent re-check against the server for a cached email, replacing a stale
  // cached decision with fresh pricing. On any failure we drop to the email
  // form (prefilled) rather than showing the stale card.
  async function recheckAndRender(email: string) {
    startStatus();
    try {
      const res = await postJsonResilient(
        '/api/courses/subscriber-status',
        { email, discount_percent: shownDiscountPct || undefined },
        { onAttempt: (attempt) => { if (attempt > 1) setStatus('Reconnecting…'); } },
      );
      const body = (await res.json()) as Decision | { error: string };
      if (!res.ok || !('variant' in body)) {
        stopStatus();
        showEmailForm(email);
        return;
      }
      stopStatus();
      saveDecision(email, body);
      renderVariant(email, body);
    } catch {
      stopStatus();
      showEmailForm(email);
    }
  }

  function rehydrateFromStorage() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const parsed = JSON.parse(raw) as { email?: string; decision?: Decision };
      if (parsed?.email && parsed?.decision?.variant) {
        // A cached decision was priced WITHOUT this link's override (the cache
        // is shared with the teaser and keyed on the email alone), so a
        // returning visitor opening a `?discount=N` link would be shown the
        // undiscounted path price while the checkout charged the discount.
        // Re-derive instead of rendering the cache.
        if (shownDiscountPct > 0) {
          recheckAndRender(parsed.email);
          return true;
        }
        // Stale launch-sale price frozen in the cache after the sale closed —
        // discard it and fetch the current price instead of flashing the old one.
        if (decisionIsPromoPriced(parsed.decision) && !launchPromoActive()) {
          try { localStorage.removeItem(STORAGE_KEY); } catch {}
          recheckAndRender(parsed.email);
          return true;
        }
        renderVariant(parsed.email, parsed.decision);
        return true;
      }
    } catch {}
    return false;
  }
  if (!hasUrlEmail()) rehydrateFromStorage();

  // React to updates dispatched from the teaser.
  window.addEventListener('cc:decision-updated', (ev) => {
    const det = (ev as CustomEvent).detail as { email: string; decision: Decision };
    if (det?.email && det?.decision) renderVariant(det.email, det.decision);
  });
  window.addEventListener('cc:decision-cleared', () => showEmailForm());
</script>
