---
---

<section class="cc-teaser" id="check-price" data-cc-teaser-root>
  <div class="cc-teaser-inner">
    <div class="cc-teaser-intro" data-cc-teaser-intro>
      <div class="cc-eyebrow cc-eyebrow--center">A personal price, not a public one</div>
      <h2 class="cc-teaser-h2">
        See your <em>price.</em>
      </h2>
      <p class="cc-teaser-lead">
        Your price depends on where you already are with this work. Enter
        your email and we'll show you the right offer further down the page.
      </p>
    </div>

    <div class="cc-teaser-stage" data-cc-teaser-stage>
      <form class="cc-teaser-form" data-cc-teaser-form>
        <input
          type="email"
          name="email"
          placeholder="Your email"
          autocomplete="email"
          required
        />
        <button type="submit">Check</button>
      </form>
      <p class="cc-teaser-note">
        We'll only use this to show you the right offer. No sign-up, no list.
      </p>
      <div class="cc-teaser-status" data-cc-teaser-status hidden aria-live="polite">
        <span class="cc-teaser-spinner" aria-hidden="true"></span>
        <span data-cc-teaser-status-text>Finding your profile…</span>
      </div>
      <p class="cc-teaser-error" data-cc-teaser-error></p>
    </div>

    <template data-cc-teaser-result>
      <div class="cc-teaser-result">
        <div class="cc-teaser-badge" data-slot="badge">
          <i class="ph-light ph-seal-check" aria-hidden="true"></i>
          <span data-slot="badge-label"></span>
        </div>
        <div class="cc-teaser-greeting" data-slot="greeting"></div>
        <p class="cc-teaser-body" data-slot="body"></p>
        <div class="cc-teaser-actions">
          <a href="#register" class="cc-teaser-cta" data-slot="cta-down">
            <span data-slot="cta-label">See your offer</span>
            <i class="ph-light ph-arrow-down"></i>
          </a>
          <button type="button" class="cc-teaser-change" data-slot="change">
            use a different email
          </button>
        </div>
      </div>
    </template>
  </div>
</section>

<script>
  import { postJsonResilient } from '../../lib/client/resilient-fetch';
  import { readCourseUrlDiscount } from '../../lib/courses/discount';

  // The same URL discount the register block reads. It matters here because
  // this lookup is often the ONLY one that runs: with `?email=` in the URL the
  // register block skips its own fetch and renders whatever decision this form
  // dispatches. Sending no override priced the page at full price while the
  // checkout charged the discount — so a `?discount=N` link looked inert to
  // anyone who arrived from a campaign link carrying their address.
  const { shownPct: urlDiscountPct } = readCourseUrlDiscount(window.location.search);

  type Variant = 'B1' | 'B2' | 'G' | 'A' | 'D' | 'E' | 'C';
  type Currency =
    | 'EUR' | 'USD' | 'GBP' | 'CAD' | 'CHF'
    | 'AUD' | 'NZD' | 'NOK' | 'SEK' | 'DKK';
  type InstallmentPlan = {
    currency: Currency;
    monthly_cents: number;
    monthly: number;
    total_cents: number;
    total: number;
    count: number;
  };
  type Offer = {
    slug: 'cc-cert' | 'cc-bundle';
    label: string;
    currency: Currency;
    price: number;
    price_cents: number;
    base_price: number;
    save_note: string;
    installments?: InstallmentPlan;
  };
  type Decision = {
    variant: Variant;
    currency: Currency;
    offers: Offer[];
    twelve_week_week?: number;
    can_activate_now?: boolean;
    course_portal_url?: string;
    first_name?: string;
    last_name?: string;
    country?: string;
    phone?: string;
  };

  // Keep in sync with CCRegister's STORAGE_KEY — they share the cache.
  const STORAGE_KEY = 'cc:decision:v4';

  function teaserCopyFor(d: Decision): {
    badge: string;
    greeting: string;
    body: string;
    ctaLabel: string;
  } {
    const name = (d.first_name || '').trim();
    const hi = name ? `Hi ${name},` : 'Hi there,';
    switch (d.variant) {
      case 'B1':
        return {
          badge: 'A price for where you are',
          greeting: hi,
          body:
            (d.twelve_week_week
              ? `you're already in week ${d.twelve_week_week} of the 12-week course. `
              : `you're already in the 12-week course. `) +
            `The certification course continues from there — and your price reflects what you've already walked.`,
          ctaLabel: 'See your offer',
        };
      case 'B2':
        return {
          badge: 'A price for where you are',
          greeting: name ? `Welcome back, ${name}.` : 'Welcome back.',
          body: `You've completed the 12-week course. The certification course continues from where that foundation ends — and your price honours what you've already done.`,
          ctaLabel: 'See your offer',
        };
      case 'G':
        return {
          badge: 'Graduate price',
          greeting: name ? `Welcome back, ${name}.` : 'Welcome back.',
          body: `You've completed the 12-week course in German. Step into the certification at a graduate's price — or add the English 12-week course alongside it, deeply discounted.`,
          ctaLabel: 'See your offer',
        };
      case 'A':
        return {
          badge: 'Welcome-back price',
          greeting: name ? `Welcome back, ${name}.` : 'Welcome back.',
          body: `You've walked this work in its earlier form. The certification course is the current arc — two ways in, depending on how deep you want to begin again.`,
          ctaLabel: 'See your options',
        };
      case 'D':
        return {
          badge: 'Your price',
          greeting: name ? `Good to see you, ${name}.` : 'Good to see you.',
          body: `You've already found this work. You can step straight into the certification — or take the full path, including the 12-week foundation, if you haven't walked it yet.`,
          ctaLabel: 'See your options',
        };
      case 'E':
        return {
          badge: 'The full path',
          greeting: name ? `Welcome, ${name}.` : 'Welcome.',
          body: `For someone new to this work, the full path is the way in — the 12-week foundation and the certification course as one continuous journey, self-paced from the day you join.`,
          ctaLabel: 'See the full path',
        };
      case 'C':
        return {
          badge: "You're already enrolled",
          greeting: name ? `You're already in, ${name}.` : "You're already in.",
          body: `You're enrolled in the certification course. The portal link is further down — see you in the next class.`,
          ctaLabel: 'Open the course portal',
        };
    }
  }

  const stage = document.querySelector<HTMLElement>('[data-cc-teaser-stage]')!;
  if (stage) {
    const root = document.querySelector<HTMLElement>('[data-cc-teaser-root]')!;
    const form = stage.querySelector<HTMLFormElement>('[data-cc-teaser-form]')!;
    const errorEl = stage.querySelector<HTMLElement>('[data-cc-teaser-error]')!;
    const noteEl = document.querySelector<HTMLElement>('.cc-teaser-note');
    const statusEl = stage.querySelector<HTMLElement>('[data-cc-teaser-status]')!;
    const statusTextEl = statusEl.querySelector<HTMLElement>('[data-cc-teaser-status-text]')!;
    const template = document.querySelector<HTMLTemplateElement>(
      '[data-cc-teaser-result]',
    )!;

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.classList.add('is-visible');
    }
    function clearError() {
      errorEl.textContent = '';
      errorEl.classList.remove('is-visible');
    }

    // Lookup progress: spinner + reassuring rotating copy, so a slow round-trip
    // on mobile reads as "working", not "broken".
    const PROGRESS_MESSAGES = [
      'Finding your profile…',
      'Checking your place on the path…',
      'Almost there…',
    ];
    let statusRotateTimer: number | undefined;
    function startStatus() {
      clearError();
      statusEl.hidden = false;
      let i = 0;
      statusTextEl.textContent = PROGRESS_MESSAGES[0];
      window.clearInterval(statusRotateTimer);
      statusRotateTimer = window.setInterval(() => {
        i = (i + 1) % PROGRESS_MESSAGES.length;
        statusTextEl.textContent = PROGRESS_MESSAGES[i];
      }, 2200);
    }
    function setStatus(text: string) {
      window.clearInterval(statusRotateTimer);
      statusTextEl.textContent = text;
    }
    function stopStatus() {
      window.clearInterval(statusRotateTimer);
      statusEl.hidden = true;
    }

    function showForm(prefillEmail?: string) {
      stopStatus();
      root.classList.remove('cc-teaser--has-result');
      stage.replaceChildren(form);
      if (noteEl) stage.appendChild(noteEl);
      stage.appendChild(errorEl);
      // Keep the progress status between the note and the error line, without a
      // further `stage` reference (TS can't narrow `stage` inside this hoisted
      // helper, so this avoids a spurious "possibly null" on a guaranteed node).
      errorEl.parentNode?.insertBefore(statusEl, errorEl);
      const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
      if (prefillEmail) input.value = prefillEmail;
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = false;
      btn.textContent = 'Check';
    }

    function renderResult(email: string, decision: Decision) {
      const fragment = template.content.cloneNode(true) as DocumentFragment;
      const resultRoot = fragment.querySelector('.cc-teaser-result') as HTMLElement;
      const copy = teaserCopyFor(decision);
      (resultRoot.querySelector('[data-slot="badge-label"]') as HTMLElement).textContent = copy.badge;
      (resultRoot.querySelector('[data-slot="greeting"]') as HTMLElement).textContent = copy.greeting;
      (resultRoot.querySelector('[data-slot="body"]') as HTMLElement).textContent = copy.body;
      (resultRoot.querySelector('[data-slot="cta-label"]') as HTMLElement).textContent = copy.ctaLabel;

      // For variant C we steer the user to the portal in the bottom block;
      // for everyone else, scroll to the offer/form block.
      const cta = resultRoot.querySelector('[data-slot="cta-down"]') as HTMLAnchorElement;
      cta.setAttribute('href', '#register');

      const changeBtn = resultRoot.querySelector('[data-slot="change"]') as HTMLButtonElement;
      changeBtn.addEventListener('click', () => {
        try { localStorage.removeItem(STORAGE_KEY); } catch {}
        window.dispatchEvent(new CustomEvent('cc:decision-cleared'));
        showForm(email);
        clearError();
      });

      root.classList.add('cc-teaser--has-result');
      stage.replaceChildren(resultRoot);
    }

    function save(email: string, decision: Decision) {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ email, decision, ts: Date.now() }),
        );
      } catch {}
      window.dispatchEvent(
        new CustomEvent('cc:decision-updated', { detail: { email, decision } }),
      );
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim().toLowerCase();
      if (!email) return;
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true;
      btn.textContent = 'Checking…';
      startStatus();
      try {
        const res = await postJsonResilient(
          '/api/courses/subscriber-status',
          { email, discount_percent: urlDiscountPct || undefined },
          {
            onAttempt: (attempt) => {
              if (attempt > 1) setStatus('Reconnecting…');
            },
          },
        );
        const body = (await res.json()) as Decision | { error: string };
        if (!res.ok || !('variant' in body)) {
          stopStatus();
          showError(('error' in body && body.error) || 'Something went wrong. Please try again.');
          btn.disabled = false;
          btn.textContent = 'Check';
          return;
        }
        stopStatus();
        save(email, body);
        renderResult(email, body);
      } catch {
        stopStatus();
        showError('We had trouble reaching the server — please check your connection and tap Check again.');
        btn.disabled = false;
        btn.textContent = 'Check';
      }
    });

    // URL-driven prefill. `?email=...` (e.g. from a Drip campaign link)
    // prefills the input and auto-submits so the recipient lands directly
    // on their personalised offer. A URL email overrides any cached
    // decision — the link is more authoritative than stale localStorage.
    function readEmailFromUrl(): string | undefined {
      try {
        const raw = new URLSearchParams(window.location.search).get('email');
        if (!raw) return undefined;
        const e = raw.trim().toLowerCase();
        return e || undefined;
      } catch {}
      return undefined;
    }

    const urlEmail = readEmailFromUrl();
    if (urlEmail) {
      try { localStorage.removeItem(STORAGE_KEY); } catch {}
      const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
      input.value = urlEmail;
      form.requestSubmit();
    } else {
      // Rehydrate if a previous visit stored a decision.
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw) as { email?: string; decision?: Decision };
          if (parsed?.email && parsed?.decision?.variant) {
            renderResult(parsed.email, parsed.decision);
          }
        }
      } catch {}
    }

    // If the bottom block resolves a decision first, mirror it up here.
    window.addEventListener('cc:decision-updated', (ev) => {
      const det = (ev as CustomEvent).detail as { email: string; decision: Decision };
      if (det?.email && det?.decision) renderResult(det.email, det.decision);
    });
    window.addEventListener('cc:decision-cleared', () => showForm());
  }
</script>
