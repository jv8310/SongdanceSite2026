---
// Persistent admin top bar. Rendered on every /admin page (except login) via
// Layout.astro so the global actions stay reachable wherever you navigate.
// It is sticky on scroll; each page's own breadcrumbs / back link / title sit
// underneath it in the page's .adm-header.
// Stats + Performance carry labels; People / Settings / Images are icon-only
// (title + aria-label) to save width. Calendar sync lives in Settings and on
// the workshops page.
import { getSessionEmail, readCookie } from '../../lib/registrations/auth';

// Which admin is signed in (multi-user login). Defensive — never let a cookie
// hiccup break the chrome; just hide the label if we can't read it.
let signedInAs: string | null = null;
try {
  const env = Astro.locals.runtime.env;
  signedInAs = await getSessionEmail(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
} catch {
  signedInAs = null;
}
---
<header class="adm-topbar">
  <div class="adm-topbar-inner">
    <a class="adm-topbar-brand" href="/admin" aria-label="Admin home">
      <img src="/brand/symbol-orange.png" alt="" width="26" height="26" />
      <span>Admin</span>
    </a>
    <nav class="adm-actions" aria-label="Admin">
      <a class="adm-btn adm-btn--ghost adm-btn--nav" href="/admin/stats">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        <span>Stats</span>
      </a>
      <a class="adm-btn adm-btn--ghost adm-btn--nav" href="/admin/workshops/performance">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
        <span>Performance</span>
      </a>
      <a class="adm-btn adm-btn--ghost adm-btn--nav adm-btn--icon" href="/admin/people" title="People" aria-label="People">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </a>
      <a class="adm-btn adm-btn--ghost adm-btn--nav adm-btn--icon" href="/admin/settings" title="Settings" aria-label="Settings">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </a>
      <a class="adm-btn adm-btn--ghost adm-btn--nav adm-btn--icon" href="/admin/image-manager" title="Images" aria-label="Images">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </a>
      {signedInAs && (
        <span class="adm-topbar-user" title={`Signed in as ${signedInAs}`}>{signedInAs}</span>
      )}
      <form method="POST" action="/api/admin/login?_method=DELETE">
        <input type="hidden" name="_method" value="DELETE" />
        <button class="adm-btn adm-btn--ghost adm-btn--nav" type="submit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Sign out</span>
        </button>
      </form>
    </nav>
  </div>
</header>
