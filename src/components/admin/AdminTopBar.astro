---
// Persistent admin top bar. Rendered on every /admin page (except login) via
// Layout.astro so the global actions stay reachable wherever you navigate.
// It is sticky on scroll; each page's own breadcrumbs / back link / title sit
// underneath it in the page's .adm-header.
// Stats + Performance carry labels; People / Settings / Images / Sign out are icon-only
// (title + aria-label) to save width. Calendar sync lives in Settings and on
// the workshops page. The search button (and ⌘K / Ctrl+K on any admin page)
// opens the people palette: type a name, email or order number and jump to that
// person's page (/api/admin/people-search). Each hit also shows their member-app
// access — account or not, and the courses the app opens for them.
import { getSessionEmail, readCookie } from '../../lib/registrations/auth';

// Which admin is signed in (multi-user login). Defensive — never let a cookie
// hiccup break the chrome; just hide the label if we can't read it.
let signedInAs: string | null = null;
try {
  const env = Astro.locals.runtime.env;
  signedInAs = await getSessionEmail(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
} catch {
  signedInAs = null;
}
---
<header class="adm-topbar">
  <div class="adm-topbar-inner">
    <a class="adm-topbar-brand" href="/admin" aria-label="Admin home">
      <img src="/brand/symbol-orange.png" alt="" width="26" height="26" />
      <span>Admin</span>
    </a>
    <nav class="adm-actions" aria-label="Admin">
      <button type="button" class="adm-btn adm-btn--ghost adm-btn--nav adm-search-btn" data-adm-search-open title="Find a person (⌘K)" aria-label="Find a person">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span>Find</span>
        <kbd class="adm-search-kbd" data-adm-search-kbd>⌘K</kbd>
      </button>
      <a class="adm-btn adm-btn--ghost adm-btn--nav" href="/admin/stats">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        <span>Stats</span>
      </a>
      <a class="adm-btn adm-btn--ghost adm-btn--nav" href="/admin/workshops/performance">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
        <span>Performance</span>
      </a>
      <a class="adm-btn adm-btn--ghost adm-btn--nav adm-btn--icon" href="/admin/people" title="People" aria-label="People">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </a>
      <a class="adm-btn adm-btn--ghost adm-btn--nav adm-btn--icon" href="/admin/settings" title="Settings" aria-label="Settings">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </a>
      <a class="adm-btn adm-btn--ghost adm-btn--nav adm-btn--icon" href="/admin/image-manager" title="Images" aria-label="Images">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </a>
      {signedInAs && (
        <span class="adm-topbar-user" title={`Signed in as ${signedInAs}`}>{signedInAs}</span>
      )}
      <form method="POST" action="/api/admin/login?_method=DELETE">
        <input type="hidden" name="_method" value="DELETE" />
        <button class="adm-btn adm-btn--ghost adm-btn--nav adm-btn--icon" type="submit" title="Sign out" aria-label="Sign out">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>
      </form>
    </nav>
  </div>
</header>

<dialog class="adm-palette" data-adm-palette aria-label="Find a person">
  <div class="adm-palette-box">
    <div class="adm-palette-field">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input
        type="search"
        data-adm-palette-input
        placeholder="Find a person — name, email or order #"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="adm-palette-list"
        aria-autocomplete="list"
      />
      <kbd class="adm-search-kbd">esc</kbd>
    </div>
    <ul class="adm-palette-list" id="adm-palette-list" role="listbox" data-adm-palette-list></ul>
    <p class="adm-palette-hint" data-adm-palette-hint>Type at least two letters.</p>
    <p class="adm-palette-foot"><kbd>↑</kbd><kbd>↓</kbd> to move · <kbd>↵</kbd> person · <kbd>⇧↵</kbd> their orders</p>
  </div>
</dialog>

<script>
  type CourseState = 'active' | 'waiting-activation' | 'starts-later' | 'ended' | 'revoked';
  type AppLine = { account: boolean; role: string | null; courses: Array<{ label: string; state: CourseState }> };
  type Hit = { email: string; name: string | null; orders: number; app: AppLine | null };
  type Item = { href: string; title: string; sub: string; ordersHref?: string; app?: AppLine | null };

  const STATE_WORD: Record<CourseState, string> = {
    active: 'open',
    'waiting-activation': 'waiting for activation',
    'starts-later': 'starts later',
    ended: 'ended',
    revoked: 'revoked',
  };

  // "App: Certification course · open, Grief course · ended" — or that there is nothing.
  const appLine = (app: AppLine): HTMLElement => {
    const el = document.createElement('span');
    el.className = 'adm-palette-app';
    const lead = document.createElement('em');
    lead.textContent = app.account ? (app.role && app.role !== 'member' ? `App (${app.role === 'admin' ? 'app admin' : app.role})` : 'App') : 'No app account';
    el.append(lead);
    if (!app.courses.length) {
      if (app.account) el.append(' · no courses');
      return el;
    }
    for (const c of app.courses) {
      const chip = document.createElement('b');
      chip.className = `adm-palette-course adm-palette-course--${c.state === 'active' ? 'open' : c.state === 'ended' ? 'ended' : 'waiting'}`;
      chip.textContent = c.state === 'active' ? c.label : `${c.label} · ${STATE_WORD[c.state]}`;
      el.append(chip);
    }
    return el;
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-adm-palette]');
  const input = document.querySelector<HTMLInputElement>('[data-adm-palette-input]');
  const list = document.querySelector<HTMLUListElement>('[data-adm-palette-list]');
  const hint = document.querySelector<HTMLElement>('[data-adm-palette-hint]');

  if (dialog && input && list && hint) {
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    if (!isMac) {
      document.querySelectorAll<HTMLElement>('[data-adm-search-kbd]').forEach((k) => (k.textContent = 'Ctrl K'));
      document.querySelectorAll<HTMLElement>('[data-adm-search-open]').forEach((b) => (b.title = 'Find a person (Ctrl+K)'));
    }

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const ORDER_RE = /^[rcw]-\d+$/i;
    const personHref = (email: string) => `/admin/people/${encodeURIComponent(email)}`;
    const ordersHref = (email: string) => `/admin/orders?email=${encodeURIComponent(email)}`;

    let items: Item[] = [];
    let active = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let ctrl: AbortController | null = null;

    const render = () => {
      list.replaceChildren(
        ...items.map((it, i) => {
          const li = document.createElement('li');
          li.id = `adm-palette-opt-${i}`;
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', String(i === active));
          li.className = 'adm-palette-item' + (i === active ? ' is-active' : '');
          const a = document.createElement('a');
          a.href = it.href;
          const t = document.createElement('strong');
          t.textContent = it.title;
          const s = document.createElement('span');
          s.textContent = it.sub;
          a.append(t, s);
          if (it.app) a.append(appLine(it.app));
          li.append(a);
          if (it.ordersHref) {
            const o = document.createElement('a');
            o.href = it.ordersHref;
            o.className = 'adm-palette-orders';
            o.textContent = 'Orders →';
            li.append(o);
          }
          li.addEventListener('mousemove', () => {
            if (active !== i) { active = i; render(); }
          });
          return li;
        }),
      );
      if (items.length) input.setAttribute('aria-activedescendant', `adm-palette-opt-${active}`);
      else input.removeAttribute('aria-activedescendant');
      list.querySelector('.is-active')?.scrollIntoView({ block: 'nearest' });
    };

    const setItems = (next: Item[], message: string) => {
      items = next;
      active = 0;
      hint.textContent = message;
      hint.hidden = !message;
      render();
    };

    // What the typed text opens on its own, before (or without) a search hit.
    const directItems = (q: string): Item[] => {
      if (ORDER_RE.test(q)) {
        const no = q.toUpperCase();
        return [{ href: `/admin/orders/${no}`, title: `Order ${no}`, sub: 'Open this order' }];
      }
      return [];
    };

    const search = async (q: string) => {
      ctrl?.abort();
      ctrl = new AbortController();
      const direct = directItems(q);
      try {
        const res = await fetch(`/api/admin/people-search?q=${encodeURIComponent(q)}`, { signal: ctrl.signal });
        if (res.status === 401) { setItems([], 'Your session has ended — sign in again.'); return; }
        if (!res.ok) throw new Error(String(res.status));
        const { people, typedApp } = (await res.json()) as { people: Hit[]; typedApp: AppLine | null };
        const hits: Item[] = people.map((p) => ({
          href: personHref(p.email),
          title: p.name || p.email,
          sub: [p.name ? p.email : null, p.orders ? `${p.orders} order${p.orders === 1 ? '' : 's'}` : 'no orders']
            .filter(Boolean)
            .join(' · '),
          ordersHref: p.orders ? ordersHref(p.email) : undefined,
          app: p.app,
        }));
        // A whole address the site doesn't know still has a page (App access).
        const typed = q.toLowerCase();
        if (EMAIL_RE.test(typed) && !people.some((p) => p.email === typed)) {
          hits.push({ href: personHref(typed), title: typed, sub: 'Open this address', app: typedApp });
        }
        const all = [...direct, ...hits];
        setItems(all, all.length ? '' : 'Nobody matches that.');
      } catch (err) {
        if ((err as Error).name === 'AbortError') return;
        setItems(direct, 'Search failed — try again.');
      }
    };

    input.addEventListener('input', () => {
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < 2) { ctrl?.abort(); setItems([], 'Type at least two letters.'); return; }
      setItems(directItems(q), 'Searching…');
      timer = setTimeout(() => search(q), 160);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!items.length) return;
        active = (active + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
        render();
      } else if (e.key === 'Enter') {
        const it = items[active];
        if (!it) return;
        e.preventDefault();
        const href = e.shiftKey && it.ordersHref ? it.ordersHref : it.href;
        if (e.metaKey || e.ctrlKey) window.open(href, '_blank');
        else window.location.href = href;
      }
    });

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      input.select();
    };
    document.querySelectorAll('[data-adm-search-open]').forEach((b) => b.addEventListener('click', open));
    // Click on the backdrop (outside the box) closes.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });
  }
</script>
