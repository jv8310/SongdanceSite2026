---
const offerings = [
  {
    label: 'A Vocal Healing Workshop',
    title: 'An hour, live, online',
    body: "You don't watch — you sound. The simplest way to feel what this is, from the inside.",
    meta: ['22€', 'live', 'online'],
    tag: 'one live hour',
    href: '/workshop',
    feature: false,
  },
  {
    label: 'The 12-Week Course',
    title: 'Learn the practice properly',
    body: 'Twelve weeks, in your own time, with live Q&A. Until you can become your own space holder.',
    meta: ['foundational', 'self-paced', 'live Q&A'],
    tag: 'foundational',
    href: '/courses/12-week',
    feature: false,
  },
  {
    label: 'For Professionals',
    title: 'How sound works in your work',
    body: 'Therapists, coaches, bodyworkers, facilitators, leaders: what sound can do when words are not enough.',
    meta: ['44€', 'masterclass', 'online'],
    tag: 'masterclass',
    href: '/courses/masterclass',
    feature: false,
  },
  {
    label: 'Practitioner Training',
    title: 'Hold this work for others',
    body: "Live training for people who want to hold space for others' sounding — to go deeper themselves, or to certify.",
    meta: ['certification', 'live', 'in cohorts'],
    tag: 'live training',
    href: '/courses/certification',
    feature: true,
  },
];
---

<section class="sd-offerings" id="offerings">
  <div class="sd-offerings-inner">
    <div class="sd-offerings-head" data-anim="reveal">
      <div class="sd-eyebrow">Offerings</div>
      <h2 class="sd-section-title sd-section-title-centered">Four ways to begin.</h2>
    </div>
    <div class="sd-offerings-grid">
      {
        offerings.map((o) => (
          <article class={'sd-offering-card' + (o.feature ? ' sd-offering-card--feature' : '')} data-anim="offering">
            <div class="sd-offering-top">
              <div class="sd-offering-label">{o.label}</div>
              <span class="sd-tag sd-tag-ember">{o.tag}</span>
            </div>
            <h3 class="sd-offering-title">{o.title}</h3>
            <p class="sd-offering-body">{o.body}</p>
            <div class="sd-offering-meta">
              {o.meta.map((m, i) => (
                <>
                  {i > 0 && <span class="sd-dot" />}
                  <span data-sd-price={m === '22€' ? 'ticket' : m === '44€' ? 'masterclass' : undefined}>{m}</span>
                </>
              ))}
            </div>
            <a href={o.href} class="sd-offering-cta">
              Read more <i class="ph-light ph-arrow-right" />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
