---
// Progressive enhancement for marketing price labels on the statically-built
// site. The HTML ships with the EUR price baked in (correct for the base
// currency and for crawlers — no JS needed); this script does two things after
// load, touching only elements tagged with data-sd-price:
//
//  1. Currency — for non-EUR visitors it swaps the EUR token (9€ / €99 …) for
//     the market-appropriate label, using the country Cloudflare exposes at
//     /api/geo.
//  2. Launch promo — for elements that also carry data-sd-promo-price (the
//     /courses grid price chips), while the promo window is live it renders the
//     normal price struck through + the discounted price, both in the resolved
//     currency. Chips with data-sd-compare (the certification) always show a
//     struck sticker. Gated on window.__SD_PROMO__.active (set in the base
//     Layout), so it self-expires at the deadline with no rebuild.
//
// Why client-side and not SSR: the pages are output:'static', served from cache.
// Resolving per request would force every page (the nav is global) to render
// dynamically, hurting load speed and cacheability. Price strings are not
// SEO-ranking content, so adjusting them after load costs nothing on either.
import {
  buildMarketingPriceLabels,
  buildMarketingPromoPriceLabels,
  buildMarketingCompareLabels,
  EUR_COPY_LABEL,
} from '../lib/workshops/marketing-prices';
import { COUNTRY_CURRENCY } from '../lib/workshops/currency';

const payload = JSON.stringify({
  labels: buildMarketingPriceLabels(),
  promoLabels: buildMarketingPromoPriceLabels(),
  compareLabels: buildMarketingCompareLabels(),
  eur: EUR_COPY_LABEL,
  countries: COUNTRY_CURRENCY,
});
---

<script type="application/json" id="sd-price-data" set:html={payload}></script>
<script is:inline>
  (function () {
    var dataEl = document.getElementById('sd-price-data');
    if (!dataEl) return;
    var D;
    try { D = JSON.parse(dataEl.textContent || '{}'); } catch (e) { return; }
    if (!D.labels) return;

    var KEY = 'sd_cur';
    var TTL = 14 * 24 * 60 * 60 * 1000; // re-check currency every 14 days

    function currencyFor(country) {
      if (!country) return 'EUR';
      return D.countries[String(country).toUpperCase()] || 'EUR';
    }

    function replaceToken(el, from, to) {
      var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
      var n;
      while ((n = walker.nextNode())) {
        if (n.nodeValue.indexOf(from) !== -1) {
          n.nodeValue = n.nodeValue.split(from).join(to);
        }
      }
    }

    function promoActive() {
      return !!(window.__SD_PROMO__ && window.__SD_PROMO__.active);
    }

    function apply(cur) {
      cur = cur || 'EUR';
      var promo = promoActive();
      var nodes = document.querySelectorAll('[data-sd-price]');
      for (var i = 0; i < nodes.length; i++) {
        var el = nodes[i];
        var product = el.getAttribute('data-sd-price');
        if (!product) continue;
        var labels = D.labels[product];
        var eur = D.eur[product];

        // Permanent-strike chips (data-sd-compare — the certification): always
        // show the sticker struck through + the current price, which is the
        // promo price while the promo runs, else the normal price.
        if (el.hasAttribute('data-sd-compare') && D.compareLabels) {
          var cmpMap = D.compareLabels[product];
          var compareLabel = cmpMap && cmpMap[cur];
          var currentMap = (promo && D.promoLabels && D.promoLabels[product]) || (labels || {});
          var currentLabel = currentMap[cur];
          if (compareLabel && currentLabel) {
            el.innerHTML =
              '<s class="sd-was">' + compareLabel + '</s> <span class="sd-now">' + currentLabel + '</span>';
            continue;
          }
        }

        // Promo display — grid chips that opt in (data-sd-promo-price). Render
        // the normal price struck through + the discounted price.
        if (promo && el.hasAttribute('data-sd-promo-price') && D.promoLabels) {
          var listLabel = (labels && labels[cur]) || eur;
          var promoMap = D.promoLabels[product];
          var nowLabel = promoMap && promoMap[cur];
          if (listLabel && nowLabel) {
            el.innerHTML =
              '<s class="sd-was">' + listLabel + '</s> <span class="sd-now">' + nowLabel + '</span>';
            continue;
          }
        }

        // Currency-only localization (no promo, or elements that don't opt in).
        if (cur !== 'EUR' && labels && eur) {
          var want = labels[cur];
          if (want && want !== eur) replaceToken(el, eur, want);
        }
      }
    }

    function readCache() {
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return null;
        var parts = raw.split(':');
        if (parts.length !== 2) return null;
        if (Date.now() - Number(parts[1]) > TTL) return null;
        return parts[0];
      } catch (e) { return null; }
    }

    function writeCache(cur) {
      try { localStorage.setItem(KEY, cur + ':' + Date.now()); } catch (e) {}
    }

    function resolve() {
      var cached = readCache();
      if (cached) { apply(cached); return; }
      fetch('/api/geo', { headers: { accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          var cur = currencyFor(j && j.country);
          writeCache(cur);
          apply(cur);
        })
        .catch(function () { apply('EUR'); }); // geo failed — still strike the promo for EUR
    }

    // The script sits at the end of <body>, so the DOM is parsed; run now.
    resolve();
  })();
</script>

<style is:global>
  /* Injected by the promo enhancer above into grid price chips. */
  .sd-was { text-decoration: line-through; opacity: 0.5; margin-right: 0.45em; font-weight: 400; }
  .sd-now { font-weight: 600; }
</style>
