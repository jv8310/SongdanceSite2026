---
// "See the music in action" — three short, vertical (9:16) clips of Jacob, Upala
// and friends moving freely together on a dance floor in South Africa, 2021.
//
// Self-hosted .mov from R2 (served at /media/<key> with HTTP Range, so it
// streams + seeks). Click-to-play with sound (preload=metadata keeps it light),
// only one plays at a time. Three across on desktop; a swipeable, scroll-snap
// row on a phone.

interface Reel {
  src: string;
  label: string;
}

const reels: Reel[] = [
  { src: '/media/library/mmj-bones-preview.mov', label: 'Movement clip from South Africa, 2021 (1 of 3)' },
  { src: '/media/library/mmj-mark-preview.mov', label: 'Movement clip from South Africa, 2021 (2 of 3)' },
  { src: '/media/library/mmj-medicine-preview.mov', label: 'Movement clip from South Africa, 2021 (3 of 3)' },
];
---

<section class="jr-section mmj-reels-section">
  <div class="jr-inner">
    <div class="mmj-reels-head">
      <div class="jr-eyebrow" style="justify-content:center;">South Africa · 2021</div>
      <h2 class="jr-h2">See the music <em>in action.</em></h2>
      <p class="jr-lead">
        Jacob, Upala and friends, letting the music move them on a dance floor in South Africa —
        the spirit this whole journey grew out of.
      </p>
    </div>

    <div class="mmj-reels" data-mmj-reels>
      {reels.map((r) => (
        <div class="mmj-reel" data-mmj-reel>
          <video
            class="mmj-reel-video"
            playsinline
            preload="metadata"
            aria-label={r.label}
            data-mmj-video
          >
            <source src={r.src} type="video/quicktime" />
            <source src={r.src} type="video/mp4" />
          </video>
          <button class="mmj-reel-btn" type="button" data-mmj-playbtn aria-label="Play clip">
            <i class="ph-fill ph-play"></i>
          </button>
          <a class="mmj-reel-open" href={r.src} target="_blank" rel="noopener" aria-label="Open this clip in a new tab">
            <i class="ph-light ph-arrow-square-out"></i>
          </a>
        </div>
      ))}
    </div>

    <p class="mmj-reels-foot">Tap a clip to play — sound and all.</p>
  </div>
</section>

<style>
  .mmj-reels-section { background: var(--paper); }
  .mmj-reels-head { max-width: 760px; margin: 0 auto var(--sp-7); text-align: center; }
  .mmj-reels-head .jr-lead { margin-left: auto; margin-right: auto; }

  .mmj-reels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5);
    max-width: 860px;
    margin: 0 auto;
  }

  .mmj-reel {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--r-lg);
    overflow: hidden;
    background:
      linear-gradient(160deg, rgba(var(--jr-accent-rgb), 0.22), rgba(var(--jr-accent-rgb), 0.06)),
      var(--ink);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
    cursor: pointer;
  }
  .mmj-reel-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* A soft scrim at the bottom so the play button reads on any first frame. */
  .mmj-reel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(42, 27, 42, 0.28), rgba(42, 27, 42, 0) 70%);
    pointer-events: none;
    transition: opacity var(--d-base) var(--ease);
  }
  .mmj-reel.is-playing::after { opacity: 0; }

  .mmj-reel-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid rgba(244, 236, 223, 0.5);
    background: rgba(244, 236, 223, 0.9);
    color: var(--ink);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: transform var(--d-base) var(--ease), background var(--d-base) var(--ease), opacity var(--d-base) var(--ease);
  }
  .mmj-reel-btn i { font-size: 26px; margin-left: 4px; line-height: 1; }
  @media (hover: hover) {
    .mmj-reel:hover .mmj-reel-btn { transform: translate(-50%, -50%) scale(1.06); background: var(--paper-soft); }
  }
  .mmj-reel.is-playing .mmj-reel-btn { opacity: 0; pointer-events: none; }

  /* A quiet escape hatch: if a browser can't play the clip inline
     (e.g. Firefox with a .mov), open it directly. */
  .mmj-reel-open {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--paper);
    background: rgba(42, 27, 42, 0.42);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity var(--d-base) var(--ease), background var(--d-base) var(--ease);
  }
  .mmj-reel-open i { font-size: 16px; }
  @media (hover: hover) {
    .mmj-reel-open:hover { opacity: 1; background: rgba(42, 27, 42, 0.66); }
  }
  .mmj-reel.is-playing .mmj-reel-open { opacity: 0; pointer-events: none; }

  .mmj-reels-foot {
    text-align: center;
    margin: var(--sp-5) auto 0;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ink-quiet);
  }

  /* Phone: a swipeable, scroll-snapping row — one clip at a time, peek the next. */
  @media (max-width: 700px) {
    .mmj-reels {
      grid-template-columns: none;
      display: flex;
      max-width: none;
      gap: var(--sp-4);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: var(--sp-3);
      /* bleed to the section edges so the peek looks intentional */
      margin: 0 calc(-1 * var(--sp-5));
      padding-left: var(--sp-5);
      padding-right: var(--sp-5);
      scroll-padding-left: var(--sp-5);
    }
    .mmj-reel {
      flex: 0 0 78%;
      scroll-snap-align: center;
    }
    .mmj-reels::-webkit-scrollbar { height: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mmj-reel::after, .mmj-reel-btn { transition: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-mmj-reels]');
  if (root) {
    const reels = Array.from(root.querySelectorAll<HTMLElement>('[data-mmj-reel]'));
    const videos = reels
      .map((r) => r.querySelector<HTMLVideoElement>('[data-mmj-video]'))
      .filter((v): v is HTMLVideoElement => !!v);

    reels.forEach((reel) => {
      const video = reel.querySelector<HTMLVideoElement>('[data-mmj-video]');
      const btn = reel.querySelector<HTMLButtonElement>('[data-mmj-playbtn]');
      if (!video || !btn) return;

      let primed = false;
      const play = () => {
        // Pause every other clip so only one soundtrack plays at a time.
        videos.forEach((v) => { if (v !== video) v.pause(); });
        if (!primed) {
          video.muted = false;
          video.volume = 0.8;
          primed = true;
        }
        void video.play();
      };
      const toggle = () => {
        if (video.paused || video.ended) play();
        else video.pause();
      };

      btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
      video.addEventListener('click', toggle);
      video.addEventListener('play', () => reel.classList.add('is-playing'));
      video.addEventListener('pause', () => reel.classList.remove('is-playing'));
      video.addEventListener('ended', () => {
        reel.classList.remove('is-playing');
        video.currentTime = 0;
      });
    });
  }
</script>
