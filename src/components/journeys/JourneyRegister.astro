---
import { COUNTRIES } from '../../lib/countries';
import LaunchOfferCallout from '../promo/LaunchOfferCallout.astro';

// The buy form for a single journey page — a dark, integrated "enrolment"
// section: a short summary of what you get, then the price options + form.
// `course` is the page's own product; the form always also offers the
// all-three bundle, and the singing page also offers the PRO mantra upgrade.
interface Props {
  course: 'asj' | 'mmj' | 'inner-child';
  heroImg: string; // shown as the thumbnail on the "this journey" option
  lede: string;
  bullets: string[]; // the "what you get" summary
}
const { course, heroImg, lede, bullets } = Astro.props;

const THIS_DESC: Record<Props['course'], string> = {
  asj: 'Forty weekly sessions — mantras & music, yours to keep.',
  mmj: 'Guided movement sessions — standing or seated, do-at-home.',
  'inner-child': 'Five gentle, self-paced sessions with music & mantra.',
};
const THIS_LABEL: Record<Props['course'], string> = {
  asj: 'The Authentic Singing Journey',
  mmj: 'The Magical Movement Journey',
  'inner-child': 'The Inner Child Healing Journey',
};
---

<section class="jr-section jr-register" id="register">
  <div class="jr-register-inner">
    <div class="jr-eyebrow">Enrolment</div>
    <h2 class="jr-register-title">Begin when you're <em>ready.</em></h2>
    <p class="jr-register-lede">{lede}</p>
    <ul class="jr-register-gets">
      {bullets.map((b) => <li>{b}</li>)}
    </ul>

    <div class="jr-register-card">
      <LaunchOfferCallout scope="this journey" />
      <!-- Price options -->
      <div class="jr-opts" data-jr-opts>
        <label class="jr-opt" data-jr-opt data-product={course}>
          <input type="radio" name="jr-product" value={course} checked />
          <span class="jr-opt-thumb"><img src={heroImg} alt="" loading="lazy" /></span>
          <span class="jr-opt-body">
            <span class="jr-opt-title">{THIS_LABEL[course]}</span>
            <span class="jr-opt-desc">{THIS_DESC[course]}</span>
          </span>
          <span class="jr-opt-price">
            <span class="jr-opt-amount" data-amount>€—</span>
          </span>
        </label>

        {course === 'asj' && (
          <label class="jr-opt jr-opt--pro" data-jr-opt data-product="asj-pro">
            <input type="radio" name="jr-product" value="asj-pro" />
            <span class="jr-opt-thumb">
              <img src="/media/library/collage-mantrapakket-klein.webp" alt="The mantra pack" loading="lazy" />
            </span>
            <span class="jr-opt-body">
              <span class="jr-opt-title">PRO — with the mantra pack <span class="jr-opt-tag">for facilitators</span></span>
              <span class="jr-opt-desc">
                The full Journey <em>plus</em> mantra versions of every session — downloadable, with a
                professional licence to use them in your own workshops &amp; sessions, and practical
                guidance on how to apply them.
              </span>
            </span>
            <span class="jr-opt-price">
              <span class="jr-opt-amount" data-amount>€—</span>
            </span>
          </label>
        )}

        <label class="jr-opt jr-opt--bundle" data-jr-opt data-product="journeys-bundle">
          <input type="radio" name="jr-product" value="journeys-bundle" />
          <span class="jr-opt-thumb jr-opt-thumb--triple">
            <img src="/media/library/singing-lights-woman.webp" alt="" loading="lazy" />
            <img src="/media/library/movement.webp" alt="" loading="lazy" />
            <img src="/media/library/inner-child-glow.webp" alt="" loading="lazy" />
          </span>
          <span class="jr-opt-body">
            <span class="jr-opt-title">
              All three journeys <span class="jr-opt-tag jr-opt-tag--save" data-save hidden>Save 20%</span>
            </span>
            <span class="jr-opt-desc">
              Authentic Singing · Magical Movement · Inner Child Healing — every journey, one price.
            </span>
          </span>
          <span class="jr-opt-price">
            <span class="jr-opt-strike" data-strike hidden></span>
            <span class="jr-opt-amount" data-amount>€—</span>
          </span>
        </label>

        <!-- PRO upgrade — only the Authentic Singing Journey has one. Appears
             once the bundle is chosen: tick it to add the ASJ PRO mantra pack
             (the facilitator licence) on top of the bundle. -->
        <label class="jr-addon" data-jr-bundle-pro hidden>
          <input type="checkbox" data-jr-bundle-pro-input />
          <span class="jr-addon-thumb">
            <img src="/media/library/collage-mantrapakket-klein.webp" alt="The mantra pack" loading="lazy" />
          </span>
          <span class="jr-addon-body">
            <span class="jr-addon-title">
              Add the PRO mantra pack <span class="jr-opt-tag">for facilitators</span>
            </span>
            <span class="jr-addon-desc">
              Upgrade the <em>Authentic Singing Journey</em> to PRO: mantra versions of every singing
              session, downloadable, with a professional licence to use them in your own workshops &amp;
              sessions. <span class="jr-addon-note">(Magical Movement &amp; Inner Child have no PRO version.)</span>
            </span>
          </span>
          <span class="jr-addon-price">
            <span class="jr-addon-amount" data-bundle-pro-amount>+€—</span>
          </span>
        </label>
      </div>

      <form class="jr-fields" data-jr-form novalidate>
        <label class="jr-field jr-field--half">
          <span>First name</span>
          <input type="text" name="first_name" autocomplete="given-name" required />
        </label>
        <label class="jr-field jr-field--half">
          <span>Last name</span>
          <input type="text" name="last_name" autocomplete="family-name" required />
        </label>

        <label class="jr-field jr-field--full">
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>

        <label class="jr-field jr-field--full">
          <span>Country</span>
          <input
            type="text"
            name="country_search"
            list="jr-country-list"
            autocomplete="country-name"
            placeholder="Start typing…"
            required
          />
          <input type="hidden" name="country" />
          <span class="jr-field-note jr-currency-note" data-jr-currency-note hidden></span>
        </label>

        <label class="jr-field jr-field--full">
          <span>Company <span class="jr-field-note">— optional, for a business invoice</span></span>
          <input type="text" name="company_name" autocomplete="organization" placeholder="Your company name" />
        </label>

        <label class="jr-field jr-field--full jr-vat-field" data-jr-vat hidden>
          <span>VAT number <span class="jr-field-note">— optional, for EU reverse-charge</span></span>
          <input type="text" name="vat_number" autocomplete="off" placeholder="e.g. BE0123456789" inputmode="text" />
        </label>

        <label class="jr-consent">
          <input type="checkbox" name="consent_terms" required />
          <span>I agree to the <a href="/terms" target="_blank" rel="noopener">terms and conditions</a>.</span>
        </label>

        <div class="jr-checkout-summary">
          <span class="jr-checkout-summary-label" data-jr-summary-label>One-time payment</span>
          <span class="jr-checkout-summary-amount" data-jr-summary>€—</span>
        </div>

        <p class="jr-reg-error" data-jr-error></p>

        <button type="submit" class="jr-checkout-cta" data-jr-cta>
          <span>Continue to payment</span>
          <i class="ph-light ph-arrow-right"></i>
        </button>

        <p class="jr-checkout-trust">
          <i class="ph-light ph-lock-simple"></i>
          Secure checkout by Stripe. Invoice by Quaderno. Lifetime access.
        </p>
      </form>
    </div>

    <datalist id="jr-country-list">
      {COUNTRIES.map((c) => (
        <option value={c.name} data-code={c.code}>{c.flag} {c.name}</option>
      ))}
    </datalist>
  </div>
</section>

<script>
  import { COUNTRIES } from '../../lib/countries';
  import { launchPromoPercent } from '../../lib/promo';

  type Currency =
    | 'EUR' | 'USD' | 'GBP' | 'CAD' | 'CHF'
    | 'AUD' | 'NZD' | 'NOK' | 'SEK' | 'DKK';

  // Regional price points (major units). MUST mirror src/lib/courses/journeys.ts.
  // The server re-derives currency + price from the country; this only controls
  // what we display. Bundle = the per-currency sum of the three journeys, 20%
  // off, rounded to a clean whole unit.
  const ASJ: Record<Currency, number> = {
    EUR: 99, USD: 99, GBP: 89, CAD: 145, CHF: 95, AUD: 165, NZD: 185, NOK: 1150, SEK: 1100, DKK: 745,
  };
  const MMJ: Record<Currency, number> = {
    EUR: 49, USD: 49, GBP: 45, CAD: 72, CHF: 49, AUD: 82, NZD: 92, NOK: 575, SEK: 545, DKK: 369,
  };
  const INNER: Record<Currency, number> = {
    EUR: 29, USD: 29, GBP: 26, CAD: 43, CHF: 29, AUD: 49, NZD: 55, NOK: 339, SEK: 325, DKK: 219,
  };
  const PRO: Record<Currency, number> = {
    EUR: 149, USD: 149, GBP: 135, CAD: 219, CHF: 145, AUD: 249, NZD: 279, NOK: 1725, SEK: 1649, DKK: 1115,
  };
  // What the PRO mantra pack adds (PRO − ASJ) — the same flat add-on turns the
  // all-three bundle into the bundle-PRO. Not discounted.
  const MANTRA_PREMIUM: Record<Currency, number> = {
    EUR: 50, USD: 50, GBP: 46, CAD: 74, CHF: 50, AUD: 84, NZD: 94, NOK: 575, SEK: 549, DKK: 370,
  };
  const BUNDLE_DISCOUNT = 0.2;

  function bundleSum(c: Currency): number { return ASJ[c] + MMJ[c] + INNER[c]; }
  function bundleMajor(c: Currency): number { return Math.round(bundleSum(c) * (1 - BUNDLE_DISCOUNT)); }
  function productCents(slug: string, c: Currency): number {
    switch (slug) {
      case 'asj': return ASJ[c] * 100;
      case 'asj-pro': return PRO[c] * 100;
      case 'mmj': return MMJ[c] * 100;
      case 'inner-child': return INNER[c] * 100;
      case 'journeys-bundle': return bundleMajor(c) * 100;
      case 'journeys-bundle-pro': return (bundleMajor(c) + MANTRA_PREMIUM[c]) * 100;
      default: return 0;
    }
  }
  function compareAtCents(slug: string, c: Currency): number | null {
    if (slug === 'journeys-bundle') return bundleSum(c) * 100;
    if (slug === 'journeys-bundle-pro') return (bundleSum(c) + MANTRA_PREMIUM[c]) * 100;
    return null;
  }

  const COUNTRY_CURRENCY: Record<string, Currency> = {
    US: 'USD', CA: 'CAD', GB: 'GBP', CH: 'CHF', NO: 'NOK', SE: 'SEK', DK: 'DKK', AU: 'AUD', NZ: 'NZD',
  };
  function currencyForCountry(code: string): Currency {
    return COUNTRY_CURRENCY[code.toUpperCase()] ?? 'EUR';
  }
  const SYMBOLS: Record<Currency, string> = {
    EUR: '€', USD: '$', GBP: '£', CAD: 'CA$', CHF: 'CHF ', AUD: 'A$', NZD: 'NZ$', NOK: 'kr ', SEK: 'kr ', DKK: 'kr ',
  };
  const CURRENCY_LABEL: Record<Currency, string> = {
    EUR: 'euros', USD: 'US dollars', GBP: 'pounds', CAD: 'Canadian dollars', CHF: 'Swiss francs',
    AUD: 'Australian dollars', NZD: 'New Zealand dollars', NOK: 'Norwegian kroner', SEK: 'Swedish kronor', DKK: 'Danish kroner',
  };
  function moneyCents(cents: number, c: Currency): string {
    const whole = cents % 100 === 0;
    const amount = (cents / 100).toLocaleString('en-US', {
      minimumFractionDigits: whole ? 0 : 2,
      maximumFractionDigits: whole ? 0 : 2,
    });
    return `${SYMBOLS[c] ?? '€'}${amount}`;
  }

  function readDiscount(): number {
    try {
      const raw = new URLSearchParams(window.location.search).get('discount');
      const n = raw ? parseInt(raw, 10) : 0;
      if (Number.isInteger(n) && n >= 1 && n <= 99) return n;
    } catch {}
    return 0;
  }
  // Launch promo: 50% off, the better of the promo and any ?discount=N. For the
  // bundle, productCents is already 20% off the sum, so this stacks the 50% on
  // top. Server re-derives the same number, so display matches the charge.
  const discountPct = Math.max(readDiscount(), launchPromoPercent());
  function applyDiscountCents(cents: number): number {
    if (discountPct <= 0) return cents;
    return Math.round((cents * (100 - discountPct)) / 100);
  }

  function guessCountry(): string | undefined {
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      const tzMap: Record<string, string> = {
        'Europe/Brussels': 'BE', 'Europe/Amsterdam': 'NL', 'Europe/Berlin': 'DE', 'Europe/Paris': 'FR',
        'Europe/Luxembourg': 'LU', 'Europe/Vienna': 'AT', 'Europe/Zurich': 'CH', 'Europe/Rome': 'IT',
        'Europe/Madrid': 'ES', 'Europe/Lisbon': 'PT', 'Europe/Dublin': 'IE', 'Europe/London': 'GB',
        'Europe/Copenhagen': 'DK', 'Europe/Stockholm': 'SE', 'Europe/Oslo': 'NO', 'Europe/Helsinki': 'FI',
        'America/New_York': 'US', 'America/Chicago': 'US', 'America/Denver': 'US', 'America/Los_Angeles': 'US',
        'America/Phoenix': 'US', 'Pacific/Honolulu': 'US', 'America/Toronto': 'CA', 'America/Vancouver': 'CA',
        'Australia/Sydney': 'AU', 'Australia/Melbourne': 'AU', 'Australia/Perth': 'AU', 'Pacific/Auckland': 'NZ',
      };
      if (tzMap[tz]) return tzMap[tz];
      const lang = navigator.language || '';
      const m = lang.match(/-([A-Z]{2})$/i);
      if (m) return m[1].toUpperCase();
    } catch {}
    return undefined;
  }

  const form = document.querySelector<HTMLFormElement>('[data-jr-form]');
  const optsWrap = document.querySelector<HTMLElement>('[data-jr-opts]');
  if (form && optsWrap) {
    const summaryEl = document.querySelector<HTMLElement>('[data-jr-summary]')!;
    const summaryLabelEl = document.querySelector<HTMLElement>('[data-jr-summary-label]')!;
    const currencyNoteEl = document.querySelector<HTMLElement>('[data-jr-currency-note]')!;
    const countryInput = form.querySelector<HTMLInputElement>('[name="country_search"]')!;
    const countryHidden = form.querySelector<HTMLInputElement>('[name="country"]')!;
    const companyInput = form.querySelector<HTMLInputElement>('[name="company_name"]')!;
    const vatField = form.querySelector<HTMLElement>('[data-jr-vat]')!;
    const vatInput = form.querySelector<HTMLInputElement>('[name="vat_number"]')!;
    const errorEl = form.querySelector<HTMLElement>('[data-jr-error]')!;
    const cta = form.querySelector<HTMLButtonElement>('[data-jr-cta]')!;
    const optionEls = Array.from(optsWrap.querySelectorAll<HTMLElement>('[data-jr-opt]'));
    // The bundle-only PRO add-on (the ASJ mantra pack). A checkbox that turns
    // the bundle into journeys-bundle-pro; revealed only while the bundle is the
    // chosen option.
    const bundleProEl = optsWrap.querySelector<HTMLElement>('[data-jr-bundle-pro]');
    const bundleProInput = bundleProEl?.querySelector<HTMLInputElement>('[data-jr-bundle-pro-input]') ?? null;
    const bundleProAmountEl = bundleProEl?.querySelector<HTMLElement>('[data-bundle-pro-amount]') ?? null;

    let currency: Currency = 'EUR';

    // The chosen radio (the base product), independent of the PRO add-on.
    function checkedRadio(): string {
      const checked = optsWrap!.querySelector<HTMLInputElement>('input[name="jr-product"]:checked');
      return checked?.value ?? optionEls[0].dataset.product!;
    }
    // PRO add-on counts only when the bundle is chosen and the box is ticked.
    function bundleProActive(): boolean {
      return checkedRadio() === 'journeys-bundle' && !!bundleProInput?.checked;
    }
    // The effective product slug sent to checkout.
    function selectedSlug(): string {
      return bundleProActive() ? 'journeys-bundle-pro' : checkedRadio();
    }

    function renderPrices() {
      for (const el of optionEls) {
        const slug = el.dataset.product!;
        const amountEl = el.querySelector<HTMLElement>('[data-amount]')!;
        const strikeEl = el.querySelector<HTMLElement>('[data-strike]');
        const saveEl = el.querySelector<HTMLElement>('[data-save]');
        const baseCents = productCents(slug, currency);
        const nowCents = applyDiscountCents(baseCents);
        const cmp = compareAtCents(slug, currency);
        // The bundle has its own dedicated strike (the undiscounted sum). For
        // the singles/PRO there's no strike element, so when the promo is live
        // we render an inline struck "was" so the saving is visible there too.
        if (discountPct > 0 && !strikeEl) {
          amountEl.innerHTML =
            `<span style="text-decoration:line-through;opacity:.55;font-weight:400;margin-right:.35em">` +
            `${moneyCents(baseCents, currency)}</span>${moneyCents(nowCents, currency)}`;
        } else {
          amountEl.textContent = moneyCents(nowCents, currency);
        }
        if (strikeEl) {
          if (cmp) { strikeEl.hidden = false; strikeEl.textContent = moneyCents(cmp, currency); }
          else strikeEl.hidden = true;
        }
        if (saveEl) {
          if (cmp) {
            // % off vs the full sum, after the promo (so it reflects the price shown).
            const pct = Math.round((1 - nowCents / cmp) * 100);
            saveEl.textContent = `Save ${pct}%`;
            saveEl.hidden = false;
          } else saveEl.hidden = true;
        }
      }

      // The PRO add-on's price is the marginal cost over the plain bundle
      // (after any promo), shown as a "+ €X" on the checkbox row.
      if (bundleProAmountEl) {
        const bundleNow = applyDiscountCents(productCents('journeys-bundle', currency));
        const proNow = applyDiscountCents(productCents('journeys-bundle-pro', currency));
        bundleProAmountEl.textContent = `+ ${moneyCents(proNow - bundleNow, currency)}`;
      }

      const slug = selectedSlug();
      const sel = optionEls.find((e) => e.dataset.product === slug);
      let title: string;
      if (sel) {
        title = sel.querySelector<HTMLElement>('.jr-opt-title')!.textContent?.trim() ?? '';
      } else {
        // bundle-pro has no option row of its own — it's the bundle + the add-on.
        const bundleOpt = optionEls.find((e) => e.dataset.product === 'journeys-bundle');
        const base = bundleOpt?.querySelector<HTMLElement>('.jr-opt-title')!.textContent?.trim() ?? 'All three journeys';
        title = `${base} + PRO mantra pack`;
      }
      summaryLabelEl.textContent =
        `${title.replace(/\s+Save \d+%$/, '').replace(/\s+for facilitators$/, '')} · one-time payment`;
      summaryEl.textContent = moneyCents(applyDiscountCents(productCents(slug, currency)), currency);

      if (currency === 'EUR') {
        currencyNoteEl.hidden = true;
        currencyNoteEl.textContent = '';
      } else {
        currencyNoteEl.hidden = false;
        currencyNoteEl.textContent = `Shown and charged in ${CURRENCY_LABEL[currency]} (${currency}).`;
      }
    }

    function setCurrencyFromCode(code: string) {
      currency = currencyForCountry(code);
      renderPrices();
    }

    function syncSelected() {
      const radio = checkedRadio();
      // The PRO add-on is offered only with the bundle. Hide (and reset) it for
      // every other choice so its tick never leaks into another product.
      if (bundleProEl) {
        const showAddon = radio === 'journeys-bundle';
        bundleProEl.hidden = !showAddon;
        if (!showAddon && bundleProInput) bundleProInput.checked = false;
        bundleProEl.classList.toggle('is-checked', !!bundleProInput?.checked);
      }
      // Selected styling follows the chosen radio (the base product).
      for (const el of optionEls) el.classList.toggle('is-selected', el.dataset.product === radio);
      renderPrices();
    }
    optsWrap.addEventListener('change', syncSelected);

    const guess = guessCountry();
    if (guess) {
      const match = COUNTRIES.find((c) => c.code === guess.toUpperCase());
      if (match) { countryInput.value = match.name; countryHidden.value = match.code; }
    }
    setCurrencyFromCode(countryHidden.value || 'XX');
    syncSelected();

    function resolveCountry() {
      const typed = countryInput.value.trim().toLowerCase();
      const match = COUNTRIES.find(
        (c) => c.name.toLowerCase() === typed || c.code.toLowerCase() === typed,
      );
      if (match) { countryHidden.value = match.code; setCurrencyFromCode(match.code); }
      else countryHidden.value = '';
      toggleVat();
    }
    countryInput.addEventListener('change', resolveCountry);
    countryInput.addEventListener('blur', resolveCountry);
    countryInput.addEventListener('input', resolveCountry);

    // VAT field only appears once a company name is entered.
    function toggleVat() {
      const show = companyInput.value.trim().length > 0;
      vatField.hidden = !show;
      if (!show) vatInput.value = '';
    }
    companyInput.addEventListener('input', toggleVat);
    toggleVat();

    function fail(msg: string) {
      errorEl.textContent = msg;
      errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.textContent = '';
      const get = (name: string) =>
        String(form.querySelector<HTMLInputElement>(`[name="${name}"]`)?.value ?? '').trim();

      const first_name = get('first_name');
      const last_name = get('last_name');
      const email = get('email');
      const country = countryHidden.value.trim();
      const company_name = get('company_name');
      const vat_number = get('vat_number');
      const consent_terms = form.querySelector<HTMLInputElement>('[name="consent_terms"]')!.checked;
      const product = selectedSlug();

      if (!first_name || !last_name) return fail('Please add your first and last name.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return fail('Please enter a valid email address.');
      if (!country) return fail('Please select your country from the list.');
      if (vat_number && !company_name) return fail('Please add your company name to use a VAT number.');
      if (!consent_terms) return fail('Please agree to the terms to continue.');

      const original = cta.innerHTML;
      cta.disabled = true;
      cta.innerHTML = '<span>Opening secure checkout…</span>';

      try {
        const res = await fetch('/api/courses/journey-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            product,
            first_name,
            last_name,
            email,
            country,
            company_name: company_name || undefined,
            vat_number: vat_number || undefined,
            consent_terms: true,
            ...(discountPct > 0 ? { discount_percent: discountPct } : {}),
          }),
        });
        let body: { checkout_url?: string; error?: string } = {};
        try { body = (await res.json()) as typeof body; } catch {}
        if (!res.ok || !body.checkout_url) {
          fail(body.error || `Could not start checkout (HTTP ${res.status}). Please try again.`);
          cta.disabled = false; cta.innerHTML = original; return;
        }
        window.location.href = body.checkout_url;
      } catch {
        fail('We could not reach the server. Please try again.');
        cta.disabled = false; cta.innerHTML = original;
      }
    });
  }
</script>
