---
// Recurring soft CTA band (content brief §2). Default variant points to the
// 9€ workshop — the primary top-of-funnel across the site. Pages with their
// own primary action can override the copy/links via props.
interface Props {
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  altLabel?: string;
  altHref?: string;
  // Which product's price the ctaLabel quotes, so the client enhancer can
  // localize it. Defaults to the workshop ticket (the standard 9€ taster CTA).
  // Pass null on CTAs whose label has no price to localize.
  priceProduct?: 'ticket' | 'masterclass' | null;
}
const {
  text = 'Curious how this actually feels?',
  ctaLabel = 'Sit in on a live workshop — 9€',
  ctaHref = '/workshop',
  altLabel,
  altHref,
  priceProduct = 'ticket',
} = Astro.props;
---

<section class="sd-softcta">
  <div class="sd-softcta-inner" data-anim="reveal">
    <p class="sd-softcta-text">{text}</p>
    <div class="sd-softcta-actions">
      <a href={ctaHref} class="sd-btn sd-btn-primary" data-sd-price={priceProduct ?? undefined}>{ctaLabel}</a>
      {altLabel && altHref && <a href={altHref} class="sd-btn sd-btn-quiet">{altLabel}</a>}
    </div>
  </div>
</section>
