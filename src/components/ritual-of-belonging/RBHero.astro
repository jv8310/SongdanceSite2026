    </div>
    <p class="rb-hero-sub">
      A three-day retreat with Lesanne &amp; Jacob.
    </p>
    <div class="rb-hero-cta-row">
      <a
        href="#register"
        class="rb-btn rb-btn--ember rb-btn--lg"
        aria-label="Register for the Ritual of Belonging retreat"
      >
        Register now <i class="ph-light ph-arrow-right"></i>
      </a>
      <a href="#what-to-expect" class="rb-btn rb-btn--ghost rb-btn--lg">
        What to expect
      </a>
    </div>
    <div>
      <a href="#practical" class="rb-hero-link">Practical details &amp; rooms</a>
    </div>
  </div>
</section>
