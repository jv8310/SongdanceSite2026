<section class="rb-hero" id="top">
  <div class="rb-hero-bg" aria-hidden="true">
    <img src="/imagery/ritual-of-belonging/winter-forest.jpg" alt="" />
  </div>
  <div class="rb-hero-inner">
    <img class="rb-hero-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
    <div class="rb-hero-eyebrow">Winter Retreat</div>
    <h1 class="rb-hero-head">
      Ritual of <em>Belonging</em>
    </h1>
    <div class="rb-hero-when">
      <span>27–29 November 2026</span>
      <span class="dot"></span>
