---
const items = [
  'Three days of slow, deliberate gathering, held by Lesanne and Jacob',
  'Sound constellations and <em>Somatic Vocal Healing</em>, drawn from where the group actually is — not from a fixed program',
  'A central <em>ritual of belonging</em>, woven across the three days, that asks nothing of you except your presence',
  'Mornings outdoors, walks in the winter woods, rest as part of the curriculum',
  "Home-cooked vegetarian meals prepared by Muriel, Jacob's mother",
  'Silence where it is needed, song where it is needed, and time to do neither',
  'A small circle — returning faces and new ones — chosen for intimacy, not scale',
];
---

<section class="rb-expect" id="what-to-expect">
  <div class="rb-expect-inner">
    <div class="rb-expect-head">
      <div class="rb-eyebrow rb-eyebrow--center">What to expect</div>
      <h2 class="rb-h2">
        Three days, <em>woven slowly.</em>
      </h2>
    </div>

    <div class="rb-expect-grid">
      {items.map((item) => (
        <article class="rb-expect-card">
          <span class="rb-expect-sparkle" aria-hidden="true">✦</span>
          <p set:html={item} />
        </article>
      ))}
    </div>
  </div>
</section>
