---
const signs = [
  'A quiet sense that you are ready for a different pace',
  'A longing to be in a circle of people who are truly here',
  'A wish to feel like yourself again — in the body, not just in thought',
  'A quiet draw toward ritual, toward something with form and meaning',
  'Trust that your voice has more to offer you, even after years of practice',
  'The desire to deepen rather than start over',
  'A sense that your aliveness wants space to come back',
  "No experience needed — you don't need a good voice, you need an honest one",
  'Wanting to be seen as you are, without having to perform it',
  "A readiness to remember that you belong — to yourself, to a circle, to the season's quieter rhythm",
];
---

<section class="rb-for">
  <div class="rb-for-inner">
    <div class="rb-for-head">
      <div class="rb-eyebrow rb-eyebrow--center">What we're making space for</div>
      <h2 class="rb-h2">
        This retreat may be for you <em>if you recognise</em> some of the following.
      </h2>
    </div>

    <ul class="rb-for-list">
      {signs.map((sign) => (
        <li>
          <span class="mark" aria-hidden="true">✦</span>
          <span set:html={sign} />
        </li>
      ))}
    </ul>

    <div class="rb-cta-wrap">
      <a
        href="#register"
        class="rb-btn"
        aria-label="Register for the Ritual of Belonging retreat"
      >
        Register now <i class="ph-light ph-arrow-right"></i>
      </a>
    </div>
  </div>
</section>
