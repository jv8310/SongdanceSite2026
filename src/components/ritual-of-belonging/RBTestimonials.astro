---
const items = [
  {
    body: "Last year's retreat was a life-changing event for me — a time of deep healing and creative expression of my soul through word, sound, movement, and community. The masterful facilitation by Jacob and Lesanne created a container in which we could truly process our lives. The deepening, the opening, the vulnerability — it created a leap forward in my healing journey.",
    by: 'Rebecca Pellerito Lucy',
    photo: '/imagery/ritual-of-belonging/rebecca.jpg',
  },
  {
    body: "Last year's retreat was an absolute joy. Taking time out of my busy life to connect deeply with the heart through Somatic Vocal Healing had a profound effect on me — ripples that continue to resonate. The space, the accommodation, the food were all superb, and I loved being with people who shared the same commitment to live more from the heart. Both Jacob and Lesanne are stellar facilitators.",
    by: 'Caitríona, actor',
    photo: '/imagery/ritual-of-belonging/caitriona.jpg',
  },
  {
    body: "Both Lesanne and Jacob are so present that you truly feel held. Together they create a brave and safe space, taking care of everyone with such attentiveness. Jacob guides through Somatic Vocal Healing into heart-centered connection; Lesanne's tender, loving energy brings an additional sense of peace and support. We slept in an old castle, the food was delicious, and deep relationships were formed. I plan to join again.",
    by: 'Minja',
    photo: '/imagery/ritual-of-belonging/minja.jpg',
  },
];
---

<section class="rb-testimonials">
  <div class="rb-testimonials-inner">
    <div class="rb-testimonials-head">
      <div class="rb-eyebrow rb-eyebrow--center">What others have said</div>
      <h2 class="rb-h2">From <em>the circle.</em></h2>
    </div>

    <div class="rb-testimonials-grid">
      {items.map((t) => (
        <article class="rb-testimonial">
          <p class="rb-testimonial-body">"{t.body}"</p>
          <div class="rb-testimonial-attrib">
            <img class="rb-testimonial-photo" src={t.photo} alt={t.by} loading="lazy" />
            <span class="rb-testimonial-by">{t.by}</span>
          </div>
        </article>
      ))}
    </div>

    <div class="rb-cta-wrap">
      <a
        href="#register"
        class="rb-btn rb-btn--ember"
        aria-label="Register for the Ritual of Belonging retreat"
      >
        Register now <i class="ph-light ph-arrow-right"></i>
      </a>
    </div>
  </div>
</section>
