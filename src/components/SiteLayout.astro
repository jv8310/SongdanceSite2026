---
// Shared shell for the integrated marketing pages: consistent header +
// footer, with the header optional (landing pages can omit it — brief §1).
// Bespoke landing pages (cert course, forgiveness, retreats, German) and
// the admin keep using the base Layout directly and are unaffected.
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import PromoBanner from './PromoBanner.astro';
import NewsletterFooter from './NewsletterFooter.astro';
import Footer from './Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  lang?: string; // 'en' (default) | 'de' | 'nl'
  header?: boolean; // default true; set false on landing-style pages
  newsletter?: boolean; // default true
  promo?: boolean; // default true; set false where the courses promo doesn't apply (retreats)
}

const {
  title,
  description,
  image,
  imageAlt,
  lang,
  header = true,
  newsletter = true,
  promo = true,
} = Astro.props;
---

<Layout title={title} description={description} image={image} imageAlt={imageAlt} lang={lang}>
  {promo && <PromoBanner />}
  {header && <Nav />}
  <slot />
  {newsletter && <NewsletterFooter />}
  <Footer />
</Layout>
