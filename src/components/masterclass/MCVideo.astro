---
// Intro video (owner's call, Aug 2026): the Vimeo film made for the
// masterclass ("Masterclass landing page"). Same embed pattern as FCVideo /
// the grief page — player.vimeo.com iframe, chrome hidden, lazy. The
// professional door places it directly below the hero ("Watch first"); the
// heal-the-healer door places it after its recognition section and passes
// its own eyebrow.
interface Props {
  eyebrow?: string;
}
const { eyebrow = 'Watch first' } = Astro.props;
---

<section class="mc-video" aria-label="Introduction video">
  <div class="mc-video-inner">
    <div class="we-eyebrow" style="justify-content: center;">{eyebrow}</div>
    <div class="mc-video-frame">
      <iframe
        src="https://player.vimeo.com/video/1221128064?title=0&byline=0&portrait=0"
        title="Jacob introduces the Professional Masterclass"
        frameborder="0"
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  </div>
</section>
