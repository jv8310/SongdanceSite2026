---
// Masterclass registration: the live masterclass dates lead. Underneath —
// "in case the masterclass doesn't fit your schedule" — the instant-access
// masterclass replay and the live workshop dates. Workshop replays (and the
// order bump — it doesn't fit this audience) are deliberately absent here.
// Same flow as the workshop page's WERegister: pick a date → name / email /
// (timezone) → POST /api/workshops/register → Stripe Checkout.
//
// Prices are fixed per currency (no FX). The country selector switches the
// currency; each date carries its full price map so the swap is instant. The
// posted country is authoritative — the server re-resolves the price for it.
import type { CalItem } from '../workshop-english/types';
import { ALL_COUNTRIES } from '../../lib/workshops/countries';
import LaunchOfferCallout from '../promo/LaunchOfferCallout.astro';
import {
  masterclassPromoActive,
  MASTERCLASS_PROMO_PERCENT,
  MASTERCLASS_PROMO_TAG,
} from '../../lib/masterclass-promo';
import MetaPixel from '../MetaPixel.astro';
interface Props {
  items: CalItem[];
  country: string;
  currency: string;
  detectedTz: string;
  tzOptions: string[];
}
const { items, country, detectedTz, tzOptions } = Astro.props;

const masterclasses = items.filter((it) => it.kind === 'masterclass' && !it.isReplay);
// The schedule-friendly alternatives: instant access to the masterclass
// replay first, then the live workshop dates.
const alternatives = [
  ...items.filter((it) => it.kind === 'masterclass' && it.isReplay),
  ...items.filter((it) => it.kind === 'workshop' && !it.isReplay),
];
const visible = [...masterclasses, ...alternatives];

// Every live masterclass date is the same price, so state it once above the
// list rather than repeating it on each row. The fallback options below
// (replay / intro workshop) differ, so they keep their per-row price.
const leadMc = masterclasses[0];

const hasMcReplay = alternatives.some((it) => it.kind === 'masterclass');
const hasWsLive = alternatives.some((it) => it.kind === 'workshop');
const altSub =
  hasMcReplay && hasWsLive
    ? 'Choose instant access to the masterclass replay — watch it anytime, starting today — or get to know this work in general first, at a live one-hour workshop.'
    : hasMcReplay
      ? 'Choose instant access to the masterclass replay — watch it anytime, starting today.'
      : 'Get to know this work in general first, at a live one-hour workshop — the gentlest introduction to Somatic Vocal Healing.';

// The full country list — the visitor can type/search any country, not just the
// markets we price for (mirrors the workshop form). Currency comes from
// countries.ts (currencyForCountry): anything outside our priced markets falls
// through to EUR.
const COUNTRIES = ALL_COUNTRIES;
const detected = COUNTRIES.find((c) => c.code === country);
const selectedCode = detected?.code ?? '';
const selectedName = detected?.name ?? '';

// Meta Pixel: the base code is loaded here (this is the real, advertised
// registration page) so PageView + InitiateCheckout fire. Empty → renders
// nothing.
const pixelId = Astro.locals.runtime.env.META_PIXEL_ID ?? '';
---

<section class="we-register" id="register">
  <MetaPixel pixelId={pixelId} />
  <div class="we-register-inner">
    <div class="we-eyebrow">Reserve your seat</div>
    <h2 class="we-register-h2">
      Come feel it<br /><em>from the inside.</em>
    </h2>
    <p class="we-register-body">
      One hundred minutes, live, online — with a replay if the time doesn't work for you.<br />
      Come as a professional. Come, also, as a person.<br />
      The method makes no distinction — that's exactly the point of it.
    </p>
    <p class="we-register-note">Live · Online · 100 min · Replay included</p>
    <p class="we-discount-note" id="mc-discount-note" hidden></p>

    <LaunchOfferCallout
      scope="your seat"
      active={masterclassPromoActive()}
      tag={MASTERCLASS_PROMO_TAG}
      percent={MASTERCLASS_PROMO_PERCENT}
      countdown={false}
      note="Applied automatically at checkout — no code needed."
    ><strong>{MASTERCLASS_PROMO_PERCENT}% off your seat</strong> — our launch offer for this masterclass.</LaunchOfferCallout>

    <div class="we-booking">
      {visible.length === 0 && (
        <p class="we-cal-empty">
          No dates are open just now. Email
          <a href="mailto:info@songdance.co"> info@songdance.co</a> and we'll
          tell you the moment the next masterclass is scheduled.
        </p>
      )}

      {visible.length > 0 && (
        <div class="we-booking-head">
          <p class="we-booking-label">{masterclasses.length > 0 ? 'Choose a masterclass date' : 'Choose an option'}</p>
        </div>
      )}

      {leadMc && (
        <p class="we-price-lead we-price-lead--plum">
          <span
            class="we-price-lead-amount"
            id="mc-price-lead"
            data-prices={JSON.stringify(leadMc.pricesByCurrency)}
            data-price-minor={String(leadMc.priceMinor)}
          >{leadMc.priceLabel}</span>
          <span class="we-price-lead-unit">per seat · replay included</span>
        </p>
      )}

      {visible.length > 0 && masterclasses.length === 0 && (
        <p class="mc-cal-none">
          No live masterclass dates are open right now. Email
          <a href="mailto:info@songdance.co"> info@songdance.co</a> and we'll
          tell you the moment the next one is scheduled — or choose an option
          below.
        </p>
      )}

      {masterclasses.length > 0 && (
        <div class="we-cal we-cal--lead-priced" role="radiogroup" aria-label="Masterclass dates">
          {masterclasses.map((it) => (
            <label class="we-cal-item mc-cal-item--masterclass">
              <input
                type="radio"
                name="mc-date"
                value={it.slug}
                data-slug={it.slug}
                data-kind={it.kind}
                data-price-minor={String(it.priceMinor)}
                data-currency={it.currency}
                data-prices={JSON.stringify(it.pricesByCurrency)}
                data-is-replay="0"
              />
              <span class="we-cal-radio" aria-hidden="true"></span>
              <span class="we-cal-main">
                <span class="we-cal-kind">Masterclass</span>
                <span class="we-cal-when">
                  {it.whenLocal}<span class="we-cal-tz"> · your time</span>
                </span>
                <span class="we-cal-meta">
                  {`${it.durationMin} min`}
                  <span> · <span class="we-cal-audience">for professionals</span></span>
                </span>
              </span>
              <span class="we-cal-price">{it.priceLabel}</span>
            </label>
          ))}
        </div>
      )}

      {alternatives.length > 0 && (
        <div class="mc-alt">
          <p class="mc-alt-head">In case the masterclass doesn't fit your schedule</p>
          <p class="mc-alt-sub">{altSub}</p>
          <div class="we-cal" role="radiogroup" aria-label="Masterclass replay and workshop alternatives">
            {alternatives.map((it) => (
              <label class={`we-cal-item${it.kind === 'masterclass' ? ' mc-cal-item--masterclass' : ''}`}>
                <input
                  type="radio"
                  name="mc-date"
                  value={it.slug}
                  data-slug={it.slug}
                  data-kind={it.kind}
                  data-price-minor={String(it.priceMinor)}
                  data-currency={it.currency}
                  data-prices={JSON.stringify(it.pricesByCurrency)}
                  data-is-replay={it.isReplay ? '1' : '0'}
                />
                <span class="we-cal-radio" aria-hidden="true"></span>
                <span class="we-cal-main">
                  <span class="we-cal-kind">{it.kind === 'masterclass' ? 'Masterclass' : 'Workshop'}</span>
                  <span class="we-cal-when">
                    {it.isReplay ? 'Instant access — watch anytime' : it.whenLocal}
                    {!it.isReplay && <span class="we-cal-tz"> · your time</span>}
                  </span>
                  <span class="we-cal-meta">
                    {it.kind === 'masterclass'
                      ? `${it.durationMin} min · the replay`
                      : `${it.durationMin} min · the general introduction`}
                  </span>
                </span>
                <span class="we-cal-price">{it.priceLabel}</span>
              </label>
            ))}
          </div>
        </div>
      )}

      {visible.length > 0 && (
        <form class="we-form" id="mc-form" hidden>
          <input type="hidden" name="workshop_slug" id="mc-slug" value="" />
          <input type="hidden" name="country" id="mc-country" value={selectedCode} />
          <input type="hidden" name="discount" id="mc-discount" value="" />
          <input type="hidden" name="adiscount" id="mc-adiscount" value="" />
          <input type="hidden" name="meta_event_id" id="mc-event-id" value="" />

          <div class="we-field-row">
            <label class="we-field">
              <span>First name</span>
              <input type="text" name="first_name" required autocomplete="given-name" />
            </label>
            <label class="we-field">
              <span>Last name</span>
              <input type="text" name="last_name" required autocomplete="family-name" />
            </label>
          </div>

          <label class="we-field">
            <span>Email</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <label class="we-field">
            <span>Country</span>
            <input
              type="text"
              id="mc-country-input"
              list="mc-country-list"
              autocomplete="country-name"
              placeholder="Start typing your country…"
              value={selectedName}
            />
            <datalist id="mc-country-list">
              {COUNTRIES.map((c) => (
                <option value={c.name} data-code={c.code} data-currency={c.currency}></option>
              ))}
            </datalist>
          </label>

          <label class="we-field" id="mc-tz-field">
            <span>Your timezone</span>
            <select name="timezone">
              {tzOptions.map((tz) => (
                <option value={tz} selected={tz === detectedTz}>{tz.replace(/_/g, ' ')}</option>
              ))}
            </select>
          </label>

          <div class="we-biz" id="mc-biz" hidden>
            <label class="we-field">
              <span>Company <em>(optional)</em></span>
              <input type="text" name="company_name" autocomplete="organization" />
            </label>
            <label class="we-field" id="mc-vat" hidden>
              <span>VAT number <em>(optional — EU businesses)</em></span>
              <input type="text" name="vat_number" autocomplete="off" />
            </label>
          </div>

          <div class="we-total">
            <span id="mc-total-label">Masterclass seat</span>
            <strong id="mc-total-amount"></strong>
          </div>

          <button type="submit" class="we-submit" id="mc-submit">Register &amp; pay →</button>

          <button
            type="button"
            class="we-submit"
            id="mc-paypal"
            hidden
            style="margin-top:10px;background:#ffc439;color:#003087;"
          >
            Pay with <strong>PayPal</strong>
          </button>

          <p class="we-err" id="mc-err" hidden></p>
          <p class="we-fine" id="mc-fine">Secure checkout via Stripe.</p>
        </form>
      )}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById('mc-form');
    var booking = document.querySelector('.we-register .we-booking');
    if (!form || !booking) return;

    var slugField = document.getElementById('mc-slug');
    var countryField = document.getElementById('mc-country');
    var countryInput = document.getElementById('mc-country-input');
    var countryList = document.getElementById('mc-country-list');
    var tzField = document.getElementById('mc-tz-field');
    var bizField = document.getElementById('mc-biz');
    var vatField = document.getElementById('mc-vat');
    var companyInput = form.querySelector('input[name="company_name"]');
    var vatInput = form.querySelector('input[name="vat_number"]');

    // VAT appears only on the masterclass (the only kind with a company field),
    // as soon as a company name is entered.
    function toggleVat() {
      var isMasterclass = !!(current && current.kind === 'masterclass');
      var hasCompany = !!(companyInput && companyInput.value.trim().length > 0);
      var show = isMasterclass && hasCompany;
      if (vatField) vatField.hidden = !show;
      if (!show && vatInput) vatInput.value = '';
    }
    if (companyInput) companyInput.addEventListener('input', toggleVat);
    var totalLabel = document.getElementById('mc-total-label');
    var totalAmount = document.getElementById('mc-total-amount');
    var submitBtn = document.getElementById('mc-submit');
    var paypalBtn = document.getElementById('mc-paypal');
    // The page is static, so PayPal availability can't be known at build time —
    // ask the server at runtime and reveal the button if the gateway is live.
    if (paypalBtn) {
      fetch('/api/payments/availability')
        .then(function (r) { return r.json(); })
        .then(function (d) { if (d && d.paypal) paypalBtn.hidden = false; })
        .catch(function () {});
    }
    var err = document.getElementById('mc-err');
    var idField = document.getElementById('mc-event-id');

    // Which gateway the next submit uses. The PayPal button flips it for one
    // submit; everything else (incl. the Enter key) stays on Stripe.
    var nextProvider = 'stripe';
    if (paypalBtn) {
      paypalBtn.addEventListener('click', function () {
        nextProvider = 'paypal';
        if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event('submit', { cancelable: true }));
      });
    }

    var SYMBOLS = { EUR: '€', USD: '$', CAD: 'CA$', GBP: '£', CHF: 'CHF ', NOK: 'kr ', SEK: 'kr ', DKK: 'kr ', AUD: 'A$', NZD: 'NZ$' };
    function money(minor, cur) {
      var major = minor / 100;
      var body = Number.isInteger(major) ? String(major) : major.toFixed(2);
      var sym = SYMBOLS[cur];
      return sym ? sym + body : body + ' ' + cur;
    }
    function parse(json) { try { return JSON.parse(json || '{}'); } catch (e) { return {}; } }
    function priceFor(map, cur, fallbackMinor) {
      if (map && map[cur] != null) return map[cur];
      if (map && map['EUR'] != null) return map['EUR'];
      return fallbackMinor;
    }

    // Render a price with the live promo applied: the struck full price next to
    // the discounted figure (matching the summary line), or just the price when
    // no discount is active.
    function priceHtml(fullMinor, cur, kind) {
      var disc = ticketAfterDiscount(fullMinor, kind);
      return (disc !== fullMinor)
        ? '<span class="we-line-was">' + money(fullMinor, cur) + '</span> ' + money(disc, cur)
        : money(fullMinor, cur);
    }
    // Repaint every visible price for `cur`: the per-row chips (the kept fallback
    // rows) and the stated-once lead. Each row strikes by its own kind, so the
    // masterclass rows carry the masterclass offer while a full-price workshop
    // fallback stays full price.
    function renderPrices(cur) {
      for (var i = 0; i < radios.length; i++) {
        var r = radios[i];
        var minor = priceFor(parse(r.dataset.prices), cur, parseInt(r.dataset.priceMinor, 10) || 0);
        var priceEl = r.closest('.we-cal-item').querySelector('.we-cal-price');
        if (priceEl) priceEl.innerHTML = priceHtml(minor, cur, r.dataset.kind);
      }
      var lead = document.getElementById('mc-price-lead');
      if (lead) {
        var lm = priceFor(parse(lead.dataset.prices), cur, parseInt(lead.dataset.priceMinor, 10) || 0);
        lead.innerHTML = priceHtml(lm, cur, 'masterclass');
      }
    }

    // Dedup id shared by the client Pixel + server CAPI (if a pixel is set).
    var eventId = (crypto.randomUUID && crypto.randomUUID()) ||
      (Date.now() + '-' + Math.random().toString(36).slice(2));
    if (idField) idField.value = eventId;

    var current = null;       // the selected radio's dataset
    var curCurrency = 'EUR';  // active display currency
    // Both lists (masterclass dates + the alternatives) share one radio name.
    var radios = booking.querySelectorAll('input[name="mc-date"]');

    // Ticket discount from the URL: ?discount=50 (public, 50 only) or
    // ?adiscount=N (owner secret, 1–100). Ticket only — never the bump.
    var discParams = new URLSearchParams(location.search);
    var rawDiscount = (discParams.get('discount') || '').trim();
    var rawAdiscount = (discParams.get('adiscount') || '').trim();
    function clampPct(v) { var n = parseInt(v, 10); return (isFinite(n) && n >= 1 && n <= 100) ? n : 0; }
    function compoundPct(a, b) { return Math.round(100 - ((100 - a) * (100 - b)) / 100); }
    // Promo(s), mirrored from the base Layout head. The launch sale
    // (window.__SD_PROMO__) applies to every row; the standalone masterclass
    // launch offer (window.__SD_MC_PROMO__) applies to the masterclass rows only
    // (live dates + the replay — kind 'masterclass'), so it keeps them at 50%
    // after the launch sale closes while the €22 intro-workshop fallback returns
    // to full price. A public ?discount=50 "share with a friend" link STACKS on
    // the promo (75% while it runs); a bespoke ?adiscount=N link is the better of
    // it and the promo. The server re-derives the same, per product.
    var launchPct = (window.__SD_PROMO__ && window.__SD_PROMO__.active) ? (window.__SD_PROMO__.percent || 0) : 0;
    var mcPct = (window.__SD_MC_PROMO__ && window.__SD_MC_PROMO__.active) ? (window.__SD_MC_PROMO__.percent || 0) : 0;
    var secretPct = clampPct(rawAdiscount);
    var referralPct = (clampPct(rawDiscount) === 50) ? 50 : 0;
    function promoForKind(kind) { return Math.max(launchPct, kind === 'masterclass' ? mcPct : 0); }
    function discountForKind(kind) {
      var promo = promoForKind(kind);
      if (secretPct) return Math.max(secretPct, promo);
      if (referralPct) return promo ? compoundPct(promo, referralPct) : referralPct;
      return promo;
    }
    var discField = document.getElementById('mc-discount');
    var adiscField = document.getElementById('mc-adiscount');
    if (discField) discField.value = rawDiscount;
    if (adiscField) adiscField.value = rawAdiscount;
    // This page is the masterclass, so the note reflects the masterclass discount.
    var pageDiscount = discountForKind('masterclass');
    if (pageDiscount) {
      // The launch-offer callout already states the promo + "applied at checkout",
      // so skip this note when a promo is driving the discount — only show it for
      // a larger, non-promo URL discount (?adiscount=N).
      var pagePromo = promoForKind('masterclass');
      var promoDriven = pagePromo > 0 && pageDiscount === pagePromo;
      var note = document.getElementById('mc-discount-note');
      if (note && !promoDriven) { note.textContent = pageDiscount + '% off your seat — applied at checkout.'; note.hidden = false; }
    }
    function ticketAfterDiscount(minor, kind) { var d = discountForKind(kind); return d ? Math.round(minor * (100 - d) / 100) : minor; }

    // Seed the active currency from the first radio (server-rendered for the
    // detected country), so a no-change submit stays consistent.
    if (radios.length) curCurrency = radios[0].dataset.currency || 'EUR';

    // Paint the promo onto the server-rendered prices on load (the chips render
    // full price server-side; the discount only otherwise appeared once a date
    // was picked).
    renderPrices(curCurrency);

    function applyCurrency(cur, countryCode) {
      curCurrency = cur;
      if (countryField) countryField.value = countryCode;
      for (var i = 0; i < radios.length; i++) {
        var r = radios[i];
        var minor = priceFor(parse(r.dataset.prices), cur, parseInt(r.dataset.priceMinor, 10) || 0);
        r.dataset.priceMinor = String(minor);
        r.dataset.currency = cur;
      }
      renderPrices(cur);
      if (current) { current = booking.querySelector('input[name="mc-date"]:checked').dataset; recompute(); }
      toggleVat();
    }

    // Resolve a typed/picked country name to its option (code + currency).
    function findCountryOption(name) {
      if (!countryList || !name) return null;
      var wanted = name.trim().toLowerCase();
      var opts = countryList.options;
      for (var i = 0; i < opts.length; i++) {
        if ((opts[i].value || '').toLowerCase() === wanted) return opts[i];
      }
      return null;
    }
    function onCountryChange() {
      var opt = findCountryOption(countryInput && countryInput.value);
      if (opt) {
        // Known country → its currency (countries.ts maps the long tail to EUR),
        // and store the ISO code for the server.
        applyCurrency(opt.getAttribute('data-currency') || 'EUR', opt.getAttribute('data-code') || '');
      } else {
        // Unrecognised entry → charge in EUR, no country code yet.
        applyCurrency('EUR', '');
      }
    }
    if (countryInput) {
      countryInput.addEventListener('change', onCountryChange);
      countryInput.addEventListener('input', onCountryChange);
    }

    function recompute() {
      if (!current) return;
      var fullPriceMinor = parseInt(current.priceMinor, 10) || 0;
      var priceMinor = ticketAfterDiscount(fullPriceMinor, current.kind);
      var cur = current.currency || curCurrency;
      totalLabel.textContent = current.kind === 'masterclass' ? 'Masterclass seat' : 'Workshop ticket';
      totalAmount.innerHTML = (priceMinor !== fullPriceMinor)
        ? '<span class="we-line-was">' + money(fullPriceMinor, cur) + '</span> ' + money(priceMinor, cur)
        : money(priceMinor, cur);
      submitBtn.textContent = 'Register & pay ' + money(priceMinor, cur) + ' →';
    }

    function selectItem(input) {
      current = input.dataset;
      slugField.value = current.slug;
      tzField.style.display = current.isReplay === '1' ? 'none' : '';
      // Company / VAT only for the masterclass (B2B — practitioners invoicing).
      if (bizField) bizField.hidden = current.kind !== 'masterclass';
      toggleVat();
      if (form.hidden) {
        form.hidden = false;
        // next frame so the transition runs
        requestAnimationFrame(function () { form.classList.add('is-revealed'); });
      }
      recompute();
    }

    booking.addEventListener('change', function (e) {
      var t = e.target;
      if (t && t.name === 'mc-date') selectItem(t);
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!current) return;
      if (err) { err.hidden = true; err.textContent = ''; }
      var provider = nextProvider;
      nextProvider = 'stripe';
      submitBtn.disabled = true;
      if (paypalBtn) paypalBtn.disabled = true;
      // Meta Pixel: the visitor is starting checkout (off to Stripe next).
      if (window.fbq) {
        try { window.fbq('track', 'InitiateCheckout', {}, { eventID: eventId }); } catch (e) {}
      }
      var fd = new FormData(form);
      var isMasterclass = current.kind === 'masterclass';
      var fullName = ((fd.get('first_name') || '') + ' ' + (fd.get('last_name') || '')).trim();
      var body = {
        workshop_slug: fd.get('workshop_slug'),
        name: fullName,
        first_name: fd.get('first_name') || '',
        last_name: fd.get('last_name') || '',
        email: fd.get('email'),
        timezone: current.isReplay === '1' ? '' : (fd.get('timezone') || ''),
        country: fd.get('country') || '',
        bump: false,
        company_name: isMasterclass ? (fd.get('company_name') || '') : '',
        vat_number: isMasterclass ? (fd.get('vat_number') || '') : '',
        discount: fd.get('discount') || '',
        adiscount: fd.get('adiscount') || '',
        meta_event_id: fd.get('meta_event_id') || '',
        provider: provider,
      };
      try {
        var res = await fetch('/api/workshops/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        // Parse defensively: an edge/platform failure can answer with an
        // empty or HTML body, and res.json() would throw browser-internal
        // wording ("Unexpected end of JSON input") straight into the form.
        var data = null;
        try { data = await res.json(); } catch (e3) { data = null; }
        if (!res.ok || !data || !(data.checkout_url || data.redirect_url)) {
          throw new Error((data && data.error) ||
            'We couldn’t start checkout (error ' + res.status + '). Please try again, or email info@songdance.co.');
        }
        window.location.href = data.checkout_url || data.redirect_url;
      } catch (e2) {
        // A TypeError here is fetch itself failing (offline, blocked).
        var msg = (e2 && e2.name === 'TypeError')
          ? 'We couldn’t reach the server. Please check your connection and try again — or email info@songdance.co.'
          : ((e2 && e2.message) || 'Something went wrong.');
        if (err) { err.hidden = false; err.textContent = msg; }
        submitBtn.disabled = false;
        if (paypalBtn) paypalBtn.disabled = false;
      }
    });
  })();
</script>
