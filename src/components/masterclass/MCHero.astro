---
// Hero for the masterclass pages. Background by default: Jacob holding a
// circle in the round hall (svh-retreat-group-indoor) — the room they hold;
// the heal-the-healer door passes its own photo through `image`. The copy
// comes in through the `eyebrow` / `heading` / `sub` slots — the defaults are
// the professional door's lines, so /courses/masterclass renders unchanged.
//
// `nextWhen` (+ `nextStartsAt`) renders the next live masterclass date right
// under the sub — a concrete anchor before the first CTA. The register block's
// "Times shown in" selector re-renders it (data-mc-live-when), so the hero and
// the calendar can never disagree about the time.
interface Props {
  class?: string;
  image?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  nextWhen?: string | null;
  nextStartsAt?: string | null;
}
const {
  class: className,
  image = '/media/library/svh-retreat-group-indoor.webp',
  secondaryHref = '#inside',
  secondaryLabel = "See what's inside the 100 minutes",
  nextWhen = null,
  nextStartsAt = null,
} = Astro.props;
---

<section class:list={['we-hero', className]}>
  <div class="we-hero-bg" aria-hidden="true">
    <img src={image} alt="" />
  </div>
  <div class="we-hero-inner">
    <img class="we-hero-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
    <div class="we-hero-eyebrow">
      <slot name="eyebrow">Professional Masterclass · Somatic Vocal Healing</slot>
    </div>
    <h1 class="we-hero-head">
      <slot name="heading">When words can't reach it, <em>sound can.</em></slot>
    </h1>
    <p class="we-hero-sub">
      <slot name="sub">
        A 100-minute live masterclass for therapists, coaches, bodyworkers,
        facilitators, teachers, and leaders — <em>the people whose work is
        other people.</em>
      </slot>
    </p>
    {nextWhen && (
      <p class="mc-hero-next">
        <span class="mc-hero-next-k">Next live date</span>
        <strong data-mc-live-when data-starts-at={nextStartsAt ?? ''}>{nextWhen}</strong>
        <span class="mc-hero-next-tz">· your time</span>
      </p>
    )}
    <div class="we-hero-actions">
      <a href="#register" class="we-hero-cta">
        Reserve your seat <i class="ph-light ph-arrow-right"></i>
      </a>
      <a href={secondaryHref} class="we-hero-link">{secondaryLabel}</a>
    </div>
    <div class="we-hero-meta">
      <span>With Jacob Vermeulen</span>
      <span class="dot"></span>
      <span>Online</span>
      <span class="dot"></span>
      <span>Live</span>
      <span class="dot"></span>
      <span>Replay included</span>
    </div>
  </div>
</section>

<script is:inline>
  // Subtle hero-background parallax, same as the workshop page. Moves the
  // background slower than the page within the -60px headroom on .we-hero-bg.
  // Disabled for reduced-motion.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var hero = document.querySelector('.we-hero');
    var bg = document.querySelector('.we-hero-bg');
    if (!hero || !bg) return;
    var ticking = false;
    function update() {
      ticking = false;
      var rect = hero.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      var shift = Math.max(-40, Math.min(40, -rect.top * 0.12));
      bg.style.transform = 'translate3d(0,' + shift.toFixed(1) + 'px,0)';
    }
    function onScroll() {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();
</script>
