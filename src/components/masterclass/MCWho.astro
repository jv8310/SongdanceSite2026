---
// Who it's for — named in plain professional language first (the chips), with
// the wider net in the note. "Holding space" is taught elsewhere on the page;
// here the door should be recognisable to anyone whose work is people.
const audiences = [
  'Psychotherapists & counsellors',
  'Coaches & facilitators',
  'Body- & breathworkers',
  'Yoga & meditation teachers',
  'Voice & music professionals',
  'Teachers, carers & leaders',
];
---

<section class="mc-who">
  <div class="mc-who-inner">
    <div class="we-eyebrow" style="justify-content: center;">Who it's for</div>
    <h2 class="we-h2">For the people <em>others turn to.</em></h2>
    <div class="mc-who-chips">
      {audiences.map((a) => <span class="mc-who-chip">{a}</span>)}
    </div>
    <p class="mc-who-note">
      Whatever the title on your door — if part of your work is staying steady
      while someone else finds their way, this was built for you. Useful
      whether or not you ever intend to teach sounding formally: it begins
      with what it does in your own practice, and in you.
    </p>
  </div>
</section>
