---
const rows = [
  {
    n: '01',
    label: 'Somatic Vocal Healing',
    title: 'Sound as the body’s language',
    body: "Your voice is the instrument — not a performance to get right, but the honest sound of what's here. You stay with it until it's been heard, and something moves.",
    meta: 'in your own voice',
    href: '/what-is-svh',
    img: '/media/library/jacob-sounding.webp',
    flip: false,
  },
  {
    n: '02',
    label: 'The group practice',
    title: 'Sound Constellations',
    body: "A group method for what runs through families, relationships, and the body's lineage — voiced, not analysed. Held in person a handful of times a year. (In Dutch: Klankopstellingen.)",
    meta: 'in person · in Dutch',
    href: '/events?filter=retreat',
    img: '/media/library/svh-retreat-circle-trees-sunset.webp',
    flip: true,
  },
];
---

<section class="sd-work" id="work">
  <div class="sd-work-inner">
    <div class="sd-work-head" data-anim="reveal">
      <div class="sd-eyebrow">What it is</div>
      <h2 class="sd-section-title sd-section-title-centered">
        It asks what a feeling <span class="sd-italic">sounds</span> like — and lets you make that sound.
      </h2>
      <p class="sd-work-lede">
        Most of us learned to manage a feeling, talk it down, or wait it out. This does
        something simpler and stranger: it gives the feeling a <em>sound</em>, and lets
        you make it — out loud, in your own voice. Nothing to perform, nothing to get
        right. You stay with it until it's been heard, and something in you settles.
      </p>
    </div>

    {
      rows.map((r) => (
        <article class={'sd-work-row' + (r.flip ? ' flip' : '')} data-anim="work-row">
          <figure class="sd-work-row-img">
            <img src={r.img} alt="" />
            <span class="sd-work-row-num">{r.n}</span>
          </figure>
          <div class="sd-work-row-text">
            <div class="sd-work-row-label">{r.label}</div>
            <h3 class="sd-work-row-title">{r.title}</h3>
            <div class="sd-work-row-meta">{r.meta}</div>
            <p class="sd-work-row-body">{r.body}</p>
            <a href={r.href} class="sd-link">Read more</a>
          </div>
        </article>
      ))
    }
  </div>
</section>
