---
const rows = [
  {
    n: '01',
    label: 'The practice',
    title: 'Somatic Vocal Healing',
    body: "Your voice is the instrument — not a performance to get right, but the honest sound of what's here. The healing is in the acknowledgment: being present with it until it can finish.",
    meta: 'in your own voice',
    href: '/what-is-svh',
    cta: 'Read more',
    img: '/media/library/svh-retreat-sounding-portrait-jacob-sunset.webp',
    pos: 'center 25%',
    flip: false,
  },
  {
    n: '02',
    label: 'What makes it different',
    title: 'Sounding, not singing',
    body: "There's no melody to reach for and nothing to perform. The crack, the waver, the rough edge — that's the information. The question isn't how it should sound, but what this feels like — and what the sound of that is.",
    meta: 'nothing to get right',
    href: '/what-is-svh',
    cta: 'Read more',
    img: '/media/library/svh-retreat-sounding-patterned-rocks.webp',
    pos: 'center 18%',
    flip: true,
  },
  {
    n: '03',
    label: 'Together',
    title: 'Sounding in a circle',
    body: "Most of the deep work happens with others — in a room, on retreat, sounding in a circle while the group holds the space. Witnessed is different from watched.",
    meta: 'in person · in groups',
    href: '/events',
    cta: 'See upcoming events →',
    img: '/media/library/svh-retreat-circle-trees-sunset.webp',
    pos: 'center 44%',
    flip: false,
  },
];
---

<section class="sd-work" id="work">
  <div class="sd-work-inner">
    <div class="sd-work-head" data-anim="reveal">
      <div class="sd-eyebrow">What it is</div>
      <h2 class="sd-section-title sd-section-title-centered">
        What does a feeling <span class="sd-italic">sound</span> like?
      </h2>
      <p class="sd-work-lede">
        Most of us were taught to handle feelings from the neck up — to name them,
        manage them, wait them out. This one works lower down: you give the feeling a
        sound, in your own voice, and stay with it until it's been heard.
      </p>
    </div>

    {
      rows.map((r) => (
        <article class={'sd-work-row' + (r.flip ? ' flip' : '')} data-anim="work-row">
          <div class="sd-work-chapter">
            <span class="sd-work-chapter-num">{r.n}</span>
            <span class="sd-work-chapter-rule" />
            <span class="sd-work-chapter-label">{r.label}</span>
          </div>
          <figure class="sd-work-row-img">
            <img src={r.img} alt="" style={r.pos ? `object-position:${r.pos}` : undefined} />
          </figure>
          <div class="sd-work-row-text">
            <h3 class="sd-work-row-title">{r.title}</h3>
            <div class="sd-work-row-meta">{r.meta}</div>
            <p class="sd-work-row-body">{r.body}</p>
            <a href={r.href} class="sd-link">{r.cta}</a>
          </div>
        </article>
      ))
    }
  </div>
</section>
