---
import { guarantee } from '../../lib/guarantee';

const faqs: [string, string][] = [
  [
    'What are the class times and dates?',
    'It’s a self-paced video course — watch whenever you like. The live Q&As run on a rotating schedule to cover every timezone, and every one is posted as a replay.',
  ],
  [
    'How long are the classes?',
    'Most videos are around two hours and are chaptered for easy navigation; some are shorter. Q&As run one hour.',
  ],
  [
    'Are there replays?',
    'Yes — Q&A replays for the full twelve weeks. The video classes are lifetime access.',
  ],
  [
    'Can I pay in installments?',
    'Yes, in three monthly payments.',
  ],
  [guarantee.faq.q, guarantee.faq.a],
  [
    'How long do I have access?',
    'Lifetime access to the course materials, plus twelve weeks of live Q&A and replays from your start.',
  ],
  [
    'Do I need to be able to sing?',
    'No. Sounding is not singing — one tone, the tone of what’s there. You don’t need a good voice. You need an honest one.',
  ],
  [
    'Do I need to be intuitive?',
    'No — if anything it runs the other way. A couple of minutes of sounding quiets the analytical mind, and information starts arriving from underneath it: what the feeling actually is, how old it is, where it began. Over twelve weeks you experience that more and more. As one student put it: “we’re all becoming human lie detectors.”',
  ],
  [
    'What about the neighbours?',
    'Everyone asks. Until the day you stop caring: a cushion, the bathroom, the car. Half this practice happens in parked cars.',
  ],
  [
    'Is this therapy?',
    'No, and it doesn’t replace it. It will always remain valuable to have regular sessions with someone who knows you. This is a practice you carry alongside.',
  ],
];
---

<section class="tw-faq tw-section">
  <div class="tw-faq-inner">
    <div class="tw-faq-head" data-reveal>
      <p class="tw-eyebrow tw-eyebrow--center">Questions</p>
      <h2 class="tw-h2">Good <em>questions.</em></h2>
    </div>

    <div class="tw-faq-list" data-reveal>
      {faqs.map(([q, a]) => (
        <details class="tw-faq-item">
          <summary class="tw-faq-summary">
            <span>{q}</span>
            <span class="tw-faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="tw-faq-body">
            <p>{a}</p>
          </div>
        </details>
      ))}
    </div>

    <p class="tw-faq-foot" data-reveal>
      Still have questions? Write to
      <a href="mailto:info@songdance.co">info@songdance.co</a> — we reply personally.
    </p>
  </div>
</section>
