---
// A thin full-bleed "sounding wave" divider between movements.
// `alt` tints the band to match an adjacent paper-soft section.
interface Props { alt?: boolean; src?: string; tall?: boolean }
const {
  alt = false,
  src = '/media/library/svhgpt-08-oscillation-breath-rhythm.webp',
  tall = false,
} = Astro.props;
---

<div class:list={["tw-wave", { "tw-wave--alt": alt, "tw-wave--photo": tall }]} aria-hidden="true">
  <img src={src} alt="" loading="lazy" />
</div>
