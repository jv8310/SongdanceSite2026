---
// A thin full-bleed "sounding wave" divider between movements.
// `alt` tints the band to match an adjacent paper-soft section.
interface Props { alt?: boolean; src?: string }
const { alt = false, src = '/media/library/svhgpt-08-oscillation-breath-rhythm.webp' } = Astro.props;
---

<div class:list={["tw-wave", { "tw-wave--alt": alt }]} aria-hidden="true">
  <img src={src} alt="" loading="lazy" />
</div>
