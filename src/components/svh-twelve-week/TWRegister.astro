---
import { SESSION_URL } from './config';
import { COUNTRIES } from '../../lib/countries';

const includes = [
  '18+ hours of video across 12 modules, full of guided practices',
  '12 weeks of weekly live Q&A with Jacob, plus replays',
  'Lifetime access to the materials',
  'A supportive student community',
  'Five of Jacob’s original mantras on joining',
];
---

<section class="tw-reg tw-section" id="register">
  <div class="tw-reg-bg" aria-hidden="true">
    <img src="/media/library/svhgpt-09-closing-candle.webp" alt="" loading="lazy" />
  </div>
  <div class="tw-reg-inner">
    <p class="tw-eyebrow tw-eyebrow--center" data-reveal>Begin</p>
    <h2 class="tw-reg-h2" data-reveal>Begin with your own <em>voice.</em></h2>
    <p class="tw-reg-sub" data-reveal>Your own time — with live company whenever you want it.</p>

    <div class="tw-reg-card" data-reveal>
      <p class="tw-reg-card-h">Your 12-Week Somatic Vocal Healing Course includes</p>
      <ul class="tw-list">
        {includes.map((item) => (
          <li>
            <span class="mark" aria-hidden="true">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="tw-reg-gate" data-tw-stage data-reveal>
      <form class="tw-reg-emailform" data-tw-email-form>
        <input type="email" name="email" placeholder="Your email" autocomplete="email" required />
        <button type="submit">See your price</button>
      </form>
      <p class="tw-reg-formnote">
        No account, no list — just to show your price and any workshop discount.
      </p>
      <p class="tw-reg-error" data-tw-error></p>
    </div>

    <!-- Cloned + filled by the script once an email has been entered. -->
    <template data-tw-template>
      <div class="tw-reg-priced">
        <div class="tw-reg-emailline">
          <span class="tw-reg-emaillabel">Your price for</span>
          <span class="tw-reg-emailval" data-slot="email"></span>
          <button type="button" class="tw-reg-emailchange" data-slot="change">change</button>
        </div>

        <!-- Pro only: choose between the 12-week course and the full
             Certification path (12-Week Course + Certification Course). -->
        <div class="tw-reg-offers-wrap" data-slot="offers-wrap" hidden>
          <div class="tw-reg-steplabel">Choose your option</div>
          <div class="tw-reg-plans" data-slot="offers"></div>
        </div>

        <div class="tw-reg-badge" data-slot="badge" hidden>
          <span class="dot" aria-hidden="true"></span>
          <span data-slot="badge-text"></span>
        </div>

        <div class="tw-reg-pricebox" data-slot="pricebox">
          <span class="tw-reg-pricewas" data-slot="was" hidden></span>
          <span class="tw-reg-pricenow" data-slot="now"></span>
          <span class="tw-reg-pricenote" data-slot="pricenote"></span>
        </div>

        <!-- Certification path breakdown: two line items + combined total. -->
        <div class="tw-reg-pathbox" data-slot="pathbox" hidden>
          <div class="tw-reg-pathline">
            <span class="tw-reg-pathline-name">12-Week Course</span>
            <span class="tw-reg-pathline-amt" data-slot="path-tw"></span>
          </div>
          <div class="tw-reg-pathline">
            <span class="tw-reg-pathline-name">Certification Course</span>
            <span class="tw-reg-pathline-amt" data-slot="path-cert"></span>
          </div>
          <div class="tw-reg-pathtotal">
            <span class="tw-reg-pathtotal-label">Total</span>
            <span class="tw-reg-pathtotal-amt" data-slot="path-total"></span>
          </div>
        </div>

        <div class="tw-reg-countdown" data-slot="countdown" hidden>
          <i class="ph-light ph-hourglass-medium" aria-hidden="true"></i>
          <span>Your discount ends in <span class="clock" data-slot="clock">--:--:--</span></span>
        </div>

        <!-- Certification path only: when does the certification course open? -->
        <fieldset class="tw-reg-activate" data-slot="activate" hidden>
          <legend>Activate the certification course</legend>
          <label>
            <input type="radio" name="activate_choice" value="now" />
            <span>
              <strong>Activate right away.</strong>
              <small>Immediate access to the certification materials and live community, alongside the 12-week foundation.</small>
            </span>
          </label>
          <label>
            <input type="radio" name="activate_choice" value="wait" checked />
            <span>
              <strong>Activate after the 12-week course completes.</strong>
              <small>Walk the foundation first; the certification opens automatically when it's done.</small>
            </span>
          </label>
          <p class="tw-reg-activate-note">You can always email us to activate it sooner.</p>
        </fieldset>

        <div class="tw-reg-steplabel">How would you like to pay?</div>
        <div class="tw-reg-plans" data-slot="plans"></div>

        <div class="tw-reg-steplabel">Your details</div>
        <div class="tw-reg-fields">
          <label class="tw-reg-field">
            <span>First name</span>
            <input type="text" name="first_name" autocomplete="given-name" required />
          </label>
          <label class="tw-reg-field">
            <span>Last name</span>
            <input type="text" name="last_name" autocomplete="family-name" required />
          </label>
          <label class="tw-reg-field">
            <span>Country</span>
            <input
              type="text"
              name="country_search"
              list="tw-country-list"
              autocomplete="country-name"
              placeholder="Start typing…"
              required
            />
            <input type="hidden" name="country" />
          </label>
          <label class="tw-reg-field">
            <span>Phone</span>
            <div class="tw-reg-phonegrid">
              <select name="phone_country" required aria-label="Phone country">
                <option value="">—</option>
                {COUNTRIES.map((c) => (
                  <option value={c.code} data-dial={c.dial}>{c.flag} +{c.dial}</option>
                ))}
              </select>
              <input type="tel" name="phone" placeholder="Phone number" autocomplete="tel" required />
            </div>
          </label>
          <label class="tw-reg-field tw-reg-field--full">
            <span>Company <span class="tw-reg-fieldnote">— optional, for a business invoice</span></span>
            <input type="text" name="company_name" autocomplete="organization" placeholder="Your company name" />
          </label>
          <label class="tw-reg-field tw-reg-field--full" data-slot="vat-field" hidden>
            <span>VAT number <span class="tw-reg-fieldnote">— EU businesses, for reverse-charge</span></span>
            <input type="text" name="vat_number" autocomplete="off" placeholder="e.g. BE0123456789" />
          </label>
        </div>

        <label class="tw-reg-consent">
          <input type="checkbox" name="consent_terms" required />
          <span>I agree to the <a href="/terms" target="_blank" rel="noopener">terms and conditions</a>.</span>
        </label>

        <div class="tw-reg-summary">
          <span class="tw-reg-summary-label" data-slot="sum-label"></span>
          <span class="tw-reg-summary-amount" data-slot="sum-amount"></span>
        </div>

        <button type="button" class="tw-reg-cta" data-slot="cta">
          <span>Continue to payment</span>
          <i class="ph-light ph-arrow-right" aria-hidden="true"></i>
        </button>
        <p class="tw-reg-error" data-slot="error"></p>
      </div>
    </template>

    <datalist id="tw-country-list">
      {COUNTRIES.map((c) => (
        <option value={c.name} data-code={c.code} data-dial={c.dial}>{c.flag} {c.name}</option>
      ))}
    </datalist>

    <p class="tw-reg-fine" data-reveal>
      Not sure yet?
      <a href={SESSION_URL} class="tw-ghost tw-ghost--ondark" data-sd-price="ticket">Try a live Vocal Healing Session for 9€ first →</a>
    </p>
  </div>
</section>

<script>
  import { COUNTRIES } from '../../lib/countries';

  type Plan = 'full' | '3x';
  type OfferId = '12week' | 'path';
  // The Certification path = cert (standard price) + the workshop-discounted
  // 12-week, shown as two line items + a combined total. The discount only
  // ever touches the 12-week portion. Priced in EUR/USD/GBP (the cert
  // currencies); mirrors CertificationPathPricing on the server.
  type PathPricing = {
    currency: string;
    twelve_week_base_cents: number;
    twelve_week_price_cents: number;
    cert_base_price_cents: number;
    cert_price_cents: number;
    total_cents: number;
    base_total_cents: number;
    base_total_monthly_cents: number;
    total_monthly_cents: number;
    installment_count: number;
    discount: {
      eligible: boolean;
      percent: number;
      kind: 'pre' | 'post' | 'none' | 'override';
      expires_at_ms: number | null;
    };
  };
  type Status = {
    email: string;
    currency: string;
    price_cents: number;
    installment_count: number;
    installment_monthly_cents: number;
    installment_total_cents: number;
    discount: {
      eligible: boolean;
      kind: 'pre' | 'post' | 'none' | 'override';
      percent: number;
      expires_at_ms: number | null;
      price_cents: number;
      monthly_cents: number;
    };
    is_pro?: boolean;
    path?: PathPricing;
    first_name?: string;
    last_name?: string;
    country?: string;
  };

  // URL forces, read once. `?audience=pro` reveals the certification option even
  // when we can't detect pro from the email; `?discount=N` (1–99) forces N% off
  // the 12-week price (overriding the automatic workshop discount).
  const urlParams = new URLSearchParams(location.search);
  const forcePro = (urlParams.get('audience') ?? '').trim().toLowerCase() === 'pro';
  const urlDiscount = (() => {
    const n = parseInt(urlParams.get('discount') ?? '', 10);
    return Number.isInteger(n) && n >= 1 && n <= 99 ? n : 0;
  })();

  const SYM: Record<string, string> = {
    EUR: '€', USD: '$', GBP: '£', CAD: 'CA$', CHF: 'CHF ',
    NOK: 'kr ', SEK: 'kr ', DKK: 'kr ', AUD: 'A$', NZD: 'NZ$',
  };
  function money(cents: number, cur: string): string {
    const major = cents / 100;
    const sym = SYM[cur] ?? '';
    const body = Number.isInteger(major) ? String(major) : major.toFixed(2);
    return sym ? `${sym}${body}` : `${body} ${cur}`;
  }
  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  const stage = document.querySelector<HTMLElement>('[data-tw-stage]');
  const template = document.querySelector<HTMLTemplateElement>('[data-tw-template]');
  if (stage && template) {
    const emailForm = stage.querySelector<HTMLFormElement>('[data-tw-email-form]')!;
    const note = stage.querySelector<HTMLElement>('.tw-reg-formnote');
    const errorEl = stage.querySelector<HTMLElement>('[data-tw-error]')!;
    let countdownTimer: number | undefined;

    function showError(msg: string) { errorEl.textContent = msg; }
    function clearError() { errorEl.textContent = ''; }

    function showEmailForm(prefill?: string) {
      window.clearInterval(countdownTimer);
      stage!.replaceChildren(emailForm);
      if (note) stage!.appendChild(note);
      stage!.appendChild(errorEl);
      const input = emailForm.querySelector<HTMLInputElement>('input[name="email"]')!;
      if (prefill) input.value = prefill;
      const btn = emailForm.querySelector<HTMLButtonElement>('button')!;
      btn.disabled = false; btn.textContent = 'See your price';
      clearError();
    }

    // Best-effort country guess from timezone / locale, so the first price
    // is shown in a sensible currency before the buyer fills in the form.
    function guessCountry(): string | undefined {
      try {
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        const tzMap: Record<string, string> = {
          'Europe/London': 'GB', 'America/New_York': 'US', 'America/Chicago': 'US',
          'America/Denver': 'US', 'America/Los_Angeles': 'US', 'America/Phoenix': 'US',
          'America/Toronto': 'CA', 'America/Vancouver': 'CA', 'America/Edmonton': 'CA',
          'Australia/Sydney': 'AU', 'Australia/Melbourne': 'AU', 'Australia/Perth': 'AU',
          'Pacific/Auckland': 'NZ', 'Europe/Zurich': 'CH', 'Europe/Oslo': 'NO',
          'Europe/Stockholm': 'SE', 'Europe/Copenhagen': 'DK',
        };
        if (tzMap[tz]) return tzMap[tz];
        const m = (navigator.language || '').match(/-([A-Z]{2})$/i);
        if (m) return m[1].toUpperCase();
      } catch {}
      return undefined;
    }

    async function fetchStatus(email: string, country?: string): Promise<Status | { error: string }> {
      const res = await fetch('/api/courses/twelve-week-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          country,
          force_pro: forcePro || undefined,
          discount_percent: urlDiscount || undefined,
        }),
      });
      try { return (await res.json()) as Status; } catch { return { error: 'Bad response' }; }
    }

    emailForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();
      const email = String(new FormData(emailForm).get('email') ?? '').trim().toLowerCase();
      if (!email) return;
      const btn = emailForm.querySelector<HTMLButtonElement>('button')!;
      btn.disabled = true; btn.textContent = 'Checking…';
      const status = await fetchStatus(email, guessCountry());
      if (!('currency' in status)) {
        showError(('error' in status && status.error) || 'Something went wrong. Please try again.');
        btn.disabled = false; btn.textContent = 'See your price';
        return;
      }
      render(email, status);
    });

    // Arriving from an email? ?email=… skips the gate: prefill and reveal
    // that person's price (and any live discount) immediately.
    const urlEmail = (new URLSearchParams(location.search).get('email') ?? '').trim().toLowerCase();
    if (urlEmail && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(urlEmail)) {
      emailForm.querySelector<HTMLInputElement>('input[name="email"]')!.value = urlEmail;
      emailForm.requestSubmit();
    }

    function render(email: string, status: Status) {
      window.clearInterval(countdownTimer);
      const frag = template!.content.cloneNode(true) as DocumentFragment;
      const root = frag.querySelector('.tw-reg-priced') as HTMLElement;
      const q = <T extends HTMLElement>(sel: string) => root.querySelector(sel) as T;

      (q('[data-slot="email"]') as HTMLElement).textContent = email;
      q<HTMLButtonElement>('[data-slot="change"]').addEventListener('click', () => showEmailForm(email));

      // Pro emails (or ?audience=pro) can switch between the 12-week course and
      // the full Certification path (12-Week Course + Certification Course). The
      // discount only ever touches the 12-week price — inside the path, only its
      // 12-week portion; the certification course always shows its standard price.
      const hasPath = !!(status.is_pro && status.path);
      let selectedOffer: OfferId = '12week';
      let selectedPlan: Plan = 'full';

      // The pricing "view" for whichever offer is currently selected.
      function view() {
        if (selectedOffer === 'path' && status.path) {
          const p = status.path;
          const dd = p.discount;
          return {
            // The total is always struck: the cert sits at its mid-cohort
            // price, and the 12-week may carry the workshop discount on top.
            cur: p.currency,
            hasStrike: p.base_total_cents > p.total_cents,
            wasCents: p.base_total_cents,
            nowCents: p.total_cents,
            monthlyWasCents: p.base_total_monthly_cents,
            monthlyNowCents: p.total_monthly_cents,
            count: p.installment_count,
            badgeText: dd.eligible
              ? (dd.kind === 'override'
                  ? `${dd.percent}% off the 12-week`
                  : `Workshop discount — ${dd.percent}% off the 12-week`)
              : '',
            offerName: 'Certification path',
            discountOff: dd.eligible ? ` (12-week ${dd.percent}% off)` : '',
            showCountdown: dd.eligible && dd.kind === 'post' && !!dd.expires_at_ms,
            expiresAtMs: dd.expires_at_ms,
          };
        }
        const d = status.discount;
        return {
          cur: status.currency,
          hasStrike: d.eligible,
          wasCents: status.price_cents,
          nowCents: d.eligible ? d.price_cents : status.price_cents,
          monthlyWasCents: status.installment_monthly_cents,
          monthlyNowCents: d.eligible ? d.monthly_cents : status.installment_monthly_cents,
          count: status.installment_count,
          badgeText: d.eligible
            ? (d.kind === 'override' ? `${d.percent}% off` : `Workshop discount — ${d.percent}% off`)
            : '',
          offerName: '12-Week Course',
          discountOff: d.eligible ? ` (${d.percent}% off)` : '',
          showCountdown: d.eligible && d.kind === 'post' && !!d.expires_at_ms,
          expiresAtMs: d.expires_at_ms,
        };
      }

      // ---- Offer picker (pro only): 12-Week Course vs Certification
      const offersWrap = q('[data-slot="offers-wrap"]') as HTMLElement;
      const offersEl = q('[data-slot="offers"]') as HTMLElement;
      const renderOffers = () => {
        if (!hasPath) { offersWrap.hidden = true; return; }
        offersWrap.hidden = false;
        const d = status.discount;
        const cur12 = status.currency;
        const now12 = d.eligible ? d.price_cents : status.price_cents;
        const amount12 = d.eligible
          ? `<span class="tw-amount-strike">${money(status.price_cents, cur12)}</span>${money(now12, cur12)}`
          : money(now12, cur12);
        const p = status.path!;
        const amountPath = p.base_total_cents > p.total_cents
          ? `<span class="tw-amount-strike">${money(p.base_total_cents, p.currency)}</span>${money(p.total_cents, p.currency)}`
          : money(p.total_cents, p.currency);

        const card = (offer: OfferId, title: string, sub: string, amountHtml: string) => {
          const el = document.createElement('button');
          el.type = 'button';
          el.className = 'tw-reg-plan' + (offer === selectedOffer ? ' tw-reg-plan--selected' : '');
          el.dataset.offer = offer;
          el.innerHTML =
            `<span class="tw-reg-plan-radio" aria-hidden="true"></span>` +
            `<span class="tw-reg-plan-text"><span class="tw-reg-plan-title">${escapeHtml(title)}</span>` +
            `<span class="tw-reg-plan-sub">${escapeHtml(sub)}</span></span>` +
            `<span class="tw-reg-plan-amount">${amountHtml}</span>`;
          el.addEventListener('click', () => {
            if (selectedOffer === offer) return;
            selectedOffer = offer;
            selectedPlan = 'full';
            offersEl.querySelectorAll<HTMLElement>('.tw-reg-plan').forEach((p) =>
              p.classList.toggle('tw-reg-plan--selected', p.dataset.offer === selectedOffer));
            renderPrice(); renderPlans(); renderSummary();
          });
          return el;
        };

        offersEl.replaceChildren(
          card('12week', 'The 12-Week Course', 'Self-paced + live weekly Q&A', amount12),
          card('path', 'Certification path', '12-Week Course + Certification Course', amountPath),
        );
      };

      // ---- Price box + badge + countdown
      const renderPrice = () => {
        const v = view();
        const isPath = selectedOffer === 'path' && !!status.path;
        const badge = q('[data-slot="badge"]') as HTMLElement;
        const pricebox = q('[data-slot="pricebox"]') as HTMLElement;
        const pathbox = q('[data-slot="pathbox"]') as HTMLElement;
        const activate = q('[data-slot="activate"]') as HTMLElement;
        const was = q('[data-slot="was"]') as HTMLElement;
        const now = q('[data-slot="now"]') as HTMLElement;
        const pricenote = q('[data-slot="pricenote"]') as HTMLElement;
        const countdown = q('[data-slot="countdown"]') as HTMLElement;

        // Discount badge shows for either offer when a discount is live.
        if (v.badgeText) {
          badge.hidden = false;
          (q('[data-slot="badge-text"]') as HTMLElement).textContent = v.badgeText;
        } else {
          badge.hidden = true;
        }

        if (isPath) {
          // Two transparent line items + a combined total. The cert shows its
          // sticker struck to the mid-cohort price; the 12-week shows the
          // workshop discount on top when it's live.
          const p = status.path!;
          pricebox.hidden = true;
          pathbox.hidden = false;
          activate.hidden = false;
          const strike = (was: number, now: number) =>
            was > now
              ? `<span class="tw-amount-strike">${money(was, p.currency)}</span>${money(now, p.currency)}`
              : money(now, p.currency);
          const twAmt = p.discount.eligible
            ? strike(p.twelve_week_base_cents, p.twelve_week_price_cents)
            : money(p.twelve_week_base_cents, p.currency);
          (q('[data-slot="path-tw"]') as HTMLElement).innerHTML = twAmt;
          (q('[data-slot="path-cert"]') as HTMLElement).innerHTML = strike(p.cert_base_price_cents, p.cert_price_cents);
          (q('[data-slot="path-total"]') as HTMLElement).innerHTML = strike(p.base_total_cents, p.total_cents);
        } else {
          pricebox.hidden = false;
          pathbox.hidden = true;
          activate.hidden = true;
          now.textContent = money(v.nowCents, v.cur);
          if (v.hasStrike) {
            was.hidden = false;
            was.textContent = money(v.wasCents, v.cur);
          } else {
            was.hidden = true;
          }
          pricenote.textContent = `One payment · or ${v.count} monthly payments of ${money(v.monthlyNowCents, v.cur)}`;
        }

        // Post-workshop 48h window → live countdown; on expiry, re-price.
        window.clearInterval(countdownTimer);
        if (v.showCountdown && v.expiresAtMs) {
          const expires = v.expiresAtMs;
          countdown.hidden = false;
          const clock = q('[data-slot="clock"]') as HTMLElement;
          const tick = async () => {
            const left = expires - Date.now();
            if (left <= 0) {
              window.clearInterval(countdownTimer);
              const fresh = await fetchStatus(email, status.country);
              if ('currency' in fresh) render(email, fresh);
              return;
            }
            const s = Math.floor(left / 1000);
            const hh = String(Math.floor(s / 3600)).padStart(2, '0');
            const mm = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
            const ss = String(s % 60).padStart(2, '0');
            clock.textContent = `${hh}:${mm}:${ss}`;
          };
          tick();
          countdownTimer = window.setInterval(tick, 1000);
        } else {
          countdown.hidden = true;
        }
      };

      // ---- Plan picker
      const plansEl = q('[data-slot="plans"]') as HTMLElement;
      const renderPlans = () => {
        const v = view();
        const cur = v.cur;
        const fullAmount = v.hasStrike
          ? `<span class="tw-amount-strike">${money(v.wasCents, cur)}</span>${money(v.nowCents, cur)}`
          : money(v.nowCents, cur);
        const monStrike = v.monthlyWasCents > v.monthlyNowCents;
        const monAmount = monStrike
          ? `<span class="tw-amount-strike">${money(v.monthlyWasCents, cur)}/mo</span>${money(v.monthlyNowCents, cur)}/mo`
          : `${money(v.monthlyNowCents, cur)}/mo`;

        const opt = (plan: Plan, title: string, sub: string, amountHtml: string) => {
          const el = document.createElement('button');
          el.type = 'button';
          el.className = 'tw-reg-plan' + (plan === selectedPlan ? ' tw-reg-plan--selected' : '');
          el.dataset.plan = plan;
          el.innerHTML =
            `<span class="tw-reg-plan-radio" aria-hidden="true"></span>` +
            `<span class="tw-reg-plan-text"><span class="tw-reg-plan-title">${escapeHtml(title)}</span>` +
            `<span class="tw-reg-plan-sub">${escapeHtml(sub)}</span></span>` +
            `<span class="tw-reg-plan-amount">${amountHtml}</span>`;
          el.addEventListener('click', () => {
            selectedPlan = plan;
            plansEl.querySelectorAll<HTMLElement>('.tw-reg-plan').forEach((p) =>
              p.classList.toggle('tw-reg-plan--selected', p.dataset.plan === selectedPlan));
            renderSummary();
          });
          return el;
        };

        plansEl.replaceChildren(
          opt('full', 'Pay in full', 'One payment · lifetime access', fullAmount),
          opt('3x', `${v.count} monthly payments`,
            `${money(v.monthlyNowCents, cur)}/mo × ${v.count} (${money(v.monthlyNowCents * v.count, cur)} total)`, monAmount),
        );
      };

      // ---- Summary line above the CTA
      const sumLabel = q('[data-slot="sum-label"]') as HTMLElement;
      const sumAmount = q('[data-slot="sum-amount"]') as HTMLElement;
      const renderSummary = () => {
        const v = view();
        const cur = v.cur;
        if (selectedPlan === '3x') {
          sumLabel.textContent = `${v.offerName} · ${v.count} monthly payments${v.discountOff}`;
          sumAmount.textContent = `${money(v.monthlyNowCents, cur)}/mo`;
        } else {
          sumLabel.textContent = `${v.offerName} · one payment${v.discountOff}`;
          sumAmount.textContent = money(v.nowCents, cur);
        }
      };

      // ---- Prefill name/country from the workshop registration / geo guess
      const firstI = root.querySelector<HTMLInputElement>('[name="first_name"]')!;
      const lastI = root.querySelector<HTMLInputElement>('[name="last_name"]')!;
      const countrySearch = root.querySelector<HTMLInputElement>('[name="country_search"]')!;
      const countryHidden = root.querySelector<HTMLInputElement>('[name="country"]')!;
      // `as unknown as` per TS: this repo's lib setup doesn't treat
      // HTMLSelectElement as overlapping Element on a bare querySelector cast.
      const phoneSel = root.querySelector('[name="phone_country"]') as unknown as HTMLSelectElement;
      const companyI = root.querySelector<HTMLInputElement>('[name="company_name"]')!;
      const vatField = q('[data-slot="vat-field"]') as HTMLElement;
      const vatI = root.querySelector<HTMLInputElement>('[name="vat_number"]')!;

      if (status.first_name) firstI.value = status.first_name;
      if (status.last_name) lastI.value = status.last_name;
      const initialCountry = status.country || guessCountry();
      if (initialCountry) {
        const match = COUNTRIES.find((c) => c.code === initialCountry.toUpperCase());
        if (match) {
          countrySearch.value = match.name;
          countryHidden.value = match.code;
          phoneSel.value = match.code;
        }
      }

      const toggleVat = () => {
        const show = companyI.value.trim().length > 0;
        vatField.hidden = !show;
        if (!show) vatI.value = '';
      };
      companyI.addEventListener('input', toggleVat);
      toggleVat();

      // Changing country re-prices (currency may change). Debounced.
      let repriceTimer: number | undefined;
      const resolveCountry = () => {
        const typed = countrySearch.value.trim().toLowerCase();
        const match = COUNTRIES.find((c) => c.name.toLowerCase() === typed || c.code.toLowerCase() === typed);
        if (match) {
          countryHidden.value = match.code;
          if (!phoneSel.value) phoneSel.value = match.code;
          window.clearTimeout(repriceTimer);
          repriceTimer = window.setTimeout(async () => {
            if (match.code === status.country) return;
            const fresh = await fetchStatus(email, match.code);
            if ('currency' in fresh) {
              // Keep whatever the buyer has typed; just refresh prices.
              status = fresh;
              renderOffers(); renderPrice(); renderPlans(); renderSummary();
            }
          }, 300);
        } else {
          countryHidden.value = '';
        }
      };
      countrySearch.addEventListener('change', resolveCountry);
      countrySearch.addEventListener('blur', resolveCountry);
      countrySearch.addEventListener('input', resolveCountry);

      // ---- Checkout
      const cta = q('[data-slot="cta"]') as HTMLButtonElement;
      const errSlot = q('[data-slot="error"]') as HTMLElement;
      cta.addEventListener('click', async () => {
        errSlot.textContent = '';
        const val = (n: string) => String(root.querySelector<HTMLInputElement>(`[name="${n}"]`)?.value ?? '').trim();
        const fail = (m: string) => { errSlot.textContent = m; errSlot.scrollIntoView({ behavior: 'smooth', block: 'center' }); };
        const first = val('first_name'), last = val('last_name');
        const country = val('country'), phoneCountry = val('phone_country'), phone = val('phone');
        const company = val('company_name'), vat = val('vat_number');
        const consent = root.querySelector<HTMLInputElement>('[name="consent_terms"]')!.checked;
        if (!first || !last) return fail('Please add your first and last name.');
        if (!country) return fail('Please select your country from the list.');
        if (!phoneCountry || !phone) return fail('Please enter a phone number with country code.');
        if (vat && !company) return fail('Please add your company name to use a VAT number.');
        if (!consent) return fail('Please agree to the terms to continue.');

        // Certification path only: when should the certification open?
        const activateChoice = String(
          root.querySelector<HTMLInputElement>('[name="activate_choice"]:checked')?.value ?? 'wait',
        );

        const label = cta.innerHTML;
        cta.disabled = true; cta.innerHTML = '<span>Opening secure checkout…</span>';
        try {
          // Path selected → the shared course checkout (cc-bundle): cert at its
          // standard price + the workshop-discounted 12-week, re-derived
          // server-side. Otherwise the 12-week checkout, which re-derives the
          // workshop / ?discount= price server-side.
          const res = selectedOffer === 'path' && status.path
            ? await fetch('/api/courses/checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  product_slug: 'cc-bundle',
                  payment_plan: selectedPlan,
                  currency: status.path.currency,
                  email, first_name: first, last_name: last, country,
                  phone_country: phoneCountry, phone,
                  company_name: company || undefined, vat_number: vat || undefined,
                  activate_choice: activateChoice,
                  source_variant: 'twelveweek',
                  consent_terms: true,
                  discount_percent: urlDiscount || undefined,
                }),
              })
            : await fetch('/api/courses/twelve-week-checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  email, first_name: first, last_name: last, country,
                  phone_country: phoneCountry, phone,
                  company_name: company || undefined, vat_number: vat || undefined,
                  payment_plan: selectedPlan, consent_terms: true,
                  discount_percent: urlDiscount || undefined,
                }),
              });
          let body: { checkout_url?: string; error?: string } = {};
          try { body = await res.json(); } catch {}
          if (!res.ok || !body.checkout_url) {
            fail(body.error || `Could not start checkout (HTTP ${res.status}). Please try again.`);
            cta.disabled = false; cta.innerHTML = label;
            return;
          }
          window.location.href = body.checkout_url;
        } catch {
          fail('We could not reach the server. Please try again.');
          cta.disabled = false; cta.innerHTML = label;
        }
      });

      renderOffers();
      renderPrice();
      renderPlans();
      renderSummary();
      stage!.replaceChildren(root);
    }
  }
</script>
