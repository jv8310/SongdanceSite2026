---
import { FORGIVENESS_SESSIONS } from '../lib/courses/forgiveness';

// A small set of hero headlines. One is shown on load, picked at random in the
// browser (the site is statically built, so the rotation has to be client-side
// to actually change on reload). The first is the no-JS / first-paint default.
// Each may use <em> for the oversized lyric-italic accent word.
const headlines = [
  "Some things can't be said. They can be <em>sounded.</em>",
  'Your voice already knows <em>how.</em>',
  'Before the words, there was a <em>sound.</em>',
  'You were born making <em>sound.</em>',
];

// While the Forgiveness Course takes registrations, a small announcement sits
// above the eyebrow. The page is static, so the inline script below takes it
// away once the last session has ended.
const forgivenessUntil = FORGIVENESS_SESSIONS[FORGIVENESS_SESSIONS.length - 1].endsAtUtc;
---

<header class="sd-hero">
  <div class="sd-hero-inner">
    <div class="sd-hero-text">
      <a href="/courses/forgiveness" class="sd-hero-announce" data-forgive-until={forgivenessUntil}>
        <span class="sd-hero-announce-tag">Registrations now open</span>
        <span>The Forgiveness Course · 6–16 Dec</span>
        <i class="ph-light ph-arrow-right" aria-hidden="true"></i>
      </a>
      <div class="sd-hero-eyebrow-row" data-anim="hero-eyebrow">
        <span class="sd-hero-eyebrow-line"></span>
        <div class="sd-eyebrow">Sound as the body's language</div>
      </div>
      <h1 class="sd-hero-head" data-anim="hero-head" data-headlines={JSON.stringify(headlines)} set:html={headlines[0]}></h1>
      <p class="sd-hero-sub" data-anim="hero-sub">
        No one can make your sound for you. We hold the space —
        your own voice does the rest. This is Somatic Vocal Healing.
      </p>
      <div class="sd-hero-cta-row" data-anim="hero-cta">
        <a href="/workshop" class="sd-btn sd-btn-primary" data-sd-price="ticket">Try a workshop — 22€</a>
        <a href="/what-is-svh" class="sd-btn sd-btn-quiet">What is this? →</a>
      </div>
    </div>
    <div class="sd-hero-imagery" aria-hidden="true">
      <figure class="sd-hero-img-primary" data-anim="hero-img-primary">
        <img src="/media/library/svh-retreat-sounding-blue.webp" alt="" />
      </figure>
      <figure class="sd-hero-img-secondary" data-anim="hero-img-secondary">
        <img src="/media/library/svh-retreat-circle-sunset-group-jacob-central.webp" alt="" />
      </figure>
      <div class="sd-hero-mark-stamp" data-anim="hero-stamp">
        <img src="/brand/symbol-orange.png" alt="" />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var a = document.querySelector('.sd-hero-announce[data-forgive-until]');
    var t = a ? Date.parse(a.getAttribute('data-forgive-until') || '') : 0;
    if (a && t && Date.now() > t) a.remove();
  })();
</script>

<script is:inline>
  // Pick a random hero headline on each load. Runs inline (synchronously) so it
  // resolves before the GSAP entrance fades the headline in.
  (function () {
    var el = document.querySelector('[data-anim="hero-head"]');
    if (!el) return;
    try {
      var list = JSON.parse(el.getAttribute('data-headlines') || '[]');
      if (list.length > 1) el.innerHTML = list[Math.floor(Math.random() * list.length)];
    } catch (e) {
      /* keep the server-rendered default */
    }
  })();
</script>

<style>
  .sd-hero-announce {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-bottom: var(--sp-5);
    padding: 6px 14px 6px 6px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--paper-soft);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 13px;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .sd-hero-announce:hover { border-color: var(--ember); background: var(--paper); }
  .sd-hero-announce-tag {
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: var(--ember);
    color: var(--paper);
    font-size: 12px;
    font-weight: 500;
  }
  .sd-hero-announce i { color: var(--ember); }
</style>
