<section class="hero">
  <h1 class="hero-title" data-anim="title">Songdance 2026</h1>
  <p class="hero-subtitle" data-anim="subtitle">
    Movement, music, and motion — together at last.
  </p>
  <a class="hero-cta" data-anim="cta" href="#about">Discover the festival</a>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    text-align: center;
  }

  .hero-title {
    font-size: clamp(2.5rem, 9vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin: 0;
    background: linear-gradient(120deg, #fff 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.4rem);
    max-width: 36rem;
    margin: 1.5rem 0 2.5rem;
    opacity: 0.8;
  }

  .hero-cta {
    display: inline-block;
    padding: 0.9rem 1.8rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
  }
</style>
