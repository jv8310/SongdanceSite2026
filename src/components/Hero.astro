<header class="sd-hero">
  <div class="sd-hero-inner">
    <div class="sd-hero-text">
      <div class="sd-hero-eyebrow-row" data-anim="hero-eyebrow">
        <span class="sd-hero-eyebrow-line"></span>
        <div class="sd-eyebrow">Foundation course · begins 14 May</div>
      </div>
      <h1 class="sd-hero-head" data-anim="hero-head">
        Sound that comes from you,
        <span class="sd-hero-soft">not toward you.</span>
      </h1>
      <p class="sd-hero-sub" data-anim="hero-sub">
        A small group, your own voice, and the time it takes for something to settle.
        We meet weekly. The room is the practice.
      </p>
      <div class="sd-hero-cta-row" data-anim="hero-cta">
        <a href="#offerings" class="sd-btn sd-btn-primary">Begin the practice</a>
        <a href="#work" class="sd-btn sd-btn-quiet">What this is →</a>
      </div>
    </div>
    <div class="sd-hero-imagery" aria-hidden="true">
      <figure class="sd-hero-img-primary" data-anim="hero-img-primary">
        <img src="/imagery/sounding-blue.jpg" alt="" />
      </figure>
      <figure class="sd-hero-img-secondary" data-anim="hero-img-secondary">
        <img src="/imagery/circle-yurt-wide.jpg" alt="" />
      </figure>
      <div class="sd-hero-mark-stamp" data-anim="hero-stamp">
        <img src="/brand/symbol-orange.png" alt="" />
      </div>
    </div>
  </div>
</header>
