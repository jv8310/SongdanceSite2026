---
---

<header class="ds-hero" id="top">
  <div class="ds-hero-bg" aria-hidden="true">
    <img
      src="/imagery/dolphin-and-sound/dolphin-hero.webp"
      alt=""
      fetchpriority="high"
    />
  </div>
  <div class="ds-hero-inner ds-wrap">
    <img class="ds-hero-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
    <p class="ds-hero-eyebrow">Retreat · 1–8 November 2026 · Red Sea, Egypt</p>
    <h1 class="ds-hero-head">Voices of <em>the Deep</em></h1>
    <p class="ds-hero-sub">Welcome back to the water — your original home.</p>
    <div class="ds-hero-when">
      <span>Seven days with wild dolphins</span>
      <span class="dot"></span>
      <span>Aboard the Nooraya</span>
      <span class="dot"></span>
      <span>With Jacob</span>
    </div>
    <div class="ds-hero-cta-row">
      <a href="#register" class="ds-btn ds-btn--primary ds-btn--lg" aria-label="Register for the Dolphin &amp; Sound Retreat">
        Register now <i class="ph-light ph-arrow-right"></i>
      </a>
      <a href="#what-it-is" class="ds-btn ds-btn--ghost ds-btn--lg">What it is</a>
    </div>
  </div>
</header>
