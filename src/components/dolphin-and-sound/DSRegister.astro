---
import { COUNTRIES } from '../../lib/countries';
---

<section class="ds-register" id="register">
  <div class="ds-register-inner ds-wrap">
    <div class="ds-register-head">
      <span class="ds-eyebrow ds-eyebrow--center">Registration</span>
      <h2 class="ds-h2">Reserve your <em>place</em></h2>
      <div class="ds-register-when">
        <span>1–8 November 2026</span>
        <span class="dot"></span>
        <span>Sataya Reef, Egypt</span>
        <span class="dot"></span>
        <span>Max 17 places</span>
        <span class="dot"></span>
        <span data-places hidden></span>
      </div>
    </div>

    <form id="ds-reg-form" class="ds-card" novalidate>
      <fieldset class="ds-rooms" aria-label="Cabin">
        <legend class="ds-rooms-legend">Choose your cabin</legend>

        <label class="ds-room" data-slug="twin-lower">
          <input type="radio" name="tier_slug" value="twin-lower" checked />
          <span class="ds-room-body">
            <span class="ds-room-text">
              <span class="ds-room-name">Twin cabin – lower deck with porthole</span>
              <span class="ds-room-avail" data-avail hidden></span>
            </span>
            <span class="ds-room-price"><span data-price>€1995</span> <em data-unit>per person</em></span>
          </span>
        </label>

        <label class="ds-room" data-slug="twin-upper">
          <input type="radio" name="tier_slug" value="twin-upper" />
          <span class="ds-room-body">
            <span class="ds-room-text">
              <span class="ds-room-name">Twin cabin – upper deck with sea views</span>
              <span class="ds-room-avail" data-avail hidden></span>
            </span>
            <span class="ds-room-price"><span data-price>€2495</span> <em data-unit>per person</em></span>
          </span>
        </label>

        <label class="ds-room" data-slug="double-lower">
          <input type="radio" name="tier_slug" value="double-lower" />
          <span class="ds-room-body">
            <span class="ds-room-text">
              <span class="ds-room-name">Cabin with double bed – lower deck with porthole</span>
              <span class="ds-room-avail" data-avail hidden></span>
            </span>
            <span class="ds-room-price"><span data-price>€3990</span> <em data-unit>for two people</em></span>
          </span>
        </label>
      </fieldset>

      <p class="ds-pay-heading">How would you like to pay?</p>
      <fieldset class="ds-pay-options" aria-label="Payment option" style="border:0; padding:0; margin:0 0 8px;">
        <label class="ds-pay">
          <input type="radio" name="payment_mode" value="full" checked />
          <span class="ds-pay-body">
            <span class="ds-pay-name">Pay in full</span>
            <span class="ds-pay-price">€1995</span>
            <span class="ds-pay-note">All-in, per person.</span>
          </span>
        </label>
        <label class="ds-pay">
          <input type="radio" name="payment_mode" value="deposit" />
          <span class="ds-pay-body">
            <span class="ds-pay-name">Reserve with a deposit</span>
            <span class="ds-pay-price">€997.50</span>
            <span class="ds-pay-note">50% now · balance €997.50 before 1 Sept 2026.</span>
          </span>
        </label>
      </fieldset>

      <div class="ds-grid">
        <label class="ds-field">
          <span>First name</span>
          <input type="text" name="first_name" autocomplete="given-name" required />
        </label>
        <label class="ds-field">
          <span>Last name</span>
          <input type="text" name="last_name" autocomplete="family-name" required />
        </label>

        <label class="ds-field ds-field--full">
          <span>Email address</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>

        <label class="ds-field">
          <span>Country</span>
          <select name="country" required>
            <option value="">— select —</option>
            {COUNTRIES.map((c) => (<option value={c.code}>{c.name} {c.flag}</option>))}
          </select>
        </label>

        <div class="ds-field">
          <span>Phone number</span>
          <div class="ds-phone">
            <select name="phone_country" aria-label="Phone country code" required>
              <option value="">—</option>
              {COUNTRIES.map((c) => (<option value={c.code} data-dial={c.dial}>{c.code} +{c.dial}</option>))}
            </select>
            <input type="tel" name="phone" autocomplete="tel-national" inputmode="tel" placeholder="470 12 34 56" required />
          </div>
        </div>

        <label class="ds-field ds-field--full">
          <span>Who are you sharing the cabin with? <em class="ds-optional">(optional — name of your cabin-mate)</em></span>
          <input type="text" name="roommate_pref" placeholder="e.g. travelling with Sam Jones" />
        </label>

        <label class="ds-field ds-field--full">
          <span>Company name <em class="ds-optional">(optional — if registering as a company)</em></span>
          <input type="text" name="company_name" autocomplete="organization" />
        </label>

        <label class="ds-field ds-field--full ds-field--biz" hidden>
          <span>VAT number <em class="ds-optional">(optional)</em></span>
          <input type="text" name="vat_number" placeholder="e.g. BE0123.456.789" autocomplete="off" />
        </label>

        <label class="ds-field ds-field--full">
          <span>Dietary notes <em class="ds-optional">(allergies, vegetarian, …)</em></span>
          <input type="text" name="dietary" placeholder="e.g. vegetarian, no nuts" />
        </label>

        <label class="ds-field ds-field--full">
          <span>Anything else we should know? <em class="ds-optional">(optional)</em></span>
          <textarea name="notes" rows="3"></textarea>
        </label>
      </div>

      <div class="ds-consents">
        <label class="ds-consent">
          <input type="checkbox" name="consent_terms" required />
          <span>
            I agree to the
            <a href="/terms" target="_blank" rel="noopener">Songdance terms and conditions</a>,
            and understand that registration is final and non-refundable.
          </span>
        </label>
      </div>

      <div id="ds-reg-error" class="ds-reg-error" hidden></div>

      <div class="ds-reg-actions">
        <button type="submit" class="ds-btn ds-btn--primary ds-btn--lg ds-btn--block" id="ds-reg-submit">
          Proceed to payment <i class="ph-light ph-arrow-right"></i>
        </button>
      </div>

      <p class="ds-fine">
        Secure payment by card via Stripe. Questions? Email
        <a href="mailto:info@songdance.co">info@songdance.co</a>.
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('ds-reg-form') as HTMLFormElement | null;
  if (form) {
    const errBox = form.querySelector('#ds-reg-error') as HTMLElement;
    const submitBtn = form.querySelector('#ds-reg-submit') as HTMLButtonElement;
    const companyInput = form.querySelector('input[name="company_name"]') as HTMLInputElement;
    const bizField = form.querySelector('.ds-field--biz') as HTMLElement;
    const countrySelect = form.querySelector('select[name="country"]') as HTMLSelectElement;
    const phoneCountrySelect = form.querySelector('select[name="phone_country"]') as HTMLSelectElement;
    const placesEl = document.querySelector('[data-places]') as HTMLElement | null;
    const roomInputs = Array.from(
      form.querySelectorAll('input[name="tier_slug"]'),
    ) as HTMLInputElement[];

    type TierInfo = {
      slug: string;
      name: string;
      price_cents: number;
      deposit_cents: number;
      remaining: number;
      sold_out: boolean;
      unit_label: string;
    };
    const tiers = new Map<string, TierInfo>();
    let balanceDue = 'before 1 Sept 2026';

    const fmtEur = (cents: number) =>
      `€${(cents / 100).toFixed(2).replace(/\.00$/, '')}`;

    const selectedSlug = () =>
      (roomInputs.find((i) => i.checked)?.value ?? roomInputs[0]?.value ?? '');

    // Mirror the selected cabin's prices into the full/deposit options.
    function renderPayment() {
      const tier = tiers.get(selectedSlug());
      const fullEl = form!.querySelector('input[value="full"]')?.closest('.ds-pay');
      const depEl = form!.querySelector('input[value="deposit"]')?.closest('.ds-pay');
      if (!tier) return;
      const perLabel = tier.unit_label === 'for two people' ? 'for two people' : 'per person';
      const fullPrice = fullEl?.querySelector('.ds-pay-price');
      const fullNote = fullEl?.querySelector('.ds-pay-note');
      if (fullPrice) fullPrice.textContent = fmtEur(tier.price_cents);
      if (fullNote) fullNote.textContent = `All-in, ${perLabel}.`;
      const depPrice = depEl?.querySelector('.ds-pay-price');
      const depNote = depEl?.querySelector('.ds-pay-note');
      if (depPrice) depPrice.textContent = fmtEur(tier.deposit_cents);
      if (depNote)
        depNote.textContent = `50% now · balance ${fmtEur(tier.price_cents - tier.deposit_cents)} ${balanceDue}.`;
    }

    function ensureSelectable() {
      const current = roomInputs.find((i) => i.checked);
      if (current && !current.disabled) return;
      const firstOpen = roomInputs.find((i) => !i.disabled);
      if (firstOpen) firstOpen.checked = true;
    }

    // Live availability + authoritative prices from the server.
    fetch('/api/registrations/dolphin-checkout', { headers: { Accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((data: any) => {
        if (!data || !Array.isArray(data.tiers)) return;
        if (typeof data.balance_due === 'string') {
          balanceDue = data.balance_due.replace('1 September 2026', '1 Sept 2026');
        }
        for (const t of data.tiers as TierInfo[]) {
          tiers.set(t.slug, t);
          const label = form!.querySelector(`.ds-room[data-slug="${t.slug}"]`) as HTMLElement | null;
          if (!label) continue;
          const priceEl = label.querySelector('[data-price]');
          const unitEl = label.querySelector('[data-unit]');
          if (priceEl) priceEl.textContent = fmtEur(t.price_cents);
          if (unitEl) unitEl.textContent = t.unit_label;
          const input = label.querySelector('input') as HTMLInputElement;
          const avail = label.querySelector('[data-avail]') as HTMLElement;
          if (t.sold_out) {
            label.classList.add('is-soldout');
            input.disabled = true;
            if (avail) { avail.textContent = 'Fully booked'; avail.hidden = false; }
          } else if (t.remaining <= 4) {
            if (avail) {
              avail.textContent = t.remaining === 1 ? '1 place left' : `${t.remaining} places left`;
              avail.hidden = false;
            }
          }
        }
        ensureSelectable();
        renderPayment();

        if (placesEl && typeof data.total_remaining === 'number') {
          if (data.total_remaining <= 0) {
            placesEl.textContent = 'Fully booked — join the waiting list';
            placesEl.hidden = false;
          } else if (data.total_remaining <= 6) {
            placesEl.textContent =
              data.total_remaining === 1 ? '1 place left' : `${data.total_remaining} places left`;
            placesEl.hidden = false;
          }
        }
      })
      .catch(() => {});

    roomInputs.forEach((i) => i.addEventListener('change', renderPayment));

    // Geo prefill (Cloudflare attaches country to the request → /api/geo).
    fetch('/api/geo', { headers: { Accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((data: any) => {
        const detected = data?.country as string | undefined;
        if (!detected) return;
        const has = (sel: HTMLSelectElement, code: string) => !!sel.querySelector(`option[value="${code}"]`);
        if (countrySelect && !countrySelect.value && has(countrySelect, detected)) countrySelect.value = detected;
        if (phoneCountrySelect && !phoneCountrySelect.value && has(phoneCountrySelect, detected)) phoneCountrySelect.value = detected;
      })
      .catch(() => {});

    // VAT field appears as soon as a company name is entered, so any company
    // can optionally add a VAT number for its invoice.
    const vatInput = form.querySelector('input[name="vat_number"]') as HTMLInputElement;
    const toggleVat = () => {
      const show = companyInput.value.trim().length > 0;
      bizField.hidden = !show;
      if (!show) vatInput.value = '';
    };
    companyInput.addEventListener('input', toggleVat);
    toggleVat();

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      errBox.hidden = true;
      errBox.textContent = '';

      const fd = new FormData(form);
      const tierSlug = String(fd.get('tier_slug') ?? '').trim();
      if (!tierSlug || tiers.get(tierSlug)?.sold_out) {
        errBox.textContent = 'Please choose an available cabin.';
        errBox.hidden = false;
        return;
      }
      const required: Array<[string, string]> = [
        ['first_name', 'first name'],
        ['last_name', 'last name'],
        ['email', 'email'],
        ['country', 'country'],
        ['phone_country', 'phone country'],
        ['phone', 'phone number'],
      ];
      const missing = required
        .filter(([name]) => !String(fd.get(name) ?? '').trim())
        .map(([, label]) => label);
      const email = String(fd.get('email') ?? '').trim();
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) missing.push('valid email');
      if (fd.get('consent_terms') !== 'on') missing.push('agreement to the terms');
      if (missing.length) {
        errBox.textContent = `Please complete: ${missing.join(', ')}.`;
        errBox.hidden = false;
        return;
      }

      const data = {
        tier_slug: tierSlug,
        first_name: fd.get('first_name'),
        last_name: fd.get('last_name'),
        email,
        country: fd.get('country'),
        phone_country: fd.get('phone_country'),
        phone: fd.get('phone'),
        roommate_pref: fd.get('roommate_pref'),
        company_name: fd.get('company_name'),
        vat_number: fd.get('vat_number'),
        dietary: fd.get('dietary'),
        notes: fd.get('notes'),
        payment_mode: fd.get('payment_mode') === 'deposit' ? 'deposit' : 'full',
        consent_terms: fd.get('consent_terms') === 'on',
      };

      const original = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = 'One moment…';
      try {
        const res = await fetch('/api/registrations/dolphin-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const body: any = await res.json().catch(() => ({}));
        if (!res.ok) {
          errBox.textContent = body?.error ?? 'Something went wrong. Please try again or email us.';
          errBox.hidden = false;
          submitBtn.disabled = false;
          submitBtn.innerHTML = original;
          return;
        }
        if (body?.checkout_url) {
          window.location.href = body.checkout_url;
          return;
        }
        errBox.textContent = 'We could not start checkout. Please try again or email us.';
        errBox.hidden = false;
        submitBtn.disabled = false;
        submitBtn.innerHTML = original;
      } catch {
        errBox.textContent = 'Network error. Please try again or email us.';
        errBox.hidden = false;
        submitBtn.disabled = false;
        submitBtn.innerHTML = original;
      }
    });
  }
</script>
