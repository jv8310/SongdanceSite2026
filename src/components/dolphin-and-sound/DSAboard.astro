---
const shots = [
  { src: '/media/library/dolphin-guests-on-beach-at-sunset.webp', alt: 'The group in a circle on a sandbank at sunset', span: 'wide' },
  { src: '/media/library/dolphin-guests-gathered-on-covered-deck.webp', alt: 'An evening gathering on the covered deck' },
  { src: '/media/library/dolphin-group-on-zodiac-at-sea.webp', alt: 'Heading out to the dolphins on the zodiac' },
  { src: '/media/library/dolphin-boat-lounge-interior.webp', alt: 'The traditional Egyptian salon aboard the Nooraya' },
  { src: '/media/library/dolphin-food2.webp', alt: 'Meals prepared fresh on board' },
  { src: '/media/library/dolphin-liveaboard-boat-anchored-by-sandbank.jpg', alt: 'The Nooraya anchored off a sandbank at dusk', span: 'wide' },
];
---

<section class="ds-section ds-section--sand2" id="aboard">
  <div class="ds-wrap">
    <div class="ds-practical-head">
      <span class="ds-eyebrow ds-eyebrow--center">Life aboard</span>
      <h2 class="ds-h2">Long days on <em>the water</em></h2>
    </div>

    <div class="ds-gallery">
      {shots.map((s) => (
        <figure class:list={['ds-gallery-item', s.span === 'wide' && 'ds-gallery-item--wide']}>
          <img src={s.src} alt={s.alt} loading="lazy" />
        </figure>
      ))}
    </div>
  </div>
</section>
