---
// Cinematic opening. A full-bleed candle-lit frame (a woman sounding, light
// glowing from her throat) with a masked, line-by-line title reveal and a slow
// recede on scroll — the "held breath" before the story begins.
const heroImg = '/media/library/svhgpt-01-hero-in-one-breath.webp';
---

<div class="wp-progress" aria-hidden="true"><span></span></div>

<section class="wp-hero">
  <div class="wp-hero-bg" style={`background-image:url('${heroImg}')`}></div>

  <div class="wp-hero-inner">
    <p class="wp-hero-eyebrow">Somatic Vocal Healing · A live workshop</p>
    <h1 class="wp-hero-title">
      <span class="wp-line"><span class="wp-line-inner">The body has</span></span>
      <span class="wp-line"><span class="wp-line-inner">its own</span></span>
      <span class="wp-line"><span class="wp-line-inner"><em>voice.</em></span></span>
    </h1>
    <p class="wp-hero-sub">
      One hour, live — where sound becomes the language of everything
      in you that words never reached.
    </p>
  </div>

  <a class="wp-hero-cue" href="#wp-thread" aria-label="Scroll to begin">
    <span>Begin</span>
    <i class="ph-light ph-arrow-down"></i>
  </a>
</section>
