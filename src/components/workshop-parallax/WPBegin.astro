---
// The threshold, just before the calendar. A single candle in the dark, a
// last quiet invitation, then a tap straight into the register section.
const candleImg = '/media/library/svhgpt-09-closing-candle.webp';
---

<section class="wp-begin" data-parallax-scope>
  <div
    class="wp-begin-bg"
    data-parallax="0.12"
    style={`background-image:url('${candleImg}')`}
  ></div>

  <div class="wp-begin-inner">
    <div class="wp-eyebrow">One hour · Live · Online</div>
    <h2>Come and discover what your voice <em>has been carrying.</em></h2>
    <p>
      No skill, no preparation, nothing to prove. You just open your mouth —
      and see what happens.
    </p>
    <a class="wp-begin-cta" href="#register">
      See the next date <i class="ph-light ph-arrow-right"></i>
    </a>
  </div>
</section>
