---
const shopUrl =
  'https://songdeck.shop/products/songdeck-authentic-singing-36-song-cards-with-accompanying-app';
const boxBackImg =
  'https://songdeck.shop/cdn/shop/files/Back_Authentic_Singing_SongDance_Box.png?v=1727627800&width=1100';
---

<section class="sk-section sk-section--night" id="order">
  <div aria-hidden="true">
    <span class="sk-shape sk-shape--disc sk-shape--orange" style="width:90px;height:90px;left:-30px;bottom:12%;opacity:.85"></span>
    <span class="sk-shape sk-shape--disc sk-shape--gold" style="width:14px;height:14px;left:18%;top:16%"></span>
    <span class="sk-shape sk-shape--half sk-shape--vermilion" style="width:110px;height:55px;right:-26px;top:14%;--sk-rot:-90deg;opacity:.9"></span>
  </div>
  <div class="sk-wrap">
    <div class="sk-order-grid">
      <div>
        <p class="sk-eyebrow sk-eyebrow--on-deep">The box</p>
        <h2 class="sk-h2 sk-h2--on-deep">What's in <em>the box</em>.</h2>
        <ul class="sk-box-list">
          <li>
            <i class="ph-light ph-cards" aria-hidden="true"></i>
            <span><strong>36 song cards</strong> — illustrated, titled, with a written message each.</span>
          </li>
          <li>
            <i class="ph-light ph-qr-code" aria-hidden="true"></i>
            <span><strong>A QR code on every card</strong> — scan it and that card's song plays.</span>
          </li>
          <li>
            <i class="ph-light ph-music-notes" aria-hidden="true"></i>
            <span><strong>36 songs, mantras and soundscapes</strong> — recorded by Songdance, in the free app for iPhone and Android.</span>
          </li>
          <li>
            <i class="ph-light ph-gift" aria-hidden="true"></i>
            <span><strong>A sturdy magnetic box</strong> — made to be opened often, and easy to give.</span>
          </li>
        </ul>

        <div class="sk-price-row">
          <span class="sk-price">€44</span>
          <span class="sk-price-meta">
            Free shipping on two boxes or more —<br />the second one tends to become a gift.
          </span>
        </div>

        <div class="sk-order-cta-row">
          <a href={shopUrl} class="sk-btn sk-btn--primary sk-btn--lg">
            Order on songdeck.shop <i class="ph-light ph-arrow-up-right"></i>
          </a>
        </div>

        <p class="sk-order-small">
          We won't promise what a song will do for you — we'd rather promise too little than too much. It's a
          well-made deck and honest music. Draw a card and see. Questions, or a larger order for
          your clients or workshops? Write to
          <a href="mailto:info@songdance.co">info@songdance.co</a>.
        </p>
      </div>

      <figure class="sk-order-media">
        <img
          src={boxBackImg}
          alt="The back of the Songdeck box: 'Sing. Dance. Feel.' with the five ways to use the cards"
          loading="lazy"
        />
        <figcaption>The back of the box says it in three words: sing, dance, feel.</figcaption>
      </figure>
    </div>
  </div>
</section>
