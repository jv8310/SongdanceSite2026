---
import SiteMenu from '../SiteMenu.astro';
const shopUrl =
  'https://songdeck.shop/products/songdeck-authentic-singing-36-song-cards-with-accompanying-app';
---

<nav class="sk-nav" aria-label="Songdeck">
  <div class="sk-nav-inner sk-wrap">
    <a class="sk-nav-brand" href="https://www.songdance.co" aria-label="Songdance home">
      <img src="/brand/logo-wordmark.svg" alt="Songdance" />
      <span>Songdeck</span>
    </a>
    <div class="sk-nav-links">
      <a href="#what">What it is</a>
      <a href="#how">How it works</a>
      <a href="#listen">Listen first</a>
      <a class="sk-nav-cta" href={shopUrl}>Order the deck</a>
      <button class="sm-trigger" data-sm-trigger aria-label="Open menu" aria-expanded="false">
        <i class="ph-light ph-list"></i>
      </button>
    </div>
  </div>
</nav>
<SiteMenu />
