---
// "Why are you here?" — the three doors. A real labelled checkbox group; the
// controller reads/writes its state to the URL (?audience=…) and re-tailors
// the page. Prominent in neutral state; the page adds `is-quiet` when a
// campaign/audience is already resolved.
const options = [
  { value: '1', label: "To give voice to something I've been carrying" },
  { value: '2', label: 'To find more freedom in using my voice' },
  { value: '3', label: 'To bring somatic voice work into my own practice' },
];
---

<section class="we-selector" id="why" aria-labelledby="we-selector-head">
  <div class="we-selector-inner">
    <button type="button" class="we-selector-reopen" id="we-selector-reopen">
      Change this
    </button>
    <form class="we-selector-form" id="we-selector-form">
      <h2 class="we-selector-head" id="we-selector-head">Why are you here?</h2>
      <p class="we-selector-sub">Pick what's true — one or more. The page will adjust to fit you.</p>
      <div class="we-selector-options">
        {
          options.map((o) => (
            <label class="we-selector-opt">
              <input type="checkbox" name="door" value={o.value} />
              <span class="we-selector-box" aria-hidden="true"></span>
              <span>{o.label}</span>
            </label>
          ))
        }
      </div>
      <button type="submit" class="we-selector-submit">
        Show me <i class="ph-light ph-arrow-right"></i>
      </button>
    </form>
  </div>
</section>
