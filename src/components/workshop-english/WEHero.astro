// The personalization controller swaps #we-h1 / #we-hero-sub by lead lens.
---

<section class="we-hero">
  <div class="we-hero-bg" aria-hidden="true">
    <img src="/media/library/svh-retreat-sounding-blue.webp" alt="" />
  </div>
  <div class="we-hero-inner">
    <img class="we-hero-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
    <div class="we-hero-eyebrow">Somatic Vocal Healing Workshop</div>
    <h1 class="we-hero-head we-swap" id="we-h1">
