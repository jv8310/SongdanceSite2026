---
// Neutral copy is rendered server-side so no-JS visitors get a complete page.
// The personalization controller swaps #we-h1 / #we-hero-sub by lead lens.
---

<section class="we-hero">
  <div class="we-hero-bg" aria-hidden="true">
    <img src="/media/library/svh-retreat-sounding-blue.webp" alt="" />
  </div>
  <div class="we-hero-inner">
    <img class="we-hero-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
    <div class="we-hero-eyebrow">Somatic Vocal Healing Workshop</div>
    <h1 class="we-hero-head we-swap" id="we-h1">
      Your voice knows <em>more</em> than you think.
    </h1>
    <p class="we-hero-sub we-swap" id="we-hero-sub">
      A one-hour live workshop in <em>Somatic Vocal Healing</em> —
      for everything in you that never found a way out.
    </p>
    <a href="#register" class="we-hero-cta">
      Register for the workshop <i class="ph-light ph-arrow-right"></i>
    </a>
    <a href="#workshop" class="we-hero-link">See the next date &amp; details</a>
    <div class="we-hero-meta">
      <span>With Jacob Vermeulen</span>
      <span class="dot"></span>
      <span>Live on Zoom</span>
      <span class="dot"></span>
      <span>1 hour</span>
      <span class="dot"></span>
      <span>9€</span>
    </div>
  </div>
</section>

<script is:inline>
  // Subtle hero-background parallax. Moves the background slower than the page,
  // within the -60px headroom on .we-hero-bg so no edge is ever revealed. The
  // image's own "breath" scale animation lives on the inner <img> and is left
  // untouched. Disabled for reduced-motion.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var hero = document.querySelector('.we-hero');
    var bg = document.querySelector('.we-hero-bg');
    if (!hero || !bg) return;
    var ticking = false;
    function update() {
      ticking = false;
      var rect = hero.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      // 0 at top of hero, grows as we scroll past it; capped to stay in headroom.
      var shift = Math.max(-40, Math.min(40, -rect.top * 0.12));
      bg.style.transform = 'translate3d(0,' + shift.toFixed(1) + 'px,0)';
    }
    function onScroll() {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();
</script>
