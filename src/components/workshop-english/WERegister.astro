---
// The new-infrastructure registration: a calendar of upcoming dates → name /
// email / (timezone) / order-bump → POST /api/workshops/register, which starts
// Stripe Checkout (Quaderno invoicing follows via the existing webhook).
//
// Prices are fixed per currency (no FX). The country selector lets the visitor
// switch the currency; each date carries its full price map so the swap is
// instant. The posted country is authoritative — the server re-resolves the
// fixed price for it at checkout.
//
// Masterclass entries (€118) are rendered too but hidden by CSS until the page
// is in pro state (.we-register.is-pro), where they're shown and highlighted.
import type { CalItem } from './types';
import { ALL_COUNTRIES } from '../../lib/workshops/countries';
import LaunchOfferCallout from '../promo/LaunchOfferCallout.astro';
interface Props {
  items: CalItem[];
  country: string;
  currency: string;
  detectedTz: string;
  tzOptions: string[];
  // Set when arriving from an abandoned-checkout email (?resume=<token>): the
  // saved name/email and the slug of the date to pre-select. The page resolves
  // it server-side; the country/timezone defaults are already adjusted upstream.
  prefill?: { firstName: string; lastName: string; email: string; slug: string } | null;
}
const { items, country, currency, detectedTz, tzOptions, prefill = null } = Astro.props;

// A shared half-price link carries ?friend=<slug> — the date the sharer is
// attending. We star it so a friend can spot "the one they're going to", while
// every other date stays open at the same discount. Read server-side (the page
// is prerender=false) so the star is in the markup, no flash.
const friendSlug = (Astro.url.searchParams.get('friend') ?? '').trim();

// The full country list — the visitor can type/search any country, not just the
// markets we price for. Currency comes from countries.ts (currencyForCountry):
// anything outside our priced markets falls through to EUR.
const COUNTRIES = ALL_COUNTRIES;
const detected = COUNTRIES.find((c) => c.code === country);
const selectedCode = detected?.code ?? '';
const selectedName = detected?.name ?? '';

// Every workshop date is the same ticket price, so state it once above the list
// rather than on each row. The pro-only masterclass entries are priced
// differently, so they keep their own per-row price (re-shown by CSS).
const leadTicket = items.find((it) => it.kind !== 'masterclass');
---

<section class="we-register" id="register">
  <div class="we-register-inner">
    <div class="we-eyebrow">Come to the next workshop</div>
    <h2 class="we-register-h2">
      What in you is waiting<br /><em>to be heard?</em>
    </h2>
    <p class="we-register-body we-swap" id="we-reg-body">
      Come. One hour. Live.<br />
      You don't need any skill, any preparation, anything to prove.<br />
      You just open your mouth<br />
      and see what happens.
    </p>
    <p class="we-register-note">Live on Zoom · No experience needed · Replay included</p>
    <p class="we-discount-note" id="we-discount-note" hidden></p>

    <LaunchOfferCallout scope="your seat" note="Applied automatically at checkout — no code needed." />

    <div class="we-booking">
      {items.length === 0 && (
        <p class="we-cal-empty">
          No dates are open just now. Email
          <a href="mailto:info@songdance.co"> info@songdance.co</a> and we'll
          tell you the moment the next one is scheduled.
        </p>
      )}

      {items.length > 0 && (
        <div class="we-booking-head">
          <p class="we-booking-label">Choose a date</p>
          <label class="we-tz-head">
            <span>Times shown in</span>
            <select id="we-tz-select" aria-label="Your timezone">
              {tzOptions.map((tz) => (
                <option value={tz} selected={tz === detectedTz}>{tz.replace(/_/g, ' ')}</option>
              ))}
            </select>
          </label>
        </div>
      )}

      {leadTicket && (
        <p class="we-price-lead">
          <span
            class="we-price-lead-amount"
            id="we-price-lead"
            data-prices={JSON.stringify(leadTicket.pricesByCurrency)}
            data-price-minor={String(leadTicket.priceMinor)}
          >{leadTicket.priceLabel}</span>
          <span class="we-price-lead-unit">per ticket · replay included</span>
        </p>
      )}

      {items.length > 0 && (
        <div class={`we-cal${leadTicket ? ' we-cal--lead-priced' : ''}`} role="radiogroup" aria-label="Choose a date">
          {items.map((it) => (
            <label class={`we-cal-item${it.kind === 'masterclass' ? ' we-cal-item--masterclass' : ''}${it.slug === friendSlug ? ' we-cal-item--friend' : ''}`}>
              <input
                type="radio"
                name="we-date"
                value={it.slug}
                checked={!!prefill && prefill.slug === it.slug}
                data-slug={it.slug}
                data-kind={it.kind}
                data-price-minor={String(it.priceMinor)}
                data-currency={it.currency}
                data-prices={JSON.stringify(it.pricesByCurrency)}
                data-has-bump={it.hasBump ? '1' : '0'}
                data-bump-name={it.bumpName}
                data-bump-minor={String(it.bumpMinor)}
                data-bump-prices={JSON.stringify(it.bumpPricesByCurrency)}
                data-bump-compare-prices={JSON.stringify(it.bumpComparePricesByCurrency)}
                data-starts-at={it.startsAtUtc ?? ''}
                data-is-replay={it.isReplay ? '1' : '0'}
              />
              <span class="we-cal-radio" aria-hidden="true"></span>
              <span class="we-cal-main">
                {it.slug === friendSlug && (
                  <span class="we-cal-friend"><span class="we-cal-friend-star" aria-hidden="true">★</span> Your friend is going to this one</span>
                )}
                {it.kind === 'masterclass' && <span class="we-cal-kind">Masterclass</span>}
                <span class="we-cal-when">
                  {it.isReplay ? 'Watch anytime' : it.whenLocal}
                  {!it.isReplay && <span class="we-cal-tz"> · your time</span>}
                </span>
                <span class="we-cal-meta">
                  {`${it.durationMin} min`}
                  {it.kind === 'masterclass' && (
                    <span> · <span class="we-cal-audience">for practitioners</span></span>
                  )}
                </span>
              </span>
              <span class="we-cal-price">{it.priceLabel}</span>
            </label>
          ))}
        </div>
      )}

      {items.length > 0 && (
        <form class="we-form" id="we-form" hidden>
          <input type="hidden" name="workshop_slug" id="we-slug" value="" />
          <input type="hidden" name="country" id="we-country" value={selectedCode} />
          <input type="hidden" name="discount" id="we-discount" value="" />
          <input type="hidden" name="adiscount" id="we-adiscount" value="" />
          <input type="hidden" name="meta_event_id" id="we-event-id" value="" />

          <div class="we-field-row">
            <label class="we-field">
              <span>First name</span>
              <input type="text" name="first_name" required autocomplete="given-name" value={prefill?.firstName ?? ''} />
            </label>
            <label class="we-field">
              <span>Last name</span>
              <input type="text" name="last_name" required autocomplete="family-name" value={prefill?.lastName ?? ''} />
            </label>
          </div>

          <label class="we-field">
            <span>Email</span>
            <input type="email" name="email" required autocomplete="email" value={prefill?.email ?? ''} />
          </label>

          <label class="we-field">
            <span>Country</span>
            <input
              type="text"
              id="we-country-input"
              list="we-country-list"
              autocomplete="country-name"
              placeholder="Start typing your country…"
              value={selectedName}
            />
            <datalist id="we-country-list">
              {COUNTRIES.map((c) => (
                <option value={c.name} data-code={c.code} data-currency={c.currency}></option>
              ))}
            </datalist>
          </label>

          <div class="we-biz" id="we-biz" hidden>
            <label class="we-field">
              <span>Company <em>(optional)</em></span>
              <input type="text" name="company_name" autocomplete="organization" />
            </label>
            <label class="we-field" id="we-vat" hidden>
              <span>VAT number <em>(optional — EU businesses)</em></span>
              <input type="text" name="vat_number" autocomplete="off" />
            </label>
          </div>

          <div class="we-bump" id="we-bump" hidden>
            <label class="we-bump-card">
              <span class="we-bump-badge">One-time offer</span>
              <span class="we-bump-row">
                <input type="checkbox" name="bump" id="we-bump-input" />
                <span class="we-bump-checkbox" aria-hidden="true"></span>
                <span class="we-bump-title" id="we-bump-title">Yes — add the journey</span>
              </span>
              <span class="we-bump-media">
                <img src="/media/library/collage-mantrapakket-klein.webp" alt="" loading="lazy" />
                <span class="we-bump-info">
                  <span class="we-bump-points">
                    <span class="we-bump-point"><strong>40 guided singing journeys</strong></span>
                    <span class="we-bump-point">Original music &amp; mantras by Jacob</span>
                    <span class="we-bump-point">Stream anytime — yours to keep</span>
                  </span>
                </span>
              </span>
              <span class="we-bump-blurb">
                These are the giving direction — music made for you, the tea and
                the blanket after the hour's questions. Somewhere to keep
                practising, long after the workshop.
              </span>
              <span class="we-bump-foot">
                <span class="we-bump-prices">
                  <span class="we-bump-was" id="we-bump-was" hidden></span>
                  <span class="we-bump-now" id="we-bump-now"></span>
                </span>
                <span class="we-bump-save" id="we-bump-save" hidden></span>
              </span>
            </label>
          </div>

          <div class="we-summary">
            <div class="we-summary-line" id="we-line-workshop">
              <span id="we-line-workshop-label">Live workshop</span>
              <span id="we-line-workshop-amount"></span>
            </div>
            <div class="we-summary-line" id="we-line-bump" hidden>
              <span id="we-line-bump-label">Authentic Singing Journey</span>
              <span id="we-line-bump-amount"></span>
            </div>
            <div class="we-total">
              <span id="we-total-label">Total</span>
              <strong id="we-total-amount"></strong>
            </div>
          </div>

          <button type="submit" class="we-submit" id="we-submit">Register &amp; pay →</button>
          <p class="we-err" id="we-err" hidden></p>
          <p class="we-fine" id="we-fine">Secure checkout via Stripe. The Zoom link and a calendar invite arrive by email right after. Something comes up? There's a replay, and you can move to another date for free.</p>
        </form>
      )}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById('we-form');
    var group = document.querySelector('.we-register .we-cal');
    if (!form || !group) return;

    var slugField = document.getElementById('we-slug');
    var countryField = document.getElementById('we-country');
    var countryInput = document.getElementById('we-country-input');
    var countryList = document.getElementById('we-country-list');
    var tzSelect = document.getElementById('we-tz-select');
    var bumpRow = document.getElementById('we-bump');
    var bumpInput = document.getElementById('we-bump-input');
    var bumpTitle = document.getElementById('we-bump-title');
    var bumpWasEl = document.getElementById('we-bump-was');
    var bumpNowEl = document.getElementById('we-bump-now');
    var bumpSaveEl = document.getElementById('we-bump-save');
    var workshopLineLabel = document.getElementById('we-line-workshop-label');
    var workshopLineAmount = document.getElementById('we-line-workshop-amount');
    var bumpLine = document.getElementById('we-line-bump');
    var bumpLineLabel = document.getElementById('we-line-bump-label');
    var bumpLineAmount = document.getElementById('we-line-bump-amount');
    var bizField = document.getElementById('we-biz');
    var vatField = document.getElementById('we-vat');
    var companyInput = form.querySelector('input[name="company_name"]');
    var vatInput = form.querySelector('input[name="vat_number"]');

    // VAT appears only on the masterclass (the only kind with a company field),
    // as soon as a company name is entered.
    function toggleVat() {
      var isMasterclass = !!(current && current.kind === 'masterclass');
      var hasCompany = !!(companyInput && companyInput.value.trim().length > 0);
      var show = isMasterclass && hasCompany;
      if (vatField) vatField.hidden = !show;
      if (!show && vatInput) vatInput.value = '';
    }
    if (companyInput) companyInput.addEventListener('input', toggleVat);
    var totalAmount = document.getElementById('we-total-amount');
    var submitBtn = document.getElementById('we-submit');
    var err = document.getElementById('we-err');
    var idField = document.getElementById('we-event-id');

    var SYMBOLS = { EUR: '€', USD: '$', CAD: 'CA$', GBP: '£', CHF: 'CHF ', NOK: 'kr ', SEK: 'kr ', DKK: 'kr ', AUD: 'A$', NZD: 'NZ$' };
    function money(minor, cur) {
      var major = minor / 100;
      var body = Number.isInteger(major) ? String(major) : major.toFixed(2);
      var sym = SYMBOLS[cur];
      return sym ? sym + body : body + ' ' + cur;
    }
    function parse(json) { try { return JSON.parse(json || '{}'); } catch (e) { return {}; } }

    // Render a price with the live promo applied: the struck full price next to
    // the discounted figure (matching the summary line), or just the price when
    // no discount is active.
    function priceHtml(fullMinor, cur) {
      var disc = ticketAfterDiscount(fullMinor);
      return (discountPct && disc !== fullMinor)
        ? '<span class="we-line-was">' + money(fullMinor, cur) + '</span> ' + money(disc, cur)
        : money(fullMinor, cur);
    }
    // Repaint every visible price for `cur`: the per-row chips and the stated-
    // once lead, each carrying the promo strike.
    function renderPrices(cur) {
      for (var i = 0; i < radios.length; i++) {
        var r = radios[i];
        var minor = priceFor(parse(r.dataset.prices), cur, parseInt(r.dataset.priceMinor, 10) || 0);
        var priceEl = r.closest('.we-cal-item').querySelector('.we-cal-price');
        if (priceEl) priceEl.innerHTML = priceHtml(minor, cur);
      }
      var lead = document.getElementById('we-price-lead');
      if (lead) {
        var lm = priceFor(parse(lead.dataset.prices), cur, parseInt(lead.dataset.priceMinor, 10) || 0);
        lead.innerHTML = priceHtml(lm, cur);
      }
    }

    var activeTz = (tzSelect && tzSelect.value) || 'Europe/Brussels';

    // Format a UTC instant in the active timezone, mirroring lib/workshops/time.ts.
    // `withTime` true → "Sun 15 Jun 2026, 20:00 CEST"; false → "Sun 15 Jun 2026".
    function formatInTz(utcIso, tz, withTime) {
      if (!utcIso) return '';
      var opts = { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' };
      if (withTime) { opts.hour = '2-digit'; opts.minute = '2-digit'; opts.timeZoneName = 'short'; }
      try {
        opts.timeZone = tz;
        return new Intl.DateTimeFormat('en-GB', opts).format(new Date(utcIso));
      } catch (e) {
        opts.timeZone = 'UTC';
        return new Intl.DateTimeFormat('en-GB', opts).format(new Date(utcIso));
      }
    }

    // Re-render the displayed start time on every date when the visitor switches
    // timezone, and refresh the selected workshop's summary line label.
    function applyTimezone(tz) {
      activeTz = tz;
      for (var i = 0; i < radios.length; i++) {
        var r = radios[i];
        if (r.dataset.isReplay === '1' || !r.dataset.startsAt) continue;
        var whenEl = r.closest('.we-cal-item').querySelector('.we-cal-when');
        if (!whenEl) continue;
        whenEl.innerHTML = formatInTz(r.dataset.startsAt, tz, true) +
          '<span class="we-cal-tz"> · your time</span>';
      }
      if (current) recompute();
    }

    // The visitor's chosen door-set ("audience"), read from the URL at submit
    // time. The personalization controller keeps the URL authoritative
    // (?audience=1,3; the selector form writes back to it), with ?campaign=
    // as the untouched-on-load alias. Sent so registrations can be segmented
    // by lens (3 = pro) in the database and in Drip.
    function audienceState() {
      var p = new URLSearchParams(location.search);
      var aud = p.get('audience');
      if (aud) return aud;
      var map = { healing: '1', freedom: '2', pro: '3' };
      return map[(p.get('campaign') || '').toLowerCase()] || '';
    }
    function priceFor(map, cur, fallbackMinor) {
      if (map && map[cur] != null) return map[cur];
      if (map && map['EUR'] != null) return map['EUR'];
      return fallbackMinor;
    }

    // Dedup id shared by the client Pixel + server CAPI (if a pixel is set).
    var eventId = (crypto.randomUUID && crypto.randomUUID()) ||
      (Date.now() + '-' + Math.random().toString(36).slice(2));
    if (idField) idField.value = eventId;

    var current = null;       // the selected radio's dataset
    var curCurrency = 'EUR';  // active display currency
    var radios = group.querySelectorAll('input[name="we-date"]');

    // Ticket discount from the URL: ?discount=50 (public, 50 only) or
    // ?adiscount=N (owner secret, 1–100). Ticket only — never the bump.
    var discParams = new URLSearchParams(location.search);
    var rawDiscount = (discParams.get('discount') || '').trim();
    var rawAdiscount = (discParams.get('adiscount') || '').trim();
    function clampPct(v) { var n = parseInt(v, 10); return (isFinite(n) && n >= 1 && n <= 100) ? n : 0; }
    // Launch promo (from window.__SD_PROMO__, set in the base Layout head): the
    // ticket is at least 50% off during the window — the better of the promo and
    // any ?discount=/?adiscount= link. The server re-derives the same number.
    var promoPct = (window.__SD_PROMO__ && window.__SD_PROMO__.active) ? (window.__SD_PROMO__.percent || 0) : 0;
    var discountPct = Math.max(clampPct(rawAdiscount) || (clampPct(rawDiscount) === 50 ? 50 : 0), promoPct);
    var discField = document.getElementById('we-discount');
    var adiscField = document.getElementById('we-adiscount');
    if (discField) discField.value = rawDiscount;
    if (adiscField) adiscField.value = rawAdiscount;
    if (discountPct) {
      // The launch-offer callout already states the promo + "applied at checkout",
      // so skip this note when the promo is what's driving the discount — only show
      // it for a larger, non-promo URL discount (?adiscount=N).
      var promoDriven = promoPct > 0 && discountPct === promoPct;
      var note = document.getElementById('we-discount-note');
      if (note && !promoDriven) { note.textContent = discountPct + '% off your ticket — applied at checkout.'; note.hidden = false; }
    }
    function ticketAfterDiscount(minor) { return discountPct ? Math.round(minor * (100 - discountPct) / 100) : minor; }

    // Seed the active currency from the first radio (server-rendered for the
    // detected country), so a no-change submit stays consistent.
    if (radios.length) curCurrency = radios[0].dataset.currency || 'EUR';

    // Paint the promo onto the server-rendered prices on load (the chips render
    // full price server-side; the discount only otherwise appeared once a date
    // was picked).
    renderPrices(curCurrency);

    function applyCurrency(cur, countryCode) {
      curCurrency = cur;
      if (countryField) countryField.value = countryCode;
      for (var i = 0; i < radios.length; i++) {
        var r = radios[i];
        var minor = priceFor(parse(r.dataset.prices), cur, parseInt(r.dataset.priceMinor, 10) || 0);
        r.dataset.priceMinor = String(minor);
        r.dataset.currency = cur;
        if (r.dataset.hasBump === '1') {
          var bMinor = priceFor(parse(r.dataset.bumpPrices), cur, parseInt(r.dataset.bumpMinor, 10) || 0);
          r.dataset.bumpMinor = String(bMinor);
        }
      }
      renderPrices(cur);
      if (current) { current = group.querySelector('input[name="we-date"]:checked').dataset; refreshBump(); recompute(); }
      toggleVat();
    }

    // Resolve a typed/picked country name to its option (code + currency).
    function findCountryOption(name) {
      if (!countryList || !name) return null;
      var wanted = name.trim().toLowerCase();
      var opts = countryList.options;
      for (var i = 0; i < opts.length; i++) {
        if ((opts[i].value || '').toLowerCase() === wanted) return opts[i];
      }
      return null;
    }
    function onCountryChange() {
      var opt = findCountryOption(countryInput && countryInput.value);
      if (opt) {
        // Known country → its currency (countries.ts already maps the long tail
        // to EUR), and store the ISO code for the server.
        applyCurrency(opt.getAttribute('data-currency') || 'EUR', opt.getAttribute('data-code') || '');
      } else {
        // Unrecognised entry → charge in EUR, no country code yet.
        applyCurrency('EUR', '');
      }
    }
    if (countryInput) {
      countryInput.addEventListener('change', onCountryChange);
      countryInput.addEventListener('input', onCountryChange);
    }

    if (tzSelect) {
      tzSelect.addEventListener('change', function () { applyTimezone(tzSelect.value); });
    }

    function refreshBump() {
      if (current && current.hasBump === '1') {
        bumpRow.hidden = false;
        var bName = current.bumpName || 'Authentic Singing Journey';
        if (bumpTitle) bumpTitle.textContent = 'Yes — add the ' + bName;
        if (bumpLineLabel) bumpLineLabel.textContent = bName;
        var offer = parseInt(current.bumpMinor, 10) || 0;
        if (bumpNowEl) bumpNowEl.textContent = money(offer, curCurrency);
        // Struck "regular price" + saving — shown only when we have an anchor
        // above the offer for this currency. The charged amount is `offer`.
        var compare = parse(current.bumpComparePrices)[curCurrency];
        if (bumpWasEl && bumpSaveEl) {
          if (compare && compare > offer) {
            bumpWasEl.textContent = money(compare, curCurrency);
            bumpWasEl.hidden = false;
            bumpSaveEl.textContent = 'Save ' + Math.round((1 - offer / compare) * 100) + '%';
            bumpSaveEl.hidden = false;
          } else {
            bumpWasEl.hidden = true;
            bumpSaveEl.hidden = true;
          }
        }
      } else {
        bumpRow.hidden = true;
        bumpInput.checked = false;
      }
    }

    // Build the workshop line label: "Live workshop on Sun 15 Jun 2026" (in the
    // active timezone), "Masterclass on …", or a plain replay label.
    function workshopLineText() {
      var noun = current.kind === 'masterclass' ? 'Masterclass' : 'Live workshop';
      if (current.isReplay === '1' || !current.startsAt) {
        return current.kind === 'masterclass' ? 'Masterclass replay' : 'Workshop replay';
      }
      return noun + ' on ' + formatInTz(current.startsAt, activeTz, false);
    }

    function recompute() {
      if (!current) return;
      var fullPriceMinor = parseInt(current.priceMinor, 10) || 0;
      var priceMinor = ticketAfterDiscount(fullPriceMinor);
      var cur = current.currency || curCurrency;
      var hasBump = current.hasBump === '1';
      var wantsBump = hasBump && bumpInput.checked;
      var bumpMinor = wantsBump ? (parseInt(current.bumpMinor, 10) || 0) : 0;
      var total = priceMinor + bumpMinor;

      // Workshop line (struck full price shown when a discount is active).
      if (workshopLineLabel) workshopLineLabel.textContent = workshopLineText();
      if (workshopLineAmount) {
        workshopLineAmount.innerHTML = discountPct
          ? '<span class="we-line-was">' + money(fullPriceMinor, cur) + '</span> ' + money(priceMinor, cur)
          : money(priceMinor, cur);
      }

      // Bump line — a second line item, shown only when the journey is added.
      if (bumpLine) bumpLine.hidden = !wantsBump;
      if (wantsBump && bumpLineAmount) bumpLineAmount.textContent = money(bumpMinor, cur);

      totalAmount.textContent = money(total, cur);
      submitBtn.textContent = 'Register & pay ' + money(total, cur) + ' →';
    }

    function selectItem(input) {
      current = input.dataset;
      slugField.value = current.slug;
      // Company / VAT only for the masterclass (B2B — practitioners invoicing).
      if (bizField) bizField.hidden = current.kind !== 'masterclass';
      toggleVat();
      bumpInput.checked = false;
      refreshBump();
      if (form.hidden) {
        form.hidden = false;
        // next frame so the transition runs
        requestAnimationFrame(function () { form.classList.add('is-revealed'); });
      }
      recompute();
    }

    group.addEventListener('change', function (e) {
      var t = e.target;
      if (t && t.name === 'we-date') selectItem(t);
    });
    if (bumpInput) bumpInput.addEventListener('change', recompute);

    // Resume link (?resume=…): the matching date was pre-checked server-side, but
    // a server-rendered `checked` fires no change event — so reveal the form and
    // wire up the summary for it on load. The name/email/country/timezone are
    // already filled in by the server.
    var preChecked = group.querySelector('input[name="we-date"]:checked');
    if (preChecked) selectItem(preChecked);

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!current) return;
      if (err) { err.hidden = true; err.textContent = ''; }
      submitBtn.disabled = true;
      var fd = new FormData(form);
      var isMasterclass = current.kind === 'masterclass';
      var fullName = ((fd.get('first_name') || '') + ' ' + (fd.get('last_name') || '')).trim();
      var body = {
        workshop_slug: fd.get('workshop_slug'),
        name: fullName,
        first_name: fd.get('first_name') || '',
        last_name: fd.get('last_name') || '',
        email: fd.get('email'),
        timezone: current.isReplay === '1' ? '' : ((tzSelect && tzSelect.value) || ''),
        country: countryField ? (countryField.value || '') : '',
        bump: fd.get('bump') === 'on',
        company_name: isMasterclass ? (fd.get('company_name') || '') : '',
        vat_number: isMasterclass ? (fd.get('vat_number') || '') : '',
        discount: fd.get('discount') || '',
        adiscount: fd.get('adiscount') || '',
        meta_event_id: fd.get('meta_event_id') || '',
        audience: audienceState(),
      };
      try {
        var res = await fetch('/api/workshops/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        var data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Something went wrong.');
        window.location.href = data.checkout_url || data.redirect_url;
      } catch (e2) {
        if (err) { err.hidden = false; err.textContent = e2.message || 'Something went wrong.'; }
        submitBtn.disabled = false;
      }
    });
  })();
</script>
