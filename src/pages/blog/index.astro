---
import SiteLayout from '../../components/SiteLayout.astro';
import { blogPostsByDate } from '../../data/blog';

const posts = blogPostsByDate;
---

<SiteLayout
  title="Journal — Songdance"
  description="Stories from the practice — how the work began, and where it keeps leading. Notes from Jacob and the Songdance community."
  image="/media/library/jacob-upala-speaker.webp"
  imageAlt="Jacob and Upala together at golden hour."
>
  <header class="sd-pagehero sd-pagehero--compact">
    <div class="sd-pagehero-inner">
      <div class="sd-eyebrow">Journal</div>
      <h1 class="sd-pagehero-title">Stories from the practice.</h1>
      <p class="sd-pagehero-lede">
        How the work began, and where it keeps leading — a few honest notes.
      </p>
    </div>
  </header>

  <section class="bl">
    <div class="bl-list">
      {
        posts.map((post) => (
          <article class="bl-card">
            <a class="bl-card-media" href={post.href} aria-label={post.title}>
              <img src={post.hero} alt={post.heroAlt} loading="lazy" />
            </a>
            <div class="bl-card-body">
              <p class="bl-card-meta">
                <time datetime={post.date}>{post.dateLabel}</time>
                <span class="bl-dot" aria-hidden="true" />
                {post.readingMinutes} min read
              </p>
              <h2 class="bl-card-title">
                <a href={post.href}>{post.title}</a>
              </h2>
              <p class="bl-card-excerpt">{post.excerpt}</p>
              <a class="bl-card-link" href={post.href}>
                Read the story <i class="ph-light ph-arrow-right" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .bl {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: var(--sp-8) var(--sp-6) var(--sp-9);
  }
  .bl-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-7);
  }

  .bl-card {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--sp-6);
    align-items: center;
  }
  .bl-card-media {
    display: block;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .bl-card-media img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    filter: var(--sd-img-filter);
    transition: transform var(--d-slow) var(--ease);
  }
  .bl-card-media:hover img {
    transform: scale(1.03);
  }

  .bl-card-meta {
    font-family: var(--font-body);
    font-size: var(--t-caption);
    letter-spacing: 0.04em;
    color: var(--ink-quiet);
    margin: 0 0 var(--sp-3);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .bl-card-meta .bl-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--ink-whisper);
  }
  .bl-card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--t-h3);
    line-height: var(--lh-snug);
    color: var(--ink);
    margin: 0 0 var(--sp-3);
    text-wrap: balance;
  }
  .bl-card-title a {
    color: inherit;
    text-decoration: none;
  }
  .bl-card-title a:hover {
    color: var(--ember-deep);
  }
  .bl-card-excerpt {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--ink-soft);
    margin: 0 0 var(--sp-4);
    text-wrap: pretty;
  }
  .bl-card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--ember-deep);
    text-decoration: none;
  }
  .bl-card-link i {
    font-size: 16px;
    transition: transform var(--d-base) var(--ease);
  }
  .bl-card-link:hover i {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .bl {
      padding: var(--sp-7) var(--sp-5) var(--sp-8);
    }
    .bl-card {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }
  }
</style>
