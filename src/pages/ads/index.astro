---
import { hasAdsAccess } from '../../lib/ads/auth';
import { computeAdsDashboard } from '../../lib/ads/dashboard';
import {
  PERIOD_PRESETS,
  resolvePeriod,
  presetRangesMap,
  shiftDays,
  shiftYears,
  daysBetween,
} from '../../lib/workshops/periods';

export const prerender = false;

const env = Astro.locals.runtime.env;
if (!(await hasAdsAccess(env, Astro.request))) {
  const next = Astro.url.pathname + Astro.url.search;
  return Astro.redirect('/ads/login?next=' + encodeURIComponent(next));
}

const { preset, from, to } = resolvePeriod(Astro.url.searchParams);

// Compare window (needs a bounded current window), mirroring the admin stats page.
const rawCompare = Astro.url.searchParams.get('compare');
const compare =
  (rawCompare === 'prev' || rawCompare === 'yoy') && from && to ? rawCompare : null;
let cmpFrom: string | null = null;
let cmpTo: string | null = null;
if (compare === 'prev' && from && to) {
  const len = daysBetween(from, to) + 1;
  cmpTo = shiftDays(from, -1);
  cmpFrom = shiftDays(from, -len);
} else if (compare === 'yoy' && from && to) {
  cmpFrom = shiftYears(from, -1);
  cmpTo = shiftYears(to, -1);
}

const d = await computeAdsDashboard(env.DB, { from, to });
const cmp = compare && cmpFrom && cmpTo
  ? await computeAdsDashboard(env.DB, { from: cmpFrom, to: cmpTo })
  : null;

// ---- formatters ----
const eur = (minor: number) =>
  '€' + (minor / 100).toLocaleString('en-IE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const eur0 = (minor: number) =>
  '€' + Math.round(minor / 100).toLocaleString('en-IE');
const pct = (v: number | null) => (v != null ? v.toFixed(1) + '%' : '—');
const int = (v: number) => v.toLocaleString('en-IE');
const roasStr = (v: number | null) => (v != null ? v.toFixed(2) + '×' : '—');
const dateLabel = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Brussels',
  }).format(new Date(iso));
const shortTitle = (t: string) => t.replace(/Somatic Vocal Healing/gi, 'SVH');

// ---- deltas (only when comparing) ----
type Delta = { arrow: string; text: string; tone: 'good' | 'bad' | 'flat' } | null;
function delta(cur: number | null, prev: number | null | undefined, goodWhenDown = false): Delta {
  if (!cmp || cur == null || prev == null) return null;
  if (prev === 0) {
    if (cur === 0) return { arrow: '', text: '±0%', tone: 'flat' };
    return { arrow: '▲', text: 'new', tone: goodWhenDown ? 'bad' : 'good' };
  }
  const p = ((cur - prev) / prev) * 100;
  const up = p > 0.5;
  const down = p < -0.5;
  const improving = goodWhenDown ? down : up;
  const worsening = goodWhenDown ? up : down;
  return {
    arrow: up ? '▲' : down ? '▼' : '–',
    text: (p > 0 ? '+' : '') + p.toFixed(1) + '%',
    tone: improving ? 'good' : worsening ? 'bad' : 'flat',
  };
}

// ---- headline KPI tiles ----
const tiles: Array<{ label: string; value: string; sub?: string; d: Delta }> = [
  {
    label: 'Ad spend',
    value: d.hasAdSpend ? eur0(d.adSpendEurMinor) : '—',
    sub: d.hasAdSpend ? undefined : 'no spend imported',
    d: delta(d.adSpendEurMinor, cmp?.adSpendEurMinor),
  },
  {
    label: 'Registrations',
    value: int(d.registrations),
    sub: 'paid + coupon',
    d: delta(d.registrations, cmp?.registrations),
  },
  {
    label: 'Cost / registration',
    value: d.costPerRegistrationEurMinor != null ? eur(Math.round(d.costPerRegistrationEurMinor)) : '—',
    sub: 'ad spend ÷ regs',
    d: delta(d.costPerRegistrationEurMinor, cmp?.costPerRegistrationEurMinor, true),
  },
  {
    label: 'Blended ROAS',
    value: roasStr(d.blendedRoas),
    sub: 'revenue ÷ spend',
    d: delta(d.blendedRoas, cmp?.blendedRoas),
  },
  {
    label: 'Attendance rate',
    value: pct(d.attendancePct),
    sub: `${int(d.attendedLive + d.replayViews)} of ${int(d.registrations)}`,
    d: delta(d.attendancePct, cmp?.attendancePct),
  },
  {
    label: 'Conversion rate',
    value: pct(d.conversionPct),
    sub: 'regs → course / cert',
    d: delta(d.conversionPct, cmp?.conversionPct),
  },
  {
    label: 'Bump take-rate',
    value: pct(d.bumpTakeRatePct),
    sub: `${int(d.workshopBumps.count)} order bumps`,
    d: delta(d.bumpTakeRatePct, cmp?.bumpTakeRatePct),
  },
];

// ---- focus products (workshop · 12-week · certification lead) ----
const focus = [
  { name: 'Workshops', count: d.workshops.ticketCount, eurMinor: d.workshops.netEurMinor, prev: cmp?.workshops.netEurMinor, unit: 'tickets' },
  { name: '12-Week Course', count: d.twelveWeek.count, eurMinor: d.twelveWeek.netEurMinor, prev: cmp?.twelveWeek.netEurMinor, unit: 'sales' },
  { name: 'Certification', count: d.certification.count, eurMinor: d.certification.netEurMinor, prev: cmp?.certification.netEurMinor, unit: 'sales' },
];

// ---- per-workshop rows: live/past first, drafts last ----
const rows = d.workshopRows.slice().sort((a, b) => {
  const ad = a.status === 'draft' ? 1 : 0;
  const bd = b.status === 'draft' ? 1 : 0;
  return ad - bd;
});
const activeRows = rows.filter((r) => r.registrations > 0 || r.totalEurMinor > 0);

// ---- revenue streams (sum to total revenue) ----
const streamSum = d.streams.reduce((s, r) => s + r.eurMinor, 0);

// ---- chart data ----
const toMajor = (m: number) => Math.round(m) / 100;
const acq = d.acquisition;
const ds = d.dailyStreams;
const anyMc = ds.some((x) => x.masterclassEurMinor > 0);
const anyTw = ds.some((x) => x.twelveWeekEurMinor > 0);
const anyCert = ds.some((x) => x.certificationEurMinor > 0);
const anyOther = ds.some((x) => x.otherCoursesEurMinor > 0);

const chartData = {
  acq: {
    labels: acq.map((x) => x.date),
    registrations: acq.map((x) => x.registrations),
    cpa: acq.map((x) => (x.cpaEurMinor == null ? null : toMajor(x.cpaEurMinor))),
    adSpend: acq.map((x) => toMajor(x.adSpendEurMinor)),
    revenue: acq.map((x) => toMajor(x.revenueEurMinor)),
  },
  streams: {
    labels: ds.map((x) => x.date),
    series: [
      { name: 'Workshops', color: 'var-s1', values: ds.map((x) => toMajor(x.workshopsEurMinor)) },
      ...(anyMc ? [{ name: 'Masterclass', color: 'var-s2', values: ds.map((x) => toMajor(x.masterclassEurMinor)) }] : []),
      ...(anyTw ? [{ name: '12-Week Course', color: 'var-s3', values: ds.map((x) => toMajor(x.twelveWeekEurMinor)) }] : []),
      ...(anyCert ? [{ name: 'Certification', color: 'var-s4', values: ds.map((x) => toMajor(x.certificationEurMinor)) }] : []),
      ...(anyOther ? [{ name: 'Other courses', color: 'var-s5', values: ds.map((x) => toMajor(x.otherCoursesEurMinor)) }] : []),
    ],
    total: ds.map((x) => toMajor(x.totalEurMinor)),
  },
};
const chartJson = JSON.stringify(chartData).replace(/</g, '\\u003c');
const presetRangesJson = JSON.stringify(presetRangesMap()).replace(/</g, '\\u003c');

const rangeLabel = from && to ? `${dateLabel(from)} → ${dateLabel(to)}` : 'all time';
const anyDaily = ds.length > 0 || acq.some((x) => x.registrations > 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>Ads dashboard — Songdance</title>
    <style>
      :root {
        --paper: #f6efe1;
        --surface: #fbf6ea;
        --card: #ffffff;
        --ink: #0b0b0b;
        --ink-2: #52514e;
        --muted: #898781;
        --line: #e3dac4;
        --hair: rgba(11, 11, 11, 0.08);
        --ember: #c9603a;
        --ember-deep: #9d3f1f;
        /* validated categorical set (worst adjacent CVD ΔE 25.0) */
        --s1: #2a78d6; /* workshops — blue */
        --s2: #eb6834; /* masterclass — orange */
        --s3: #1baf7a; /* 12-week — aqua */
        --s4: #4a3aa7; /* certification — violet */
        --s5: #008300; /* other — green */
        --good: #006300;
        --bad: #b53d3d;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--paper); color: var(--ink);
        font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: 14px; line-height: 1.5;
      }
      .wrap { max-width: 1240px; margin: 0 auto; padding: 22px 20px 80px; }
      a { color: var(--ember-deep); }

      /* header */
      .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-bottom: 16px; border-bottom: 1px solid var(--line); margin-bottom: 22px; }
      .brand { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin: 0 0 4px; }
      h1 { font-family: Georgia, serif; font-weight: 500; font-size: 1.7rem; margin: 0; }
      .top-actions { display: flex; align-items: center; gap: 10px; }
      .signout { font-size: 13px; color: var(--ink-2); text-decoration: none; border: 1px solid var(--line); border-radius: 7px; padding: 7px 12px; background: var(--surface); }
      .signout:hover { border-color: var(--ember); color: var(--ember-deep); }

      /* filter bar */
      .filters { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
      .filters label { font-size: 12px; color: var(--ink-2); display: inline-flex; flex-direction: column; gap: 3px; }
      .filters select, .filters input[type='date'] { font: inherit; font-size: 13px; padding: 7px 9px; border: 1px solid var(--line); border-radius: 7px; background: var(--card); color: var(--ink); }
      .apply { align-self: flex-end; padding: 8px 16px; font-size: 13px; font-weight: 600; cursor: pointer; border: 1px solid var(--ember-deep); border-radius: 7px; background: var(--ember); color: var(--paper); font-family: inherit; }
      .apply:hover { background: var(--ember-deep); }
      .rangenote { color: var(--ink-2); font-size: 12.5px; margin: 4px 0 22px; }
      .rangenote strong { color: var(--ink); }

      .banner { background: #fff6e6; border: 1px solid #f0d69a; color: #7a5a12; border-radius: 10px; padding: 12px 16px; font-size: 13px; margin-bottom: 22px; }
      .banner code { background: rgba(0,0,0,0.05); padding: 1px 5px; border-radius: 4px; }

      /* hero + KPI */
      .headline { display: grid; grid-template-columns: minmax(220px, 1fr) 3fr; gap: 14px; margin-bottom: 14px; }
      @media (max-width: 720px) { .headline { grid-template-columns: 1fr; } }
      .hero { background: var(--ink); color: #fff; border-radius: 14px; padding: 20px 22px; display: flex; flex-direction: column; justify-content: center; }
      .hero .lbl { font-size: 12.5px; letter-spacing: 0.04em; color: #cdbfa6; margin: 0 0 6px; }
      .hero .val { font-size: 50px; line-height: 1; font-weight: 650; letter-spacing: -0.02em; }
      .hero .sub { margin-top: 10px; font-size: 12.5px; color: #b7ab93; }
      .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
      .kpi { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 13px 15px; }
      .kpi .lbl { font-size: 12px; color: var(--muted); margin: 0 0 5px; }
      .kpi .val { font-size: 25px; font-weight: 620; letter-spacing: -0.01em; color: var(--ink); }
      .kpi .sub { font-size: 11px; color: var(--muted); margin-top: 3px; }
      .delta { display: inline-block; margin-top: 7px; font-size: 11.5px; font-weight: 600; border-radius: 6px; padding: 1px 7px; }
      .delta--good { color: var(--good); background: #e2f3e7; }
      .delta--bad { color: var(--bad); background: #f9e4e8; }
      .delta--flat { color: #6b6258; background: #efece7; }

      /* section */
      section { margin-top: 30px; }
      h2 { font-family: Georgia, serif; font-weight: 500; font-size: 1.2rem; margin: 0 0 3px; }
      .note { color: var(--ink-2); font-size: 12px; margin: 2px 0 14px; }
      .sub-muted { color: var(--muted); font-size: 11.5px; }

      /* focus cards */
      .focus { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
      .fcard { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; border-top: 3px solid var(--accent); }
      .fcard h3 { margin: 0 0 8px; font-size: 14px; font-weight: 600; }
      .fcard .big { font-size: 27px; font-weight: 640; letter-spacing: -0.01em; }
      .fcard .cnt { font-size: 12.5px; color: var(--ink-2); margin-top: 3px; }
      .secondary { margin-top: 12px; color: var(--ink-2); font-size: 12.5px; }

      /* charts */
      .chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      @media (max-width: 820px) { .chart-grid { grid-template-columns: 1fr; } }
      .chart-block { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 13px 14px 6px; margin-bottom: 16px; }
      .chart-block.span { grid-column: 1 / -1; }
      .chart-block h3 { font-size: 13px; margin: 0 0 2px; font-weight: 600; }
      .chart-block .ch-sub { font-size: 11px; color: var(--muted); margin: 0 0 6px; }
      .chart { position: relative; }
      .chart svg text { font-size: 11px; fill: var(--muted); }
      .legend { display: flex; flex-wrap: wrap; gap: 6px 14px; padding: 2px 4px 8px; font-size: 12px; color: var(--ink-2); }
      .legend-item { display: inline-flex; align-items: center; gap: 6px; }
      .legend label.legend-item { cursor: pointer; user-select: none; }
      .legend label.legend-item input { margin: 0; cursor: pointer; accent-color: var(--s1); }
      .legend-item--off { opacity: 0.4; }
      .legend i.sw { display: inline-block; width: 16px; height: 0; border-top: 3px solid; border-radius: 2px; }
      .legend i.sw--dash { border-top-style: dashed; }
      .tip { position: absolute; pointer-events: none; background: var(--ink); color: #fff; font-size: 12px; line-height: 1.5; border-radius: 8px; padding: 7px 10px; opacity: 0; transition: opacity .08s; z-index: 6; white-space: nowrap; }
      .empty { color: var(--muted); font-size: 13px; padding: 12px 0; }

      /* tables */
      .scroll { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; }
      th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--hair); font-size: 12.5px; white-space: nowrap; }
      th { color: var(--ink-2); font-weight: 600; }
      td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
      .card-tbl { background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
      .card-tbl table th { background: var(--surface); position: sticky; top: 0; }
      .perf-scroll { max-height: 62vh; overflow: auto; }
      .name a { color: var(--ink); font-weight: 600; text-decoration: none; }
      .name a:hover { text-decoration: underline; }
      .name span { display: block; font-size: 10.5px; color: var(--muted); font-weight: 400; }
      tr.total td { border-top: 2px solid rgba(11,11,11,0.2); font-weight: 600; }
      .cols-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
      @media (max-width: 820px) { .cols-2 { grid-template-columns: 1fr; } }
      .flags { margin-top: 22px; color: var(--muted); font-size: 11.5px; }
      .flags p { margin: 3px 0; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="top">
        <div>
          <p class="brand">Songdance</p>
          <h1>Ads performance</h1>
        </div>
        <div class="top-actions">
          <a class="signout" href="/api/ads/logout">Sign out</a>
        </div>
      </div>

      <form method="GET" class="filters" id="filter">
        <label>Period
          <select name="preset" id="f-preset">
            {PERIOD_PRESETS.map(([v, l]) => <option value={v} selected={preset === v}>{l}</option>)}
          </select>
        </label>
        <label>From <input type="date" name="from" id="f-from" value={from ?? ''} /></label>
        <label>To <input type="date" name="to" id="f-to" value={to ?? ''} /></label>
        <label>Compare
          <select name="compare" id="f-compare" disabled={!(from && to)}>
            <option value="">Off</option>
            <option value="prev" selected={compare === 'prev'}>Previous period</option>
            <option value="yoy" selected={compare === 'yoy'}>Same period last year</option>
          </select>
        </label>
        <button type="submit" class="apply">Apply</button>
      </form>
      <p class="rangenote">
        Showing <strong>{rangeLabel}</strong>{cmp && cmpFrom && cmpTo && <> · vs <strong>{dateLabel(cmpFrom)} → {dateLabel(cmpTo)}</strong></>}.
        {d.hasAdSpend && <> Ad spend {eur0(d.adSpendEurMinor)} ÷ {int(d.registrations)} registrations = <strong>{d.costPerRegistrationEurMinor != null ? eur(Math.round(d.costPerRegistrationEurMinor)) : '—'}</strong> per registration.</>}
        {!(from && to) && <span class="sub-muted"> Pick a bounded period to compare against the previous one.</span>}
      </p>

      {!d.hasAdSpend && (
        <div class="banner">
          No Meta ad spend has been recorded for this window, so <strong>cost&nbsp;per&nbsp;registration</strong> and <strong>ROAS</strong> show “—”.
          Pull spend from Meta (or import the CSV) on <code>/admin/workshops/stats</code> to light these up. Registrations, attendance, conversion &amp; revenue are shown regardless.
        </div>
      )}

      <div class="headline">
        <div class="hero">
          <p class="lbl">Total revenue</p>
          <div class="val">{eur0(d.totalRevenueEurMinor)}</div>
          <p class="sub">
            workshop engine + course sales{d.hasAdSpend && <> · {roasStr(d.blendedRoas)} blended ROAS</>}
            {(() => { const hd = delta(d.totalRevenueEurMinor, cmp?.totalRevenueEurMinor); return hd ? ` · ${hd.text} vs prev` : ''; })()}
          </p>
        </div>
        <div class="kpis">
          {tiles.map((t) => (
            <div class="kpi">
              <p class="lbl">{t.label}</p>
              <div class="val">{t.value}</div>
              {t.sub && <div class="sub">{t.sub}</div>}
              {t.d && <span class={`delta delta--${t.d.tone}`}>{t.d.arrow} {t.d.text}</span>}
            </div>
          ))}
        </div>
      </div>

      <section>
        <h2>Focus products</h2>
        <p class="note">Where the ads spend is pointed: the workshop, the 12-Week course, and the certification path. Revenue is net of tax where known.</p>
        <div class="focus">
          {focus.map((f, i) => {
            const fd = delta(f.eurMinor, f.prev);
            return (
              <div class="fcard" style={`--accent: var(--s${i === 0 ? 1 : i === 1 ? 3 : 4})`}>
                <h3>{f.name}</h3>
                <div class="big">{eur0(f.eurMinor)}</div>
                <div class="cnt">{int(f.count)} {f.unit}{fd ? <> · <span style={`color: var(--${fd.tone === 'good' ? 'good' : fd.tone === 'bad' ? 'bad' : 'muted'})`}>{fd.arrow} {fd.text}</span></> : null}</div>
              </div>
            );
          })}
        </div>
        <p class="secondary">
          Also in window — Masterclass: <strong>{eur0(d.masterclass.netEurMinor)}</strong> ({int(d.masterclass.count)}){d.otherCourses.count > 0 && <> · Other courses: <strong>{eur0(d.otherCourses.netEurMinor)}</strong> ({int(d.otherCourses.count)})</>}.
        </p>
      </section>

      <section>
        <h2>Acquisition &amp; efficiency</h2>
        <p class="note">Registrations the spend bought, and what each one cost. One measure per chart — never two scales on one axis.</p>
        {!anyDaily && <p class="empty">No day-level activity in this window.</p>}
        {anyDaily && (
          <>
            <div class="chart-grid">
              <div class="chart-block">
                <h3>Registrations per day</h3>
                <p class="ch-sub">Completed registrations (paid + coupon)</p>
                <div class="chart" id="ch-regs"></div>
              </div>
              <div class="chart-block">
                <h3>Cost per registration</h3>
                <p class="ch-sub">Ad spend ÷ registrations, per day{!d.hasAdSpend && ' — needs imported spend'}</p>
                <div class="chart" id="ch-cpa"></div>
              </div>
            </div>
            <div class="chart-block span">
              <h3>Ad spend vs revenue</h3>
              <p class="ch-sub">Both in euros — same axis</p>
              <div class="chart" id="ch-spend"></div>
            </div>
            <div class="chart-block span">
              <h3>Revenue by product stream</h3>
              <p class="ch-sub">Tick a series to show/hide — the scale fits what’s shown</p>
              <div class="chart" id="ch-streams"></div>
            </div>
          </>
        )}
      </section>

      <section>
        <h2>Results per workshop</h2>
        <p class="note">The funnel for every workshop: registrations → attendance → course/cert conversion, with allocated Meta cost and ROAS. Course/Cert buys are matched by email across checkouts and standalone sales, so a buyer counts toward each workshop they attended.</p>
        {activeRows.length === 0 && <p class="empty">No workshop activity in this window.</p>}
        {activeRows.length > 0 && (
          <div class="card-tbl">
            <div class="perf-scroll">
              <table>
                <thead>
                  <tr>
                    <th>Workshop</th>
                    <th class="num">Regs</th>
                    <th class="num">Live</th>
                    <th class="num">Replay</th>
                    <th class="num">No-show</th>
                    <th class="num">Attend %</th>
                    <th class="num">Bumps</th>
                    <th class="num">Course</th>
                    <th class="num">Cert</th>
                    <th class="num">Revenue</th>
                    <th class="num">Meta cost</th>
                    <th class="num">ROAS</th>
                    <th class="num">Conv %</th>
                  </tr>
                </thead>
                <tbody>
                  {activeRows.map((r) => (
                    <tr>
                      <td class="name">
                        {shortTitle(r.title)}
                        <span>{r.isReplay ? 'On-demand' : dateLabel(r.startsAtUtc)}{r.status !== 'published' ? ` · ${r.status}` : ''}</span>
                      </td>
                      <td class="num">{int(r.registrations)}</td>
                      <td class="num">{int(r.attendedLive)}</td>
                      <td class="num">{int(r.replayViews)}</td>
                      <td class="num">{int(r.noShows)}</td>
                      <td class="num">{pct(r.attendancePct)}</td>
                      <td class="num">{int(r.bumpBuys)}</td>
                      <td class="num">{int(r.courseBuys)}</td>
                      <td class="num">{int(r.certBuys)}</td>
                      <td class="num" title={`Checkout ${eur(r.engineNetEurMinor)} + attributed courses ${eur(r.attributedCourseEurMinor)}`}>{eur0(r.totalEurMinor)}</td>
                      <td class="num">{r.metaCostEurMinor != null ? eur0(r.metaCostEurMinor) : '—'}</td>
                      <td class="num">{roasStr(r.roas)}</td>
                      <td class="num">{pct(r.conversionPct)}</td>
                    </tr>
                  ))}
                  <tr class="total">
                    <td>Total</td>
                    <td class="num">{int(d.registrations)}</td>
                    <td class="num">{int(d.attendedLive)}</td>
                    <td class="num">{int(d.replayViews)}</td>
                    <td class="num">{int(d.noShows)}</td>
                    <td class="num">{pct(d.attendancePct)}</td>
                    <td class="num">{int(d.workshopBumps.count)}</td>
                    <td class="num">{int(d.courseBuyers)}</td>
                    <td class="num">{int(d.certBuyers)}</td>
                    <td class="num">{eur0(d.workshopRows.reduce((s, r) => s + r.totalEurMinor, 0))}</td>
                    <td class="num">{d.hasAdSpend ? eur0(d.workshopRows.reduce((s, r) => s + (r.metaCostEurMinor ?? 0), 0)) : '—'}</td>
                    <td class="num">—</td>
                    <td class="num">{pct(d.conversionPct)}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        )}
      </section>

      <div class="cols-2">
        <section>
          <h2>Bump offers</h2>
          <p class="note">Order bumps taken in this window — the workshop checkout bump and the 12-Week checkout bumps.</p>
          <div class="card-tbl">
            <table>
              <thead><tr><th>Offer</th><th class="num">Taken</th><th class="num">Revenue</th></tr></thead>
              <tbody>
                <tr>
                  <td>Workshop order bump{d.bumpTakeRatePct != null && <span class="sub-muted"> · {pct(d.bumpTakeRatePct)} of tickets</span>}</td>
                  <td class="num">{int(d.workshopBumps.count)}</td>
                  <td class="num">{eur0(d.workshopBumps.netEurMinor)}</td>
                </tr>
                {d.courseBumps.byLabel.map((b) => (
                  <tr>
                    <td>12-Week bump · {b.label}</td>
                    <td class="num">{int(b.count)}</td>
                    <td class="num">{eur0(b.eurMinor)}</td>
                  </tr>
                ))}
                {d.workshopBumps.count === 0 && d.courseBumps.count === 0 && (
                  <tr><td colspan="3" class="empty" style="padding:14px 10px;">No bumps taken in this window.</td></tr>
                )}
                <tr class="total">
                  <td>Total</td>
                  <td class="num">{int(d.workshopBumps.count + d.courseBumps.count)}</td>
                  <td class="num">{eur0(d.workshopBumps.netEurMinor + d.courseBumps.eurMinor)}</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="sub-muted" style="margin-top:8px;">12-Week checkout bumps sit outside the revenue-streams total below (they’re a separate charge), so they’re counted here only.</p>
        </section>

        <section>
          <h2>Revenue streams</h2>
          <p class="note">Every income line in the window, with its share of the total.</p>
          <div class="card-tbl">
            <table>
              <thead><tr><th>Stream</th><th class="num">Sales</th><th class="num">Net</th><th class="num">Share</th></tr></thead>
              <tbody>
                {d.streams.map((r) => (
                  <tr>
                    <td>{r.name}</td>
                    <td class="num">{int(r.count)}</td>
                    <td class="num">{eur0(r.eurMinor)}</td>
                    <td class="num">{streamSum > 0 ? ((r.eurMinor / streamSum) * 100).toFixed(1) + '%' : '—'}</td>
                  </tr>
                ))}
                <tr class="total">
                  <td>Total</td>
                  <td class="num">{int(d.streams.reduce((s, r) => s + r.count, 0))}</td>
                  <td class="num">{eur0(streamSum)}</td>
                  <td class="num">100%</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <div class="flags">
        <p>Money in EUR. Workshop-engine figures are net of tax where tax data exists; standalone course sales (12-week, certification) are amounts charged so far (installments count paid installments only, refunds subtracted), gross of VAT, converted at fallback FX. Meta cost per workshop = average cost per registration × that workshop’s registrations (ad spend isn’t tracked per workshop). Figures reconcile with /admin/workshops/stats for the same window.</p>
        {d.flaggedNoTax > 0 && <p>⚠ {d.flaggedNoTax} workshop payment(s) had no tax data — net taken equal to gross for those.</p>}
        {d.fxConverted > 0 && <p>⚠ {d.fxConverted} course sale(s) charged in a non-EUR currency, converted with the fallback rate table.</p>}
      </div>
    </div>

    <script is:inline type="application/json" id="chart-data" set:html={chartJson} />
    <script is:inline type="application/json" id="preset-ranges" set:html={presetRangesJson} />

    <script is:inline>
      // Filter form: presets fill the dates and auto-apply; editing a date flips
      // to "custom"; compare needs a bounded period.
      (function () {
        var ranges = JSON.parse(document.getElementById('preset-ranges').textContent);
        var form = document.getElementById('filter');
        var presetSel = document.getElementById('f-preset');
        var fromIn = document.getElementById('f-from');
        var toIn = document.getElementById('f-to');
        var compareSel = document.getElementById('f-compare');
        function syncCompare() { compareSel.disabled = !(fromIn.value && toIn.value); if (compareSel.disabled) compareSel.value = ''; }
        presetSel.addEventListener('change', function () {
          var v = presetSel.value;
          if (v === 'custom') { syncCompare(); return; }
          var r = ranges[v] || { from: null, to: null };
          fromIn.value = r.from || '';
          toIn.value = r.to || '';
          syncCompare();
          form.submit();
        });
        function toCustom() { presetSel.value = 'custom'; syncCompare(); }
        fromIn.addEventListener('change', toCustom);
        toIn.addEventListener('change', toCustom);
      })();
    </script>

    <script is:inline>
      // Hand-rolled SVG line charts (no deps). Gap-aware (null = break), a
      // crosshair + tooltip on hover, and an interactive legend for the stream
      // chart. One value scale per chart — never a second axis.
      (function () {
        var el = document.getElementById('chart-data');
        if (!el) return;
        var data = JSON.parse(el.textContent);
        var css = getComputedStyle(document.documentElement);
        function color(name) { return name && name.indexOf('var-') === 0 ? css.getPropertyValue('--' + name.slice(4)).trim() : name; }

        var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var NS = 'http://www.w3.org/2000/svg';
        function elNS(t, a) { var e = document.createElementNS(NS, t); for (var k in a) e.setAttribute(k, a[k]); return e; }
        function shortDate(ymd, many) { return parseInt(ymd.slice(8,10),10) + ' ' + MONTHS[parseInt(ymd.slice(5,7),10)-1] + (many ? " '" + ymd.slice(2,4) : ''); }
        function niceMax(v) { if (v <= 0) return 1; var pow = Math.pow(10, Math.floor(Math.log(v)/Math.LN10)); var u = v/pow; var nice = u <= 1 ? 1 : u <= 2 ? 2 : u <= 2.5 ? 2.5 : u <= 5 ? 5 : 10; return nice*pow; }
        function fmtEur(v) { return '€' + v.toLocaleString('en-IE', { maximumFractionDigits: 0 }); }
        function fmtEurAxis(v) { if (v >= 10000) return '€' + Math.round(v/1000) + 'k'; if (v >= 1000) return '€' + (v/1000).toFixed(1) + 'k'; return '€' + Math.round(v); }
        function fmtInt(v) { return v.toLocaleString('en-IE'); }

        // Contiguous non-null runs → point arrays, so a gap (null) breaks the line.
        function runs(values, x, y) {
          var out = [], cur = [];
          for (var i = 0; i < values.length; i++) {
            var v = values[i];
            if (v == null) { if (cur.length) { out.push(cur); cur = []; } }
            else cur.push({ i: i, x: x(i), y: y(v) });
          }
          if (cur.length) out.push(cur);
          return out;
        }

        // opts: { labels, series:[{name,color,values,dashed?}], fmt:'eur'|'int',
        //         area?:bool, hidden?, interactive? }
        function draw(mountId, opts) {
          var mount = document.getElementById(mountId);
          if (!mount) return;
          mount.innerHTML = '';
          var labels = opts.labels;
          var n = labels.length;
          var isEur = opts.fmt === 'eur';
          var fmt = isEur ? fmtEur : fmtInt;
          var fmtAxis = isEur ? fmtEurAxis : fmtInt;
          var hidden = opts.hidden || null;
          var series = opts.series;

          // Legend (for ≥2 series, or when interactive).
          if (series.length >= 2 || opts.interactive) {
            var legend = document.createElement('div');
            legend.className = 'legend';
            series.forEach(function (s) {
              var off = !!(hidden && hidden[s.name]);
              var item, cb;
              if (opts.interactive) {
                item = document.createElement('label');
                item.className = 'legend-item' + (off ? ' legend-item--off' : '');
                cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = !off;
                cb.addEventListener('change', function () { if (cb.checked) delete hidden[s.name]; else hidden[s.name] = true; draw(mountId, opts); });
                item.appendChild(cb);
              } else { item = document.createElement('span'); item.className = 'legend-item'; }
              var sw = document.createElement('i'); sw.className = 'sw' + (s.dashed ? ' sw--dash' : ''); sw.style.borderTopColor = color(s.color);
              item.appendChild(sw); item.appendChild(document.createTextNode(s.name)); legend.appendChild(item);
            });
            mount.appendChild(legend);
          }

          var visible = hidden ? series.filter(function (s) { return !hidden[s.name]; }) : series;
          var W = Math.max(mount.clientWidth || 700, 300), H = 240, padL = 52, padR = 16, padT = 12, padB = 26;
          var max = 1;
          visible.forEach(function (s) { s.values.forEach(function (v) { if (v != null && v > max) max = v; }); });
          max = niceMax(max);
          function x(i) { return n === 1 ? (padL + W - padR) / 2 : padL + (W - padL - padR) * (i / (n - 1)); }
          function y(v) { return H - padB - (H - padT - padB) * (v / max); }

          var svg = elNS('svg', { viewBox: '0 0 ' + W + ' ' + H, width: '100%', height: H });
          for (var g = 0; g <= 4; g++) {
            var gy = H - padB - (H - padT - padB) * (g / 4);
            svg.appendChild(elNS('line', { x1: padL, y1: gy, x2: W - padR, y2: gy, stroke: css.getPropertyValue('--hair').trim() || 'rgba(0,0,0,0.08)' }));
            var tk = elNS('text', { x: padL - 7, y: gy + 4, 'text-anchor': 'end' }); tk.textContent = fmtAxis(max * g / 4); svg.appendChild(tk);
          }
          var step = Math.max(1, Math.ceil(n / 7)), many = n > 370;
          for (var i = 0; i < n; i += step) { var tx = elNS('text', { x: x(i), y: H - padB + 17, 'text-anchor': 'middle' }); tx.textContent = shortDate(labels[i], many); svg.appendChild(tx); }

          visible.forEach(function (s) {
            var rr = runs(s.values, x, y);
            // area wash under a single visible series
            if (opts.area && visible.length === 1) {
              rr.forEach(function (run) {
                if (run.length < 2) return;
                var dpath = 'M' + run[0].x + ',' + (H - padB) + ' ' + run.map(function (p) { return 'L' + p.x + ',' + p.y; }).join(' ') + ' L' + run[run.length - 1].x + ',' + (H - padB) + ' Z';
                svg.appendChild(elNS('path', { d: dpath, fill: color(s.color), 'fill-opacity': 0.1, stroke: 'none' }));
              });
            }
            rr.forEach(function (run) {
              if (run.length === 1) { svg.appendChild(elNS('circle', { cx: run[0].x, cy: run[0].y, r: 3.2, fill: color(s.color) })); return; }
              var pl = elNS('polyline', { points: run.map(function (p) { return p.x + ',' + p.y; }).join(' '), fill: 'none', stroke: color(s.color), 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' });
              if (s.dashed) pl.setAttribute('stroke-dasharray', '5 4');
              svg.appendChild(pl);
            });
          });

          // hover crosshair + dots + tooltip
          var guide = elNS('line', { y1: padT, y2: H - padB, stroke: css.getPropertyValue('--baseline') || 'rgba(0,0,0,0.3)', 'stroke-width': 1, visibility: 'hidden' }); svg.appendChild(guide);
          var dots = visible.map(function (s) { var c = elNS('circle', { r: 3.5, fill: color(s.color), stroke: css.getPropertyValue('--card').trim() || '#fff', 'stroke-width': 2, visibility: 'hidden' }); svg.appendChild(c); return c; });
          mount.appendChild(svg);
          var tip = document.createElement('div'); tip.className = 'tip'; mount.appendChild(tip);
          svg.addEventListener('mousemove', function (ev) {
            var rect = svg.getBoundingClientRect(); var sx = W / rect.width; var mx = (ev.clientX - rect.left) * sx;
            var i = n === 1 ? 0 : Math.round(((mx - padL) / (W - padL - padR)) * (n - 1)); if (i < 0) i = 0; if (i > n - 1) i = n - 1;
            guide.setAttribute('x1', x(i)); guide.setAttribute('x2', x(i)); guide.setAttribute('visibility', 'visible');
            var html = '<strong>' + shortDate(labels[i], many) + '</strong>';
            visible.forEach(function (s, k) {
              var v = s.values[i];
              if (v == null) { dots[k].setAttribute('visibility', 'hidden'); html += '<br>' + s.name + ': —'; }
              else { dots[k].setAttribute('cx', x(i)); dots[k].setAttribute('cy', y(v)); dots[k].setAttribute('visibility', 'visible'); html += '<br>' + s.name + ': ' + fmt(v); }
            });
            tip.innerHTML = html;
            var mr = mount.getBoundingClientRect(); var left = ev.clientX - mr.left + 14;
            tip.style.opacity = '1'; tip.style.top = (ev.clientY - mr.top + 14) + 'px'; tip.style.left = left + 'px';
            var over = left + tip.offsetWidth - mr.width + 8; if (over > 0) tip.style.left = (left - tip.offsetWidth - 28) + 'px';
          });
          svg.addEventListener('mouseleave', function () { tip.style.opacity = '0'; guide.setAttribute('visibility', 'hidden'); dots.forEach(function (dd) { dd.setAttribute('visibility', 'hidden'); }); });
        }

        var hiddenStreams = {};
        function drawAll() {
          if (document.getElementById('ch-regs')) {
            draw('ch-regs', { labels: data.acq.labels, fmt: 'int', area: true, series: [{ name: 'Registrations', color: 'var-s1', values: data.acq.registrations }] });
            draw('ch-cpa', { labels: data.acq.labels, fmt: 'eur', series: [{ name: 'Cost / registration', color: 'var-s4', values: data.acq.cpa }] });
            draw('ch-spend', { labels: data.acq.labels, fmt: 'eur', series: [
              { name: 'Revenue', color: 'var-s5', values: data.acq.revenue },
              { name: 'Ad spend', color: 'var-s2', values: data.acq.adSpend },
            ] });
            var streamSeries = data.streams.series.concat([{ name: 'Total', color: '#8a8076', values: data.streams.total, dashed: true }]);
            draw('ch-streams', { labels: data.streams.labels, fmt: 'eur', interactive: true, hidden: hiddenStreams, series: streamSeries });
          }
        }
        drawAll();
        var rt; window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(drawAll, 150); });
      })();
    </script>
  </body>
</html>
