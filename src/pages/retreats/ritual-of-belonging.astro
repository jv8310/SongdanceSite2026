---
import '../../styles/ritual-of-belonging.css';
import Layout from '../../layouts/Layout.astro';
import RBNav from '../../components/ritual-of-belonging/RBNav.astro';
import RBHero from '../../components/ritual-of-belonging/RBHero.astro';
import RBOpening from '../../components/ritual-of-belonging/RBOpening.astro';
import RBNote from '../../components/ritual-of-belonging/RBNote.astro';
import RBForWhom from '../../components/ritual-of-belonging/RBForWhom.astro';
import RBExpect from '../../components/ritual-of-belonging/RBExpect.astro';
import RBFacilitators from '../../components/ritual-of-belonging/RBFacilitators.astro';
import RBGallery from '../../components/ritual-of-belonging/RBGallery.astro';
import RBTestimonials from '../../components/ritual-of-belonging/RBTestimonials.astro';
import RBPractical from '../../components/ritual-of-belonging/RBPractical.astro';
import RBTogether from '../../components/ritual-of-belonging/RBTogether.astro';
import RBFramework from '../../components/ritual-of-belonging/RBFramework.astro';
import RBRegister from '../../components/ritual-of-belonging/RBRegister.astro';
import RetreatWaitlist from '../../components/RetreatWaitlist.astro';
import RBFooter from '../../components/ritual-of-belonging/RBFooter.astro';
import DiscoverMore from '../../components/DiscoverMore.astro';
---

<Layout
  title="Ritual of Belonging — Winter Retreat with Lesanne & Jacob | Songdance"
  description="A three-day winter retreat with Lesanne and Jacob at Château Cortils in the Belgian Ardennes. 27–29 November 2026. Sound, circle, ritual, and a slow return to belonging."
  image="/media/library/ritual-winter-forest.webp"
  imageAlt="Low winter light through a snowy forest."
>
  <div class="rb-site">
    <RBNav />
    <RBHero />
    <RBOpening />
    <RBNote />
    <RBForWhom />
    <RBExpect />
    <RBFacilitators />
    <RBGallery />
    <RBTestimonials />
    <RBTogether />
    <RBFramework />
    <RBPractical />
    <RBRegister />
    <RetreatWaitlist
      product="ritual-of-belonging-2026"
      when="27–29 November 2026 · Château Cortils, Belgium"
      variant="rwl--rb"
      tiers={[
        { slug: 'private-ensuite', label: 'Private En-suite' },
        { slug: 'private-shared-bath', label: 'Private Shared-bath' },
        { slug: 'private-double', label: 'Private Double (couple)' },
        { slug: 'shared-bedroom', label: 'Shared Room' },
        { slug: 'common-space', label: 'Budget Room' },
      ]}
    />
    <DiscoverMore currentHref="/retreats/ritual-of-belonging" />
    <RBFooter />
  </div>
</Layout>
