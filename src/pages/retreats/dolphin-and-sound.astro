---
import '../../styles/dolphin-and-sound.css';
import Layout from '../../layouts/Layout.astro';
import DSNav from '../../components/dolphin-and-sound/DSNav.astro';
import DSHero from '../../components/dolphin-and-sound/DSHero.astro';
import DSHighlights from '../../components/dolphin-and-sound/DSHighlights.astro';
import DSEncounter from '../../components/dolphin-and-sound/DSEncounter.astro';
import DSNooraya from '../../components/dolphin-and-sound/DSNooraya.astro';
import DSAboard from '../../components/dolphin-and-sound/DSAboard.astro';
import DSJacob from '../../components/dolphin-and-sound/DSJacob.astro';
import DSPractical from '../../components/dolphin-and-sound/DSPractical.astro';
import DSFAQ from '../../components/dolphin-and-sound/DSFAQ.astro';
import DSRegister from '../../components/dolphin-and-sound/DSRegister.astro';
import RetreatWaitlist from '../../components/RetreatWaitlist.astro';
import DSFooter from '../../components/dolphin-and-sound/DSFooter.astro';
import DiscoverMore from '../../components/DiscoverMore.astro';
---

<Layout
  title="Voices of the Deep — Dolphin & Sound Retreat, Egypt 2026 | Songdance"
  description="Seven days with wild dolphins and your own voice, aboard the Nooraya in Egypt's Red Sea. 1–8 November 2026 with Jacob — swimming in the Sataya Reef and Somatic Vocal Healing. €1995 all-inclusive, max 17 places."
  image="/media/library/dolphin-group-of-dolphins.webp"
>
  <div class="ds-site">
    <DSNav />
    <DSHero />
    <DSHighlights />
    <DSEncounter />
    <DSNooraya />
    <DSAboard />
    <DSJacob />
    <DSPractical />
    <DSFAQ />
    <DSRegister />
    <RetreatWaitlist
      product="dolphin-and-sound-2026"
      when="1–8 November 2026 · Sataya Reef, Egypt"
      variant="rwl--ds"
      noun="cabin"
      tiers={[
        { slug: 'twin-lower', label: 'Twin cabin – lower deck with porthole' },
        { slug: 'twin-upper', label: 'Twin cabin – upper deck with sea views' },
        { slug: 'double-lower', label: 'Cabin with double bed – lower deck' },
      ]}
    />
    <DiscoverMore currentHref="/retreats/dolphin-and-sound" />
    <DSFooter />
  </div>
</Layout>
