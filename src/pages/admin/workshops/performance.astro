---
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import { computeWorkshopPerformance, resolveMoneyOpts, type WorkshopPerformanceRow } from '../../../lib/workshops/stats';
import { PERIOD_PRESETS, resolvePeriod, presetRangesMap } from '../../../lib/workshops/periods';
import { computeShareReport } from '../../../lib/workshops/share-report';
import { computeMcPageReport } from '../../../lib/workshops/mc-page-report';
import { PAGE_CHANGES } from '../../../lib/workshops/experiments';
import { SHARE_CHANNEL_LABELS } from '../../../lib/workshops/share';

export const prerender = false;

const env = Astro.locals.runtime.env;
if (!(await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request)))) {
  return Astro.redirect('/admin/login');
}

const { preset, from, to } = resolvePeriod(Astro.url.searchParams);
// Same money context /admin/stats uses: live `fx_rates` (never the static
// approximations) and the Quaderno VAT config, so a course sale is counted net
// of VAT and in true euros — and this page's figures match that one's.
const money = await resolveMoneyOpts(env.DB, env);
const report = await computeWorkshopPerformance(env.DB, { from, to, money });
// The referral funnel — the same window, the channel that costs nothing.
const share = await computeShareReport(env.DB, { from, to, money });
// The bookmarked page changes, each read as two equal windows either side of
// the day it shipped. Deliberately NOT bound to the period picker above: the
// windows are what make the two halves comparable, so they are fixed by the
// change date rather than by whatever range is being browsed — which is also
// why each bookmark gets its own panel rather than sharing one.
const pageChanges = await Promise.all(
  PAGE_CHANGES.map((change) => computeMcPageReport(env.DB, change, { money })),
);
const windowLabel = (w: { from: string; to: string; days: number }) =>
  `${dateLabel(w.from)} – ${dateLabel(w.to)} · ${w.days} day${w.days === 1 ? '' : 's'}`;
// Step-to-step conversion, as a percentage of the step before it.
const shareRate = (n: number, of: number) => (of > 0 ? (n / of) * 100 : null);
// Drafts last, so live/past workshops lead.
const rows = report.rows.slice().sort((a, b) => {
  const ad = a.status === 'draft' ? 1 : 0;
  const bd = b.status === 'draft' ? 1 : 0;
  return ad - bd;
});
// A card each for the workshops that actually did something in this window; the
// rest (drafts, not-yet-open sessions) collapse into a one-line list at the
// bottom rather than filling the page with empty cards.
const activeRows = rows.filter((r) => r.registrations > 0 || r.totalEurMinor > 0);
const idleRows = rows.filter((r) => !(r.registrations > 0 || r.totalEurMinor > 0));

const eur = (minor: number) =>
  '€' + (minor / 100).toLocaleString('en-IE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const eur0 = (minor: number) =>
  '€' + Math.round(minor / 100).toLocaleString('en-IE');
const pct = (v: number | null) => (v != null ? v.toFixed(1) + '%' : '—');
const roasStr = (v: number | null) => (v != null ? v.toFixed(2) + '×' : '—');
const roasTone = (v: number | null): 'good' | 'bad' | 'flat' =>
  v == null ? 'flat' : v >= 1 ? 'good' : 'bad';

// The day-by-day acquisition ledger the per-workshop costs are built from —
// only days that actually saw spend or a registration.
const costDays = report.dailyCosts.filter(
  (dc) => dc.adSpendEurMinor > 0 || dc.registrations > 0,
).slice().reverse();

const dateLabel = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Brussels',
  }).format(new Date(iso));
const shortTitle = (t: string) => t.replace(/Somatic Vocal Healing/gi, 'SVH');

// Totals. Attendance/conversion recomputed from the sums rather than averaging
// the per-row percentages.
const sum = (f: (r: WorkshopPerformanceRow) => number) => rows.reduce((s, r) => s + f(r), 0);
const totRegs = sum((r) => r.registrations);
const totLive = sum((r) => r.attendedLive);
const totReplay = sum((r) => r.replayViews);
const totNoShow = sum((r) => r.noShows);
const totBumps = sum((r) => r.bumpBuys);
const totCourse = sum((r) => r.courseBuys);
const totCert = sum((r) => r.certBuys);
const totRev = sum((r) => r.totalEurMinor);
// The part of that already charged. Course plans bill monthly, so a window
// with a fresh 6x path shows a large gap between the two — the sale is real,
// the cash arrives over the next months.
const totRevCollected = sum((r) => r.totalCollectedEurMinor);
const totMeta = sum((r) => r.metaCostEurMinor ?? 0);
const totTof = sum((r) => r.acquisitionCostEurMinor ?? 0);
const totRoas = totMeta > 0 ? totRev / totMeta : null;
const totAttended = totLive + totReplay;

// Money bars share one scale across every card, so bar lengths are comparable
// workshop to workshop rather than each card telling its own story.
const moneyMax = Math.max(
  1,
  ...activeRows.map((r) => Math.max(r.totalEurMinor, r.metaCostEurMinor ?? 0)),
);
const barPct = (v: number, max: number) => (max > 0 ? Math.min(100, (v / max) * 100) : 0);

// Attendance is one segmented bar per card: live · replay · no-show · the
// remainder (registered, nothing recorded yet — upcoming sessions live here).
type Attendance = { registrations: number; attendedLive: number; replayViews: number; noShows: number };
type Seg = { key: string; label: string; n: number };
const segments = (r: Attendance): Seg[] => {
  const open = Math.max(0, r.registrations - r.attendedLive - r.replayViews - r.noShows);
  return [
    { key: 'live', label: 'live', n: r.attendedLive },
    { key: 'replay', label: 'replay', n: r.replayViews },
    { key: 'noshow', label: 'no-show', n: r.noShows },
    { key: 'open', label: 'not marked', n: open },
  ].filter((s) => s.n > 0);
};
// Nothing recorded at all — an upcoming session. Showing the bar and a row of
// zeros there reads as "nobody came"; it hasn't happened yet.
const anyAttendance = (r: Attendance) => r.attendedLive + r.replayViews + r.noShows > 0;

const presetRangesJson = JSON.stringify(presetRangesMap()).replace(/</g, '\\u003c');
const rangeLabel = from && to ? `${from} → ${to}` : 'all time';
---

<Layout title="Admin — Workshop performance — Songdance" description="">
  <main class="adm adm--wide">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs"><a href="/admin">Admin</a> <span class="sep">/</span> <a href="/admin/workshops">Workshops</a> <span class="sep">/</span> Performance</p>
        <h1>Per-workshop performance</h1>
        <p class="adm-sub">The funnel per workshop: registrations → attendance → course purchases. Course / Cert buys are matched by email across workshop checkouts and standalone course sales, so someone who registered for several workshops counts toward each. Revenue counts each course sale <strong>in full</strong> — a 3×/6×/12× plan is one purchase the ad bought, so all of its installments count on the day it was sold; the lighter part of the revenue bar is what has actually been charged so far.</p>
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--ghost" href="/admin/stats">← Statistics</a>
        <a class="adm-btn adm-btn--ghost" href="/admin/workshops">Workshops</a>
      </div>
    </header>

    <section class="adm-section">
      <form method="GET" class="adm-inline-form" id="perf-filter">
        <label>Period
          <select name="preset" id="f-preset">
            {PERIOD_PRESETS.map(([v, l]) => <option value={v} selected={preset === v}>{l}</option>)}
          </select>
        </label>
        <label>From <input type="date" name="from" id="f-from" value={from ?? ''} /></label>
        <label>To <input type="date" name="to" id="f-to" value={to ?? ''} /></label>
        <button type="submit" class="adm-btn adm-btn--solid">Apply</button>
      </form>
      <p class="adm-sub" style="margin-top:10px;">
        Showing <strong>{rangeLabel}</strong> ·
        prospecting (TOF) spend {eur(report.acquisitionSpendEurMinor)} ÷ {report.totalRegistrations} registrations =
        <strong>{report.costPerRegistrationEurMinor != null ? eur(Math.round(report.costPerRegistrationEurMinor)) : '—'}</strong> cost per registration, blended.
        {report.retargetingSpendEurMinor > 0 && <> Retargeting {eur(report.retargetingSpendEurMinor)} is excluded from that (total ad spend {eur(report.adSpendEurMinor)}).</>}
      </p>
      <div class="pf-aud">
        {([
          ['Workshop', report.audiences.workshop],
          ['Masterclass', report.audiences.masterclass],
        ] as const).map(([label, a]) => (
          <div class="pf-aud-card">
            <div class="pf-aud-key">Cost per {label.toLowerCase()} registration</div>
            <div class="pf-aud-val">{a.costPerRegistrationEurMinor != null ? eur(Math.round(a.costPerRegistrationEurMinor)) : '—'}</div>
            <div class="pf-aud-sub">
              {eur(a.allocatedCostEurMinor)} charged ÷ {a.registrations} registration{a.registrations === 1 ? '' : 's'}
              <br />{label} campaigns spent {eur(a.acquisitionSpendEurMinor)} (TOF)
            </div>
          </div>
        ))}
      </div>
      <p class="adm-sub" style="margin-top:10px;">
        Each product is charged its <strong>own campaigns’ money</strong>: a campaign whose name says <em>Masterclass</em> only ever pays for masterclass seats, one that says <em>Workshop</em> only for workshop seats. Within that, the charge is <strong>day by day</strong> — every registration carries the price of a registration of its own kind on the day it came in (that day’s spend for that product ÷ that day’s registrations for it), so a session that filled on expensive days costs more per seat than the average. See the daily table below.
        {report.generalAcquisitionSpendEurMinor > 0 && <> {eur(report.generalAcquisitionSpendEurMinor)} of TOF spend came from campaigns naming neither product — that part is charged across every registration.</>}
        {report.unallocatedAcquisitionSpendEurMinor > 0 && <> {eur(report.unallocatedAcquisitionSpendEurMinor)} could not be charged to anything: its product took no registration at all in this window, and charging it to the other product’s seats is exactly what this split avoids.</>}
      </p>
    </section>

    <section class="adm-section">
      {/* ── Summary band: the same card shape, totalled ── */}
      <article class="pf-card pf-card--total">
        <div class="pf-id">
          <div class="pf-name">All workshops</div>
          <div class="pf-when">{rangeLabel} · {activeRows.length} with activity</div>
        </div>

        <div class="pf-roas">
          <b class={roasTone(report.workshopRoas)}>{roasStr(report.workshopRoas)}</b>
          <span>ROAS<br />income ÷ TOF spend</span>
        </div>

        <div class="pf-money">
          <div class="pf-bar" title={`${eur(totRevCollected)} of this has been charged so far; the rest is installments still to bill`}>
            <span class="pf-bar-key">Revenue</span>
            <span class="pf-track">
              <span class="pf-fill pf-fill--rev" style={`width:${barPct(totRev, Math.max(totRev, totMeta, 1))}%`}>
                <span class="pf-fill-paid" style={`width:${totRev > 0 ? (totRevCollected / totRev) * 100 : 100}%`}></span>
              </span>
            </span>
            <span class="pf-bar-amt">{eur0(totRev)}</span>
          </div>
          <div class="pf-bar">
            <span class="pf-bar-key">TOF cost</span>
            <span class="pf-track"><span class="pf-fill pf-fill--cost" style={`width:${barPct(totTof, Math.max(totRev, totMeta, 1))}%`}></span></span>
            <span class="pf-bar-amt">{eur0(totTof)}</span>
          </div>
          <p class="pf-money-note">
            {report.audiences.workshop.costPerRegistrationEurMinor != null && <>{eur(Math.round(report.audiences.workshop.costPerRegistrationEurMinor))} / workshop reg · </>}
            {report.audiences.masterclass.costPerRegistrationEurMinor != null && <>{eur(Math.round(report.audiences.masterclass.costPerRegistrationEurMinor))} / masterclass reg · </>}
            {eur0(totMeta)} total Meta cost
            {totRevCollected < totRev && <> · {eur0(totRevCollected)} of the revenue charged so far</>}
          </p>
        </div>

        <div class="pf-funnel">
          <div class="pf-funnel-top"><b>{totRegs}</b> registrations · <b>{pct(totRegs > 0 ? (totAttended / totRegs) * 100 : null)}</b> attended</div>
          <div class="pf-seg">
            {segments({ registrations: totRegs, attendedLive: totLive, replayViews: totReplay, noShows: totNoShow }).map((s) => (
              <span class={`pf-seg-part pf-seg-part--${s.key}`} style={`width:${(s.n / Math.max(1, totRegs)) * 100}%`} title={`${s.n} ${s.label}`}></span>
            ))}
          </div>
          <div class="pf-legend">
            <span><i class="pf-dot pf-dot--live"></i>{totLive} live</span>
            <span><i class="pf-dot pf-dot--replay"></i>{totReplay} replay</span>
            <span><i class="pf-dot pf-dot--noshow"></i>{totNoShow} no-show</span>
          </div>
        </div>

        <div class="pf-chips">
          <span class="pf-chip"><b>{totBumps}</b> bumps</span>
          <span class="pf-chip"><b>{totCourse}</b> course</span>
          <span class="pf-chip"><b>{totCert}</b> cert path</span>
          <span class="pf-chip"><b>{pct(totRegs > 0 ? ((totCourse + totCert) / totRegs) * 100 : null)}</b> conv</span>
          <span class="pf-chip"><b>{pct(totAttended > 0 ? ((totCourse + totCert) / totAttended) * 100 : null)}</b> conv / attendee</span>
          <span class="pf-chip"><b>{roasStr(totRoas)}</b> blended ROAS</span>
        </div>
      </article>

      {activeRows.length === 0 && <p class="adm-empty">No workshop activity in this window.</p>}

      {/* ── One card per workshop, one card per row ── */}
      <div class="pf-list">
        {activeRows.map((r) => {
          const segs = segments(r);
          const held = anyAttendance(r);
          const cost = r.acquisitionCostEurMinor;
          return (
            <article class="pf-card">
              <div class="pf-id">
                <a class="pf-name" href={`/admin/workshops/${r.workshopId}`}>{shortTitle(r.title)}</a>
                <div class="pf-when">
                  {r.isReplay ? 'On-demand' : dateLabel(r.startsAtUtc)}
                  {r.isMasterclass && <span class="pf-kind">masterclass</span>}
                  {r.status !== 'published' && <span class="pf-status">{r.status}</span>}
                </div>
              </div>

              <div class="pf-roas">
                <b class={roasTone(r.workshopRoas)}>{roasStr(r.workshopRoas)}</b>
                <span>ROAS<br />revenue ÷ TOF cost</span>
              </div>

              <div class="pf-money">
                <div class="pf-bar" title={`Workshop checkout ${eur(r.engineNetEurMinor)} + courses its registrants bought ${eur(r.attributedCourseEurMinor)} (full sale value; ${eur(r.attributedCourseCollectedEurMinor)} of that charged so far)`}>
                  <span class="pf-bar-key">Revenue</span>
                  <span class="pf-track">
                    <span class="pf-fill pf-fill--rev" style={`width:${barPct(r.totalEurMinor, moneyMax)}%`}>
                      <span
                        class="pf-fill-paid"
                        style={`width:${r.totalEurMinor > 0 ? (r.totalCollectedEurMinor / r.totalEurMinor) * 100 : 100}%`}
                      ></span>
                    </span>
                  </span>
                  <span class="pf-bar-amt">{eur0(r.totalEurMinor)}</span>
                </div>
                <div class="pf-bar" title={`Prospecting (TOF) spend charged to this session from the ${r.isMasterclass ? 'masterclass' : 'workshop'} campaigns (plus any campaign naming no product), summed day by day over the days its registrations came in`}>
                  <span class="pf-bar-key">TOF cost</span>
                  <span class="pf-track"><span class="pf-fill pf-fill--cost" style={`width:${barPct(cost ?? 0, moneyMax)}%`}></span></span>
                  <span class="pf-bar-amt">{cost != null ? eur0(cost) : '—'}</span>
                </div>
                <p class="pf-money-note">
                  {r.costPerRegistrationEurMinor != null
                    ? <><b>{eur(Math.round(r.costPerRegistrationEurMinor))}</b> per registration</>
                    : <>no ad spend to charge</>}
                  {r.metaCostEurMinor != null && <> · {eur0(r.metaCostEurMinor)} Meta cost</>}
                  {r.totalCollectedEurMinor < r.totalEurMinor && (
                    <> · {eur0(r.totalCollectedEurMinor)} charged so far, rest on payment plans</>
                  )}
                </p>
              </div>

              <div class="pf-funnel">
                <div class="pf-funnel-top">
                  <b>{r.registrations}</b> registrations
                  {held && <> · <b>{pct(r.attendancePct)}</b> attended</>}
                </div>
                {held ? (
                  <>
                    <div class="pf-seg">
                      {segs.map((s) => (
                        <span
                          class={`pf-seg-part pf-seg-part--${s.key}`}
                          style={`width:${(s.n / Math.max(1, r.registrations)) * 100}%`}
                          title={`${s.n} ${s.label}`}
                        ></span>
                      ))}
                    </div>
                    <div class="pf-legend">
                      <span><i class="pf-dot pf-dot--live"></i>{r.attendedLive} live</span>
                      <span><i class="pf-dot pf-dot--replay"></i>{r.replayViews} replay</span>
                      <span><i class="pf-dot pf-dot--noshow"></i>{r.noShows} no-show</span>
                    </div>
                  </>
                ) : (
                  <p class="pf-pending">Seats sold · no attendance recorded yet</p>
                )}
              </div>

              <div class="pf-chips">
                <span class="pf-chip"><b>{r.bumpBuys}</b> bumps</span>
                <span class="pf-chip"><b>{r.courseBuys}</b> course</span>
                <span class="pf-chip"><b>{r.certBuys}</b> cert path</span>
                <span class="pf-chip"><b>{pct(r.conversionPct)}</b> conv</span>
                <span class="pf-chip" title="Buyers ÷ attendees — conversion of the people who actually showed up"><b>{pct(r.conversionPerAttendeePct)}</b> conv / attendee</span>
                <span class="pf-chip"><b>{roasStr(r.roas)}</b> blended ROAS</span>
              </div>
            </article>
          );
        })}
      </div>

      {idleRows.length > 0 && (
        <div class="pf-idle">
          <p class="pf-idle-head">No activity in this window ({idleRows.length})</p>
          <div class="pf-idle-list">
            {idleRows.map((r) => (
              <a class="pf-idle-item" href={`/admin/workshops/${r.workshopId}`}>
                {shortTitle(r.title)}
                <span>{r.isReplay ? 'On-demand' : dateLabel(r.startsAtUtc)}{r.status !== 'published' ? ` · ${r.status}` : ''}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <p class="adm-sub" style="margin-top:14px;">
        Registrations = completed (paid or coupon). The bar splits them into live · replay · no-show — live vs replay is whether they joined before or after the live slot ended, and admin-marked attendance without a join time counts as live; any remainder is registered with nothing recorded yet.
        TOF cost = the prospecting spend this session’s registrations pulled, out of the campaigns that were buying registrations for <em>its</em> product (a masterclass is never charged workshop-campaign money, or the other way round), priced day by day — each registration costs what a registration of that product cost on the day it came in — and the per-registration figure is that ÷ this session’s registrations, so it differs from the product average when its seats filled on cheaper or dearer days. Meta cost is the same day-by-day allocation of <em>total</em> ad spend (prospecting + retargeting); blended ROAS is revenue ÷ Meta cost. Revenue hovers to show the workshop-checkout vs attributed-course split. Conv = distinct course/cert buyers ÷ registrations.
      </p>
    </section>

    <section class="adm-section">
      <h2 style="margin:0 0 6px;font-size:18px;">Cost per registration, day by day</h2>
      <p class="adm-sub" style="margin-top:0;">
        The prices every workshop’s cost above is built from — per product, because that is how the money was spent: each day’s workshop-campaign spend ÷ that day’s workshop registrations, and the same for the masterclass. (Spend from campaigns naming neither product is added to both prices, spread across every registration.)
        {report.unattributedAcquisitionSpendEurMinor > 0 && (
          <> <strong>{eur(report.unattributedAcquisitionSpendEurMinor)}</strong> of prospecting spend fell on days that produced no registration of the product its campaign was buying — it can’t be priced against a registration, so it’s spread evenly across that product’s registrations in the window.</>
        )}
        {report.unallocatedAcquisitionSpendEurMinor > 0 && (
          <> <strong>{eur(report.unallocatedAcquisitionSpendEurMinor)}</strong> is charged to nothing: its product took no registration in this window.</>
        )}
      </p>
      {costDays.length === 0 && <p class="adm-empty">No ad spend or registrations in this window.</p>}
      {costDays.length > 0 && (
        <div class="wk-perf-scroll">
          <table class="adm-table wk-perf">
            <thead>
              <tr>
                <th>Day</th>
                <th>Workshop regs</th>
                <th>Workshop TOF</th>
                <th>Cost / workshop reg</th>
                <th>Masterclass regs</th>
                <th>Masterclass TOF</th>
                <th>Cost / masterclass reg</th>
                <th>Other TOF</th>
                <th>Total ad spend</th>
              </tr>
            </thead>
            <tbody>
              {costDays.map((dc) => (
                <tr>
                  <td>{dc.date}</td>
                  <td>{dc.workshopRegistrations}</td>
                  <td>{eur(dc.workshopSpendEurMinor)}</td>
                  <td title={dc.workshopCostPerRegistrationEurMinor == null ? 'Workshop spend but no workshop registration — spread across the window’s workshop registrations instead' : ''}>
                    {dc.workshopCostPerRegistrationEurMinor == null
                      ? '— unattributed'
                      : eur(Math.round(dc.workshopCostPerRegistrationEurMinor))}
                  </td>
                  <td>{dc.masterclassRegistrations}</td>
                  <td>{eur(dc.masterclassSpendEurMinor)}</td>
                  <td title={dc.masterclassCostPerRegistrationEurMinor == null ? 'Masterclass spend but no masterclass registration — spread across the window’s masterclass registrations instead' : ''}>
                    {dc.masterclassCostPerRegistrationEurMinor == null
                      ? '— unattributed'
                      : eur(Math.round(dc.masterclassCostPerRegistrationEurMinor))}
                  </td>
                  <td>{dc.generalSpendEurMinor > 0 ? eur(dc.generalSpendEurMinor) : '—'}</td>
                  <td>{eur(dc.adSpendEurMinor)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    {pageChanges.map((mcPage) => (
      <section class="adm-section">
        {/* ── Bookmarked page change, read against the windows either side ── */}
        <h2 style="margin:0 0 6px;font-size:18px;">{mcPage.change.title}</h2>
        <p class="adm-sub" style="margin-top:0;">
          {mcPage.change.note} Shipped <strong>{dateLabel(mcPage.change.date)}</strong>.
          <br />This block ignores the period picker above — it compares the {mcPage.after.days} day{mcPage.after.days === 1 ? '' : 's'} since the
          change against the {mcPage.before.days} day{mcPage.before.days === 1 ? '' : 's'} immediately before it, which is what makes the two halves
          comparable. “Started” is a form submitted (a registration row is written before the gateway); “secured” is paid or comped. There is no
          page-view tracking on the site, so started → secured is the conversion rate available, and it is the one this change should move.
        </p>

        <div class="pf-share">
          <div class="pf-share-step">
            <div class="pf-share-key">Before · masterclass</div>
            <div class="pf-share-val">{mcPage.before.secured}<span style="font-size:14px;color:var(--adm-mute);"> / {mcPage.before.started}</span></div>
            <div class="pf-share-sub">
              {windowLabel(mcPage.before)}<br />
              {pct(mcPage.before.started ? mcPage.before.securedRate * 100 : null)} secured · {eur(mcPage.before.revenueEurMinor)}
            </div>
          </div>
          <div class="pf-share-step pf-share-step--out">
            <div class="pf-share-key">After · masterclass</div>
            <div class="pf-share-val">{mcPage.after.secured}<span style="font-size:14px;color:var(--adm-mute);"> / {mcPage.after.started}</span></div>
            <div class="pf-share-sub">
              {windowLabel(mcPage.after)}<br />
              {pct(mcPage.after.started ? mcPage.after.securedRate * 100 : null)} secured · {eur(mcPage.after.revenueEurMinor)}
            </div>
          </div>
          <div class="pf-share-step">
            <div class="pf-share-key">Change in conversion</div>
            <div class="pf-share-val">
              {mcPage.before.started === 0 || mcPage.after.started === 0
                ? '—'
                : (mcPage.rateDeltaPoints >= 0 ? '+' : '') + mcPage.rateDeltaPoints.toFixed(1) + ' pts'}
            </div>
            <div class="pf-share-sub">
              {mcPage.before.started === 0 || mcPage.after.started === 0
                ? 'not enough registrations on one side yet'
                : <>{mcPage.after.perDay.toFixed(2)} seats/day after vs {mcPage.before.perDay.toFixed(2)} before</>}
            </div>
          </div>
          {mcPage.change.showBumpTakeUp && (
            <div class="pf-share-step">
              <div class="pf-share-key">Order bump taken</div>
              <div class="pf-share-val">
                {mcPage.after.secured === 0 ? '—' : pct(mcPage.after.bump.rate * 100)}
              </div>
              <div class="pf-share-sub">
                {mcPage.after.secured === 0
                  ? 'no seats secured since the change yet'
                  : <>{mcPage.after.bump.taken} of {mcPage.after.secured} secured seats · {eur(mcPage.after.bump.revenueEurMinor)} — against {mcPage.before.bump.taken} of {mcPage.before.secured} before. Both halves count masterclass seats sold through every door, and /workshop and /w/&lt;slug&gt; already offered the bump, so the before figure is not zero-by-construction</>}
              </div>
            </div>
          )}
          {mcPage.change.showWorkshopSwitch && (
            <div class="pf-share-step">
              <div class="pf-share-key">Workshop seats from this page</div>
              <div class="pf-share-val">{mcPage.workshopFromMcPage.tracked ? mcPage.workshopFromMcPage.secured : '—'}</div>
              <div class="pf-share-sub">
                {mcPage.workshopFromMcPage.tracked
                  ? <>{mcPage.workshopFromMcPage.started} started · {eur(mcPage.workshopFromMcPage.revenueEurMinor)} — people who came to the masterclass page and took a workshop seat instead</>
                  : <>not recorded before this shipped — no registration until now stored the page it was made on, so the historical answer is unknown, not zero</>}
              </div>
            </div>
          )}
        </div>

        {mcPage.change.showWorkshopSwitch && mcPage.workshopFromMcPage.unknownPage > 0 && (
          <p class="adm-muted" style="margin:0 0 6px;">
            {mcPage.workshopFromMcPage.unknownPage} registration{mcPage.workshopFromMcPage.unknownPage === 1 ? '' : 's'} in these windows
            predate the page column and count as “unknown page”.
          </p>
        )}
      </section>
    ))}

    <section class="adm-section">
      {/* ── Share with a friend: the referral funnel ── */}
      <h2 style="margin:0 0 6px;font-size:18px;">Share with a friend</h2>
      <p class="adm-sub" style="margin-top:0;">
        Every paid registrant is offered a link on the countdown page that gives a friend a discount on their own
        ticket (the public <code>?discount=50</code>, which stacks on whatever promo is running). Each step below is counted
        separately: the panel was shown · a share button was pressed · a friend opened the link · that friend registered.
        Link-preview crawlers (WhatsApp, Facebook and the rest fetch a URL the moment it is posted) are filtered out, and a
        reload of the same link is not recounted — so “friends who opened a link” is people, not requests.
        <br />Counting starts the day this shipped: an earlier window is empty because nothing was recorded then, not because nobody shared.
      </p>

      <div class="pf-share">
        <div class="pf-share-step">
          <div class="pf-share-key">Shown the panel</div>
          <div class="pf-share-val">{share.panelViews}</div>
          <div class="pf-share-sub">paid registrants who reached the countdown page</div>
        </div>
        <div class="pf-share-step">
          <div class="pf-share-key">Shared it</div>
          <div class="pf-share-val">{share.sharers}</div>
          <div class="pf-share-sub">
            {share.shareClicks} button press{share.shareClicks === 1 ? '' : 'es'}
            {share.panelViews > 0 && <> · {pct(shareRate(share.sharers, share.panelViews))} of those shown</>}
          </div>
        </div>
        <div class="pf-share-step">
          <div class="pf-share-key">Friends who opened a link</div>
          <div class="pf-share-val">{share.visits}</div>
          <div class="pf-share-sub">
            {share.sharers > 0
              ? `${(share.visits / share.sharers).toFixed(1)} per person who shared`
              : 'nobody has shared yet'}
          </div>
        </div>
        <div class="pf-share-step">
          <div class="pf-share-key">They registered</div>
          <div class="pf-share-val">{share.registrations}</div>
          <div class="pf-share-sub">
            {share.visits > 0 && <>{pct(shareRate(share.registrations, share.visits))} of the friends who opened one</>}
          </div>
        </div>
        <div class="pf-share-step pf-share-step--out">
          <div class="pf-share-key">Seats secured</div>
          <div class="pf-share-val">{share.secured}</div>
          <div class="pf-share-sub">{eur(share.revenueEurMinor)} of ticket revenue, at the shared discount</div>
        </div>
      </div>

      {share.byChannel.length === 0 && (
        <p class="adm-empty">Nobody has used the share panel in this window.</p>
      )}

      {share.byChannel.length > 0 && (
        <>
          <h3 class="pf-share-h3">By button</h3>
          <div class="wk-perf-scroll">
            <table class="adm-table wk-perf">
              <thead>
                <tr>
                  <th>Button</th>
                  <th>Shares</th>
                  <th>Friends opened</th>
                  <th>Registered</th>
                  <th>Secured</th>
                  <th>Revenue</th>
                </tr>
              </thead>
              <tbody>
                {share.byChannel.map((c) => (
                  <tr>
                    <td>{SHARE_CHANNEL_LABELS[c.channel]}</td>
                    <td>{c.shares || '—'}</td>
                    <td>{c.visits || '—'}</td>
                    <td>{c.registrations || '—'}</td>
                    <td>{c.secured || '—'}</td>
                    <td>{c.revenueEurMinor > 0 ? eur(c.revenueEurMinor) : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="adm-sub" style="margin-top:8px;">
            The button is carried on the link itself, so a friend’s click and their registration land on the same row as the
            press that produced them. <em>Untagged link</em> is a link that reached someone without its tag — pasted by hand,
            or copied from a browser that couldn’t use the clipboard API.
          </p>
        </>
      )}

      {share.topSharers.length > 0 && (
        <>
          <h3 class="pf-share-h3">Who is actually sending people</h3>
          <div class="wk-perf-scroll">
            <table class="adm-table wk-perf">
              <thead>
                <tr>
                  <th>Registrant</th>
                  <th>Their session</th>
                  <th>Shares</th>
                  <th>Friends opened</th>
                  <th>Registered</th>
                  <th>Secured</th>
                  <th>Revenue</th>
                </tr>
              </thead>
              <tbody>
                {share.topSharers.map((r) => (
                  <tr>
                    <td>{r.name || r.email || `#${r.registrationId}`}<br /><span class="adm-muted">{r.email}</span></td>
                    <td>{r.workshopTitle ? shortTitle(r.workshopTitle) : '—'}</td>
                    <td>{r.shares || '—'}</td>
                    <td>{r.visits || '—'}</td>
                    <td>{r.registrations || '—'}</td>
                    <td>{r.secured || '—'}</td>
                    <td>{r.revenueEurMinor > 0 ? eur(r.revenueEurMinor) : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
    </section>
  </main>

  <script is:inline type="application/json" id="perf-preset-ranges" set:html={presetRangesJson} />

  <style>
    .adm--wide { max-width: 1280px; }
    .adm-table { width:100%; border-collapse:collapse; }

    /* The two prices that matter: what a workshop seat costs and what a
       masterclass seat costs, each out of its own campaigns' budget. */
    .pf-aud { display:flex; gap:12px; flex-wrap:wrap; margin-top:12px; }
    .pf-aud-card {
      flex:1 1 220px; min-width:200px; padding:12px 14px;
      border:1px solid rgba(42,27,42,0.12); border-radius:12px;
      background: var(--adm-paper-soft);
    }
    .pf-aud-key { font-size:11px; letter-spacing:0.4px; text-transform:uppercase; color:var(--adm-mute); }
    .pf-aud-val { font-size:22px; font-weight:600; margin:2px 0 4px; }
    .pf-aud-sub { font-size:11px; color:var(--adm-mute); line-height:1.5; }
    .adm-table th, .adm-table td { text-align:left; padding:8px 10px; border-bottom:1px solid rgba(42,27,42,0.1); font-size:13px; white-space:nowrap; }

    /* Referral funnel: one tile per step, reading left to right, with the
       outcome tile accented so the eye lands on what it produced. */
    .pf-share { display:flex; gap:12px; flex-wrap:wrap; margin:14px 0 18px; }
    .pf-share-step {
      flex:1 1 170px; min-width:160px; padding:12px 14px;
      border:1px solid rgba(42,27,42,0.12); border-radius:12px;
      background: var(--adm-paper-soft);
    }
    .pf-share-step--out { border-color: rgba(74,120,72,0.45); background: rgba(74,120,72,0.07); }
    .pf-share-key { font-size:11px; letter-spacing:0.4px; text-transform:uppercase; color:var(--adm-mute); }
    .pf-share-val { font-size:26px; font-weight:600; margin:2px 0 4px; }
    .pf-share-sub { font-size:11px; color:var(--adm-mute); line-height:1.5; }
    .pf-share-h3 { margin:18px 0 6px; font-size:15px; }
    .adm-muted { color:var(--adm-mute); font-size:11px; }
    .adm-inline-form { display:flex; gap:12px; align-items:center; flex-wrap:wrap; }

    /* The daily ledger stays a table — it *is* a ledger. Frozen header: the
       table scrolls inside its own box and the header cells stick to the top of
       that box. The shared .adm-table sets `overflow: hidden` (to clip its
       rounded corners), which would make the *table* the scroll container and
       trap the sticky header against it, so we override that back to visible. */
    .wk-perf-scroll { overflow: auto; max-height: 52vh; }
    .wk-perf { overflow: visible; border-radius: 0; }
    .wk-perf thead th {
      position: sticky; top: 0; z-index: 5;
      background: var(--adm-paper-soft);
      box-shadow: 0 1px 0 rgba(42,27,42,0.1);
    }

    /* ── One card per workshop, one card per row ──────────────────────────
       Everything a row of the old table held, laid out so it fits the page
       width at any size: identity, the ROAS it earned, money in vs money out,
       the attendance bar, then the rest as chips. */
    .pf-list { display: flex; flex-direction: column; gap: 10px; }
    .pf-card {
      display: grid;
      grid-template-columns: minmax(190px, 1.05fr) 118px minmax(210px, 1.25fr) minmax(210px, 1.2fr);
      gap: 11px 24px;
      align-items: center;
      background: var(--adm-paper-soft);
      border: 1px solid var(--adm-line);
      border-radius: 12px;
      padding: 14px 18px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .pf-card:hover { border-color: #d5cab1; box-shadow: 0 2px 10px rgba(43, 37, 25, 0.05); }
    .pf-card--total {
      background: linear-gradient(180deg, rgba(201, 96, 58, 0.055), rgba(201, 96, 58, 0.015));
      border-color: rgba(201, 96, 58, 0.3);
      margin-bottom: 16px;
    }
    .pf-card--total:hover { border-color: rgba(201, 96, 58, 0.45); }

    /* Identity */
    .pf-name {
      display: block; font-size: 14.5px; font-weight: 650; line-height: 1.25;
      color: var(--adm-ink); text-decoration: none; letter-spacing: -0.005em;
    }
    a.pf-name:hover { color: var(--adm-ember-deep); text-decoration: underline; }
    .pf-when { margin-top: 3px; font-size: 11.5px; color: var(--adm-mute); }
    .pf-status {
      display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 999px;
      background: rgba(43, 37, 25, 0.07); color: var(--adm-ink-soft);
      font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em;
    }
    /* Which campaigns' money can be charged here. */
    .pf-kind {
      display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 999px;
      background: rgba(201, 96, 58, 0.12); color: var(--adm-ember-deep);
      font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em;
    }

    /* The number that matters */
    .pf-roas b {
      display: block; font-size: 30px; font-weight: 650;
      letter-spacing: -0.025em; line-height: 1; font-variant-numeric: tabular-nums;
    }
    .pf-roas b.good { color: var(--adm-success); }
    .pf-roas b.bad { color: var(--adm-danger); }
    .pf-roas b.flat { color: var(--adm-mute); }
    .pf-roas span { display: block; margin-top: 5px; font-size: 10.5px; line-height: 1.35; color: var(--adm-mute); }

    /* Money in vs money out — one scale across every card, so the bars are
       comparable workshop to workshop. */
    .pf-money { display: flex; flex-direction: column; gap: 6px; }
    .pf-bar { display: flex; align-items: center; gap: 9px; font-size: 11.5px; }
    .pf-bar-key { width: 56px; flex: none; color: var(--adm-mute); }
    .pf-track {
      flex: 1; height: 9px; border-radius: 5px; overflow: hidden;
      background: rgba(43, 37, 25, 0.08);
    }
    .pf-fill { display: block; height: 100%; border-radius: 5px; min-width: 2px; }
    /* Revenue bar reads in two tones: the pale whole is the full value of the
       sales this session produced (a payment plan counts in full — see the
       note above the list), the solid part is what has been charged so far. */
    .pf-fill--rev { background: rgba(47, 122, 76, 0.34); }
    .pf-fill-paid { display: block; height: 100%; border-radius: 5px; background: var(--adm-success); }
    .pf-fill--cost { background: var(--adm-ember); }
    .pf-bar-amt {
      width: 66px; flex: none; text-align: right;
      font-variant-numeric: tabular-nums; color: var(--adm-ink); font-weight: 600;
    }
    .pf-money-note { margin: 3px 0 0; font-size: 11px; color: var(--adm-mute); }
    .pf-money-note b { color: var(--adm-ink-soft); font-weight: 600; }

    /* Attendance as one segmented bar */
    .pf-funnel { display: flex; flex-direction: column; gap: 6px; }
    .pf-funnel-top { font-size: 11.5px; color: var(--adm-ink-soft); }
    .pf-funnel-top b { color: var(--adm-ink); font-weight: 650; }
    .pf-seg {
      display: flex; height: 11px; border-radius: 5px; overflow: hidden;
      background: rgba(43, 37, 25, 0.08);
    }
    .pf-seg-part { display: block; height: 100%; }
    .pf-seg-part--live { background: #2f7a4c; }
    .pf-seg-part--replay { background: #86b295; }
    .pf-seg-part--noshow { background: #b53d3d; }
    .pf-seg-part--open { background: rgba(43, 37, 25, 0.16); }
    .pf-legend { display: flex; flex-wrap: wrap; gap: 12px; font-size: 10.5px; color: var(--adm-mute); }
    .pf-dot {
      display: inline-block; width: 7px; height: 7px; border-radius: 2px;
      margin-right: 5px; vertical-align: baseline;
    }
    .pf-dot--live { background: #2f7a4c; }
    .pf-dot--replay { background: #86b295; }
    .pf-dot--noshow { background: #b53d3d; }
    /* Not held yet — an empty bar plus a row of zeros would read as "nobody came". */
    .pf-pending {
      margin: 2px 0 0; padding: 5px 0 6px; font-size: 11px; font-style: italic;
      color: var(--adm-mute); border-top: 1px dashed var(--adm-line);
    }

    /* Everything else, as chips on their own row */
    .pf-chips {
      grid-column: 1 / -1;
      display: flex; flex-wrap: wrap; gap: 6px;
      padding-top: 10px; border-top: 1px solid var(--adm-line);
    }
    .pf-card--total .pf-chips { border-top-color: rgba(201, 96, 58, 0.22); }
    .pf-chip {
      padding: 4px 10px; border-radius: 999px;
      background: rgba(43, 37, 25, 0.045);
      font-size: 11.5px; color: var(--adm-ink-soft); white-space: nowrap;
    }
    .pf-chip b { color: var(--adm-ink); font-weight: 650; font-variant-numeric: tabular-nums; }

    /* Workshops with nothing in this window */
    .pf-idle { margin-top: 18px; }
    .pf-idle-head {
      margin: 0 0 8px; font-size: 11.5px; text-transform: uppercase;
      letter-spacing: 0.07em; color: var(--adm-mute);
    }
    .pf-idle-list { display: flex; flex-wrap: wrap; gap: 8px; }
    .pf-idle-item {
      padding: 6px 11px; border: 1px dashed var(--adm-line); border-radius: 9px;
      font-size: 12px; color: var(--adm-ink-soft); text-decoration: none;
      background: rgba(251, 246, 234, 0.6);
    }
    .pf-idle-item:hover { border-style: solid; color: var(--adm-ember-deep); }
    .pf-idle-item span { display: block; font-size: 10.5px; color: var(--adm-mute); }

    @media (max-width: 1080px) {
      .pf-card { grid-template-columns: minmax(170px, 1fr) 104px; }
      .pf-money, .pf-funnel { grid-column: 1 / -1; }
    }
    @media (max-width: 560px) {
      .pf-card { grid-template-columns: 1fr; gap: 12px; }
      .pf-roas { display: flex; align-items: baseline; gap: 10px; }
      .pf-roas b { font-size: 26px; }
      .pf-roas span { margin-top: 0; }
    }
  </style>

  <script is:inline>
    (function () {
      var ranges = JSON.parse(document.getElementById('perf-preset-ranges').textContent);
      var form = document.getElementById('perf-filter');
      var presetSel = document.getElementById('f-preset');
      var fromIn = document.getElementById('f-from');
      var toIn = document.getElementById('f-to');
      presetSel.addEventListener('change', function () {
        var v = presetSel.value;
        if (v === 'custom') return;
        var r = ranges[v] || { from: null, to: null };
        fromIn.value = r.from || '';
        toIn.value = r.to || '';
        form.submit();
      });
      function toCustom() { presetSel.value = 'custom'; }
      fromIn.addEventListener('change', toCustom);
      toIn.addEventListener('change', toCustom);
    })();
  </script>
</Layout>
