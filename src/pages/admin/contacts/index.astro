---
// Admin — marketing contacts. Upload a CSV (e.g. a Drip export) into the
// standalone `contacts` list that broadcasts send to. The file is parsed in the
// browser and posted in chunks, so a 55k import streams in with live progress
// and never trips a request limit. Columns are auto-detected: email (required),
// name / first+last name, timezone (IANA — drives local-time sending), country.
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import {
  countContacts,
  countSendable,
  recentContacts,
  countDeadDomainSuppressions,
  countBounceSuppressions,
  uncheckedContactDomainCount,
} from '../../../lib/broadcasts/db';

export const prerender = false;

const env = Astro.locals.runtime.env;
if (!(await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request)))) {
  return Astro.redirect('/admin/login');
}

const total = await countContacts(env.DB);
const sendable = await countSendable(env.DB);
const recent = await recentContacts(env.DB, 8);
// List-health figures for the dead-domain cleaner.
const deadSuppressed = await countDeadDomainSuppressions(env.DB);
const uncheckedDomains = await uncheckedContactDomainCount(env.DB);
// Addresses taken off by the bounce-checker loop + Resend hard bounces/complaints.
const bounceSuppressed = await countBounceSuppressions(env.DB);
---

<Layout title="Admin — Contacts — Songdance" description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs"><a href="/admin">Admin</a> <span class="sep">/</span> Contacts</p>
        <h1>Marketing contacts</h1>
        <p class="adm-sub">
          The standalone list that broadcasts send to — independent of workshop
          registrations. Unsubscribed / complained addresses are excluded from
          every send automatically.
        </p>
      </div>
      <div class="adm-actions">
        <a class="adm-btn" href="/admin/broadcasts">Broadcasts →</a>
        <a class="adm-btn adm-btn--ghost" href="/admin">← Admin</a>
      </div>
    </header>

    <section class="adm-section">
      <div class="ct-stats">
        <div class="ct-stat"><span class="ct-num" id="ct-total">{total.toLocaleString()}</span><span class="ct-lbl">contacts</span></div>
        <div class="ct-stat"><span class="ct-num">{sendable.toLocaleString()}</span><span class="ct-lbl">sendable (minus suppressions)</span></div>
        <div class="ct-stat"><span class="ct-num">{deadSuppressed.toLocaleString()}</span><span class="ct-lbl">at dead domains</span></div>
        <div class="ct-stat"><span class="ct-num">{bounceSuppressed.toLocaleString()}</span><span class="ct-lbl">bounced / complained</span></div>
      </div>
    </section>

    <section class="adm-section">
      <h2>List health</h2>
      <p class="ct-help">
        Check every contact's email domain for a working mail server (MX/A via
        DNS). Addresses at dead domains — no mail server, typo TLDs like
        <code>.con</code>, domains that no longer exist — are added to the
        suppression list, so they're skipped on this and <strong>every future
        broadcast</strong> and never bounce again. Non-destructive: the contacts
        stay, just flagged. Done once; new imports at a known-dead domain are
        auto-skipped. (Dead mailboxes at live providers — a closed Gmail, say —
        still resolve, so for those export a broadcast's queue and run a
        mailbox-level validator.)
      </p>
      <div class="ct-actions">
        <button id="ct-clean" class="adm-btn" type="button">Clean dead domains</button>
        <span id="ct-clean-msg" class="ct-progress">
          {uncheckedDomains > 0
            ? `${uncheckedDomains.toLocaleString()} domains not yet checked`
            : 'All domains checked'}
        </span>
      </div>
    </section>

    <section class="adm-section">
      <h2>Workshop follow-up segment</h2>
      <p class="ct-help">
        Tag everyone who <strong>registered for a workshop whose date has already
        passed</strong> and <strong>hasn't bought the 12-week or certification
        course</strong> — the exact audience for a post-workshop sale follow-up.
        A broadcast can only target tags, and it has no notion of a workshop's
        date, so people registered for a still-open <em>upcoming</em> session
        can't be told apart from past attendees by tag alone (they share the same
        source tag). This computes the cohort from the registration dates and
        writes it as one tag you can then include in a broadcast. Idempotent —
        re-run it right before you send and it picks up newly-passed workshops and
        drops anyone who has since bought. (Belt-and-suspenders: also keep
        <code>prod_SVH_12w, prod_SVH_9m</code> in the broadcast's <em>exclude</em>
        tags so any last-minute buyers are dropped at launch too.)
      </p>
      <div class="ct-actions">
        <label class="ct-inline-label">Tag
          <input id="seg-tag" type="text" value="workshop-passed-nonbuyer"
                 class="ct-input" spellcheck="false" />
        </label>
        <button id="seg-run" class="adm-btn" type="button">Build segment</button>
        <span id="seg-msg" class="ct-progress"></span>
      </div>
    </section>

    <section class="adm-section">
      <h2>Bounce check (mailbox-level)</h2>
      <p class="ct-help">
        Dead-domain cleaning can't catch a dead mailbox at a live provider (a
        closed Gmail still resolves Gmail's MX). For those, <strong>export the
        sendable list</strong>, run it through a bounce-checker (NeverBounce,
        ZeroBounce, Bouncer, …), then <strong>reimport the results</strong> here.
        Addresses you mark go onto the suppression list — skipped on this and
        every future broadcast, and removed from any live queue. Non-destructive:
        the contacts stay, just flagged. (Going forward, Resend hard bounces and
        spam complaints are now auto-suppressed too.)
      </p>
      <div class="ct-actions">
        <a class="adm-btn" href="/api/admin/contacts/export">Export sendable list (CSV)</a>
        <span class="ct-progress">{sendable.toLocaleString()} addresses</span>
      </div>

      <p class="ct-help" style="margin-top:18px;">
        Reimport the checker's results CSV. The email column and a result/status
        column are detected automatically; pick which result values mean
        undeliverable and suppress them. (No result column? Every address in the
        file is treated as bad.)
      </p>
      <input id="bc-file" type="file" accept=".csv,text/csv" class="ct-file" />
      <div id="bc-detected" class="ct-detected" hidden></div>
      <div id="bc-values" class="ct-values" hidden></div>
      <div class="ct-actions">
        <button id="bc-suppress" class="adm-btn" type="button" disabled>Suppress selected</button>
        <span id="bc-progress" class="ct-progress"></span>
      </div>
      <div id="bc-bar-wrap" class="ct-bar-wrap" hidden><div id="bc-bar" class="ct-bar"></div></div>
    </section>

    <section class="adm-section">
      <h2>Import a CSV</h2>
      <p class="ct-help">
        Headers are matched automatically. Expected columns:
        <code>email</code> (required), <code>name</code> (or
        <code>first name</code> + <code>last name</code>),
        <code>timezone</code> (IANA, e.g. <code>America/New_York</code>),
        <code>country</code> and <code>tags</code>. Every other column is
        preserved on the contact as custom data (so your full export is kept and
        is filterable when you target a broadcast). Re-importing the same address
        updates it; it never duplicates.
      </p>

      <input id="csv-file" type="file" accept=".csv,text/csv" class="ct-file" />

      <label class="ct-checkbox"><input type="checkbox" id="ct-skip-name" /> Skip the name column (keep existing names; don't import names from this file)</label>

      <div id="ct-detected" class="ct-detected" hidden></div>

      <div class="ct-actions">
        <button id="ct-import" class="adm-btn" type="button" disabled>Import</button>
        <span id="ct-progress" class="ct-progress"></span>
      </div>
      <div id="ct-bar-wrap" class="ct-bar-wrap" hidden><div id="ct-bar" class="ct-bar"></div></div>
    </section>

    {recent.length > 0 && (
      <section class="adm-section">
        <h2>Most recent</h2>
        <table class="ct-table">
          <thead><tr><th>Email</th><th>Name</th><th>Timezone</th><th>Country</th><th>Tags</th></tr></thead>
          <tbody>
            {recent.map((c) => (
              <tr>
                <td>{c.email}</td>
                <td>{c.name ?? '—'}</td>
                <td>{c.timezone ?? <span class="ct-muted">default window</span>}</td>
                <td>{c.country ?? '—'}</td>
                <td class="ct-tags">{c.tags ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}
  </main>

  <style>
    .ct-stats { display: flex; gap: 28px; }
    .ct-stat { display: flex; flex-direction: column; }
    .ct-num { font-size: 30px; font-weight: 600; color: #2a1b2a; font-variant-numeric: tabular-nums; }
    .ct-lbl { font-size: 13px; color: #6f5f6d; }
    .ct-help { font-size: 13.5px; color: #6f5f6d; line-height: 1.7; max-width: 60ch; }
    .ct-help code { background: #f4ecdf; padding: 1px 6px; border-radius: 5px; font-size: 12.5px; }
    .ct-file { display: block; margin: 14px 0; font-size: 14px; }
    .ct-checkbox { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: #4a3848; margin: 0 0 12px; cursor: pointer; }
    .ct-detected {
      font-size: 13.5px; color: #2a1b2a; background: #fbf6ec;
      border: 1px solid rgba(161,72,38,0.22); border-radius: 10px; padding: 12px 16px; margin: 6px 0 14px;
      line-height: 1.7;
    }
    .ct-detected .warn { color: #a14826; }
    .ct-detected code { background: #f4ecdf; padding: 1px 5px; border-radius: 4px; }
    .ct-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .ct-progress { font-size: 13px; color: #6f5f6d; }
    .ct-inline-label { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: #6f5f6d; }
    .ct-input { font: inherit; font-size: 13.5px; padding: 6px 10px; border: 1px solid rgba(161,72,38,0.3); border-radius: 8px; background: #fff; min-width: 220px; }
    .ct-bar-wrap { margin-top: 12px; height: 8px; background: #ece0cf; border-radius: 999px; overflow: hidden; max-width: 460px; }
    .ct-bar { height: 100%; width: 0; background: #a14826; transition: width 0.2s ease; }
    .ct-table { width: 100%; border-collapse: collapse; background: #fbf6ec; border: 1px solid rgba(161,72,38,0.22); border-radius: 12px; overflow: hidden; }
    .ct-table th, .ct-table td { padding: 9px 14px; text-align: left; font-size: 13.5px; border-bottom: 1px solid rgba(161,72,38,0.12); }
    .ct-table th { font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; color: #6f5f6d; }
    .ct-table tr:last-child td { border-bottom: none; }
    .ct-muted { color: #b6a8b4; }
    .ct-tags { color: #6f5f6d; font-size: 12px; max-width: 280px; }
    .ct-values { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 4px 0 14px; max-width: 64ch; }
    .ct-values label { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; color: #2a1b2a; cursor: pointer; }
    .ct-values .bad { color: #a14826; }
    .ct-values .cnt { color: #6f5f6d; font-variant-numeric: tabular-nums; }
  </style>

  <script is:inline>
    // ── Minimal CSV parser (handles quoted fields, embedded commas/quotes, CRLF) ──
    function parseCsv(text) {
      const rows = [];
      let row = [];
      let field = '';
      let inQuotes = false;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (inQuotes) {
          if (ch === '"') {
            if (text[i + 1] === '"') { field += '"'; i++; }
            else inQuotes = false;
          } else field += ch;
        } else if (ch === '"') {
          inQuotes = true;
        } else if (ch === ',') {
          row.push(field); field = '';
        } else if (ch === '\n') {
          row.push(field); rows.push(row); row = []; field = '';
        } else if (ch === '\r') {
          // swallow; \n handles the row break
        } else field += ch;
      }
      if (field.length > 0 || row.length > 0) { row.push(field); rows.push(row); }
      return rows.filter((r) => r.some((c) => c.trim() !== ''));
    }

    const norm = (s) => s.toLowerCase().replace(/[^a-z0-9]/g, '');

    function detectColumns(header) {
      const idx = { email: -1, name: -1, first: -1, last: -1, timezone: -1, country: -1, tags: -1, status: -1, result: -1, quality: -1 };
      header.forEach((h, i) => {
        const n = norm(h);
        if (idx.email < 0 && n.includes('email')) idx.email = i;
        else if (idx.timezone < 0 && (n.includes('timezone') || n === 'tz')) idx.timezone = i;
        else if (idx.tags < 0 && (n === 'tags' || n === 'tag')) idx.tags = i;
        else if (idx.status < 0 && n === 'status') idx.status = i;
        else if (idx.result < 0 && n === 'result') idx.result = i;       // email-verifier result
        else if (idx.quality < 0 && n === 'quality') idx.quality = i;     // email-verifier quality
        else if (idx.country < 0 && n.includes('country')) idx.country = i;
        else if (idx.first < 0 && (n === 'firstname' || n === 'first')) idx.first = i;
        else if (idx.last < 0 && (n === 'lastname' || n === 'last')) idx.last = i;
        else if (idx.name < 0 && (n === 'name' || n === 'fullname')) idx.name = i;
      });
      return idx;
    }

    // Map an email-verifier (e.g. MillionVerifier) result/quality to an action:
    // bad → suppress as invalid; risky → tag 'risky'; good/blank → no action.
    function verdictOf(result, quality) {
      const r = (result || '').trim().toLowerCase();
      const q = (quality || '').trim().toLowerCase();
      if (r === 'invalid' || r === 'disposable' || r === 'abuse' || q === 'bad') return 'bad';
      if (r === 'unknown' || r === 'catch_all' || r === 'catchall' || q === 'risky') return 'risky';
      if (r === 'ok' || q === 'good') return 'good';
      return ''; // not verified / unrecognised
    }

    const fileInput = document.getElementById('csv-file');
    const detected = document.getElementById('ct-detected');
    const importBtn = document.getElementById('ct-import');
    const progress = document.getElementById('ct-progress');
    const barWrap = document.getElementById('ct-bar-wrap');
    const bar = document.getElementById('ct-bar');
    const totalEl = document.getElementById('ct-total');

    let parsedRows = [];
    let parsed = null; // cached { header, rows } from the selected file
    const skipNameBox = document.getElementById('ct-skip-name');

    // Build the row payload + detection line from the cached file, honouring the
    // "skip name" toggle. Re-runnable so toggling the checkbox updates instantly.
    function rebuild() {
      if (!parsed) return;
      const { header, rows } = parsed;
      const idx = detectColumns(header);
      if (idx.email < 0) {
        detected.hidden = false;
        detected.innerHTML = '<span class="warn">No email column found. The CSV needs a header row with an <code>email</code> column.</span>';
        importBtn.disabled = true;
        return;
      }
      const useName = !(skipNameBox && skipNameBox.checked);
      // Explicitly-mapped columns never get duplicated into `custom`. name/first/
      // last stay mapped even when skipped, so a skipped name isn't stored as custom.
      const mapped = new Set([idx.email, idx.name, idx.first, idx.last, idx.timezone, idx.country, idx.tags]);
      const customCols = [];
      header.forEach((h, i) => { if (!mapped.has(i) && (h || '').trim()) customCols.push(i); });

      const hasVerdict = idx.result >= 0 || idx.quality >= 0;
      const out = [];
      let unsubCount = 0;
      let badCount = 0;
      let riskyCount = 0;
      for (let r = 1; r < rows.length; r++) {
        const cells = rows[r];
        const email = (cells[idx.email] || '').trim();
        if (!email) continue;
        let name = '';
        if (useName) {
          name = idx.name >= 0 ? (cells[idx.name] || '').trim() : '';
          if (!name && (idx.first >= 0 || idx.last >= 0)) {
            name = [idx.first >= 0 ? cells[idx.first] : '', idx.last >= 0 ? cells[idx.last] : '']
              .map((s) => (s || '').trim()).filter(Boolean).join(' ');
          }
        }
        const custom = {};
        for (const ci of customCols) {
          const v = (cells[ci] || '').trim();
          if (v) custom[header[ci].trim()] = v;
        }
        const unsubscribed = idx.status >= 0 && (cells[idx.status] || '').trim().toLowerCase() === 'unsubscribed';
        if (unsubscribed) unsubCount++;
        const verdict = hasVerdict
          ? verdictOf(idx.result >= 0 ? cells[idx.result] : '', idx.quality >= 0 ? cells[idx.quality] : '')
          : '';
        if (verdict === 'bad') badCount++;
        else if (verdict === 'risky') riskyCount++;
        out.push({
          email,
          name: name || null,
          timezone: idx.timezone >= 0 ? (cells[idx.timezone] || '').trim() || null : null,
          country: idx.country >= 0 ? (cells[idx.country] || '').trim() || null : null,
          tags: idx.tags >= 0 ? (cells[idx.tags] || '').trim() || null : null,
          custom: Object.keys(custom).length ? custom : null,
          unsubscribed,
          verdict: verdict || null,
        });
      }
      parsedRows = out;
      const cols = [];
      cols.push(`email → <code>${header[idx.email]}</code>`);
      if (!useName) cols.push('name → <span class="warn">skipped</span>');
      else if (idx.name >= 0) cols.push(`name → <code>${header[idx.name]}</code>`);
      else if (idx.first >= 0 || idx.last >= 0) cols.push('name → first + last');
      if (idx.timezone >= 0) cols.push(`timezone → <code>${header[idx.timezone]}</code>`);
      else cols.push('<span class="warn">no timezone column — those contacts use the default send window</span>');
      if (idx.tags >= 0) cols.push(`tags → <code>${header[idx.tags]}</code>`);
      if (idx.country >= 0) cols.push(`country → <code>${header[idx.country]}</code>`);
      if (customCols.length) cols.push(`+ ${customCols.length} custom fields preserved`);
      if (hasVerdict) cols.push(`verifier verdict → <code>${header[idx.result >= 0 ? idx.result : idx.quality]}</code>`);
      if (unsubCount > 0) cols.push(`<strong>${unsubCount.toLocaleString()}</strong> unsubscribed (stored, won't be emailed)`);
      if (badCount > 0) cols.push(`<strong>${badCount.toLocaleString()}</strong> invalid → suppressed`);
      if (riskyCount > 0) cols.push(`<strong>${riskyCount.toLocaleString()}</strong> risky → tagged <code>risky</code>`);
      detected.hidden = false;
      detected.innerHTML = `<strong>${out.length.toLocaleString()}</strong> rows ready · ${cols.join(' · ')}`;
      importBtn.disabled = out.length === 0;
    }

    fileInput.addEventListener('change', async () => {
      parsedRows = [];
      parsed = null;
      importBtn.disabled = true;
      detected.hidden = true;
      const file = fileInput.files && fileInput.files[0];
      if (!file) return;
      const text = await file.text();
      const rows = parseCsv(text);
      if (rows.length < 2) {
        detected.hidden = false;
        detected.innerHTML = '<span class="warn">Could not read any data rows from that file.</span>';
        return;
      }
      parsed = { header: rows[0], rows };
      rebuild();
    });

    if (skipNameBox) skipNameBox.addEventListener('change', rebuild);

    importBtn.addEventListener('click', async () => {
      if (parsedRows.length === 0) return;
      importBtn.disabled = true;
      fileInput.disabled = true;
      barWrap.hidden = false;
      const CHUNK = 200; // each row may carry many custom fields; keeps the batch modest
      let done = 0;
      let processed = 0;
      let suppressed = 0;
      let risky = 0;
      let latestTotal = null;
      try {
        for (let i = 0; i < parsedRows.length; i += CHUNK) {
          const chunk = parsedRows.slice(i, i + CHUNK);
          const res = await fetch('/api/admin/contacts/import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rows: chunk, source: 'csv-import' }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Import failed');
          processed += data.processed || 0;
          suppressed += data.suppressed || 0;
          risky += data.risky || 0;
          latestTotal = data.total;
          done += chunk.length;
          const pct = Math.round((done / parsedRows.length) * 100);
          bar.style.width = pct + '%';
          progress.textContent = `${done.toLocaleString()} / ${parsedRows.length.toLocaleString()} (${pct}%)`;
        }
        progress.textContent =
          `Imported ${processed.toLocaleString()} contacts. ✓` +
          (suppressed > 0 ? ` · ${suppressed.toLocaleString()} suppressed (invalid/unsub)` : '') +
          (risky > 0 ? ` · ${risky.toLocaleString()} tagged risky` : '');
        if (latestTotal != null && totalEl) totalEl.textContent = Number(latestTotal).toLocaleString();
      } catch (err) {
        progress.textContent = 'Failed: ' + (err && err.message ? err.message : String(err));
        importBtn.disabled = false;
      } finally {
        fileInput.disabled = false;
      }
    });

    // Clean dead domains — loops the batch endpoint until every contact domain
    // is resolved, then the server suppresses addresses at dead domains.
    (function () {
      const btn = document.getElementById('ct-clean');
      if (!btn) return;
      const msg = document.getElementById('ct-clean-msg');
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        let checked = 0;
        let dead = 0;
        let removed = 0;
        msg.textContent = 'Checking domains…';
        try {
          for (;;) {
            const res = await fetch('/api/admin/contacts/clean', {
              method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}',
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Clean failed');
            checked += data.checked || 0;
            dead += data.dead || 0;
            removed += data.removed || 0;
            msg.textContent =
              `Checked ${checked.toLocaleString()} domains · ${dead.toLocaleString()} dead · ` +
              `${Number(data.remaining).toLocaleString()} left…`;
            if (data.remaining === 0) break;
            if (!data.checked) break; // safety: no progress
          }
          msg.textContent =
            `Done — ${removed.toLocaleString()} addresses at dead domains suppressed. Reload to update counts.`;
        } catch (err) {
          msg.textContent = 'Failed: ' + (err && err.message ? err.message : String(err));
        }
        btn.disabled = false;
      });
    })();

    // Workshop follow-up segment — tag past-workshop registrants who haven't
    // bought the course, so a broadcast can target that one tag.
    (function () {
      const btn = document.getElementById('seg-run');
      if (!btn) return;
      const tagInput = document.getElementById('seg-tag');
      const msg = document.getElementById('seg-msg');
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        msg.textContent = 'Building segment…';
        try {
          const res = await fetch('/api/admin/contacts/segment-workshop', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tag: (tagInput && tagInput.value) || undefined }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Segment build failed');
          msg.textContent =
            `Done — ${Number(data.sendable).toLocaleString()} contacts tagged “${data.tag}” ` +
            `(${Number(data.added).toLocaleString()} new this run). ` +
            `Include that tag in a broadcast to send to them.`;
        } catch (err) {
          msg.textContent = 'Failed: ' + (err && err.message ? err.message : String(err));
        }
        btn.disabled = false;
      });
    })();

    // ── Bounce-check reimport — upload a validator's results, pick the bad
    // result values, suppress those addresses (and scrub live queues). ──────────
    (function () {
      const file = document.getElementById('bc-file');
      if (!file) return;
      const detected = document.getElementById('bc-detected');
      const valuesEl = document.getElementById('bc-values');
      const suppressBtn = document.getElementById('bc-suppress');
      const progress = document.getElementById('bc-progress');
      const barWrap = document.getElementById('bc-bar-wrap');
      const bar = document.getElementById('bc-bar');
      const totalEl = document.getElementById('ct-total');

      // Result values a checker uses for an undeliverable address — pre-checked.
      // Risky / unknown / catch-all / disposable are judgment calls: shown, left
      // off, the user opts in.
      const BAD = /invalid|undeliver|^bad$|donotmail|do_not_mail|spamtrap|spam_trap|abuse|bounce|reject|fail|hardbounce/;

      // rows: [{ email, status }]; statusCol present when a result column found.
      let rows = [];
      let hasStatus = false;

      function detectStatusCol(header) {
        for (let i = 0; i < header.length; i++) {
          const n = norm(header[i]);
          if (n.includes('result') || n.includes('status') || n === 'verdict' ||
              n.includes('deliverab') || n.includes('zbstatus') || n.includes('state')) {
            return i;
          }
        }
        return -1;
      }

      file.addEventListener('change', async () => {
        rows = [];
        suppressBtn.disabled = true;
        detected.hidden = true;
        valuesEl.hidden = true;
        valuesEl.innerHTML = '';
        progress.textContent = '';
        const f = file.files && file.files[0];
        if (!f) return;
        const parsed = parseCsv(await f.text());
        if (parsed.length < 2) {
          detected.hidden = false;
          detected.innerHTML = '<span class="warn">Could not read any data rows from that file.</span>';
          return;
        }
        const header = parsed[0];
        const idx = detectColumns(header); // reuse — finds the email column
        if (idx.email < 0) {
          detected.hidden = false;
          detected.innerHTML = '<span class="warn">No email column found in the results file.</span>';
          return;
        }
        const statusCol = detectStatusCol(header);
        hasStatus = statusCol >= 0;

        const counts = new Map(); // lowercased status value → count
        for (let r = 1; r < parsed.length; r++) {
          const email = (parsed[r][idx.email] || '').trim().toLowerCase();
          if (!email) continue;
          const status = hasStatus ? (parsed[r][statusCol] || '').trim() : '';
          rows.push({ email, status });
          if (hasStatus) {
            const key = status.toLowerCase() || '(blank)';
            counts.set(key, (counts.get(key) || 0) + 1);
          }
        }

        detected.hidden = false;
        if (!hasStatus) {
          detected.innerHTML =
            `<strong>${rows.length.toLocaleString()}</strong> addresses · ` +
            `<span class="warn">no result column detected — every address in this file will be suppressed.</span>`;
          suppressBtn.disabled = rows.length === 0;
          return;
        }

        detected.innerHTML =
          `<strong>${rows.length.toLocaleString()}</strong> addresses · result column → ` +
          `<code>${header[statusCol]}</code>. Tick the values that mean undeliverable:`;
        const entries = [...counts.entries()].sort((a, b) => b[1] - a[1]);
        valuesEl.hidden = false;
        valuesEl.innerHTML = entries.map(([val, n]) => {
          const bad = BAD.test(norm(val));
          return `<label><input type="checkbox" value="${encodeURIComponent(val)}"${bad ? ' checked' : ''}>` +
            `<span class="${bad ? 'bad' : ''}">${val}</span> <span class="cnt">(${n.toLocaleString()})</span></label>`;
        }).join('');
        suppressBtn.disabled = false;
      });

      suppressBtn.addEventListener('click', async () => {
        let targets;
        if (hasStatus) {
          const chosen = new Set(
            [...valuesEl.querySelectorAll('input:checked')].map((c) => decodeURIComponent(c.value)),
          );
          targets = rows.filter((r) => chosen.has(r.status.toLowerCase() || '(blank)')).map((r) => r.email);
        } else {
          targets = rows.map((r) => r.email);
        }
        targets = [...new Set(targets)];
        if (targets.length === 0) {
          progress.textContent = 'Nothing selected.';
          return;
        }
        if (!confirm(`Suppress ${targets.length.toLocaleString()} address(es)? They'll be skipped on every future send.`)) return;

        suppressBtn.disabled = true;
        file.disabled = true;
        barWrap.hidden = false;
        const CHUNK = 2000;
        let done = 0;
        let suppressed = 0;
        let scrubbed = 0;
        let sendable = null;
        try {
          for (let i = 0; i < targets.length; i += CHUNK) {
            const slice = targets.slice(i, i + CHUNK);
            const res = await fetch('/api/admin/contacts/suppress', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ emails: slice, reason: 'bounced' }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Suppress failed');
            suppressed += data.suppressed || 0;
            scrubbed += data.scrubbed || 0;
            sendable = data.sendable;
            done += slice.length;
            const pct = Math.round((done / targets.length) * 100);
            bar.style.width = pct + '%';
            progress.textContent = `${done.toLocaleString()} / ${targets.length.toLocaleString()} (${pct}%)`;
          }
          progress.textContent =
            `Suppressed ${suppressed.toLocaleString()} new address(es). ✓` +
            (scrubbed > 0 ? ` (${scrubbed.toLocaleString()} removed from live queues)` : '') +
            ' Reload to update counts.';
        } catch (err) {
          progress.textContent = 'Failed: ' + (err && err.message ? err.message : String(err));
          suppressBtn.disabled = false;
        } finally {
          file.disabled = false;
        }
      });
    })();
  </script>
</Layout>
