---
import Layout from '../../layouts/Layout.astro';
import { safeAdminNext } from '../../lib/registrations/auth';

export const prerender = false;

const error = Astro.url.searchParams.get('error');
// Where to go after signing in. Set when an admin was bounced here mid-task
// (a form POST on a lapsed session — see src/middleware.ts), so they land back
// on the page they pressed the button on. Sanitised to an in-site admin path.
const next = safeAdminNext(Astro.url.searchParams.get('next'));
---

<Layout title="Admin login — Songdance" description="">
  <main style="max-width: 360px; margin: 120px auto; padding: 0 24px; font-family: Georgia, serif;">
    <h1 style="font-size: 1.5rem; margin-bottom: 24px;">Admin login</h1>
    {error && (
      <p style="color: #b22; margin-bottom: 16px;">Incorrect email or password.</p>
    )}
    {next !== '/admin' && (
      <p style="margin-bottom: 16px; color: #6b6257;">
        Your session had expired. Sign in and we'll take you back to what you were doing.
      </p>
    )}
    <form method="POST" action="/api/admin/login" style="display: flex; flex-direction: column; gap: 12px;">
      <input type="hidden" name="next" value={next} />
      <input
        type="email"
        name="email"
        placeholder="Email"
        required
        autocomplete="username"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        style="padding: 10px 12px; border: 1px solid #c8c0b1; border-radius: 4px;"
      />
      <input
        type="password"
        name="password"
        placeholder="Password"
        required
        autocomplete="current-password"
        style="padding: 10px 12px; border: 1px solid #c8c0b1; border-radius: 4px;"
      />
      <button
        type="submit"
        style="padding: 10px 14px; background: #2b2519; color: #fff; border: none; border-radius: 4px; cursor: pointer;"
      >Sign in</button>
    </form>
  </main>
</Layout>
