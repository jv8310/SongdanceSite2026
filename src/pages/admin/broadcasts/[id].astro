---
// Admin — a single broadcast. Draft: edit (with live preview), test-send, then
// launch. Sending/paused/done: live progress + engagement (open/click/bounce/
// complaint), with pause/resume. Delivery itself is the cron's job.
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import {
  getBroadcast,
  recipientCounts,
  broadcastStats,
  broadcastEmailType,
  countAudience,
  availableTags,
  cleaningCounts,
  pendingByTimezone,
  failedReasons,
} from '../../../lib/broadcasts/db';
import { previewBroadcast } from '../../../lib/broadcasts/email';
import { dripHtmlForBroadcast } from '../../../lib/broadcasts/drip';
import { DEFAULT_SEND_TZ, localHour } from '../../../lib/workshops/time';

export const prerender = false;

const env = Astro.locals.runtime.env;
if (!(await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request)))) {
  return Astro.redirect('/admin/login');
}

const id = Number(Astro.params.id);
const b = Number.isFinite(id) ? await getBroadcast(env.DB, id) : null;
if (!b) return Astro.redirect('/admin/broadcasts');

const isDraft = b.status === 'draft';
// Editable until done — content edits to a sending/paused broadcast flow to
// recipients not yet sent (the cron re-renders each batch).
const isEditable = b.status !== 'done';
const counts = await recipientCounts(env.DB, b.id);
const stats = await broadcastStats(env.DB, broadcastEmailType(b.id));
// The audience this broadcast targets right now (criteria minus suppressions).
const audience = await countAudience(env.DB, {
  includeTags: b.audience_include_tags,
  excludeTags: b.audience_exclude_tags,
  field: b.audience_field,
  fieldValue: b.audience_field_value,
});
const tags = isEditable ? await availableTags(env.DB, 1000) : [];
const hasAudienceFilter = !!(b.audience_include_tags || b.audience_exclude_tags || b.audience_field);
const preview = previewBroadcast(b, env.PUBLIC_BASE_URL);
const dripHtml = dripHtmlForBroadcast(b);
// A human label for an armed auto-stop, formatted in the business timezone so
// "midnight Brussels" reads plainly regardless of where the admin is sitting.
const stopAtLabel =
  b.stop_at && Number.isFinite(Date.parse(b.stop_at))
    ? new Date(b.stop_at).toLocaleString('en-GB', {
        timeZone: 'Europe/Brussels',
        weekday: 'short',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }) + ' (Brussels)'
    : '';
// How much the queue cleaning has removed (dead domains vs by tag), and when it
// last ran — so "did I already clean this?" is answerable at a glance.
const clean = isDraft ? { deadDomain: 0, byTag: 0 } : await cleaningCounts(env.DB, b.id);
// Why the failed rows failed — grouped error text, so "what is that about?" is
// answerable without a DB console. A 'failed' row is terminal (3 retries spent);
// a 429/rate-limit reason is wreckage from before the batch-send fix.
const failReasons = !isDraft && counts.failed > 0 ? await failedReasons(env.DB, b.id) : [];

// Pacing breakdown — why a "Sending" broadcast with a full queue can still
// trickle. The cron only mails a recipient inside their LOCAL send window
// (window_start_hour–window_end_hour), so the eligible-right-now slice of the
// queue is what actually paces a tick — not the per-run cap. Bucket the pending
// queue by stored timezone and compute, against the current instant, how many
// are awake/in-window now vs asleep, plus how many carry no timezone (which ride
// the default zone). Only worth computing while there's a live queue.
const showPacing = (b.status === 'sending' || b.status === 'paused') && counts.pending > 0;
const tzGroups = showPacing ? await pendingByTimezone(env.DB, b.id) : [];
const nowMs = Date.now();
let inWindowNow = 0;
let asleepNow = 0;
let noTimezone = 0;
// Roll the pending queue up by IANA region (the part before the first "/", e.g.
// "Europe", "America", "Asia") for a high-level overview — a region spans many
// local hours, so instead of a per-zone "local now" we show how much of each
// region is eligible-now vs asleep. Eligibility is still decided per underlying
// timezone (each has its own local clock) and then summed into its region.
// No-timezone recipients ride DEFAULT_SEND_TZ but get their own row — an unknown
// zone is semantically distinct from a real region.
type PaceRegion = { region: string; n: number; eligible: number; isNull: boolean };
const regionMap = new Map<string, PaceRegion>();
for (const g of tzGroups) {
  const isNull = g.timezone == null;
  const hour = localHour(g.timezone || DEFAULT_SEND_TZ, nowMs);
  const inWindow = hour >= b.window_start_hour && hour < b.window_end_hour;
  if (isNull) noTimezone += g.n;
  if (inWindow) inWindowNow += g.n;
  else asleepNow += g.n;
  const key = isNull ? '~none' : g.timezone!.split('/')[0];
  const label = isNull ? `(no timezone → ${DEFAULT_SEND_TZ})` : key;
  const cur = regionMap.get(key) ?? { region: label, n: 0, eligible: 0, isNull };
  cur.n += g.n;
  if (inWindow) cur.eligible += g.n;
  regionMap.set(key, cur);
}
// A handful of regions, so show them all — no-timezone row last, rest by size.
const regionRows = [...regionMap.values()].sort((a, c) =>
  a.isNull === c.isNull ? c.n - a.n : a.isNull ? 1 : -1,
);

const pct = (r: number) => `${(r * 100).toFixed(1)}%`;
// SQLite datetime('now') is UTC, no zone marker — read it as UTC, show it local.
const fmtWhen = (s: string | null): string | null => {
  if (!s) return null;
  const d = new Date(s.replace(' ', 'T') + 'Z');
  if (Number.isNaN(d.getTime())) return s;
  return new Intl.DateTimeFormat('en-GB', {
    dateStyle: 'medium', timeStyle: 'short', timeZone: DEFAULT_SEND_TZ,
  }).format(d);
};
const lastCleaned = fmtWhen(b.last_cleaned_at);
const statusLabel: Record<string, string> = {
  draft: 'Draft', sending: 'Sending', paused: 'Paused', done: 'Done',
};
---

<Layout title={`Admin — ${b.name} — Songdance`} description="">
  <main class="adm" data-status={b.status}>
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs">
          <a href="/admin">Admin</a> <span class="sep">/</span>
          <a href="/admin/broadcasts">Broadcasts</a> <span class="sep">/</span> {b.name}
        </p>
        <h1>{b.name} <span class={`bc-pill bc-pill--${b.status}`}>{statusLabel[b.status]}</span></h1>
        <p class="adm-sub">Subject: {b.subject} · {b.format === 'html' ? 'HTML' : 'Simple'} · {b.urgent ? '⚡ urgent — local-time windows ignored' : `window ${b.window_start_hour}:00–${b.window_end_hour}:00 local`}</p>
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--ghost" href="/admin/broadcasts">← All broadcasts</a>
      </div>
    </header>

    {b.status === 'paused' && b.paused_reason && (
      <div class="adm-flash adm-flash--warn">{b.paused_reason}</div>
    )}

    <section class="adm-section">
      <h2>Send</h2>
      {isDraft ? (
        <div class="bc-launch">
          <p>
            This will queue <strong>{audience.toLocaleString()}</strong> contacts
            ({hasAudienceFilter ? 'matching your audience filter' : 'the whole list'}, minus
            unsubscribes). They'll be sent over the coming days, only inside each
            recipient's local {b.window_start_hour}:00–{b.window_end_hour}:00, and
            the send auto-pauses if bounces or spam complaints spike.
          </p>
          <button id="bc-launch" class="adm-btn" type="button" data-id={b.id}>Launch broadcast →</button>
          <span id="bc-launch-msg" class="bc-msg"></span>
        </div>
      ) : (
        <div>
          <div class="bc-stats">
            <div class="bc-stat"><span class="n">{counts.sent.toLocaleString()}</span><span class="l">sent</span></div>
            <div class="bc-stat"><span class="n">{counts.pending.toLocaleString()}</span><span class="l">queued</span></div>
            <div class="bc-stat"><span class="n">{counts.suppressed.toLocaleString()}</span><span class="l">skipped</span></div>
            <div class="bc-stat"><span class="n">{counts.failed.toLocaleString()}</span><span class="l">failed</span></div>
            <div class="bc-stat"><span class="n">{counts.total.toLocaleString()}</span><span class="l">total audience</span></div>
          </div>
          <div class="bc-stats bc-stats--eng">
            <div class="bc-stat"><span class="n">{stats.delivered.toLocaleString()}</span><span class="l">delivered</span></div>
            <div class="bc-stat"><span class="n">{pct(stats.openRate)}</span><span class="l">open rate ({stats.opened})</span></div>
            <div class="bc-stat"><span class="n">{pct(stats.clickRate)}</span><span class="l">click rate ({stats.clicked})</span></div>
            <div class="bc-stat"><span class="n">{stats.bounced.toLocaleString()}</span><span class="l">bounced ({stats.hardBounced.toLocaleString()} hard)</span></div>
            <div class="bc-stat"><span class="n">{stats.complained.toLocaleString()}</span><span class="l">spam</span></div>
          </div>
          <p class="bc-note">
            Open/click data flows in from the Resend webhook; it also appears on
            <a href="/admin/emails/stats">email stats</a> under “Broadcasts”.
          </p>

          {failReasons.length > 0 && (
            <details class="bc-fails">
              <summary><strong>{counts.failed.toLocaleString()} failed</strong> — why they didn't send (top reasons)</summary>
              <p class="bc-note">
                A <em>failed</em> row is one whose send was attempted and exhausted its 3 retries — it's terminal
                (never re-tried automatically, and a “top up &amp; resume” skips it). A <strong>429 / rate-limit</strong>
                reason is wreckage from before the batch-send fix (the old sender overran Resend's request limit);
                a <strong>422 / validation</strong> reason means a bad address.
              </p>
              <table class="bc-fail-tbl">
                <thead><tr><th>Error (first 60 chars)</th><th>Count</th></tr></thead>
                <tbody>
                  {failReasons.map((f) => (
                    <tr><td><code>{f.reason}</code></td><td>{f.n.toLocaleString()}</td></tr>
                  ))}
                </tbody>
              </table>
            </details>
          )}

          {showPacing && (
            <div class={`bc-pace${b.urgent ? ' bc-pace--urgent' : ''}`}>
              <strong>Pacing — who's eligible right now</strong>
              {b.urgent ? (
                <p class="bc-pace-lead">
                  <strong>⚡ Urgent mode is on</strong> — local-time windows are ignored, so all
                  {' '}<strong>{counts.pending.toLocaleString()}</strong> still queued are eligible every tick and the
                  send drains as fast as the cap allows (~3,000/tick ≈ tens of thousands per hour, bounded by Resend's send
                  rate). The breakdown below is just where the remaining queue is in the world.
                </p>
              ) : (
                <p class="bc-pace-lead">
                  The cron only mails a recipient inside their local {b.window_start_hour}:00–{b.window_end_hour}:00 window.
                  Of the <strong>{counts.pending.toLocaleString()}</strong> still queued,
                  {' '}<strong>{inWindowNow.toLocaleString()}</strong> are inside that window right now (eligible this tick)
                  and <strong>{asleepNow.toLocaleString()}</strong> are outside it — those resume automatically at their
                  own local morning.
                  {noTimezone > 0 && <> {noTimezone.toLocaleString()} of the queue carry no timezone and ride {DEFAULT_SEND_TZ}.</>}
                </p>
              )}
              <table class="bc-pace-tz">
                <thead><tr><th>Region</th><th>Queued</th><th>Eligible now</th><th>Asleep</th></tr></thead>
                <tbody>
                  {regionRows.map((r) => {
                    const elig = b.urgent ? r.n : r.eligible;
                    const asleep = r.n - elig;
                    return (
                      <tr class={b.urgent || elig >= asleep ? 'in' : 'out'}>
                        <td>{r.region}</td>
                        <td>{r.n.toLocaleString()}</td>
                        <td class={elig > 0 ? 'elig' : 'zero'}>{elig.toLocaleString()}</td>
                        <td class={asleep > 0 ? 'slept' : 'zero'}>{asleep.toLocaleString()}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              {!b.urgent && (
                <p class="bc-note">
                  Throughput tops out at ~350/tick, but only across the eligible slice — so when most of the queue is
                  asleep it paces slowly by design (nothing is failing). To push the whole list out now regardless of
                  local hour — e.g. for a same-day deadline — hit <strong>⚡ Send now</strong> above (or widen the send
                  window toward 0:00–24:00 below); it takes effect on the next tick.
                </p>
              )}
            </div>
          )}

          {(clean.deadDomain > 0 || clean.byTag > 0 || lastCleaned) && (
            <p class="bc-note bc-cleanstatus">
              <strong>Queue cleaned{lastCleaned ? ` · last run ${lastCleaned}` : ''}:</strong>
              {' '}{clean.deadDomain.toLocaleString()} removed at dead domains ·
              {' '}{clean.byTag.toLocaleString()} removed by tag
              {' '}(part of the {counts.suppressed.toLocaleString()} skipped above).
            </p>
          )}

          {counts.pending > 0 && (
            <div class="bc-clean">
              <strong>List health</strong>
              <p>
                Dead domains (no mail server / typo domains) are cleaned at the
                list level now — run <a href="/admin/contacts">Clean dead domains on Contacts</a>
                {' '}once and they're suppressed for this and every future broadcast.
                For dead mailboxes at live providers (e.g. closed Gmail accounts),
                <a href={`/api/admin/broadcasts/export?id=${b.id}`}>export the remaining list</a>
                and run it through a validator, then re-import the verified-good addresses.
              </p>

              <div class="bc-clean-tags">
                <label for="bc-extags">Remove queued contacts carrying tags <em>(comma-separated — e.g. a Drip “undeliverable” / “bounced” tag)</em></label>
                <div class="bc-clean-tagrow">
                  <input id="bc-extags" type="text" value={b.audience_exclude_tags ?? ''} placeholder="bounced, undeliverable" />
                  <button id="bc-extags-btn" class="adm-btn adm-btn--ghost" type="button" data-id={b.id}>Remove from queue</button>
                </div>
                <span id="bc-extags-msg" class="bc-msg"></span>
              </div>
            </div>
          )}

          <div class="bc-actions">
            {b.status === 'sending' && <button class="adm-btn adm-btn--ghost bc-ctl" type="button" data-id={b.id} data-action="pause">Pause</button>}
            {b.status === 'paused' && <button class="adm-btn bc-ctl" type="button" data-id={b.id} data-action="resume">Resume</button>}
            {b.status === 'paused' && <button class="adm-btn adm-btn--ghost bc-ctl" type="button" data-id={b.id} data-action="launch">Top up &amp; resume</button>}
            {(b.status === 'sending' || b.status === 'paused') && (b.urgent ? (
              <button class="adm-btn adm-btn--ghost bc-ctl" type="button" data-id={b.id} data-action="urgent_off">Restore local-time windows</button>
            ) : (
              <button class="adm-btn bc-ctl" type="button" data-id={b.id} data-action="urgent_on" data-confirm="Send to the whole remaining queue as fast as possible, ignoring each recipient's local time-of-day window? Right for a hard deadline — but some people will receive it in the middle of their local night.">⚡ Send now — ignore time windows</button>
            ))}
            {counts.failed > 0 && (
              <button class="adm-btn adm-btn--ghost bc-ctl" type="button" data-id={b.id} data-action="retry_failed" data-confirm={`Requeue all ${counts.failed.toLocaleString()} failed recipients and send to them under the fixed batch path? They failed on a platform limit (not bad addresses), so they should deliver — but this does re-send the email to those ${counts.failed.toLocaleString()} people.`}>↻ Retry {counts.failed.toLocaleString()} failed</button>
            )}
            <span id="bc-ctl-msg" class="bc-msg"></span>
          </div>
        </div>
      )}

      {b.status !== 'done' && (
        <div class="bc-stopat">
          <strong>Auto-stop (deadline)</strong>
          <p class="bc-stopat-note">
            {b.stop_at ? (
              <>⏱ Armed — this broadcast ends itself at <strong>{stopAtLabel}</strong>, and nothing is sent after that. Any recipients still queued at that moment are left unsent.</>
            ) : (
              <>Off. Set a moment (entered in <em>your</em> local time) for the send to end itself — e.g. the instant a sale closes — so a "closes tonight" mail never lands after the deadline. Pairs with ⚡ Send now for a hard cut-off.</>
            )}
          </p>
          <div class="bc-stopat-row">
            <input id="bc-stopat-input" type="datetime-local" />
            <button id="bc-stopat-set" class="adm-btn adm-btn--ghost" type="button" data-id={b.id}>{b.stop_at ? 'Change' : 'Set auto-stop'}</button>
            {b.stop_at && <button id="bc-stopat-clear" class="adm-btn adm-btn--ghost" type="button" data-id={b.id}>Clear</button>}
          </div>
          <span id="bc-stopat-msg" class="bc-msg"></span>
        </div>
      )}
    </section>

    <div class="bc-grid">
      <section class="adm-section">
        <h2>{isDraft ? 'Compose' : 'Email'}</h2>
        {!isDraft && isEditable && (
          <p class="bc-editnote">Editing a live broadcast — changes apply to recipients not yet sent. (Audience changes need a re-launch.)</p>
        )}
        {isEditable ? (
          <form id="bc-edit" class="bc-form">
            <input type="hidden" name="id" value={b.id} />
            <label class="bc-field"><span>Internal name</span><input name="name" required value={b.name} /></label>
            <label class="bc-field"><span>Subject line</span><input name="subject" required value={b.subject} /></label>
            <label class="bc-field">
              <span>Content format</span>
              <select name="format" id="bc-format">
                <option value="simple" selected={b.format !== 'html'}>Simple — Songdance template</option>
                <option value="html" selected={b.format === 'html'}>Paste HTML — your own code</option>
              </select>
            </label>
            <div class="bc-simple-only">
              <label class="bc-field"><span>Heading</span><input name="heading" value={b.heading} /></label>
              <label class="bc-field"><span>Preheader</span><input name="preheader" value={b.preheader ?? ''} /></label>
            </div>
            <label class="bc-field"><span id="bc-body-label">Body</span><textarea name="body" rows="12" required>{b.body}</textarea></label>
            <label class="bc-field"><span>Plain-text version <em>(optional)</em></span><textarea name="body_text" rows="3">{b.body_text ?? ''}</textarea></label>
            <div class="bc-simple-only">
              <label class="bc-field"><span>Hero image URL</span><input name="hero_image" value={b.hero_image ?? ''} /></label>
              <div class="bc-row">
                <label class="bc-field"><span>Button label</span><input name="cta_label" value={b.cta_label ?? ''} /></label>
                <label class="bc-field"><span>Button link</span><input name="cta_href" value={b.cta_href ?? ''} /></label>
              </div>
            </div>
            <div class="bc-row">
              <label class="bc-field"><span>Send window start <em>(0–23)</em></span><input name="window_start_hour" type="number" min="0" max="23" value={b.window_start_hour} /></label>
              <label class="bc-field"><span>end <em>(1–24)</em></span><input name="window_end_hour" type="number" min="1" max="24" value={b.window_end_hour} /></label>
            </div>

            <fieldset class="bc-audience">
              <legend>Audience <span id="bc-aud-count" class="bc-aud-count"></span></legend>
              <label class="bc-field"><span>Include tags <em>(match ANY; blank = everyone)</em></span><input name="audience_include_tags" id="aud-include" value={b.audience_include_tags ?? ''} /></label>
              <label class="bc-field"><span>Exclude tags</span><input name="audience_exclude_tags" value={b.audience_exclude_tags ?? ''} /></label>
              <div class="bc-row">
                <label class="bc-field"><span>Field filter</span><input name="audience_field" value={b.audience_field ?? ''} /></label>
                <label class="bc-field"><span>equals</span><input name="audience_field_value" value={b.audience_field_value ?? ''} /></label>
              </div>
              {tags.length > 0 && (
                <div class="bc-tagcloud">
                  <span class="bc-tagcloud-label">Your {tags.length.toLocaleString()} tags — click to include, or type any tag name into the fields above.</span>
                  <input type="text" class="bc-tagsearch" placeholder="Filter tags…" />
                  <div class="bc-tagchips">
                    {tags.map((t) => (
                      <button type="button" class="bc-tagchip" data-tag={t.tag}>{t.tag} <span>{t.n.toLocaleString()}</span></button>
                    ))}
                  </div>
                </div>
              )}
            </fieldset>

            <div class="bc-actions">
              <button class="adm-btn" type="submit">Save changes</button>
              <span id="bc-save-msg" class="bc-msg"></span>
            </div>
          </form>
        ) : (
          <dl class="bc-readonly">
            <dt>Format</dt><dd>{b.format === 'html' ? 'Pasted HTML' : 'Simple template'}</dd>
            <dt>Audience</dt><dd>{hasAudienceFilter ? [
              b.audience_include_tags ? `include: ${b.audience_include_tags}` : null,
              b.audience_exclude_tags ? `exclude: ${b.audience_exclude_tags}` : null,
              b.audience_field ? `${b.audience_field} = ${b.audience_field_value ?? ''}` : null,
            ].filter(Boolean).join(' · ') : 'Whole list'} <span class="bc-muted">({audience.toLocaleString()} contacts)</span></dd>
            {b.format !== 'html' && <><dt>Heading</dt><dd>{b.heading}</dd></>}
            <dt>Body</dt>
            <dd><details class="bc-bodydetails"><summary>Show {b.format === 'html' ? 'HTML' : 'body'}</summary><pre class="bc-pre">{b.body}</pre></details></dd>
            {b.cta_label && <><dt>Button</dt><dd>{b.cta_label} → {b.cta_href}</dd></>}
          </dl>
        )}
      </section>

      <section class="adm-section">
        <h2>Preview</h2>
        <iframe id="bc-preview" class="bc-frame" srcdoc={preview.html} sandbox="" title="Broadcast preview"></iframe>
        <div class="bc-test">
          <input id="bc-test-to" type="email" value="jacob@songdance.co" />
          <button id="bc-test-btn" class="adm-btn" type="button" data-id={b.id}>Send test</button>
          <span id="bc-test-msg" class="bc-msg"></span>
        </div>
        <div class="bc-driprow">
          <button id="bc-drip-btn" class="adm-btn adm-btn--ghost" type="button">Copy Drip HTML</button>
          <span id="bc-drip-msg" class="bc-msg"></span>
          <span class="bc-driphint">Paste into Drip — footer tags &amp; <code>utm_source=drip</code> are set for you.</span>
        </div>
        <textarea id="bc-drip-src" hidden readonly aria-hidden="true">{dripHtml}</textarea>
      </section>
    </div>
  </main>

  <style>
    .bc-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: start; }
    @media (max-width: 1000px) { .bc-grid { grid-template-columns: 1fr; } }
    .bc-pill { font-size: 13px; padding: 2px 11px; border-radius: 999px; background: #ece0cf; color: #4a3848; vertical-align: middle; margin-left: 8px; }
    .bc-pill--sending { background: #d9ead0; color: #38601f; }
    .bc-pill--paused { background: #f4dcc9; color: #a14826; }
    .bc-pill--done { background: #dfe7ef; color: #335; }
    .bc-form { display: flex; flex-direction: column; gap: 12px; }
    .bc-field { display: flex; flex-direction: column; gap: 5px; }
    .bc-field > span { font-size: 13px; color: #4a3848; }
    .bc-field > span em { color: #b6a8b4; font-style: normal; }
    .bc-field > span code { background: #f4ecdf; padding: 1px 5px; border-radius: 4px; font-size: 12px; }
    .bc-field input, .bc-field textarea, .bc-field select {
      font: inherit; font-size: 14px; padding: 9px 11px; border: 1px solid rgba(161,72,38,0.3);
      border-radius: 8px; background: #fff; color: #2a1b2a;
    }
    .bc-field textarea { resize: vertical; line-height: 1.6; }
    .bc-simple-only { display: flex; flex-direction: column; gap: 12px; }
    .bc-row { display: flex; gap: 12px; }
    .bc-row .bc-field { flex: 1; }
    .bc-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .bc-msg { font-size: 13px; color: #6f5f6d; }
    .bc-stopat { border: 1px solid rgba(161,72,38,0.22); border-radius: 10px; padding: 14px 16px; margin: 16px 0 0; }
    .bc-stopat-note { font-size: 13px; color: #4a3848; line-height: 1.7; margin: 6px 0 12px; max-width: 74ch; }
    .bc-stopat-note strong { color: #2a1b2a; }
    .bc-stopat-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .bc-stopat-row input { padding: 7px 10px; border: 1px solid rgba(161,72,38,0.3); border-radius: 8px; font: inherit; }
    .bc-readonly dt { font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; color: #6f5f6d; margin-top: 12px; }
    .bc-readonly dd { margin: 3px 0 0; font-size: 14px; color: #2a1b2a; }
    .bc-pre { white-space: pre-wrap; line-height: 1.6; word-break: break-word; }
    .bc-frame { width: 100%; height: 560px; border: 1px solid rgba(161,72,38,0.22); border-radius: 12px; background: #fff; }
    .bc-test { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
    .bc-test input { font: inherit; font-size: 14px; padding: 8px 11px; border: 1px solid rgba(161,72,38,0.3); border-radius: 8px; }
    .bc-driprow { display: flex; align-items: center; gap: 10px; margin-top: 10px; flex-wrap: wrap; }
    .bc-driphint { font-size: 12px; color: #9a8ba6; }
    .bc-driphint code { font-size: 11px; background: #ece0cf; padding: 1px 5px; border-radius: 4px; }
    .bc-launch p { font-size: 14px; color: #4a3848; line-height: 1.7; max-width: 64ch; }
    .bc-stats { display: flex; gap: 26px; flex-wrap: wrap; margin-bottom: 16px; }
    .bc-stats--eng { padding-top: 14px; border-top: 1px solid rgba(161,72,38,0.15); }
    .bc-stat { display: flex; flex-direction: column; }
    .bc-stat .n { font-size: 24px; font-weight: 600; color: #2a1b2a; font-variant-numeric: tabular-nums; }
    .bc-stat .l { font-size: 12.5px; color: #6f5f6d; }
    .bc-note { font-size: 12.5px; color: #6f5f6d; margin: 0 0 14px; }
    .bc-cleanstatus { background: #f4ecdf; border: 1px solid rgba(161,72,38,0.18); border-radius: 8px; padding: 8px 12px; }
    .bc-cleanstatus strong { color: #4a3848; }
    .bc-fails { border: 1px solid rgba(161,72,38,0.22); border-radius: 10px; padding: 12px 16px; margin: 0 0 16px; }
    .bc-fails summary { cursor: pointer; font-size: 13.5px; color: #4a3848; }
    .bc-fails summary strong { color: #a14826; }
    .bc-fail-tbl { width: 100%; border-collapse: collapse; font-size: 12.5px; margin: 8px 0 0; }
    .bc-fail-tbl th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #6f5f6d; font-weight: 600; padding: 4px 10px 4px 0; border-bottom: 1px solid rgba(161,72,38,0.15); }
    .bc-fail-tbl th:last-child, .bc-fail-tbl td:last-child { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .bc-fail-tbl td { padding: 5px 10px 5px 0; color: #2a1b2a; border-bottom: 1px solid rgba(161,72,38,0.08); vertical-align: top; }
    .bc-fail-tbl code { font-size: 12px; color: #4a3848; word-break: break-all; }
    .bc-pace { border: 1px solid rgba(161,72,38,0.22); border-radius: 10px; padding: 14px 16px; margin: 0 0 16px; }
    .bc-pace--urgent { border-color: rgba(161,72,38,0.55); background: #f9efe2; }
    .bc-pace > strong { font-size: 13px; }
    .bc-pace-lead { font-size: 13px; color: #4a3848; line-height: 1.7; margin: 6px 0 12px; max-width: 74ch; }
    .bc-pace-lead strong { color: #2a1b2a; }
    .bc-pace-tz { width: 100%; border-collapse: collapse; font-size: 13px; margin: 0 0 10px; }
    .bc-pace-tz th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #6f5f6d; font-weight: 600; padding: 4px 10px 4px 0; border-bottom: 1px solid rgba(161,72,38,0.15); }
    .bc-pace-tz td { padding: 5px 10px 5px 0; color: #2a1b2a; font-variant-numeric: tabular-nums; border-bottom: 1px solid rgba(161,72,38,0.08); }
    .bc-pace-tz td.elig { color: #38601f; }
    .bc-pace-tz td.slept { color: #a14826; }
    .bc-pace-tz td.zero { color: #b7a9b4; }
    .bc-pace-tz tr.out td:first-child { color: #6f5f6d; }
    .bc-muted { color: #b6a8b4; }
    .bc-audience { border: 1px solid rgba(161,72,38,0.22); border-radius: 10px; padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; margin: 0; }
    .bc-audience legend { font-size: 13px; color: #4a3848; padding: 0 6px; }
    .bc-aud-count { color: #a14826; font-weight: 600; }
    .bc-tagcloud { display: flex; flex-direction: column; gap: 8px; }
    .bc-tagcloud-label { font-size: 12px; color: #6f5f6d; }
    .bc-tagsearch { font: inherit; font-size: 13px; padding: 6px 10px; border: 1px solid rgba(161,72,38,0.3); border-radius: 8px; max-width: 260px; }
    .bc-tagchips { display: flex; flex-wrap: wrap; gap: 6px; max-height: 168px; overflow: auto; }
    .bc-tagchip { font: inherit; font-size: 12px; cursor: pointer; border: 1px solid rgba(161,72,38,0.3); background: #fff; color: #4a3848; border-radius: 999px; padding: 3px 10px; }
    .bc-tagchip:hover { background: #f4ecdf; }
    .bc-tagchip span { color: #b6a8b4; }
    .bc-editnote { font-size: 12.5px; color: #a14826; background: #f9efe2; border: 1px solid rgba(161,72,38,0.22); border-radius: 8px; padding: 8px 12px; margin: 0 0 12px; }
    .bc-bodydetails summary { cursor: pointer; font-size: 13px; color: #a14826; }
    .bc-bodydetails pre { max-height: 320px; overflow: auto; background: #fbf6ec; border: 1px solid rgba(161,72,38,0.18); border-radius: 8px; padding: 12px; font-size: 12px; white-space: pre-wrap; word-break: break-word; margin: 6px 0 0; }
    .bc-clean { border: 1px solid rgba(161,72,38,0.22); border-radius: 10px; padding: 14px 16px; margin: 0 0 16px; }
    .bc-clean strong { font-size: 13px; }
    .bc-clean p { font-size: 13px; color: #6f5f6d; line-height: 1.6; margin: 6px 0 10px; max-width: 70ch; }
    .bc-clean a { color: #a14826; }
    .bc-clean-tags { margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(161,72,38,0.15); }
    .bc-clean-tags label { display: block; font-size: 13px; color: #4a3848; margin-bottom: 6px; }
    .bc-clean-tags label em { color: #b6a8b4; font-style: normal; }
    .bc-clean-tagrow { display: flex; gap: 10px; flex-wrap: wrap; }
    .bc-clean-tagrow input { flex: 1; min-width: 220px; font: inherit; font-size: 14px; padding: 8px 11px; border: 1px solid rgba(161,72,38,0.3); border-radius: 8px; }
  </style>

  <script is:inline>
    const editForm = document.getElementById('bc-edit');
    const previewFrame = document.getElementById('bc-preview');
    let formDirty = false; // pause the live stats refresh while the user is editing

    // Compose: format toggle + live preview.
    if (editForm) {
      const formatSel = document.getElementById('bc-format');
      const bodyLabel = document.getElementById('bc-body-label');
      const saveMsg = document.getElementById('bc-save-msg');

      function applyFormat() {
        const html = formatSel.value === 'html';
        document.querySelectorAll('.bc-simple-only').forEach((el) => { el.style.display = html ? 'none' : 'flex'; });
        bodyLabel.innerHTML = html
          ? 'Body — paste your full HTML email. <code>{{first_name}}</code>, <code>{{unsubscribe_url}}</code> &amp; Drip-style <code>{{ subscriber.first_name | default: "there" }}</code> are replaced per recipient.'
          : 'Body — blank line = new paragraph. <code>{{first_name}}</code> is replaced per recipient.';
      }

      let timer = null;
      async function updatePreview() {
        const payload = Object.fromEntries(new FormData(editForm).entries());
        try {
          const res = await fetch('/api/admin/broadcasts/preview', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok && data.html) previewFrame.srcdoc = data.html;
        } catch (_) { /* best-effort */ }
      }
      const schedule = () => { clearTimeout(timer); timer = setTimeout(updatePreview, 400); };

      // Live audience estimate + tag chips.
      const audCount = document.getElementById('bc-aud-count');
      const audInclude = document.getElementById('aud-include');
      let audTimer = null;
      async function updateAudience() {
        const fd = new FormData(editForm);
        const payload = {
          audience_include_tags: fd.get('audience_include_tags'),
          audience_exclude_tags: fd.get('audience_exclude_tags'),
          audience_field: fd.get('audience_field'),
          audience_field_value: fd.get('audience_field_value'),
        };
        const any = Object.values(payload).some((v) => (v || '').toString().trim());
        try {
          const res = await fetch('/api/admin/broadcasts/audience', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok) audCount.textContent = `${Number(data.count).toLocaleString()} contacts` + (any ? '' : ' (whole list)');
        } catch (_) { /* best-effort */ }
      }
      const scheduleAud = () => { clearTimeout(audTimer); audTimer = setTimeout(updateAudience, 400); };
      document.querySelectorAll('.bc-tagchip').forEach((chip) => {
        chip.addEventListener('click', () => {
          const tag = chip.dataset.tag;
          const cur = audInclude.value.split(',').map((s) => s.trim()).filter(Boolean);
          if (!cur.includes(tag)) cur.push(tag);
          audInclude.value = cur.join(', ');
          updateAudience();
        });
      });

      // Filter the tag chips as you type (the full list can be long).
      document.querySelectorAll('.bc-tagsearch').forEach((inp) => {
        inp.addEventListener('input', () => {
          const q = inp.value.trim().toLowerCase();
          inp.parentElement.querySelectorAll('.bc-tagchip').forEach((c) => {
            c.style.display = !q || c.dataset.tag.includes(q) ? '' : 'none';
          });
        });
      });

      formatSel.addEventListener('change', () => { applyFormat(); schedule(); });
      editForm.addEventListener('input', () => { formDirty = true; schedule(); scheduleAud(); });
      applyFormat();
      updateAudience();

      editForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        saveMsg.textContent = 'Saving…';
        const payload = Object.fromEntries(new FormData(editForm).entries());
        try {
          const res = await fetch('/api/admin/broadcasts/save', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Save failed');
          formDirty = false;
          saveMsg.textContent = 'Saved ✓ — applies to recipients not yet sent.';
          updatePreview();
        } catch (err) { saveMsg.textContent = 'Failed: ' + (err.message || err); }
      });
    }

    // Test send
    (function () {
      const btn = document.getElementById('bc-test-btn');
      if (!btn) return;
      btn.addEventListener('click', async () => {
        const to = document.getElementById('bc-test-to').value.trim();
        const m = document.getElementById('bc-test-msg');
        m.textContent = 'Saving + sending…';
        // Persist current edits first (if a draft) so the test matches the preview.
        if (editForm) {
          const payload = Object.fromEntries(new FormData(editForm).entries());
          try {
            await fetch('/api/admin/broadcasts/save', {
              method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
            });
          } catch (_) { /* fall through to send what's saved */ }
        }
        try {
          const res = await fetch('/api/admin/broadcasts/test', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: Number(btn.dataset.id), to }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Send failed');
          m.textContent = 'Sent ✓';
        } catch (err) { m.textContent = 'Failed: ' + (err.message || err); }
      });
    })();

    // Launch
    (function () {
      const btn = document.getElementById('bc-launch');
      if (!btn) return;
      btn.addEventListener('click', async () => {
        const m = document.getElementById('bc-launch-msg');
        if (!confirm('Launch this broadcast to the full list? It will send gradually over the coming days.')) return;
        btn.disabled = true;
        m.textContent = 'Launching…';
        try {
          const res = await fetch('/api/admin/broadcasts/control', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: Number(btn.dataset.id), action: 'launch' }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Launch failed');
          window.location.reload();
        } catch (err) { m.textContent = 'Failed: ' + (err.message || err); btn.disabled = false; }
      });
    })();

    // Pause / resume / top-up
    document.querySelectorAll('.bc-ctl').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const m = document.getElementById('bc-ctl-msg');
        if (btn.dataset.confirm && !confirm(btn.dataset.confirm)) return;
        m.textContent = '…';
        try {
          const res = await fetch('/api/admin/broadcasts/control', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: Number(btn.dataset.id), action: btn.dataset.action }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed');
          window.location.reload();
        } catch (err) { m.textContent = 'Failed: ' + (err.message || err); }
      });
    });

    // Remove queued contacts carrying given tags (e.g. Drip "undeliverable").
    (function () {
      const btn = document.getElementById('bc-extags-btn');
      if (!btn) return;
      btn.addEventListener('click', async () => {
        const tags = document.getElementById('bc-extags').value.trim();
        const msg = document.getElementById('bc-extags-msg');
        if (!tags) { msg.textContent = 'Enter one or more tags.'; return; }
        btn.disabled = true;
        msg.textContent = 'Removing…';
        try {
          const res = await fetch('/api/admin/broadcasts/exclude-tags', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: Number(btn.dataset.id), tags }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed');
          msg.textContent = `Removed ${Number(data.removed).toLocaleString()} queued contacts. Reload to see updated counts.`;
        } catch (err) {
          msg.textContent = 'Failed: ' + (err.message || err);
        }
        btn.disabled = false;
      });
    })();

    // Auto-stop (deadline): arm or clear the stop_at instant. The datetime-local
    // is read in the admin's own timezone (that's how the browser parses it) and
    // converted to an absolute ISO instant the cron can compare anywhere.
    (function () {
      const setBtn = document.getElementById('bc-stopat-set');
      const clearBtn = document.getElementById('bc-stopat-clear');
      const input = document.getElementById('bc-stopat-input');
      const msg = document.getElementById('bc-stopat-msg');
      const post = async (body) => {
        const res = await fetch('/api/admin/broadcasts/control', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        return data;
      };
      if (setBtn) setBtn.addEventListener('click', async () => {
        const v = input && input.value ? input.value.trim() : '';
        if (!v) { msg.textContent = 'Pick a date and time first.'; return; }
        const d = new Date(v);
        if (isNaN(d.getTime())) { msg.textContent = 'That time is not valid.'; return; }
        setBtn.disabled = true; msg.textContent = 'Saving…';
        try { await post({ id: Number(setBtn.dataset.id), action: 'set_stop_at', stop_at: d.toISOString() }); window.location.reload(); }
        catch (err) { msg.textContent = 'Failed: ' + (err.message || err); setBtn.disabled = false; }
      });
      if (clearBtn) clearBtn.addEventListener('click', async () => {
        if (!confirm('Remove the auto-stop? The broadcast will keep sending until its queue is empty.')) return;
        clearBtn.disabled = true; msg.textContent = 'Clearing…';
        try { await post({ id: Number(clearBtn.dataset.id), action: 'clear_stop_at' }); window.location.reload(); }
        catch (err) { msg.textContent = 'Failed: ' + (err.message || err); clearBtn.disabled = false; }
      });
    })();

    // Live refresh while a send is in flight — but never while the user is
    // mid-edit (would wipe unsaved changes); re-arm and wait instead.
    if (document.querySelector('.adm')?.dataset.status === 'sending') {
      const tick = () => {
        if (!formDirty) window.location.reload();
        else setTimeout(tick, 20000);
      };
      setTimeout(tick, 20000);
    }
  </script>

  <script is:inline>
    // Copy the Drip-ready HTML to the clipboard.
    (function () {
      const btn = document.getElementById('bc-drip-btn');
      const src = document.getElementById('bc-drip-src');
      const msg = document.getElementById('bc-drip-msg');
      if (!btn || !src) return;
      const flash = (t) => { if (msg) { msg.textContent = t; setTimeout(() => { msg.textContent = ''; }, 4000); } };
      const fallback = () => {
        src.hidden = false;
        src.focus();
        src.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch (_) { ok = false; }
        src.hidden = true;
        flash(ok ? 'Copied — paste into Drip' : 'Select the box and press ⌘/Ctrl-C');
      };
      btn.addEventListener('click', () => {
        const text = src.value;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(() => flash('Copied — paste into Drip'), fallback);
        } else {
          fallback();
        }
      });
    })();
  </script>
</Layout>
