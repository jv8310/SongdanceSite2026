---
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import { expireStaleCoursePendings } from '../../../lib/courses/db';

export const prerender = false;

const env = Astro.locals.runtime.env;
const authed = await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
if (!authed) {
  return Astro.redirect('/admin/login');
}

// Hardcoded course catalog — mirrors /admin/courses/index.astro.
const COURSES: Record<
  string,
  { name: string; productSlugs: string[] }
> = {
  'svh-certification': {
    name: 'SVH Certification Course',
    productSlugs: ['cc-cert', 'cc-bundle'],
  },
};

const slug = Astro.params.slug ?? '';
const course = COURSES[slug];
if (!course) {
  return new Response('Course not found', { status: 404 });
}

// Sweep stale pending rows to `expired` before reading. Keeps the admin
// view honest without needing a cron — the price is one tiny UPDATE per
// admin page load.
await expireStaleCoursePendings(env.DB);

const statusFilter = Astro.url.searchParams.get('status') ?? '';
const productFilter = Astro.url.searchParams.get('product') ?? '';
const returnTo = Astro.url.pathname + Astro.url.search;

const where: string[] = [`product_slug IN (${course.productSlugs.map(() => '?').join(',')})`];
const binds: unknown[] = [...course.productSlugs];
if (statusFilter) {
  where.push('status = ?');
  binds.push(statusFilter);
}
if (productFilter && course.productSlugs.includes(productFilter)) {
  where.push('product_slug = ?');
  binds.push(productFilter);
}

type Row = {
  id: number;
  email: string;
  first_name: string | null;
  last_name: string | null;
  country: string | null;
  phone: string | null;
  phone_country: string | null;
  product_slug: string;
  activate_choice: 'now' | 'wait' | null;
  source_variant: string | null;
  amount_cents: number;
  currency: string;
  status: string;
  stripe_session_id: string | null;
  stripe_payment_intent: string | null;
  stripe_subscription_id: string | null;
  subscription_status: string | null;
  payment_plan: 'full' | '3x';
  installments_paid: number;
  installments_total: number;
  created_at: string;
  paid_at: string | null;
  cancelled_at: string | null;
  refunded_at: string | null;
  refunded_amount_cents: number;
};

const q = await env.DB
  .prepare(
    `SELECT id, email, first_name, last_name, country, phone, phone_country,
            product_slug, activate_choice, source_variant,
            amount_cents, currency, status,
            stripe_session_id, stripe_payment_intent, stripe_subscription_id,
            subscription_status,
            payment_plan, installments_paid, installments_total,
            created_at, paid_at, cancelled_at, refunded_at,
            refunded_amount_cents
       FROM course_registrations
      WHERE ${where.join(' AND ')}
      ORDER BY created_at DESC`,
  )
  .bind(...binds)
  .all<Row>();
const rows: Row[] = q.results ?? [];

const summary = await env.DB
  .prepare(
    `SELECT product_slug,
            COUNT(*) AS total,
            SUM(CASE WHEN status = 'paid' THEN 1 ELSE 0 END) AS paid
       FROM course_registrations
      WHERE product_slug IN (${course.productSlugs.map(() => '?').join(',')})
      GROUP BY product_slug`,
  )
  .bind(...course.productSlugs)
  .all<{ product_slug: string; total: number; paid: number | null }>();

function eur(cents: number, currency: string) {
  return (cents / 100).toLocaleString('en-GB', {
    style: 'currency',
    currency: currency || 'EUR',
  });
}
function ymd(s: string | null) {
  if (!s) return '—';
  return s.slice(0, 16).replace('T', ' ');
}
function variantLabel(v: string | null) {
  if (!v) return '—';
  const map: Record<string, string> = {
    B1: 'B1 · in 12w',
    B2: 'B2 · 12w done',
    A: 'A · returning VSH',
    D: 'D · SVH ecosystem',
    E: 'E · newcomer',
    C: 'C · already enrolled',
    direct: 'direct',
  };
  return map[v] ?? v;
}
function productLabel(slug: string) {
  if (slug === 'cc-cert') return 'Cert only';
  if (slug === 'cc-bundle') return 'Bundle';
  return slug;
}
function activateLabel(choice: Row['activate_choice'], productSlug: string) {
  if (choice === 'now') return 'Activate now';
  if (choice === 'wait') return 'Wait for 12w end';
  if (productSlug === 'cc-cert') return '—';
  return '—';
}
// Tone for the subscription_status badge — mirrors how Stripe colours its
// own dashboard so the admin reads the two side-by-side without translation.
function subStatusTone(s: string | null): string {
  if (!s) return 'cancelled';
  if (s === 'active' || s === 'trialing') return 'paid';
  if (s === 'past_due' || s === 'unpaid' || s === 'incomplete' || s === 'paused')
    return 'pending';
  return 'cancelled'; // canceled, incomplete_expired
}
// Show the subscription badge only when it adds info beyond the main
// `status` column — i.e. row is still 'paid' but Stripe says otherwise.
function showSubBadge(rowStatus: string, subStatus: string | null): boolean {
  if (!subStatus) return false;
  if (rowStatus === 'paid' && subStatus === 'active') return false;
  return true;
}
---

<Layout title={`Admin — ${course.name}`} description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs">
          <a href="/admin">Admin</a>
          <span class="sep">/</span>
          <a href="/admin/courses">Courses</a>
          <span class="sep">/</span>
          {slug}
        </p>
        <h1>{course.name}</h1>
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--ghost" href="/admin/courses">← All courses</a>
        <form method="POST" action="/api/admin/login?_method=DELETE">
          <input type="hidden" name="_method" value="DELETE" />
          <button class="adm-btn adm-btn--ghost" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <!-- ─── Summary ─── -->
    <section class="adm-section">
      <h2>By product</h2>
      <table class="adm-table">
        <thead>
          <tr>
            <th>Product</th>
            <th class="num">Paid</th>
            <th class="num">Total</th>
          </tr>
        </thead>
        <tbody>
          {course.productSlugs.map((ps) => {
            const r = (summary.results ?? []).find((s) => s.product_slug === ps);
            return (
              <tr>
                <td>{productLabel(ps)} <span class="adm-mono" style="color: var(--adm-mute);">({ps})</span></td>
                <td class="num">{r?.paid ?? 0}</td>
                <td class="num">{r?.total ?? 0}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </section>

    <!-- ─── Registrations ─── -->
    <section class="adm-section">
      <h2>
        Registrations
        <span class="adm-filters">
          <a href={`/admin/courses/${slug}`} class={statusFilter === '' && productFilter === '' ? 'is-on' : ''}>all</a>
          <a href={`/admin/courses/${slug}?status=paid`} class={statusFilter === 'paid' ? 'is-on' : ''}>paid</a>
          <a href={`/admin/courses/${slug}?status=pending`} class={statusFilter === 'pending' ? 'is-on' : ''}>pending</a>
          <a href={`/admin/courses/${slug}?status=cancelled`} class={statusFilter === 'cancelled' ? 'is-on' : ''}>cancelled</a>
          <a href={`/admin/courses/${slug}?status=refunded`} class={statusFilter === 'refunded' ? 'is-on' : ''}>refunded</a>
          <a href={`/admin/courses/${slug}?status=expired`} class={statusFilter === 'expired' ? 'is-on' : ''}>expired</a>
          {course.productSlugs.map((ps) => (
            <a href={`/admin/courses/${slug}?product=${ps}`} class={productFilter === ps ? 'is-on' : ''}>{productLabel(ps)}</a>
          ))}
        </span>
      </h2>

      {rows.length === 0 && (
        <p class="adm-empty">No course registrations yet.</p>
      )}

      <div class="adm-regs">
        {rows.map((r) => {
          const displayName =
            (r.first_name || r.last_name)
              ? `${r.first_name ?? ''} ${r.last_name ?? ''}`.trim()
              : r.email;
          const phoneDisplay = r.phone
            ? r.phone_country ? `${r.phone} (${r.phone_country})` : r.phone
            : null;
          return (
            <article class={`adm-reg adm-reg--${r.status}`}>
              <div class="adm-reg-head">
                <div class="adm-reg-id">#{r.id}</div>
                <div class="adm-reg-name">
                  <strong>{displayName}</strong>
                  <a href={`mailto:${r.email}`}>{r.email}</a>
                </div>
                <div class="adm-reg-tier">
                  {productLabel(r.product_slug)}
                  <span class="adm-pill adm-pill--role">{activateLabel(r.activate_choice, r.product_slug)}</span>
                </div>
                <div class="adm-reg-amount">
                  {eur(r.amount_cents, r.currency)}
                  {r.refunded_amount_cents > 0 && (
                    <span class="adm-reg-discount">
                      −{eur(r.refunded_amount_cents, r.currency)} refunded
                    </span>
                  )}
                </div>
                <div class="adm-reg-status">
                  <span class={`adm-pill adm-pill--${r.status}`}>{r.status}</span>
                  {showSubBadge(r.status, r.subscription_status) && (
                    <span
                      class={`adm-pill adm-pill--${subStatusTone(r.subscription_status)}`}
                      title="Live Stripe subscription status"
                    >
                      sub · {r.subscription_status}
                    </span>
                  )}
                </div>
                <div class="adm-reg-dates">
                  <div><span>Created</span> {ymd(r.created_at)}</div>
                  <div><span>Paid</span> {ymd(r.paid_at)}</div>
                  {r.cancelled_at && (
                    <div><span>Cancelled</span> {ymd(r.cancelled_at)}</div>
                  )}
                  {r.refunded_at && (
                    <div><span>Refunded</span> {ymd(r.refunded_at)}</div>
                  )}
                </div>
              </div>

              <dl class="adm-reg-details">
                <div><dt>Country</dt><dd>{r.country ?? '—'}</dd></div>
                <div><dt>Phone</dt><dd>{phoneDisplay ?? '—'}</dd></div>
                <div><dt>Variant</dt><dd>{variantLabel(r.source_variant)}</dd></div>
                <div><dt>Payment</dt><dd>
                  {r.payment_plan === '3x'
                    ? `3 monthly · ${r.installments_paid}/${r.installments_total} paid`
                    : 'Full payment'}
                </dd></div>
                {r.stripe_session_id && (
                  <div class="adm-reg-detail--full">
                    <dt>Stripe session</dt>
                    <dd class="adm-mono">{r.stripe_session_id}</dd>
                  </div>
                )}
                {r.stripe_subscription_id && (
                  <div class="adm-reg-detail--full">
                    <dt>Stripe subscription</dt>
                    <dd class="adm-mono">{r.stripe_subscription_id}</dd>
                  </div>
                )}
                {r.stripe_payment_intent && (
                  <div class="adm-reg-detail--full">
                    <dt>Payment intent</dt>
                    <dd class="adm-mono">{r.stripe_payment_intent}</dd>
                  </div>
                )}
              </dl>

              {(r.status === 'pending' || r.status === 'expired' || r.status === 'cancelled') && (
                <div class="adm-reg-actions">
                  {(r.status === 'pending' || r.status === 'expired') && (
                    <form method="POST" action="/api/admin/mark-course-paid" class="adm-reg-markpaid"
                          onsubmit={`return confirm('Mark course registration #${r.id} (${displayName}, ${r.email}) as paid and push to Drip?')`}>
                      <input type="hidden" name="course_registration_id" value={r.id} />
                      <input type="hidden" name="return_to" value={returnTo} />
                      <button type="submit" class="adm-btn adm-btn--solid">Mark paid + Drip</button>
                    </form>
                  )}
                  <form method="POST" action="/api/admin/delete-course-registration" class="adm-reg-delete"
                        onsubmit={`return confirm('Permanently delete course registration #${r.id} (${displayName}, ${r.email})? This cannot be undone.')`}>
                    <input type="hidden" name="course_registration_id" value={r.id} />
                    <input type="hidden" name="return_to" value={returnTo} />
                    <button type="submit" class="adm-btn adm-btn--danger">Delete</button>
                  </form>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>
  </main>
</Layout>
