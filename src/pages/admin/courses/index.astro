---
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import { expireStaleCoursePendings } from '../../../lib/courses/db';

export const prerender = false;

const env = Astro.locals.runtime.env;
const authed = await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
if (!authed) {
  return Astro.redirect('/admin/login');
}

await expireStaleCoursePendings(env.DB);

// Hardcoded course catalog — single entry for now. Add more as they launch.
// Each `slug` is the value stored in course_registrations.product_slug
// after the matching certification-course offer is purchased.
const COURSES = [
  {
    slug: 'svh-certification',
    name: 'SVH Certification Course',
    description: 'Cert-only (€797) and the Foundation + Cert path (€1,347; 20% off in a workshop window).',
    productSlugs: ['cc-cert', 'cc-bundle'],
  },
  {
    slug: 'grief-course',
    name: 'The Grief Course',
    description: 'With Daniela Hess & Jacob · €99 / $99, one-time.',
    productSlugs: ['grief-course'],
  },
];

const counts = new Map<string, { total: number; paid: number }>();
for (const course of COURSES) {
  const placeholders = course.productSlugs.map(() => '?').join(',');
  const row = await env.DB
    .prepare(
      `SELECT COUNT(*) AS total,
              SUM(CASE WHEN status = 'paid' THEN 1 ELSE 0 END) AS paid
         FROM course_registrations
        WHERE product_slug IN (${placeholders})`,
    )
    .bind(...course.productSlugs)
    .first<{ total: number; paid: number | null }>();
  counts.set(course.slug, {
    total: row?.total ?? 0,
    paid: row?.paid ?? 0,
  });
}
---

<Layout title="Admin — Courses — Songdance" description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs">
          <a href="/admin">Admin</a>
          <span class="sep">/</span>
          Courses
        </p>
        <h1>Courses</h1>
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--ghost" href="/admin">← Admin</a>
      </div>
    </header>

    <section class="adm-section">
      <div class="adm-menu">
        {COURSES.map((c) => {
          const n = counts.get(c.slug) ?? { total: 0, paid: 0 };
          return (
            <a href={`/admin/courses/${c.slug}`}>
              <strong>{c.name}</strong>
              <span>{c.description} · {n.paid} paid · {n.total} total</span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="adm-section">
      <h2>Revenue</h2>
      <div class="adm-menu">
        <a href="/admin/courses/future-revenue">
          <strong>Future revenue →</strong>
          <span>Expected income from installment plans by month, with a line graph &amp; a watch list of cancelled / unpaid / retrying plans</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
