---
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import { formatMoney } from '../../../lib/workshops/currency';
import {
  isRefundable,
  refundableMinor,
  type OrderSource,
} from '../../../lib/admin/orders';
import { getOrderDetail } from '../../../lib/admin/order-detail';
import {
  hasInstallmentLedger,
  installmentRefundableMinor,
  listOrderInstallments,
  perChargeRefundableMinor,
} from '../../../lib/admin/installments';
import { getFxRatesToEur } from '../../../lib/admin/fx';
import { providerLinkFor, resolveProviderModes } from '../../../lib/admin/provider-links';

export const prerender = false;

const env = Astro.locals.runtime.env;
const authed = await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
if (!authed) {
  return Astro.redirect('/admin/login');
}

const orderNo = (Astro.params.order ?? '').toString();

// Same money inputs as the list, so every figure here matches /admin/orders.
const fxRates = await getFxRatesToEur(env.DB);
const quaderno =
  env.QUADERNO_API_KEY && env.QUADERNO_ACCOUNT
    ? {
        apiKey: env.QUADERNO_API_KEY,
        account: env.QUADERNO_ACCOUNT,
        sandbox: env.QUADERNO_SANDBOX === '1',
      }
    : undefined;

const detail = await getOrderDetail(env.DB, orderNo, { fxRates, quaderno });

// Where "Back" returns to — the filtered list the admin came from, falling
// back to the bare orders page.
const rawReturn = Astro.url.searchParams.get('return_to') ?? '';
const backHref = rawReturn.startsWith('/admin/orders') ? rawReturn : '/admin/orders';
// The refund form returns to THIS detail page (so the flash shows in context).
const selfReturn = Astro.url.pathname + Astro.url.search;

const providerModes = resolveProviderModes(env);

// Flash from the refund endpoint.
const flash = Astro.url.searchParams.get('flash');
const flashMsg = Astro.url.searchParams.get('msg');
const flashBanner =
  flash === 'refund_ok'
    ? { tone: 'ok' as const, text: flashMsg ?? 'Refund submitted.' }
  : flash === 'refund_error'
    ? { tone: 'err' as const, text: flashMsg ?? 'Refund failed.' }
    : null;

const SOURCE_LABEL: Record<OrderSource, string> = {
  retreat: 'Retreat',
  course: 'Course',
  workshop: 'Workshop',
};

function eur(minor: number): string {
  const major = minor / 100;
  return `€${Number.isInteger(major) ? major : major.toFixed(2)}`;
}

const o = detail?.order ?? null;
const name = o ? `${o.firstName ?? ''} ${o.lastName ?? ''}`.trim() || '—' : '';
const link = o ? providerLinkFor(o, providerModes) : null;

// An installment plan is N charges at the gateway, and the row only remembers
// the first — so read the cycles live and offer a refund per cycle. The gateway
// is the source of truth here; a mirror in D1 could only be as fresh as the
// last webhook, which is the very thing that goes missing.
const ledger = o ? await listOrderInstallments(env, o) : null;
const isPlan = o ? hasInstallmentLedger(o) : false;
// The single charge stored on the row — what the whole-order form targets.
// Null on a plan whose first PaymentIntent was never captured, in which case
// that form has nothing to aim at and only the per-installment panel works.
const rowChargeTarget = o
  ? o.provider === 'paypal'
    ? o.paypalCaptureId
    : o.paymentIntent
  : null;

// Workshops carry a personal countdown / join page — surface the full,
// shareable link so Jacob can re-send it (e.g. a registrant who lost the email).
const siteBase = (env.PUBLIC_BASE_URL || Astro.url.origin).replace(/\/$/, '');
const countdownUrl = detail?.countdownPath ? `${siteBase}${detail.countdownPath}` : null;
// What the whole-order form can actually refund: it targets the row's single
// stored charge, so on a plan that is ONE installment — never the plan total.
const remaining = o ? perChargeRefundableMinor(o) : 0;
const remainingMajor = (remaining / 100).toFixed(2);
const wholeOrderRemaining = o ? refundableMinor(o) : 0;
const jsName = name.replace(/['\\]/g, '\\$&');

function ymdhm(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '—' : d.toISOString().slice(0, 10);
}
---

<Layout title={`Admin — Order ${orderNo} — Songdance`} description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs">
          <a href="/admin">Admin</a>
          <span class="sep">/</span>
          <a href="/admin/orders">Orders</a>
          <span class="sep">/</span>
          {orderNo}
        </p>
        <h1>Order {orderNo}</h1>
        {o && <p class="adm-sub">{o.productLabel}</p>}
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--ghost" href={backHref}>← Back to orders</a>
      </div>
    </header>

    {flashBanner && (
      <div class={`adm-flash adm-flash--${flashBanner.tone}`}>{flashBanner.text}</div>
    )}

    {!detail && (
      <section class="adm-section">
        <p class="adm-empty">No order found for “{orderNo}”.</p>
      </section>
    )}

    {detail && o && (
      <>
        <!-- ─── Summary ─── -->
        <section class="adm-section">
          <div class="od-summary">
            <div class="od-head">
              <span class="adm-mono od-no">{o.orderNo}</span>
              <span class={`od-tag od-tag--src-${o.source}`}>{SOURCE_LABEL[o.source]}</span>
              <span class={`adm-pill adm-pill--${o.statusClass}`}>{o.rawStatus}</span>
            </div>
            <div class="od-grid">
              <div class="od-stat"><span>Name</span><strong>{name}</strong></div>
              <div class="od-stat">
                <span>Email</span>
                <strong><a href={`mailto:${o.email}`}>{o.email}</a></strong>
              </div>
              <div class="od-stat">
                <span>Original</span>
                <strong>{o.originalAmountMinor > 0 ? formatMoney(o.originalAmountMinor, o.originalCurrency) : '—'}</strong>
              </div>
              <div class="od-stat">
                <span>Net (EUR)</span>
                <strong>{o.netEurMinor != null && o.netKind !== 'none' ? eur(o.netEurMinor) : '—'}</strong>
              </div>
              {o.refundedMinor > 0 && (
                <div class="od-stat">
                  <span>Refunded</span>
                  <strong class="od-refunded">−{formatMoney(o.refundedMinor, o.originalCurrency)}</strong>
                </div>
              )}
            </div>
          </div>

          <!-- The headline the admin came here for: which coupon/discount applied. -->
          <div class={`od-coupon ${detail.couponNote ? 'od-coupon--on' : ''}`}>
            <span class="od-coupon-label">Coupon / discount</span>
            <strong>{detail.couponNote ?? 'None — full price'}</strong>
          </div>
        </section>

        <!-- ─── Detail cards ─── -->
        <section class="adm-section od-cards">
          {detail.lineItems.length > 0 && (
            <div class="od-card">
              <h2>Price breakdown</h2>
              <table class="od-lines">
                <tbody>
                  {detail.lineItems.map((li) => (
                    <tr>
                      <td>{li.label}</td>
                      <td class="num">{li.amount}</td>
                    </tr>
                  ))}
                  <tr class="od-lines-total">
                    <td>Charged total</td>
                    <td class="num">
                      {o.originalAmountMinor > 0 ? formatMoney(o.originalAmountMinor, o.originalCurrency) : '—'}
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          )}

          {detail.customer.length > 0 && (
            <div class="od-card">
              <h2>Customer</h2>
              <dl class="od-kv">
                {detail.customer.map((f) => (
                  <div class="od-kv-row">
                    <dt>{f.label}</dt>
                    <dd class={f.mono ? 'adm-mono' : ''}>{f.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {detail.payment.length > 0 && (
            <div class="od-card">
              <h2>Payment</h2>
              <dl class="od-kv">
                {detail.payment.map((f) => (
                  <div class="od-kv-row">
                    <dt>{f.label}</dt>
                    <dd class={f.mono ? 'adm-mono' : ''}>{f.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {detail.extra.length > 0 && (
            <div class="od-card">
              <h2>Details</h2>
              <dl class="od-kv">
                {detail.extra.map((f) => (
                  <div class="od-kv-row">
                    <dt>{f.label}</dt>
                    <dd class={f.mono ? 'adm-mono' : ''}>{f.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
        </section>

        <!-- ─── Installments (course plans only) ─── -->
        {isPlan && (
          <section class="adm-section">
            <div class="od-inst">
              <div class="od-inst-head">
                <h2>Installments</h2>
                <span class="od-inst-sub">
                  {o.paymentPlan} · {o.installmentsPaid}/{o.installmentsTotal} charged ·
                  live from {ledger?.provider === 'paypal' ? 'PayPal' : 'Stripe'}
                </span>
              </div>

              {ledger?.error && (
                <p class="od-inst-warn">
                  Couldn’t read the plan from {ledger.provider === 'paypal' ? 'PayPal' : 'Stripe'} —
                  {' '}refund one installment from the gateway, or retry. ({ledger.error})
                </p>
              )}

              {ledger && !ledger.error && ledger.rows.length === 0 && (
                <p class="od-inst-warn">No charges on this plan yet.</p>
              )}

              {ledger && ledger.rows.length > 0 && (
                <table class="od-inst-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Charged</th>
                      <th>Reference</th>
                      <th class="num">Amount</th>
                      <th class="num">Refunded</th>
                      <th>Status</th>
                      <th><span class="sr-only">Refund</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    {ledger.rows.map((inst) => {
                      const left = installmentRefundableMinor(inst);
                      const leftMajor = (left / 100).toFixed(2);
                      const cur = inst.currency || o.originalCurrency;
                      return (
                        <tr class={left <= 0 ? 'od-inst-done' : ''}>
                          <td>{inst.seq}</td>
                          <td>{ymdhm(inst.paidAt)}</td>
                          <td class="adm-mono od-inst-ref">{inst.reference}</td>
                          <td class="num">{formatMoney(inst.amountMinor, cur)}</td>
                          <td class="num">
                            {inst.refundedMinor == null
                              ? '?'
                              : inst.refundedMinor > 0
                                ? `−${formatMoney(inst.refundedMinor, cur)}`
                                : '—'}
                          </td>
                          <td><span class="od-inst-status">{inst.status}</span></td>
                          <td>
                            {inst.refundTarget && left > 0 ? (
                              <form
                                method="POST"
                                action="/api/admin/refund"
                                class="od-inst-refund"
                                onsubmit={`return confirm('Refund installment ${inst.seq} of ${o.orderNo} (${jsName}, ${o.email})?\\nBlank = the whole installment, ${leftMajor} ${cur}. This moves real money.')`}
                              >
                                <input type="hidden" name="order_no" value={o.orderNo} />
                                <input type="hidden" name="return_to" value={selfReturn} />
                                <input type="hidden" name="installment" value={inst.id} />
                                <input
                                  type="number"
                                  name="amount"
                                  step="0.01"
                                  min="0.01"
                                  max={leftMajor}
                                  placeholder={`full ${leftMajor}`}
                                  aria-label={`Refund amount for installment ${inst.seq} (${cur})`}
                                />
                                <button type="submit" class="adm-btn adm-btn--danger adm-btn--tiny">Refund</button>
                              </form>
                            ) : (
                              <span class="od-inst-none">
                                {inst.refundTarget ? 'fully refunded' : 'no charge id'}
                              </span>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              )}

              <p class="od-inst-hint">
                Each row is its own charge — refunding one leaves the others alone, and the
                plan keeps billing. Refunds are subtracted from the order total; the order
                only reads <strong>refunded</strong> once everything collected has gone back.
                {ledger?.provider === 'paypal' && ' PayPal reports a refunded state per cycle but not the amount, so the “Refunded” column shows ? — the order total above is the reliable figure.'}
                {' '}To stop the charges still to come, use
                {' '}<a href="/admin/courses/future-revenue">Future revenue → stop the plan early</a>
                {' '}— that forgives future charges without refunding past ones.
              </p>
            </div>
          </section>
        )}

        <!-- ─── Actions ─── -->
        <section class="adm-section">
          {countdownUrl && (
            <div class="od-countdown">
              <span class="od-countdown-label">Countdown / join page</span>
              <div class="od-countdown-row">
                <a class="od-countdown-url adm-mono" href={countdownUrl} target="_blank" rel="noopener">{countdownUrl}</a>
                <button type="button" class="adm-btn adm-btn--ghost od-copy" data-copy data-url={countdownUrl}>Copy link</button>
              </div>
              <p class="od-countdown-hint">The registrant’s personal page — countdown, calendar links, and the Join button 5 min before start. Same link the confirmation &amp; reminder emails carry.</p>
            </div>
          )}

          <div class="od-actions">
            {link && (
              <a class="adm-btn adm-btn--ghost" href={link.href} target="_blank" rel="noopener">Open in {link.label} ↗</a>
            )}
            <a class="adm-btn adm-btn--ghost" href={`/api/admin/drip-profile?email=${encodeURIComponent(o.email)}`} target="_blank" rel="noopener">Drip profile ↗</a>
            <a class="adm-btn adm-btn--ghost" href={`/api/admin/quaderno-profile?email=${encodeURIComponent(o.email)}`} target="_blank" rel="noopener">Quaderno profile ↗</a>
          </div>

          {/*
            The whole-order form targets the ONE charge stored on the row. On a
            plan that is the first installment, so it stays hidden while the
            per-installment panel above is usable, and only reappears as the
            fallback when the gateway couldn't be read.
          */}
          {isRefundable(o) && (!isPlan || !!ledger?.error) && !!rowChargeTarget && (
            <form
              method="POST"
              action="/api/admin/refund"
              class="od-refund"
              onsubmit={`return confirm('Refund ${o.orderNo} (${jsName}, ${o.email})?\\nBlank = ${isPlan ? 'the first installment' : 'the full'} ${remainingMajor} ${o.originalCurrency}. This moves real money.')`}
            >
              <input type="hidden" name="order_no" value={o.orderNo} />
              <input type="hidden" name="return_to" value={selfReturn} />
              <label>
                <span>Refund amount ({o.originalCurrency})</span>
                <input
                  type="number"
                  name="amount"
                  step="0.01"
                  min="0.01"
                  max={remainingMajor}
                  placeholder={`full ${remainingMajor}`}
                />
              </label>
              <button type="submit" class="adm-btn adm-btn--danger">Issue refund</button>
              <p class="od-refund-hint">
                {isPlan ? (
                  <>
                    Blank = the <strong>first installment</strong> ({remainingMajor} {o.originalCurrency}) —
                    the only charge recorded on this order. The other{' '}
                    {o.installmentsTotal - 1} are refundable individually once{' '}
                    {ledger?.provider === 'paypal' ? 'PayPal' : 'Stripe'} can be read again;
                    {' '}{formatMoney(wholeOrderRemaining, o.originalCurrency)} is outstanding across the plan.
                  </>
                ) : (
                  <>Blank = full refund of what’s left ({remainingMajor} {o.originalCurrency}).</>
                )}
              </p>
            </form>
          )}
        </section>
      </>
    )}
  </main>

  <script>
    // Copy-to-clipboard for the countdown / join link (same pattern as the
    // image manager). Falls back to a prompt where the async clipboard API is
    // unavailable (older browsers / insecure context).
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = btn.dataset.url || '';
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
          const prev = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = prev; }, 1200);
        } catch {
          window.prompt('Copy this link:', url);
        }
      });
    });
  </script>

  <style>
    .od-summary {
      border: 1px solid var(--adm-line); border-radius: 12px;
      background: var(--adm-paper-soft); padding: 16px 18px;
    }
    .od-head { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:14px; }
    .od-no { font-size:18px; font-weight:600; }
    .od-tag {
      font-size:10px; font-weight:600; letter-spacing:0.04em; text-transform:uppercase;
      padding:1px 8px; border-radius:999px;
      background:rgba(0,0,0,0.06); color:var(--adm-ink-soft);
    }
    .od-tag--src-retreat  { background:rgba(201, 96, 58, 0.16); color:var(--adm-ember-deep); }
    .od-tag--src-course   { background:#d6e4f0; color:#2a5a8a; }
    .od-tag--src-workshop { background:#dcefdc; color:#2f7a4c; }

    .od-grid { display:flex; flex-wrap:wrap; gap:14px 28px; }
    .od-stat { display:flex; flex-direction:column; gap:2px; min-width:120px; }
    .od-stat span { font-size:11px; text-transform:uppercase; letter-spacing:0.04em; color:var(--adm-mute); }
    .od-stat strong { font-size:16px; }
    .od-stat a { color:var(--adm-ember-deep); text-decoration:none; }
    .od-refunded { color:var(--adm-danger); }

    /* Coupon / discount headline — the answer to "what brought the price down". */
    .od-coupon {
      margin-top:12px; display:flex; align-items:center; gap:12px; flex-wrap:wrap;
      padding:12px 16px; border:1px dashed var(--adm-line); border-radius:10px;
      background:var(--adm-paper-soft);
    }
    .od-coupon--on { border-style:solid; border-color:#cbb27a; background:#f7f0dd; }
    .od-coupon-label { font-size:11px; text-transform:uppercase; letter-spacing:0.04em; color:var(--adm-mute); }
    .od-coupon strong { font-size:15px; }

    .od-cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px; }
    .od-card {
      border:1px solid var(--adm-line); border-radius:12px;
      background:var(--adm-paper-soft); padding:14px 16px;
    }
    .od-card h2 {
      font-size:12px; text-transform:uppercase; letter-spacing:0.06em;
      color:var(--adm-ink-soft); margin:0 0 10px;
    }

    .od-lines { width:100%; border-collapse:collapse; }
    .od-lines td { padding:6px 0; border-bottom:1px solid var(--adm-line); font-size:14px; }
    .od-lines td.num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .od-lines tr:last-child td { border-bottom:none; }
    .od-lines-total td { font-weight:600; padding-top:9px; }

    .od-kv { margin:0; display:flex; flex-direction:column; gap:8px; }
    .od-kv-row { display:flex; justify-content:space-between; gap:16px; align-items:baseline; }
    .od-kv dt { font-size:12px; color:var(--adm-mute); flex:0 0 auto; }
    .od-kv dd { margin:0; font-size:14px; text-align:right; word-break:break-word; }
    .od-kv dd.adm-mono { font-size:12px; }

    /* Countdown / join page — a shareable per-registrant link with a copy button. */
    .od-countdown {
      margin-bottom:14px; padding:14px 16px;
      border:1px solid var(--adm-line); border-radius:12px; background:var(--adm-paper-soft);
    }
    .od-countdown-label { font-size:11px; text-transform:uppercase; letter-spacing:0.04em; color:var(--adm-mute); }
    .od-countdown-row { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-top:8px; }
    .od-countdown-url {
      flex:1 1 320px; min-width:0; font-size:12px; word-break:break-all;
      color:var(--adm-ember-deep); text-decoration:none;
    }
    .od-countdown-url:hover { text-decoration:underline; }
    .od-copy { flex:0 0 auto; }
    .od-countdown-hint { margin:8px 0 0; font-size:11px; color:var(--adm-mute); }

    .od-actions { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:14px; }
    .sr-only {
      position:absolute; width:1px; height:1px; padding:0; margin:-1px;
      overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
    }

    /* ─── Installments panel ─── */
    .od-inst {
      border:1px solid var(--adm-line); border-radius:12px;
      background:var(--adm-paper-soft); padding:16px 18px;
    }
    .od-inst-head { display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; margin-bottom:12px; }
    .od-inst-head h2 { font-size:15px; margin:0; }
    .od-inst-sub { font-size:12px; color:var(--adm-mute); }
    .od-inst-warn {
      margin:0 0 10px; font-size:12px; color:var(--adm-danger);
    }
    .od-inst-table { width:100%; border-collapse:collapse; font-size:13px; }
    .od-inst-table th {
      text-align:left; font-size:10px; letter-spacing:0.05em; text-transform:uppercase;
      color:var(--adm-mute); font-weight:600; padding:0 8px 6px 0; border-bottom:1px solid var(--adm-line);
    }
    .od-inst-table td { padding:8px 8px 8px 0; border-bottom:1px solid var(--adm-line); vertical-align:middle; }
    .od-inst-table .num { text-align:right; }
    .od-inst-ref { font-size:11px; color:var(--adm-ink-soft); }
    .od-inst-done td { opacity:0.6; }
    .od-inst-status { font-size:11px; color:var(--adm-ink-soft); text-transform:capitalize; }
    .od-inst-none { font-size:11px; color:var(--adm-mute); }
    .od-inst-refund { display:flex; gap:6px; align-items:center; justify-content:flex-end; }
    .od-inst-refund input[type="number"] {
      width:96px; padding:5px 7px; border:1px solid var(--adm-line); border-radius:7px;
      font:inherit; font-size:12px;
    }
    .od-inst-hint { margin:12px 0 0; font-size:11px; color:var(--adm-mute); line-height:1.5; }
    @media (max-width: 640px) {
      .od-inst-table thead { display:none; }
      .od-inst-table tr { display:grid; grid-template-columns:1fr 1fr; gap:2px 10px; padding:8px 0; border-bottom:1px solid var(--adm-line); }
      .od-inst-table td { border:0; padding:2px 0; }
      .od-inst-table td:last-child { grid-column:1 / -1; }
      .od-inst-refund { justify-content:flex-start; }
    }

    .od-refund {
      display:flex; flex-wrap:wrap; align-items:flex-end; gap:12px;
      border:1px solid var(--adm-line); border-radius:12px;
      background:var(--adm-paper-soft); padding:14px 16px;
    }
    .od-refund label { display:flex; flex-direction:column; gap:4px; font-size:12px; color:var(--adm-ink-soft); }
    .od-refund input[type="number"] {
      padding:8px 12px; border:1px solid rgba(42,27,42,0.18); border-radius:8px; font-size:14px; width:180px;
    }
    .od-refund-hint { flex-basis:100%; font-size:11px; color:var(--adm-mute); margin:0; }
