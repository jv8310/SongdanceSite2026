---
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import { formatMoney } from '../../../lib/workshops/currency';
import {
  listAllOrders,
  isRefundable,
  refundableMinor,
  type OrderSource,
  type StatusClass,
} from '../../../lib/admin/orders';
import { getFxRatesToEur } from '../../../lib/admin/fx';
import {
  providerLinkFor,
  resolveProviderModes,
} from '../../../lib/admin/provider-links';

export const prerender = false;

const env = Astro.locals.runtime.env;
const authed = await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
if (!authed) {
  return Astro.redirect('/admin/login');
}

// ── Filters (multi-select: source/status are comma-separated sets) ──
const SOURCES: OrderSource[] = ['retreat', 'course', 'workshop'];
const STATUSES: StatusClass[] = ['paid', 'pending', 'refunded', 'cancelled', 'expired', 'other'];

const parseList = <T extends string>(raw: string | null, allowed: readonly T[]): T[] =>
  (raw ? raw.split(',') : [])
    .map((s) => s.trim())
    .filter((s): s is T => (allowed as readonly string[]).includes(s));

const selectedSources = parseList(Astro.url.searchParams.get('source'), SOURCES);
const selectedStatuses = parseList(Astro.url.searchParams.get('status'), STATUSES);
const q = Astro.url.searchParams.get('q') ?? '';

// EUR net relies on the daily-refreshed FX store + a live Quaderno VAT lookup
// for course rows (eservice destination VAT — the same the checkout uses).
const fxRates = await getFxRatesToEur(env.DB);
const quaderno =
  env.QUADERNO_API_KEY && env.QUADERNO_ACCOUNT
    ? {
        apiKey: env.QUADERNO_API_KEY,
        account: env.QUADERNO_ACCOUNT,
        sandbox: env.QUADERNO_SANDBOX === '1',
      }
    : undefined;

const orders = await listAllOrders(
  env.DB,
  { sources: selectedSources, statuses: selectedStatuses, query: q },
  { fxRates, quaderno },
);
const returnTo = Astro.url.pathname + Astro.url.search;

// Dashboard deep-link modes (Stripe test/live, PayPal sandbox/live).
const providerModes = resolveProviderModes(env);

// Build a filter URL from explicit source/status sets (+ the current search).
function filterHref(sources: string[], statuses: string[], query: string): string {
  const params = new URLSearchParams();
  if (sources.length) params.set('source', sources.join(','));
  if (statuses.length) params.set('status', statuses.join(','));
  if (query) params.set('q', query);
  const qs = params.toString();
  return '/admin/orders' + (qs ? `?${qs}` : '');
}
function toggle<T extends string>(list: T[], value: T): T[] {
  return list.includes(value) ? list.filter((v) => v !== value) : [...list, value];
}

// Flash from the refund endpoint.
const flash = Astro.url.searchParams.get('flash');
const flashMsg = Astro.url.searchParams.get('msg');
const flashBanner =
  flash === 'refund_ok'
    ? { tone: 'ok' as const, text: flashMsg ?? 'Refund submitted.' }
  : flash === 'refund_error'
    ? { tone: 'err' as const, text: flashMsg ?? 'Refund failed.' }
  : flash === 'order_ok'
    ? { tone: 'ok' as const, text: flashMsg ?? 'Manual order created.' }
  : flash === 'order_warn'
    ? { tone: 'warn' as const, text: flashMsg ?? 'Manual order created with a warning.' }
  : flash === 'order_error'
    ? { tone: 'err' as const, text: flashMsg ?? 'Manual order failed.' }
  : null;

// ── Money helpers ──
function eur(minor: number): string {
  const major = minor / 100;
  return `€${Number.isInteger(major) ? major : major.toFixed(2)}`;
}

// ── Date helpers (D1 stores 'YYYY-MM-DD HH:MM:SS' UTC) ──
function fmtDate(s: string | null): string {
  if (!s) return '—';
  const iso = s.includes('T') ? s : `${s.replace(' ', 'T')}Z`;
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '—' : d.toISOString().slice(0, 10);
}
function fmtDateTime(s: string | null): string | undefined {
  if (!s) return undefined;
  const iso = s.includes('T') ? s : `${s.replace(' ', 'T')}Z`;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return undefined;
  return d.toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
}

const SOURCE_LABEL: Record<OrderSource, string> = {
  retreat: 'Retreat',
  course: 'Course',
  workshop: 'Workshop',
};

// Pretty names for the stored Stripe/PayPal method tokens.
const METHOD_LABELS: Record<string, string> = {
  card: 'Card',
  credit_card: 'Card',
  ideal: 'iDEAL',
  bancontact: 'Bancontact',
  sepa_debit: 'SEPA',
  sepa: 'SEPA',
  sofort: 'Sofort',
  giropay: 'Giropay',
  link: 'Link',
  paypal: 'PayPal',
};
function methodLabel(m: string | null): string | null {
  if (!m) return null;
  const key = m.toLowerCase();
  return (
    METHOD_LABELS[key] ??
    m.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
  );
}
// Gateway + (where known) the specific method, e.g. {gateway:'Stripe',
// method:'Bancontact'} or {gateway:'PayPal', method:null}.
function paymentDisplay(o: { provider: 'stripe' | 'paypal'; paymentMethod: string | null; paymentIntent?: string | null }) {
  // Manual bank-transfer orders carry a synthetic `manual-…` payment intent and
  // never touched a gateway (see src/lib/orders/manual-order.ts).
  if (o.paymentIntent?.startsWith('manual-')) {
    return { gateway: 'Bank transfer', method: null as string | null };
  }
  if (o.provider === 'paypal') return { gateway: 'PayPal', method: null as string | null };
  const method = methodLabel(o.paymentMethod);
  // 'paypal' via Stripe would duplicate; fold it into the gateway name.
  if (method === 'PayPal') return { gateway: 'PayPal', method: null as string | null };
  return { gateway: 'Stripe', method };
}

// ── Summary (over the filtered set) ──
const paidOrders = orders.filter((o) => o.statusClass === 'paid');
const netEurPaid = paidOrders.reduce((s, o) => s + (o.netEurMinor ?? 0), 0);
const refundedTotal = orders.reduce((s, o) => s + o.refundedMinor, 0);

// Preserve the source/status filter on the search form via hidden inputs.
---

<Layout title="Admin — Orders — Songdance" description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs">
          <a href="/admin">Admin</a>
          <span class="sep">/</span>
          Orders
        </p>
        <h1>Orders</h1>
        <p class="adm-sub">Every order across retreats, courses &amp; workshops</p>
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--solid" href="/admin/orders/new">＋ Manual order</a>
        <a class="adm-btn adm-btn--ghost" href="/admin">← Admin</a>
        <form method="POST" action="/api/admin/login?_method=DELETE">
          <input type="hidden" name="_method" value="DELETE" />
          <button class="adm-btn adm-btn--ghost" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    {flashBanner && (
      <div class={`adm-flash adm-flash--${flashBanner.tone}`}>{flashBanner.text}</div>
    )}

    <!-- ─── Summary ─── -->
    <section class="adm-section">
      <div class="ord-summary">
        <div class="ord-stat"><span>Showing</span><strong>{orders.length}</strong></div>
        <div class="ord-stat"><span>Paid</span><strong>{paidOrders.length}</strong></div>
        <div class="ord-stat"><span>Paid net (EUR)*</span><strong>{eur(netEurPaid)}</strong></div>
        {refundedTotal > 0 && (
          <div class="ord-stat"><span>Refunded</span><strong>{eur(refundedTotal)}</strong></div>
        )}
      </div>
      <p class="adm-table-note">
        *Net is tax-excluded in EUR: workshops use the exact Stripe settlement +
        VAT split; retreats strip the product VAT; courses strip the buyer-country
        VAT looked up live from Quaderno (eservice). Non-EUR charges are converted
        to EUR at ECB rates (refreshed daily).
      </p>
    </section>

    <!-- ─── Filters (multi-select — toggle as many as you like) ─── -->
    <section class="adm-section">
      <span class="adm-filters" role="group" aria-label="Filter by source">
        <a href={filterHref([], selectedStatuses, q)} class={selectedSources.length === 0 ? 'is-on' : ''}>all sources</a>
        {SOURCES.map((s) => (
          <a
            href={filterHref(toggle(selectedSources, s), selectedStatuses, q)}
            class={`ord-toggle ${selectedSources.includes(s) ? 'is-on' : ''}`}
          >{SOURCE_LABEL[s]}s</a>
        ))}
      </span>
      <span class="adm-filters" role="group" aria-label="Filter by status">
        <a href={filterHref(selectedSources, [], q)} class={selectedStatuses.length === 0 ? 'is-on' : ''}>all statuses</a>
        {STATUSES.map((s) => (
          <a
            href={filterHref(selectedSources, toggle(selectedStatuses, s), q)}
            class={`ord-toggle ${selectedStatuses.includes(s) ? 'is-on' : ''}`}
          >{s}</a>
        ))}
        <span class="ord-filter-hint">pick any number</span>
      </span>
      <form method="GET" action="/admin/orders" class="ord-search">
        {selectedSources.length > 0 && <input type="hidden" name="source" value={selectedSources.join(',')} />}
        {selectedStatuses.length > 0 && <input type="hidden" name="status" value={selectedStatuses.join(',')} />}
        <input type="search" name="q" value={q} placeholder="Search name, email, order # or product…" />
        <button type="submit" class="adm-btn adm-btn--solid">Search</button>
        {q && <a class="adm-btn adm-btn--ghost" href={filterHref(selectedSources, selectedStatuses, '')}>Clear</a>}
      </form>
    </section>

    <!-- ─── Orders ─── -->
    <section class="adm-section">
      {orders.length === 0 && <p class="adm-empty">No orders match these filters.</p>}

      {orders.length > 0 && (
        <table class="adm-table ord-table">
          <thead>
            <tr>
              <th>Order</th>
              <th>Date</th>
              <th>Product(s)</th>
              <th>Customer</th>
              <th>Payment</th>
              <th class="num">Original</th>
              <th class="num">Net (EUR)</th>
              <th>Status</th>
              <th class="ord-act-th"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            {orders.map((o) => {
              const name = `${o.firstName ?? ''} ${o.lastName ?? ''}`.trim() || '—';
              const remaining = refundableMinor(o);
              const remainingMajor = (remaining / 100).toFixed(2);
              // Escape for safe interpolation into the inline confirm() JS string.
              const jsName = name.replace(/['\\]/g, '\\$&');
              const isInstallment = o.installmentsTotal > 1;
              const link = providerLinkFor(o, providerModes);
              const pay = paymentDisplay(o);
              const detailHref = `/admin/orders/${o.orderNo}?return_to=${encodeURIComponent(returnTo)}`;
              return (
                <tr>
                  <td>
                    <div class="ord-id">
                      <a class="adm-mono ord-no-link" href={detailHref}>{o.orderNo}</a>
                      <span class={`ord-tag ord-tag--src-${o.source}`}>{SOURCE_LABEL[o.source]}</span>
                      {isInstallment && (
                        <span class="ord-tag ord-tag--plan" title="Paid in monthly installments">
                          {o.paymentPlan} · {o.installmentsPaid}/{o.installmentsTotal}
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="ord-date" title={fmtDateTime(o.createdAt)}>
                    {fmtDate(o.createdAt)}
                    {o.paidAt && fmtDate(o.paidAt) !== fmtDate(o.createdAt) && (
                      <><br /><small class="ord-paid-date" title={fmtDateTime(o.paidAt)}>paid {fmtDate(o.paidAt)}</small></>
                    )}
                  </td>
                  <td class="ord-product">
                    <span class="ord-product-name" title={o.productLabel}>{o.productLabel}</span>
                  </td>
                  <td class="ord-cust">
                    <span class={`ord-cust-name${name === '—' ? ' is-empty' : ''}`}>
                      {name === '—' ? 'No name' : name}
                    </span>
                    <a class="ord-cust-email" href={`mailto:${o.email}`} title={o.email}>{o.email}</a>
                  </td>
                  <td class="ord-pay">
                    <span class={`ord-pay-gw ord-pay-gw--${o.provider}`}>{pay.gateway}</span>
                    {pay.method && <span class="ord-pay-method"> · {pay.method}</span>}
                  </td>
                  <td class="num">
                    {o.originalAmountMinor > 0
                      ? formatMoney(o.originalAmountMinor, o.originalCurrency)
                      : '—'}
                    {isInstallment && (
                      <><br /><small class="ord-plan-note">plan total · {o.installmentsPaid}/{o.installmentsTotal} charged</small></>
                    )}
                    {o.refundedMinor > 0 && (
                      <><br /><small class="ord-refunded">−{formatMoney(o.refundedMinor, o.originalCurrency)} refunded</small></>
                    )}
                  </td>
                  <td class="num">
                    {o.netKind === 'exact' && o.netEurMinor != null && eur(o.netEurMinor)}
                    {o.netKind === 'approx' && o.netEurMinor != null && (
                      <span title="Approximate — converted to EUR at display FX">{eur(o.netEurMinor)}</span>
                    )}
                    {(o.netKind === 'none' || o.netEurMinor == null) && '—'}
                  </td>
                  <td><span class={`adm-pill adm-pill--${o.statusClass}`}>{o.rawStatus}</span></td>
                  <td class="ord-act-cell">
                    <details class="ord-menu">
                      <summary class="ord-menu-btn" title="Actions" aria-label="Actions">⋯</summary>
                      <div class="ord-menu-panel">
                        <a class="ord-menu-item" href={detailHref}>View details →</a>
                        <hr class="ord-menu-sep" />
                        {link && (
                          <a class="ord-menu-item" href={link.href} target="_blank" rel="noopener">Open in {link.label} ↗</a>
                        )}
                        <a class="ord-menu-item" href={`/api/admin/drip-profile?email=${encodeURIComponent(o.email)}`} target="_blank" rel="noopener">Drip profile ↗</a>
                        <a class="ord-menu-item" href={`/api/admin/quaderno-profile?email=${encodeURIComponent(o.email)}`} target="_blank" rel="noopener">Quaderno profile ↗</a>
                        {isRefundable(o) && (
                          <>
                            <hr class="ord-menu-sep" />
                            <form
                              method="POST"
                              action="/api/admin/refund"
                              class="ord-menu-refund"
                              onsubmit={`return confirm('Refund ${o.orderNo} (${jsName}, ${o.email})?\\nBlank = full ${remainingMajor} ${o.originalCurrency}. This moves real money.')`}
                            >
                              <input type="hidden" name="order_no" value={o.orderNo} />
                              <input type="hidden" name="return_to" value={returnTo} />
                              <label>
                                <span>Refund amount ({o.originalCurrency})</span>
                                <input
                                  type="number"
                                  name="amount"
                                  step="0.01"
                                  min="0.01"
                                  max={remainingMajor}
                                  placeholder={`full ${remainingMajor}`}
                                />
                              </label>
                              <button type="submit" class="adm-btn adm-btn--danger adm-btn--tiny">Issue refund</button>
                              <p class="ord-refund-hint">Blank = full refund of what’s left.</p>
                            </form>
                          </>
                        )}
                      </div>
                    </details>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </section>
  </main>

  <style>
    .ord-summary { display:flex; flex-wrap:wrap; gap:14px; margin-bottom:10px; }
    .ord-stat {
      display:flex; flex-direction:column; gap:2px;
      padding:10px 16px; border:1px solid rgba(42,27,42,0.12); border-radius:10px;
      min-width:120px; background:var(--adm-paper-soft);
    }
    .ord-stat span { font-size:11px; text-transform:uppercase; letter-spacing:0.04em; color:var(--adm-mute); }
    .ord-stat strong { font-size:20px; font-variant-numeric:tabular-nums; }

    /* Multi-select filter chips: a selected toggle shows a ✓ so it's clear
       several can be on at once (not radio-style single-pick). */
    .ord-toggle.is-on::before { content:'✓ '; }
    .ord-filter-hint { font-size:11px; color:var(--adm-mute); align-self:center; }

    .ord-search { display:flex; gap:8px; margin-top:12px; align-items:center; flex-wrap:wrap; }
    .ord-search input[type="search"] {
      flex:1; min-width:240px; padding:8px 12px;
      border:1px solid rgba(42,27,42,0.18); border-radius:8px; font-size:14px;
    }

    /* Compact rows: single-line content + a pop-out actions menu instead of a
       stack of buttons, so each row stays short. */
    /* The actions menu pops out below its row; admin.css gives .adm-table
       `overflow:hidden` (for rounded corners), which would clip the panel and
       make it unclickable. Let this table overflow so the menu shows in full. */
    .ord-table { overflow: visible; }
    .ord-table td { vertical-align:middle; padding-top:9px; padding-bottom:9px; }
    .ord-table .num { font-variant-numeric: tabular-nums; white-space:nowrap; }
    .ord-refunded { color:var(--adm-danger); }
    .ord-plan-note { color:var(--adm-mute); }
    .ord-date { white-space:nowrap; font-variant-numeric:tabular-nums; }
    .ord-paid-date { color:var(--adm-mute); }
    .adm-pill--other { background:rgba(0,0,0,0.06); color:var(--adm-ink-soft); }

    /* Product: give it room, but clamp very long names to two lines so a
       "Somatic Vocal Healing Masterclass" no longer stacks four rows tall and
       every row stays short + even. Full name on hover via title. */
    .ord-product { min-width:170px; max-width:280px; }
    .ord-product-name {
      display:-webkit-box; -webkit-line-clamp:2; line-clamp:2;
      -webkit-box-orient:vertical; overflow:hidden; line-height:1.3;
    }

    /* Customer: name stacked over a muted email, reclaiming the width the two
       separate columns used to spend — so Product can breathe. */
    .ord-cust { min-width:190px; line-height:1.35; }
    .ord-cust-name { display:block; font-weight:600; color:var(--adm-ink); }
    .ord-cust-name.is-empty { color:var(--adm-mute); font-weight:500; }
    .ord-cust-email {
      display:block; max-width:250px; font-size:12px; color:var(--adm-ink-soft);
      text-decoration:none; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    }
    .ord-cust-email:hover { color:var(--adm-ember-deep); text-decoration:underline; }

    /* Order id + compact source / plan tags, kept together on one small line. */
    .ord-id { display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .ord-no-link { color:var(--adm-ember-deep); text-decoration:none; font-weight:600; }
    .ord-no-link:hover { text-decoration:underline; }
    .ord-tag {
      font-size:10px; font-weight:600; letter-spacing:0.04em; text-transform:uppercase;
      padding:1px 7px; border-radius:999px; white-space:nowrap;
      background:rgba(0,0,0,0.06); color:var(--adm-ink-soft);
    }
    .ord-tag--src-retreat  { background:rgba(201, 96, 58, 0.16); color:var(--adm-ember-deep); }
    .ord-tag--src-course   { background:#d6e4f0; color:#2a5a8a; }
    .ord-tag--src-workshop { background:#dcefdc; color:#2f7a4c; }
    .ord-tag--plan         { background:#efe6d2; color:var(--adm-ink-soft); text-transform:none; }

    /* Payment-method column */
    .ord-pay { white-space:nowrap; }
    .ord-pay-gw { font-weight:600; }
    .ord-pay-gw--stripe { color:#4a3aa0; }
    .ord-pay-gw--paypal { color:#003087; }
    .ord-pay-method { color:var(--adm-ink-soft); }

    /* Actions kebab → pop-out menu */
    .ord-act-th { width:1%; }
    .ord-act-cell { text-align:right; }
    .ord-menu { position:relative; display:inline-block; }
    .ord-menu > summary {
      list-style:none; cursor:pointer; user-select:none;
      display:inline-flex; align-items:center; justify-content:center;
      width:30px; height:28px; border-radius:7px; font-size:18px; line-height:1;
      border:1px solid var(--adm-line); background:var(--adm-paper-soft); color:var(--adm-ink-soft);
    }
    .ord-menu > summary::-webkit-details-marker { display:none; }
    .ord-menu > summary:hover,
    .ord-menu[open] > summary { background:#f0e8d6; border-color:#d5cab1; }
    .ord-menu-panel {
      position:absolute; right:0; z-index:20; margin-top:6px; width:232px;
      padding:8px; border:1px solid rgba(42,27,42,0.16); border-radius:10px;
      background:var(--adm-paper); box-shadow:0 10px 28px rgba(0,0,0,0.18);
      display:flex; flex-direction:column; gap:2px; text-align:left;
    }
    .ord-menu-item {
      display:block; padding:7px 10px; border-radius:7px; font-size:13px;
      color:var(--adm-ink); text-decoration:none; white-space:nowrap;
    }
    .ord-menu-item:hover { background:var(--adm-paper-soft); }
    .ord-menu-sep { border:none; border-top:1px solid var(--adm-line); margin:6px 2px; }
    .ord-menu-refund { display:flex; flex-direction:column; gap:8px; padding:4px 8px 6px; }
    .ord-menu-refund label { display:flex; flex-direction:column; gap:4px; font-size:12px; }
    .ord-menu-refund input[type="number"] {
      padding:7px 10px; border:1px solid rgba(42,27,42,0.18); border-radius:7px; font-size:14px;
    }
    .ord-refund-hint { font-size:11px; color:var(--adm-mute); margin:0; }
    .sr-only {
      position:absolute; width:1px; height:1px; padding:0; margin:-1px;
      overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
    }
  </style>
</Layout>
