---
// Admin email preview — every lifecycle + transactional workshop email,
// rendered with sample data, with one-click "send me a test". The cadence
// notes mirror src/lib/workshops/cron.ts; the words live in emails.ts.
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import { buildEmailSamples } from '../../../lib/workshops/email-samples';

export const prerender = false;

const env = Astro.locals.runtime.env;
if (!(await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request)))) {
  return Astro.redirect('/admin/login');
}

const samples = buildEmailSamples(env.PUBLIC_BASE_URL);
const groups = [...new Set(samples.map((s) => s.group))];
---

<Layout title="Admin — Emails — Songdance" description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs"><a href="/admin">Admin</a> <span class="sep">/</span> Emails</p>
        <h1>Email sequences</h1>
        <p class="adm-sub">
          Every automated workshop email, rendered with sample data. Cadence
          runs from the 5-minute cron; sends are one-per-person
          (idempotent), and the marketing ones respect the unsubscribe list.
        </p>
      </div>
      <div class="adm-actions">
        <label class="em-tolabel" for="test-to">Send tests to</label>
        <input id="test-to" class="em-toinput" type="email" value="jacob@songdance.co" />
        <a class="adm-btn" href="/admin/emails/stats">Open &amp; click rates →</a>
        <a class="adm-btn" href="/admin/broadcasts">Broadcasts →</a>
        <a class="adm-btn adm-btn--ghost" href="/admin">← Admin</a>
      </div>
    </header>

    <section class="adm-section em-realsend">
      <h2>Reports (internal) — send with real data</h2>
      <p class="adm-sub">
        The cards below preview with sample data. This sends the actual
        SD-REPORT digest for a chosen window — the escape hatch for a digest the
        cron dropped. Leave the date blank for <strong>yesterday</strong>; blank
        recipient sends to the usual reports list (REPORTS_TO).
      </p>
      <div class="em-realsend-row">
        <label>Kind
          <select id="rpt-kind">
            <option value="daily">Daily (one day)</option>
            <option value="weekly">Weekly (7 days ending on date)</option>
          </select>
        </label>
        <label>Date (end of window)
          <input id="rpt-date" type="date" />
        </label>
        <label>Recipient override (optional)
          <input id="rpt-to" type="text" placeholder="defaults to REPORTS_TO" />
        </label>
        <button id="rpt-send" class="adm-btn" type="button">Send now (real data)</button>
      </div>
      <p id="rpt-status" class="em-realsend-status"></p>
    </section>

    <section class="adm-section em-realsend">
      <h2>Songdeck gift → Shopify (integration test)</h2>
      <p class="adm-sub">
        Check the Shopify wiring for the post-workshop Songdeck gift.
        <strong>Check connection</strong> is read-only — it mints a token and
        resolves the deck variant, confirming the domain, credentials, scopes
        (<code>write_draft_orders</code> + <code>read_products</code>) and product
        id. <strong>Place €0 test order</strong> creates a real order in Shopify
        (tagged <code>TEST</code>) so you can confirm the full path — cancel it
        in Shopify afterwards.
      </p>
      <div class="em-realsend-row">
        <button id="sd-check" class="adm-btn" type="button">Check connection</button>
        <button id="sd-place" class="adm-btn adm-btn--ghost" type="button">Place €0 test order</button>
      </div>
      <p id="sd-status" class="em-realsend-status"></p>
    </section>

    {groups.map((group) => (
      <section class="adm-section">
        <h2>{group}</h2>
        <div class="em-grid">
          {samples.filter((s) => s.group === group).map((s) => (
            <article class="em-card">
              <header class="em-card-head">
                <div>
                  <h3>{s.label}</h3>
                  <p class="em-meta"><strong>Subject:</strong> {s.content.subject}</p>
                  <p class="em-meta"><strong>When:</strong> {s.timing}</p>
                  <p class="em-meta"><strong>Who:</strong> {s.audience}</p>
                </div>
                <button class="adm-btn em-send" data-id={s.id} type="button">Send test</button>
              </header>
              <iframe class="em-frame" srcdoc={s.content.html} sandbox="" title={s.label}></iframe>
              <details class="em-text">
                <summary>Plain-text version</summary>
                <pre>{s.content.text}</pre>
              </details>
            </article>
          ))}
        </div>
      </section>
    ))}
  </main>

  <style>
    .em-tolabel { font-size: 13px; color: #6f5f6d; margin-right: 6px; }
    .em-toinput {
      font: inherit; font-size: 14px; padding: 8px 12px; margin-right: 10px;
      border: 1px solid rgba(161, 72, 38, 0.3); border-radius: 8px;
      background: #fbf6ec; min-width: 220px;
    }
    .em-realsend-row {
      display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-end; margin-top: 10px;
    }
    .em-realsend-row label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: #6f5f6d; }
    .em-realsend-row select, .em-realsend-row input {
      font: inherit; font-size: 14px; padding: 8px 12px;
      border: 1px solid rgba(161, 72, 38, 0.3); border-radius: 8px; background: #fbf6ec;
    }
    .em-realsend-row #rpt-to { min-width: 240px; }
    .em-realsend-status { margin: 10px 0 0; font-size: 13px; min-height: 1.2em; }
    .em-realsend-status[data-state='ok'] { color: #2f6b34; }
    .em-realsend-status[data-state='error'] { color: #a03636; }
    .em-grid { display: grid; gap: 22px; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); }
    .em-card {
      background: #fbf6ec; border: 1px solid rgba(161, 72, 38, 0.22);
      border-radius: 14px; padding: 18px; min-width: 0;
    }
    .em-card-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
    .em-card h3 { margin: 0 0 8px; font-size: 17px; font-weight: 600; }
    .em-meta { margin: 0 0 4px; font-size: 13px; color: #6f5f6d; }
    .em-send { white-space: nowrap; }
    .em-send[data-state='sent'] { background: #dcefdc; }
    .em-send[data-state='error'] { background: #f0d8d8; }
    .em-frame {
      width: 100%; height: 520px; border: 1px solid rgba(161, 72, 38, 0.18);
      border-radius: 10px; background: #f4ecdf; margin-top: 12px;
    }
    .em-text { margin-top: 10px; font-size: 13px; }
    .em-text pre {
      white-space: pre-wrap; background: #f4ecdf; border-radius: 10px;
      padding: 12px; font-size: 12.5px; line-height: 1.55;
    }
  </style>

  <script>
    // "Send now (real data)" — force-send the real SD-REPORT digest for a window.
    const rptSend = document.getElementById('rpt-send') as HTMLButtonElement | null;
    if (rptSend) {
      // A <select> exposes `.value` like an input; cast to the type this inline
      // script's DOM lib recognises (HTMLSelectElement isn't resolved here).
      const kindEl = document.getElementById('rpt-kind') as HTMLInputElement;
      const dateEl = document.getElementById('rpt-date') as HTMLInputElement;
      const toEl = document.getElementById('rpt-to') as HTMLInputElement;
      const statusEl = document.getElementById('rpt-status') as HTMLElement;
      rptSend.addEventListener('click', async () => {
        rptSend.disabled = true;
        statusEl.removeAttribute('data-state');
        statusEl.textContent = 'Sending…';
        try {
          const res = await fetch('/api/admin/emails/report-send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              kind: kindEl.value,
              date: dateEl.value || undefined,
              to: toEl.value.trim() || undefined,
            }),
          });
          const data = (await res.json()) as {
            ok?: boolean; error?: string; recipients?: string[]; from?: string; to?: string;
          };
          if (res.ok && data.ok) {
            statusEl.dataset.state = 'ok';
            const window = data.from === data.to ? data.to : `${data.from} → ${data.to}`;
            statusEl.textContent = `Sent ✓ (${window}) to ${(data.recipients ?? []).join(', ')}`;
          } else {
            statusEl.dataset.state = 'error';
            statusEl.textContent = data.error ?? 'Failed';
          }
        } catch {
          statusEl.dataset.state = 'error';
          statusEl.textContent = 'Failed';
        }
        rptSend.disabled = false;
      });
    }

    // Songdeck → Shopify integration test (read-only check, or a real €0 order).
    const sdCheck = document.getElementById('sd-check') as HTMLButtonElement | null;
    const sdPlace = document.getElementById('sd-place') as HTMLButtonElement | null;
    const sdStatus = document.getElementById('sd-status') as HTMLElement | null;
    async function sdRun(place: boolean) {
      if (!sdStatus) return;
      if (sdCheck) sdCheck.disabled = true;
      if (sdPlace) sdPlace.disabled = true;
      sdStatus.removeAttribute('data-state');
      sdStatus.textContent = place ? 'Placing a €0 test order…' : 'Checking connection…';
      try {
        const res = await fetch('/api/admin/courses/deck-gift-test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ place }),
        });
        const data = (await res.json()) as {
          ok?: boolean; error?: string; shop?: string; variantId?: string;
          placed?: { orderName?: string; adminUrl?: string } | null;
        };
        if (res.ok && data.ok) {
          sdStatus.dataset.state = 'ok';
          if (data.placed && data.placed.adminUrl) {
            sdStatus.innerHTML =
              `Placed test order ${data.placed.orderName ?? ''} ✓ — ` +
              `<a href="${data.placed.adminUrl}" target="_blank" rel="noopener">open in Shopify</a> and cancel it.`;
          } else {
            sdStatus.textContent = `Connection OK ✓ — ${data.shop ?? ''}, deck variant resolved. Ready to place orders.`;
          }
        } else {
          sdStatus.dataset.state = 'error';
          sdStatus.textContent = data.error ?? 'Failed';
        }
      } catch {
        sdStatus.dataset.state = 'error';
        sdStatus.textContent = 'Failed';
      }
      if (sdCheck) sdCheck.disabled = false;
      if (sdPlace) sdPlace.disabled = false;
    }
    sdCheck?.addEventListener('click', () => sdRun(false));
    sdPlace?.addEventListener('click', () => {
      if (
        confirm('Place a real €0 test order in Shopify? It will be tagged TEST — cancel it in Shopify afterwards.')
      ) {
        sdRun(true);
      }
    });

    const toInput = document.getElementById('test-to') as HTMLInputElement;
    document.querySelectorAll<HTMLButtonElement>('.em-send').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const original = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Sending…';
        btn.removeAttribute('data-state');
        try {
          const res = await fetch('/api/admin/emails/test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: btn.dataset.id, to: toInput.value.trim() }),
          });
          const data = (await res.json()) as { ok?: boolean; error?: string };
          if (res.ok && data.ok) {
            btn.dataset.state = 'sent';
            btn.textContent = 'Sent ✓';
          } else {
            btn.dataset.state = 'error';
            btn.textContent = data.error ?? 'Failed';
          }
        } catch {
          btn.dataset.state = 'error';
          btn.textContent = 'Failed';
        }
        setTimeout(() => {
          btn.disabled = false;
          btn.textContent = original;
          btn.removeAttribute('data-state');
        }, 3500);
      });
    });
  </script>
</Layout>
