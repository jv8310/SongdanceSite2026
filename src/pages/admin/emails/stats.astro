---
// Admin email stats — open & click rates per email type, fed by the Resend
// event webhook (/api/webhooks/resend) writing onto email_sends. Rates are over
// delivered mail. Open rate is soft (Apple Mail Privacy Protection inflates it);
// click rate is the trustworthy signal, and the basis for future A/B testing.
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import { emailStatsByType, type EmailTypeStats } from '../../../lib/email/sends';

export const prerender = false;

const env = Astro.locals.runtime.env;
if (!(await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request)))) {
  return Astro.redirect('/admin/login');
}

const stats = await emailStatsByType(env.DB);
const groups = [...new Set(stats.map((s) => s.group))];
const totalSent = stats.reduce((n, s) => n + s.sent, 0);

const pct = (r: number) => `${(r * 100).toFixed(1)}%`;
const byGroup = (g: string): EmailTypeStats[] => stats.filter((s) => s.group === g);
---

<Layout title="Admin — Email stats — Songdance" description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs">
          <a href="/admin">Admin</a> <span class="sep">/</span>
          <a href="/admin/emails">Emails</a> <span class="sep">/</span> Stats
        </p>
        <h1>Email engagement</h1>
        <p class="adm-sub">
          Open &amp; click rates per email, from Resend delivery events. Rates
          are over delivered mail. Open rate is approximate (Apple Mail
          Privacy Protection pre-fetches the pixel and inflates it) — click
          rate is the signal to trust. {totalSent.toLocaleString()} sends tracked.
        </p>
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--ghost" href="/admin/emails">← Previews</a>
      </div>
    </header>

    {totalSent === 0 ? (
      <section class="adm-section">
        <p class="es-empty">
          No tracked sends yet. Sends are recorded from the moment this ships;
          open/click data appears once the Resend webhook is configured
          (Resend dashboard → Webhooks → <code>/api/webhooks/resend</code>) and
          open/click tracking is enabled on the sending domain, with the signing
          secret set as <code>RESEND_WEBHOOK_SECRET</code>.
        </p>
      </section>
    ) : (
      groups.map((group) => (
        <section class="adm-section">
          <h2>{group}</h2>
          <table class="es-table">
            <thead>
              <tr>
                <th>Email</th>
                <th class="es-num">Sent</th>
                <th class="es-num">Delivered</th>
                <th class="es-num">Open rate</th>
                <th class="es-num">Click rate</th>
                <th class="es-num">Bounced</th>
                <th class="es-num">Spam</th>
              </tr>
            </thead>
            <tbody>
              {byGroup(group).map((s) => (
                <tr>
                  <td>{s.label} <span class="es-key">{s.type}</span></td>
                  <td class="es-num">{s.sent.toLocaleString()}</td>
                  <td class="es-num">{s.delivered.toLocaleString()}</td>
                  <td class="es-num"><strong>{pct(s.openRate)}</strong> <span class="es-sub">{s.opened}</span></td>
                  <td class="es-num"><strong>{pct(s.clickRate)}</strong> <span class="es-sub">{s.clicked}</span></td>
                  <td class="es-num">{s.bounced.toLocaleString()}</td>
                  <td class="es-num">{s.complained.toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))
    )}
  </main>

  <style>
    .es-empty {
      font-size: 14px; color: #6f5f6d; line-height: 1.6;
      background: #fbf6ec; border: 1px solid rgba(161, 72, 38, 0.22);
      border-radius: 12px; padding: 18px 20px;
    }
    .es-empty code {
      font-size: 12.5px; background: #f4ecdf; padding: 1px 6px; border-radius: 5px;
    }
    .es-table {
      width: 100%; border-collapse: collapse; background: #fbf6ec;
      border: 1px solid rgba(161, 72, 38, 0.22); border-radius: 12px; overflow: hidden;
    }
    .es-table th, .es-table td {
      padding: 10px 14px; text-align: left; font-size: 14px;
      border-bottom: 1px solid rgba(161, 72, 38, 0.12);
    }
    .es-table th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: #6f5f6d; }
    .es-table tr:last-child td { border-bottom: none; }
    .es-num { text-align: right; font-variant-numeric: tabular-nums; }
    .es-key { color: #b6a8b4; font-size: 11.5px; margin-left: 6px; }
    .es-sub { color: #b6a8b4; font-size: 12px; margin-left: 4px; }
  </style>
</Layout>
