---
// Admin — Person detail: everything the site knows about one email address —
// engagement summary (src/lib/admin/people.ts), every order across retreats/
// courses/workshops (src/lib/admin/orders.ts), tracked email sends with
// open/click data (src/lib/email/sends.ts), and Drip-imported contact tags
// (src/lib/broadcasts/db.ts). Read-only, assembled live — no `people` table.
// The one exception is "App access": the person's courses, certification,
// Circle seats and host spaces in the member app, which the app answers and
// changes through its service binding (src/lib/admin/app-access.ts,
// /api/admin/app-access).
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import { listPeople } from '../../../lib/admin/people';
import { listAllOrders, refundableMinor, type OrderSource } from '../../../lib/admin/orders';
import { getFxRatesToEur } from '../../../lib/admin/fx';
import { formatMoney } from '../../../lib/workshops/currency';
import { emailSendsForAddress } from '../../../lib/email/sends';
import { getContact, listBroadcasts } from '../../../lib/broadcasts/db';
import FeedbackEditor from '../../../components/admin/FeedbackEditor.astro';
import { CERT_STEPS, MAX_CERTIFICATE_BYTES, STATE_LABEL, STATE_PILL, actorLabel, askApp, day, fileSize, sourceLabel } from '../../../lib/admin/app-access';

export const prerender = false;

const env = Astro.locals.runtime.env;
if (!(await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request)))) {
  return Astro.redirect('/admin/login');
}

// The Cloudflare adapter hands `Astro.params` the raw, still-percent-encoded
// path segment, so an email arrives as `name%40gmail.com` (the `@` never
// decoded) and every lookup below misses. Decode it once — defensively, since a
// stray unescaped `%` would otherwise throw — before normalising. Already-
// decoded values have no `%` sequences and pass through unchanged.
const rawEmailParam = (Astro.params.email ?? '').toString();
let decodedEmailParam = rawEmailParam;
try {
  decodedEmailParam = decodeURIComponent(rawEmailParam);
} catch {
  // Not valid percent-encoding — use the segment as-is.
}
const email = decodedEmailParam.trim().toLowerCase();

const rawReturn = Astro.url.searchParams.get('return_to') ?? '';
const backHref = rawReturn.startsWith('/admin/people') ? rawReturn : '/admin/people';
const selfReturn = Astro.url.pathname + Astro.url.search;

const fxRates = await getFxRatesToEur(env.DB);
const quaderno =
  env.QUADERNO_API_KEY && env.QUADERNO_ACCOUNT
    ? {
        apiKey: env.QUADERNO_API_KEY,
        account: env.QUADERNO_ACCOUNT,
        sandbox: env.QUADERNO_SANDBOX === '1',
      }
    : undefined;

const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

const [allPeople, orders, sends, contact, broadcasts, appAccess] = await Promise.all([
  listPeople(env.DB),
  listAllOrders(env.DB, { email }, { fxRates, quaderno }),
  emailSendsForAddress(env.DB, email),
  getContact(env.DB, email),
  listBroadcasts(env.DB),
  validEmail ? askApp(env, (app) => app.member({ email })) : Promise.resolve(null),
]);

const person = allPeople.find((p) => p.email === email) ?? null;

// Swap the generic "Broadcast #<id>" label for the real name, same as
// /admin/emails/stats.
const bcNames = new Map(broadcasts.map((b) => [`broadcast_${b.id}`, b.name]));
for (const s of sends) {
  const name = bcNames.get(s.type);
  if (name) s.label = name;
}

const exists = !!person || orders.length > 0 || sends.length > 0 || !!contact;

const SOURCE_LABEL: Record<OrderSource, string> = {
  retreat: 'Retreat',
  course: 'Course',
  workshop: 'Workshop',
};

function eur(minor: number): string {
  const major = minor / 100;
  return `€${Number.isInteger(major) ? major : major.toFixed(2)}`;
}
function fmtDate(s: string | null): string {
  if (!s) return '—';
  const iso = s.includes('T') ? s : `${s.replace(' ', 'T')}Z`;
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '—' : d.toISOString().slice(0, 10);
}
function fmtDateTime(s: string | null): string | undefined {
  if (!s) return undefined;
  const iso = s.includes('T') ? s : `${s.replace(' ', 'T')}Z`;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return undefined;
  return d.toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
}

const sendGroups = [...new Set(sends.map((s) => s.group))];

// App access (see the header). A failed answer prints its message in place.
const app = appAccess?.ok ? appAccess.data : null;
const appProblem = appAccess && !appAccess.ok ? appAccess.message : null;
const appFlash = Astro.url.searchParams.get('app_msg');
const appFlashErr = Astro.url.searchParams.has('app_err');
const otherEmails = app ? app.linkedEmails.filter((e) => e !== email) : [];
// A course with live sessions starts its live window on its start date; a
// grant with no start opens the materials only. So the form starts on today.
const todayBrussels = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Brussels' }).format(new Date());
const seatableSpaces = app ? app.catalogue.spaces.filter((sp) => sp.audience !== 'everyone') : [];
const hostableSpaces = app ? app.catalogue.spaces.filter((sp) => !sp.archived && !app.hostSpaces.some((h) => h.spaceKey === sp.key)) : [];
const ROLE_LABEL: Record<string, string> = { member: 'member', host: 'host', admin: 'app admin' };
// Certification: their own ticks in the app, and Jacob's "certified" with the certificate.
const cert = app?.certification ?? null;
const certSteps = cert?.checks ? CERT_STEPS.filter((st) => cert.checks?.[st.key]).length : 0;
const certificateHref = `/api/admin/app-certificate?email=${encodeURIComponent(email)}`;
const jsEmail = email.replace(/['\\]/g, '\\$&');

// Flash from the unsubscribe / resubscribe endpoints, which return here.
const subFlashKind = Astro.url.searchParams.get('flash');
const subFlash =
  subFlashKind === 'unsub_ok'
    ? { tone: 'ok' as const, text: 'Unsubscribed — on the suppression list, and unsubscribed in Drip if Drip knows the address.' }
  : subFlashKind === 'resub_ok'
    ? { tone: 'ok' as const, text: 'Resubscribed — lifted the suppression and reactivated them in Drip.' }
  : subFlashKind === 'unsub_error' || subFlashKind === 'resub_error'
    ? { tone: 'err' as const, text: Astro.url.searchParams.get('msg') ?? 'That did not work.' }
  : null;
---

<Layout title={`Admin — ${email || 'Person'} — Songdance`} description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs">
          <a href="/admin">Admin</a>
          <span class="sep">/</span>
          <a href="/admin/people">People</a>
          <span class="sep">/</span>
          {email}
        </p>
        <h1>{person?.name || email}</h1>
        {person?.name && <p class="adm-sub">{email}</p>}
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--ghost" href={`/admin/orders?email=${encodeURIComponent(email)}`}>Orders →</a>
        <a class="adm-btn adm-btn--ghost" href={`mailto:${email}`}>Email</a>
        <a class="adm-btn adm-btn--ghost" href={`/api/admin/drip-profile?email=${encodeURIComponent(email)}`} target="_blank" rel="noopener">Drip profile ↗</a>
        <a class="adm-btn adm-btn--ghost" href={backHref}>← Back to people</a>
      </div>
    </header>

    {!exists && (
      <section class="adm-section">
        <p class="adm-empty">Nothing on the site for “{email}”.</p>
      </section>
    )}

    {exists && (
      <>
        <!-- ─── Overview ─── -->
        <section class="adm-section">
          <div class="pd-summary">
            <div class="pd-head">
              {person?.subscribed
                ? <span class="adm-pill adm-pill--paid">subscribed</span>
                : person && <span class="adm-pill adm-pill--cancelled" title={`Unsubscribed ${fmtDate(person.unsubscribedAt)}${person.unsubscribeSource ? ` (${person.unsubscribeSource})` : ''}`}>unsubscribed</span>}
              {person?.isCustomer && <span class="adm-pill adm-pill--paid">customer</span>}
              {person && !person.isCustomer && <span class="adm-pill adm-pill--pending">lead</span>}
              {person?.isPro && <span class="adm-pill adm-pill--pro">pro</span>}
            </div>
            <div class="pd-grid">
              {person && (
                <div class="pd-stat">
                  <span>Workshops</span>
                  <strong>
                    {person.workshopsSecured > 0
                      ? `${person.workshopsAttended}/${person.workshopsSecured} attended${person.workshopsNoShow > 0 ? `, ${person.workshopsNoShow} missed` : ''}`
                      : person.workshopsAbandoned > 0
                        ? `${person.workshopsAbandoned} unfinished`
                        : '—'}
                  </strong>
                </div>
              )}
              {person && person.country && (
                <div class="pd-stat"><span>Country</span><strong>{person.country}</strong></div>
              )}
              {person && (
                <div class="pd-stat"><span>First seen</span><strong>{fmtDate(person.firstSeen)}</strong></div>
              )}
              {person && (
                <div class="pd-stat"><span>Last activity</span><strong>{fmtDate(person.lastActivity)}</strong></div>
              )}
              <div class="pd-stat"><span>Orders</span><strong>{orders.length > 0 ? <a href={`/admin/orders?email=${encodeURIComponent(email)}`}>{orders.length}</a> : 0}</strong></div>
              <div class="pd-stat"><span>Tracked sends</span><strong>{sends.length}</strong></div>
            </div>
            {person && person.purchases.length > 0 && (
              <p class="pd-purchases">
                {person.bought12w && <span class="adm-pill adm-pill--src-course">12-week</span>}
                {person.boughtCert && <span class="adm-pill adm-pill--src-course">Cert</span>}
                {person.retreatsBought > 0 && <span class="adm-pill adm-pill--src-retreat">Retreat{person.retreatsBought > 1 ? `×${person.retreatsBought}` : ''}</span>}
              </p>
            )}
          </div>

          {subFlash && <div class={`adm-flash ${subFlash.tone === 'err' ? 'adm-flash--err' : 'adm-flash--ok'} pd-resub`}>{subFlash.text}</div>}

          {person?.subscribed && (
            <form
              method="POST"
              action="/api/admin/unsubscribe"
              class="pd-resub"
              onsubmit={`return confirm('Unsubscribe ${jsEmail}? They get no more marketing email from the site, and are unsubscribed in Drip. Order and session mail still arrives.')`}
            >
              <input type="hidden" name="email" value={email} />
              <input type="hidden" name="return_to" value={selfReturn} />
              <button type="submit" class="adm-btn adm-btn--ghost">Unsubscribe</button>
            </form>
          )}

          {person && !person.subscribed && (
            <form
              method="POST"
              action="/api/admin/resubscribe"
              class="pd-resub"
              onsubmit={`return confirm('Resubscribe ${jsEmail}? This opts them back into marketing and reactivates them in Drip.')`}
            >
              <input type="hidden" name="email" value={email} />
              <input type="hidden" name="return_to" value={selfReturn} />
              <button type="submit" class="adm-btn adm-btn--solid">Resubscribe</button>
            </form>
          )}
        </section>
      </>
    )}

    <!-- ─── App access (the member app answers this one) ─── -->
    {validEmail && (
      <section class="adm-section" id="app-access">
        <h2>App access</h2>
        {appFlash && <div class={`adm-flash ${appFlashErr ? 'adm-flash--err' : 'adm-flash--ok'}`}>{appFlash}</div>}
        {appProblem && <p class="adm-empty">{appProblem}</p>}
        {app && (
          <>
            <p class="app-account">
              {app.account
                ? <>Has an app account{app.account.name ? ` as ${app.account.name}` : ''} · {ROLE_LABEL[app.account.role] ?? app.account.role} · {app.account.lastSeenAt ? `last seen ${fmtDate(app.account.lastSeenAt)}` : 'has not opened the app yet'}</>
                : 'No app account yet. Whatever you add here is waiting for them the first time they sign in to the app with this address.'}
            </p>
            {otherEmails.length > 0 && <p class="pd-mute">Also linked in the app: {otherEmails.join(', ')}</p>}

            <h3 class="app-h3">Courses</h3>
            {app.courses.length === 0 && <p class="adm-empty">No courses in the app.</p>}
            {app.courses.length > 0 && (
              <div class="app-scroll"><table class="adm-table app-table">
                <thead>
                  <tr>
                    <th>Course</th>
                    <th>Status</th>
                    <th>Dates</th>
                    <th>Where it comes from</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {app.courses.map((c) => (
                    <tr class={c.state === 'revoked' ? 'app-row--off' : ''}>
                      <td>
                        {c.label}
                        {c.email !== email && <><br /><span class="pd-mute">under {c.email}</span></>}
                      </td>
                      <td><span class={`adm-pill adm-pill--${STATE_PILL[c.state]}`}>{STATE_LABEL[c.state]}</span></td>
                      <td class="app-dates">
                        {c.startsAt ? <span>from {day(c.startsAt)}</span> : <span class="pd-mute">no start date (materials only)</span>}
                        {c.isCertification && c.activateChoice === 'wait' && (
                          c.activatedAt ? <span>activated {day(c.activatedAt)}</span> : <span class="pd-mute">not activated yet</span>
                        )}
                        {c.endsAt && <span>ends {day(c.endsAt)}</span>}
                        {c.graceUntil && <span>closes {day(c.graceUntil)} (stopped plan)</span>}
                        {c.liveUntil && c.state !== 'revoked' && (
                          <span class="pd-mute">
                            live sessions {new Date(c.liveUntil).getTime() < Date.now() ? 'ended' : 'until'} {day(c.liveUntil)}
                            {c.liveSetByAdmin && ' (set by hand)'}
                          </span>
                        )}
                        {c.revokedAt && <span>revoked {day(c.revokedAt)}</span>}
                      </td>
                      <td>
                        {sourceLabel(c.source)}
                        {c.state !== 'revoked' && c.by && <span class="pd-mute"> by {actorLabel(c.by)}</span>}
                        {c.state === 'revoked' && <><br /><span class="pd-mute">Revoked{c.by ? ` by ${actorLabel(c.by)}` : ''}{c.note ? `: ${c.note}` : ''}</span></>}
                        {c.state !== 'revoked' && c.note && <><br /><span class="pd-mute">{c.note}</span></>}
                      </td>
                      <td class="app-actions">
                        {c.state !== 'revoked' && (
                          <details class="app-details">
                            <summary>Change</summary>
                            {c.hasLiveWindow && (
                              <form method="POST" action="/api/admin/app-access" class="app-form">
                                <input type="hidden" name="action" value="extend-course" />
                                <input type="hidden" name="email" value={email} />
                                <input type="hidden" name="entitlement_id" value={c.id} />
                                <div class="adm-grid app-grid">
                                  <label><span>Extra time (months)</span><input type="number" name="months" min="1" max="36" step="1" required placeholder="e.g. 3" /></label>
                                </div>
                                <button type="submit" class="adm-btn adm-btn--tiny adm-btn--solid">Give extra time</button>
                                <p class="pd-mute">Months of Q&amp;As, live classes and deepening sessions: added to the day the live sessions end, or counted from today if they have already ended. The materials never run out.</p>
                              </form>
                            )}
                            <form method="POST" action="/api/admin/app-access" class="app-form">
                              <input type="hidden" name="action" value="course-dates" />
                              <input type="hidden" name="email" value={email} />
                              <input type="hidden" name="entitlement_id" value={c.id} />
                              <div class="adm-grid app-grid">
                                <label><span>Starts</span><input type="date" name="starts_at" value={day(c.startsAt)} /></label>
                                {c.isCertification && c.activateChoice === 'wait' && <label><span>Activated</span><input type="date" name="activated_at" value={day(c.activatedAt)} /></label>}
                                <label><span>Ends</span><input type="date" name="ends_at" value={day(c.endsAt)} /></label>
                                {c.hasLiveWindow && <label><span>Live sessions until</span><input type="date" name="live_until" value={c.liveSetByAdmin ?? ''} /></label>}
                              </div>
                              <button type="submit" class="adm-btn adm-btn--tiny">Save dates</button>
                              <p class="pd-mute">An empty field clears that date. A date set here wins over the order's.{c.hasLiveWindow && ' "Ends" closes the whole course, materials included; "Live sessions until" moves only the live sessions (empty = the course\'s own 12 weeks / 9 months).'}</p>
                            </form>
                            <form
                              method="POST"
                              action="/api/admin/app-access"
                              class="app-form"
                              onsubmit={`return confirm('Take ${c.label.replace(/['\\]/g, '\\$&')} away from ${jsEmail} in the app? Nothing is refunded, and no order or Drip tag brings it back.')`}
                            >
                              <input type="hidden" name="action" value="revoke-course" />
                              <input type="hidden" name="email" value={email} />
                              <input type="hidden" name="entitlement_id" value={c.id} />
                              <div class="adm-grid app-grid">
                                <label class="span-full"><span>Reason</span><input type="text" name="reason" required maxlength="500" placeholder="Why (kept in the app's log)" /></label>
                              </div>
                              <button type="submit" class="adm-btn adm-btn--tiny adm-btn--danger">Revoke</button>
                            </form>
                          </details>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table></div>
            )}

            <details class="app-add" open={app.courses.length === 0}>
              <summary>Add a course</summary>
              <form method="POST" action="/api/admin/app-access" class="app-form">
                <input type="hidden" name="action" value="grant-course" />
                <input type="hidden" name="email" value={email} />
                <div class="adm-grid">
                  <label class="span-2">
                    <span>Course</span>
                    <select name="product" required>
                      <option value="">Choose a course…</option>
                      {app.catalogue.products.map((p) => <option value={p.key}>{p.label}</option>)}
                    </select>
                  </label>
                  <label><span>Starts</span><input type="date" name="starts_at" value={todayBrussels} /></label>
                  <label><span>Ends (optional)</span><input type="date" name="ends_at" /></label>
                  <label><span>Live sessions for (months, optional)</span><input type="number" name="live_months" min="1" max="36" step="1" placeholder="12-week / certification" /></label>
                  <label class="span-full"><span>Note</span><input type="text" name="note" required maxlength="500" placeholder="Why (kept in the app's log), e.g. comp after the retreat" /></label>
                </div>
                <button type="submit" class="adm-btn adm-btn--solid">Add course</button>
                <p class="pd-mute">The start date also starts any live sessions the course comes with. With no start date only the materials open. For the 12-week or certification course, "Live sessions for" gives that many months of Q&amp;As, live classes and deepening sessions from the start, instead of the course's own 12 weeks / 9 months; the materials stay open for good. Leave "Ends" empty unless the whole course should close.</p>
              </form>
            </details>

            <h3 class="app-h3" id="app-certification">Certification</h3>
            {!cert && <p class="pd-mute">The app does not answer about certification yet: it needs the app deployed with it first.</p>}
            {cert && !cert.available && <p class="pd-mute">The app's database does not have certification yet (migration app_0030). Run the app's migrations first.</p>}
            {cert && cert.available && (
              <>
                <p class="app-cert-line">
                  {!cert.checks && <span class="pd-mute">No app account, so nothing ticked in the app.</span>}
                  {cert.checks && (cert.checks.applied
                    ? <>Applied in the app on <strong>{fmtDate(cert.checks.applied)}</strong> ("I've filled in the form and applied")</>
                    : <span class="pd-mute">Has not ticked "I've applied" in the app.</span>)}
                  {cert.checks && <span class="pd-mute"> · steps ticked: {certSteps} of {CERT_STEPS.length}{certSteps > 0 && certSteps < CERT_STEPS.length ? ` (${CERT_STEPS.filter((st) => cert.checks?.[st.key]).map((st) => st.label).join(', ')})` : ''}</span>}
                </p>

                {cert.certified ? (
                  <div class="app-cert">
                    <p class="app-cert-status">
                      <span class="adm-pill adm-pill--paid">🎓 certified</span>
                      <span>since <strong>{cert.certified.on}</strong></span>
                      <span class="pd-mute">by {actorLabel(cert.certified.by) ?? 'an admin'}{cert.certified.email !== email ? ` · under ${cert.certified.email}` : ''}</span>
                    </p>
                    {cert.certified.note && <p class="pd-mute">{cert.certified.note}</p>}
                    {cert.certified.certificate ? (
                      <p class="app-cert-file">
                        Certificate: <a href={certificateHref} target="_blank" rel="noopener">{cert.certified.certificate.filename}</a>
                        <span class="pd-mute"> · {fileSize(cert.certified.certificate.sizeBytes)}{cert.certified.certificate.addedAt ? ` · added ${fmtDate(cert.certified.certificate.addedAt)}` : ''}{cert.certified.certificate.by ? ` by ${actorLabel(cert.certified.certificate.by)}` : ''}</span>
                      </p>
                    ) : (
                      <p class="pd-mute">No certificate yet: the app says "You are certified", and offers the certificate to download once it is added.</p>
                    )}
                    <form method="POST" action="/api/admin/app-access" enctype="multipart/form-data" class="app-form app-inline">
                      <input type="hidden" name="action" value="add-certificate" />
                      <input type="hidden" name="email" value={email} />
                      <div class="adm-grid">
                        <label class="span-2"><span>{cert.certified.certificate ? 'Replace the certificate' : 'Add the certificate'} (PDF, JPEG or PNG, up to {MAX_CERTIFICATE_BYTES / 1024 / 1024} MB)</span><input type="file" name="certificate" accept="application/pdf,image/jpeg,image/png" required /></label>
                      </div>
                      <button type="submit" class="adm-btn adm-btn--solid">{cert.certified.certificate ? 'Replace certificate' : 'Add certificate'}</button>
                    </form>
                    {cert.certified.feedback !== undefined && (
                      <form method="POST" action="/api/admin/app-access" class="app-form app-inline" id="app-cert-feedback">
                        <input type="hidden" name="action" value="certification-feedback" />
                        <input type="hidden" name="email" value={email} />
                        <FeedbackEditor value={cert.certified.feedback?.text ?? ''} label="Your feedback on their session" />
                        <button type="submit" class="adm-btn adm-btn--solid">{cert.certified.feedback ? 'Save feedback' : 'Add feedback'}</button>
                        <p class="pd-mute">
                          {cert.certified.feedback
                            ? `Saved ${fmtDate(cert.certified.feedback.at)}${cert.certified.feedback.by ? ` by ${actorLabel(cert.certified.feedback.by)}` : ''}. `
                            : ''}
                          They read it on their certification page in the app, under the certificate. Saving an empty box takes it away.
                        </p>
                      </form>
                    )}
                    <details class="app-add">
                      <summary>Change the day or the note, take the certificate away, or undo</summary>
                      <form method="POST" action="/api/admin/app-access" class="app-form">
                        <input type="hidden" name="action" value="certified-day" />
                        <input type="hidden" name="email" value={email} />
                        <div class="adm-grid app-grid">
                          <label><span>Certified on</span><input type="date" name="on" value={cert.certified.on} required /></label>
                          <label class="span-2"><span>Note (optional)</span><input type="text" name="note" maxlength="500" placeholder="Kept in the app's log" /></label>
                        </div>
                        <button type="submit" class="adm-btn adm-btn--tiny">Save</button>
                      </form>
                      {cert.certified.certificate && (
                        <form
                          method="POST"
                          action="/api/admin/app-access"
                          class="app-form"
                          onsubmit={`return confirm('Take the certificate away from ${jsEmail}? They stay certified.')`}
                        >
                          <input type="hidden" name="action" value="remove-certificate" />
                          <input type="hidden" name="email" value={email} />
                          <button type="submit" class="adm-btn adm-btn--tiny adm-btn--danger">Take the certificate away</button>
                        </form>
                      )}
                      <form
                        method="POST"
                        action="/api/admin/app-access"
                        class="app-form"
                        onsubmit={`return confirm('Undo the certification of ${jsEmail}? The certificate is deleted too.')`}
                      >
                        <input type="hidden" name="action" value="uncertify" />
                        <input type="hidden" name="email" value={email} />
                        <div class="adm-grid app-grid">
                          <label class="span-full"><span>Reason</span><input type="text" name="reason" required maxlength="500" placeholder="Why (kept in the app's log)" /></label>
                        </div>
                        <button type="submit" class="adm-btn adm-btn--tiny adm-btn--danger">Undo certification</button>
                      </form>
                    </details>
                  </div>
                ) : (
                  <form method="POST" action="/api/admin/app-access" enctype="multipart/form-data" class="app-form app-inline">
                    <input type="hidden" name="action" value="certify" />
                    <input type="hidden" name="email" value={email} />
                    <div class="adm-grid">
                      <label><span>Certified on</span><input type="date" name="on" value={todayBrussels} required /></label>
                      <label class="span-2"><span>Certificate (optional: PDF, JPEG or PNG, up to {MAX_CERTIFICATE_BYTES / 1024 / 1024} MB)</span><input type="file" name="certificate" accept="application/pdf,image/jpeg,image/png" /></label>
                      <label class="span-full"><span>Note (optional)</span><input type="text" name="note" maxlength="500" placeholder="Kept in the app's log, e.g. reviewed the session video" /></label>
                    </div>
                    <FeedbackEditor />
                    <button type="submit" class="adm-btn adm-btn--solid">Mark as certified</button>
                    <p class="pd-mute">On their certification course page in the app, "Apply for certification" becomes a "You are certified" label; it opens their certification page, with the certificate to download and your feedback. Works before they have an app account: it waits under this address. The certificate and the feedback can be added now or later.</p>
                  </form>
                )}
              </>
            )}

            <h3 class="app-h3">CiRCLE spaces</h3>
            <p class="pd-mute">A course already opens its own spaces. Seat someone here only in a space none of their courses gives them.</p>
            {app.spaceSeats.length > 0 && (
              <div class="app-scroll"><table class="adm-table app-table">
                <tbody>
                  {app.spaceSeats.map((seat) => (
                    <tr>
                      <td>{seat.title}</td>
                      <td class="pd-mute">{seat.source === 'import' ? 'Brought over from Mighty' : `Seated by ${actorLabel(seat.grantedBy) ?? 'an admin'}`} · {fmtDate(seat.createdAt)}</td>
                      <td class="app-actions">
                        <details class="app-details">
                          <summary>Remove</summary>
                          <form method="POST" action="/api/admin/app-access" class="app-form">
                            <input type="hidden" name="action" value="unseat-space" />
                            <input type="hidden" name="email" value={email} />
                            <input type="hidden" name="space" value={seat.spaceKey} />
                            <div class="adm-grid app-grid">
                              <label class="span-full"><span>Reason</span><input type="text" name="reason" required maxlength="500" placeholder="Why (kept in the app's log)" /></label>
                            </div>
                            <button type="submit" class="adm-btn adm-btn--tiny adm-btn--danger">Take the seat away</button>
                          </form>
                        </details>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table></div>
            )}
            {seatableSpaces.length > 0 && (
              <form method="POST" action="/api/admin/app-access" class="app-form app-inline">
                <input type="hidden" name="action" value="seat-space" />
                <input type="hidden" name="email" value={email} />
                <div class="adm-grid">
                  <label class="span-2">
                    <span>Space</span>
                    <select name="space" required>
                      <option value="">Choose a space…</option>
                      {seatableSpaces.map((sp) => <option value={sp.key}>{sp.title}{sp.archived ? ' (archive)' : ''}</option>)}
                    </select>
                  </label>
                  <label class="span-2"><span>Note</span><input type="text" name="note" required maxlength="500" placeholder="Why (kept in the app's log)" /></label>
                </div>
                <button type="submit" class="adm-btn adm-btn--solid">Seat in space</button>
              </form>
            )}

            <h3 class="app-h3">Hosting</h3>
            {!app.account && <p class="pd-mute">Hosting needs an app account. Once they have signed in to the app, you can make them a host here.</p>}
            {app.account && (
              <>
                {app.hostSpaces.length === 0 && <p class="pd-mute">Not a host of any space.</p>}
                {app.hostSpaces.length > 0 && (
                  <div class="app-scroll"><table class="adm-table app-table">
                    <tbody>
                      {app.hostSpaces.map((h) => (
                        <tr>
                          <td>Host of {h.title}</td>
                          <td class="app-actions">
                            <form
                              method="POST"
                              action="/api/admin/app-access"
                              onsubmit={`return confirm('Stop ${jsEmail} hosting ${h.title.replace(/['\\]/g, '\\$&')}?')`}
                            >
                              <input type="hidden" name="action" value="remove-host" />
                              <input type="hidden" name="email" value={email} />
                              <input type="hidden" name="space" value={h.spaceKey} />
                              <button type="submit" class="adm-btn adm-btn--tiny adm-btn--danger">Remove</button>
                            </form>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table></div>
                )}
                {hostableSpaces.length > 0 && (
                  <form method="POST" action="/api/admin/app-access" class="app-form app-inline">
                    <input type="hidden" name="action" value="add-host" />
                    <input type="hidden" name="email" value={email} />
                    <div class="adm-grid">
                      <label class="span-2">
                        <span>Space</span>
                        <select name="space" required>
                          <option value="">Choose a space…</option>
                          {hostableSpaces.map((sp) => <option value={sp.key}>{sp.title}</option>)}
                        </select>
                      </label>
                    </div>
                    <button type="submit" class="adm-btn adm-btn--solid">Make host</button>
                  </form>
                )}
              </>
            )}
          </>
        )}
      </section>
    )}

    {exists && (
      <>
        <!-- ─── Tags (Drip) ─── -->
        <section class="adm-section">
          <h2>Tags</h2>
          {!contact && <p class="adm-empty">Not in the imported contacts list.</p>}
          {contact && (
            <div class="pd-contact">
              {contact.tags.length === 0 && <p class="pd-mute">No tags recorded.</p>}
              {contact.tags.length > 0 && (
                <div class="pd-tags">
                  {contact.tags.map((t) => <span class="adm-pill pd-tag">{t}</span>)}
                </div>
              )}
              <dl class="pd-contact-kv">
                {contact.timezone && <><dt>Timezone</dt><dd>{contact.timezone}</dd></>}
                {contact.country && <><dt>Country</dt><dd>{contact.country}</dd></>}
              </dl>
            </div>
          )}
        </section>

        <!-- ─── Orders ─── -->
        <section class="adm-section">
          <h2>Orders {orders.length > 0 && <a class="pd-h2-link" href={`/admin/orders?email=${encodeURIComponent(email)}`}>open in Orders →</a>}</h2>
          {orders.length === 0 && <p class="adm-empty">No orders on file.</p>}
          {orders.length > 0 && (
            <table class="adm-table pd-orders">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>Date</th>
                  <th>Product</th>
                  <th class="num">Original</th>
                  <th class="num">Net (EUR)</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {orders.map((o) => {
                  const remaining = refundableMinor(o);
                  return (
                    <tr>
                      <td>
                        <a class="adm-mono" href={`/admin/orders/${o.orderNo}?return_to=${encodeURIComponent(selfReturn)}`}>{o.orderNo}</a>
                        <span class={`pd-src pd-src--${o.source}`}>{SOURCE_LABEL[o.source]}</span>
                      </td>
                      <td title={fmtDateTime(o.createdAt)}>{fmtDate(o.createdAt)}</td>
                      <td>{o.productLabel}</td>
                      <td class="num">
                        {o.originalAmountMinor > 0 ? formatMoney(o.originalAmountMinor, o.originalCurrency) : '—'}
                        {o.refundedMinor > 0 && (
                          <><br /><small class="pd-refunded">−{formatMoney(o.refundedMinor, o.originalCurrency)} refunded{remaining === 0 ? ' (full)' : ''}</small></>
                        )}
                      </td>
                      <td class="num">
                        {o.netKind !== 'none' && o.netEurMinor != null ? eur(o.netEurMinor) : '—'}
                      </td>
                      <td><span class={`adm-pill adm-pill--${o.statusClass}`}>{o.rawStatus}</span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
        </section>

        <!-- ─── Emails sent ─── -->
        <section class="adm-section">
          <h2>Emails sent</h2>
          <p class="adm-table-note">
            Tracked sends only (from Resend delivery events, migration 0046
            onward) — older history may only show in the workshop reminder log
            on the People list. Open rate is soft (Apple Mail Privacy Protection
            pre-fetches the pixel) — click is the signal to trust.
          </p>
          {sends.length === 0 && <p class="adm-empty">No tracked sends.</p>}
          {sends.length > 0 &&
            sendGroups.map((group) => (
              <table class="adm-table pd-sends">
                <thead>
                  <tr>
                    <th>{group}</th>
                    <th>Sent</th>
                    <th>Delivered</th>
                    <th>Opened</th>
                    <th>Clicked</th>
                    <th>Bounced</th>
                  </tr>
                </thead>
                <tbody>
                  {sends
                    .filter((s) => s.group === group)
                    .map((s) => (
                      <tr>
                        <td>{s.label}</td>
                        <td title={fmtDateTime(s.sentAt)}>{fmtDate(s.sentAt)}</td>
                        <td>{s.deliveredAt ? '✓' : '—'}</td>
                        <td>
                          {s.openedAt
                            ? <>✓ <span class="pd-mute">{fmtDate(s.openedAt)}{s.openCount > 1 ? ` ×${s.openCount}` : ''}</span></>
                            : '—'}
                        </td>
                        <td>
                          {s.clickedAt
                            ? <>✓ <span class="pd-mute">{fmtDate(s.clickedAt)}{s.clickCount > 1 ? ` ×${s.clickCount}` : ''}</span></>
                            : '—'}
                        </td>
                        <td>
                          {s.complainedAt
                            ? <span class="pd-danger">spam</span>
                            : s.hardBouncedAt
                              ? <span class="pd-danger">hard</span>
                              : s.bouncedAt
                                ? <span class="pd-mute">soft</span>
                                : '—'}
                        </td>
                      </tr>
                    ))}
                </tbody>
              </table>
            ))}
        </section>
      </>
    )}
  </main>

  <style>
    .pd-summary {
      border: 1px solid var(--adm-line); border-radius: 12px;
      background: var(--adm-paper-soft); padding: 16px 18px;
    }
    .pd-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
    .pd-grid { display:flex; flex-wrap:wrap; gap:14px 28px; }
    .pd-stat { display:flex; flex-direction:column; gap:2px; min-width:120px; }
    .pd-stat span { font-size:11px; text-transform:uppercase; letter-spacing:0.04em; color:var(--adm-mute); }
    .pd-stat strong { font-size:15px; }
    .pd-purchases { margin:14px 0 0; }
    .pd-resub { margin-top:12px; }

    .adm-pill--pro { background:#efe3d2; color:var(--adm-ember-deep); }
    .adm-pill--src-course { background:#d6e4f0; color:#2a5a8a; margin-right:6px; }
    .adm-pill--src-retreat { background:rgba(201, 96, 58, 0.16); color:var(--adm-ember-deep); }

    .pd-contact { border: 1px solid var(--adm-line); border-radius: 12px; background: var(--adm-paper-soft); padding: 14px 16px; }
    .pd-tags { display:flex; flex-wrap:wrap; gap:6px; }
    .pd-tag { background: rgba(154, 142, 117, 0.16); color: var(--adm-ink-soft); }
    .pd-contact-kv { display:flex; gap:20px; margin:10px 0 0; font-size:13px; }
    .pd-contact-kv dt { color: var(--adm-mute); display:inline; }
    .pd-contact-kv dd { display:inline; margin:0 0 0 4px; }

    .pd-orders, .pd-sends { margin-bottom: 14px; }
    .pd-h2-link { margin-left: 10px; font-family: ui-sans-serif, -apple-system, sans-serif; font-size: 13px; font-weight: 400; color: var(--adm-ink-soft); }
    .pd-h2-link:hover { color: var(--adm-ember-deep); }
    .pd-orders:last-child, .pd-sends:last-child { margin-bottom: 0; }
    .pd-src {
      font-size:10px; font-weight:600; letter-spacing:0.04em; text-transform:uppercase;
      padding:1px 8px; border-radius:999px; margin-left:8px;
      background:rgba(0,0,0,0.06); color:var(--adm-ink-soft);
    }
    .pd-src--retreat  { background:rgba(201, 96, 58, 0.16); color:var(--adm-ember-deep); }
    .pd-src--course   { background:#d6e4f0; color:#2a5a8a; }
    .pd-src--workshop { background:#dcefdc; color:#2f7a4c; }
    .pd-refunded { color: var(--adm-danger); }

    .pd-mute { color: var(--adm-mute); font-size: 12px; margin: 0; }

    .app-account { margin: 0 0 6px; font-size: 14px; }
    .app-h3 { font-size: 15px; margin: 22px 0 8px; }
    .app-table { margin-bottom: 10px; }
    .app-table td { vertical-align: top; }
    .app-dates span { display: block; }
    .app-row--off td { opacity: 0.6; }
    .app-actions { width: 1%; white-space: nowrap; text-align: right; }
    .app-details summary, .app-add summary {
      cursor: pointer; font-size: 13px; color: var(--adm-ember-deep); list-style: none;
    }
    .app-details summary::-webkit-details-marker, .app-add summary::-webkit-details-marker { display: none; }
    .app-details[open] { white-space: normal; text-align: left; min-width: 340px; }
    .app-add { margin: 12px 0 0; }
    .app-add > summary { font-weight: 600; font-size: 14px; }
    .app-form { margin: 10px 0 0; }
    .app-form .adm-grid { margin-bottom: 8px; }
    .app-form .pd-mute { margin-top: 6px; }
    .app-grid { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
    .app-scroll { overflow-x: auto; }
    .app-inline { margin-top: 12px; }
    .app-cert-line { margin: 0 0 6px; font-size: 14px; }
    .app-cert-status { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 6px; font-size: 14px; }
    .app-cert-file { margin: 6px 0 0; font-size: 14px; }
    @media (max-width: 720px) {
      .app-grid, .app-form .adm-grid { grid-template-columns: 1fr; }
      .app-form .adm-grid > label.span-2 { grid-column: auto; }
      .app-details[open] { min-width: 0; }
    }
    .pd-danger { color: var(--adm-danger); font-weight: 600; font-size: 12px; text-transform: uppercase; }
  </style>
</Layout>
