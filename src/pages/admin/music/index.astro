---
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import { albumCoverUrl, albumUrl, listAlbums } from '../../../lib/music/db';

export const prerender = false;

const env = Astro.locals.runtime.env;
const authed = await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
if (!authed) {
  return Astro.redirect('/admin/login');
}

const albums = await listAlbums(env.DB);

const flash = Astro.url.searchParams.get('flash');
let flashText: { tone: 'ok' | 'warn'; text: string } | null = null;
if (flash === 'deleted') flashText = { tone: 'ok', text: 'Album removed.' };
else if (flash === 'exists')
  flashText = {
    tone: 'warn',
    text: `An album with the id “${Astro.url.searchParams.get('id') ?? ''}” already exists — open it below, or pick a different URL id.`,
  };
---

<Layout title="Admin — Music albums — Songdance" description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs">
          <a href="/admin">Admin</a>
          <span class="sep">/</span>
          Music albums
        </p>
        <h1>Music albums</h1>
        <p class="adm-sub">
          Each album is a cover + a set of audio tracks with its own player page at
          <code>/music/&lt;id&gt;</code>. The page only opens for buyers: set the album's
          <strong>Drip tag</strong> (the one its product/bump automation applies on payment) and
          anyone whose email carries that tag can listen — same email-only login as
          <a href="/access" target="_blank" rel="noopener">/access</a>, where owned albums also
          show up.
        </p>
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--ghost" href="/admin">← Admin</a>
      </div>
    </header>

    {flashText && <div class={`adm-flash adm-flash--${flashText.tone}`}>{flashText.text}</div>}

    <section class="adm-section">
      <h2>Albums <small>{albums.length}</small></h2>
      {albums.length === 0 && <p class="adm-empty">No albums yet. Create the first one below.</p>}
      {albums.length > 0 && (
        <div class="music-albums">
          {albums.map((a) => (
            <a class="music-album-row" href={`/admin/music/${a.id}`}>
              <span class="music-album-thumb">
                {albumCoverUrl(a) ? (
                  <img src={albumCoverUrl(a)} alt="" loading="lazy" />
                ) : (
                  <span class="music-album-thumb-empty">no cover</span>
                )}
              </span>
              <span class="music-album-meta">
                <strong>{a.title}</strong>
                <span class="music-album-sub">
                  <code>{albumUrl(a)}</code>
                  · {a.track_count} track{a.track_count === 1 ? '' : 's'}
                  {a.drip_tag ? (
                    <span> · tag <code>{a.drip_tag}</code></span>
                  ) : (
                    <span class="music-warn"> · no Drip tag</span>
                  )}
                  {a.price_eur_cents ? (
                    <span> · €{(a.price_eur_cents / 100).toFixed(2).replace(/\.00$/, '')}</span>
                  ) : (
                    <span> · not for sale</span>
                  )}
                </span>
              </span>
              <span class={`music-album-state ${a.published ? 'is-on' : 'is-off'}`}>
                {a.published ? 'Published' : 'Hidden'}
              </span>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="adm-section">
      <h2>New album</h2>
      <form method="POST" action="/api/admin/music/save-album" class="adm-grid music-new" data-new-album>
        <label class="span-2">
          <span>Title</span>
          <input type="text" name="title" required maxlength="200" placeholder="Mantra Album" data-new-title />
        </label>
        <label>
          <span>URL id (slug)</span>
          <input type="text" name="id" required maxlength="80" pattern="[a-z0-9-]+" placeholder="mantra-album" data-new-slug />
        </label>
        <label>
          <span>Drip tag (grants access)</span>
          <input type="text" name="drip_tag" maxlength="100" placeholder="prod_MantraEmpower" />
        </label>
        <label class="music-check">
          <input type="checkbox" name="published" checked />
          <span>Published</span>
        </label>
        <div class="span-full">
          <button type="submit" class="adm-btn adm-btn--solid">Create album</button>
          <p class="adm-hint">Cover, description and tracks are added on the album's own page next.</p>
        </div>
      </form>
    </section>
  </main>
</Layout>

<style>
  .music-albums { display: flex; flex-direction: column; gap: 10px; }
  .music-album-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    background: #fff;
    border: 1px solid var(--adm-line, #e3dbc8);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
  }
  .music-album-row:hover { border-color: var(--adm-ember, #c96f4a); }
  .music-album-thumb {
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    background: #f0e8d6;
    display: grid;
    place-items: center;
  }
  .music-album-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .music-album-thumb-empty { font-size: 10px; color: #8a8272; text-align: center; }
  .music-album-meta { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .music-album-sub { font-size: 12.5px; color: #6f6a5d; }
  .music-album-sub code { font-size: 11.5px; }
  .music-warn { color: #a3542f; }
  .music-album-state {
    flex: 0 0 auto;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid;
  }
  .music-album-state.is-on { color: #3e6b3f; border-color: #b9ccb0; background: #eef4ea; }
  .music-album-state.is-off { color: #8a8272; border-color: #ddd5c2; background: #f6f1e4; }
  .music-check { display: flex; flex-direction: row !important; align-items: center; gap: 8px; align-self: end; padding-bottom: 8px; }
  .adm-hint { font-size: 12.5px; color: #6f6a5d; margin: 8px 0 0; }
</style>

<script>
  // Auto-fill the slug from the title until the admin edits the slug by hand.
  const title = document.querySelector<HTMLInputElement>('[data-new-title]');
  const slug = document.querySelector<HTMLInputElement>('[data-new-slug]');
  let touched = false;
  slug?.addEventListener('input', () => { touched = true; });
  title?.addEventListener('input', () => {
    if (touched || !slug) return;
    slug.value = (title.value || '')
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 80);
  });
</script>
