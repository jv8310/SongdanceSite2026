---
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import { isVideoKey, listLibrary, type MediaItem } from '../../../lib/media';

export const prerender = false;

const env = Astro.locals.runtime.env;
const authed = await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
if (!authed) {
  return Astro.redirect('/admin/login');
}

let items: MediaItem[] = [];
let loadError: string | null = null;
try {
  items = await listLibrary(env.MEDIA);
} catch (err) {
  loadError =
    'Could not read the media bucket. Make sure the R2 bucket "songdance-media" exists and is bound as MEDIA.';
  console.error('image-manager list failed', err);
}

function fmtBytes(n: number): string {
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(0)} KB`;
  return `${(n / (1024 * 1024)).toFixed(1)} MB`;
}
function fmtDate(iso: string): string {
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
function basename(key: string): string {
  return key.slice(key.lastIndexOf('/') + 1);
}
function folder(key: string): string {
  const i = key.lastIndexOf('/');
  return i >= 0 ? key.slice(0, i) : '—';
}
---

<Layout title="Admin — Image library — Songdance" description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs">
          <a href="/admin">Admin</a>
          <span class="sep">/</span>
          Image library
        </p>
        <h1>Image library</h1>
        <p class="adm-sub">
          Every image — and short video — in the media bucket. Drag files in to upload (images are
          resized and converted to WebP automatically; videos are stored as-is), rename or delete
          them, and copy each item’s <code>/media/…</code> URL to use anywhere on the site. Files
          with <strong>“email”</strong> in the name are kept in their original format (JPEG/PNG) so
          they render in mail clients that don’t support WebP.
        </p>
        <p class="adm-sub">
          <strong>Short videos:</strong> MP4 or WebM up to 150 MB — for background/accent clips. Drop
          one in and use it on a page with <code>&lt;video src="/media/…" muted loop playsinline&gt;</code>.
          Anything longer or watched with sound belongs on Vimeo, not here.
        </p>
        <p class="adm-sub">
          <strong>Heads-up:</strong> images under <code>events/</code> are event-card pictures —
          renaming or deleting one will break the card that uses it until you re-set its image.
        </p>
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--ghost" href="/admin/events">Events</a>
        <a class="adm-btn adm-btn--ghost" href="/admin">← Admin</a>
      </div>
    </header>

    {loadError && <div class="adm-flash adm-flash--warn">{loadError}</div>}

    <section class="adm-section">
      <div
        class="media-dropzone"
        data-dropzone
        role="button"
        tabindex="0"
        aria-label="Upload images"
      >
        <input
          type="file"
          accept="image/*,video/mp4,video/webm,video/quicktime"
          multiple
          hidden
          data-file-input
        />
        <div class="media-dropzone-inner">
          <strong>Drop images or short videos here</strong>
          <span>or click to choose — JPG, PNG, WebP, GIF, SVG, MP4, WebM · multiple at once</span>
        </div>
        <div class="media-dropzone-progress" data-progress hidden>
          <div class="media-dropzone-progress-track">
            <div class="media-dropzone-progress-fill" data-progress-fill></div>
          </div>
          <span class="media-dropzone-progress-text" data-progress-text></span>
        </div>
      </div>
    </section>

    <section class="adm-section">
      <div class="media-toolbar">
        <h2>
          Images <small data-count>{items.length}</small>
        </h2>
        <input
          type="search"
          class="media-search"
          data-search
          placeholder="Search by name…"
          aria-label="Search images by name"
          autocomplete="off"
        />
      </div>
      {!loadError && items.length === 0 && (
        <p class="adm-empty" data-empty>No images yet. Drop some above to get started.</p>
      )}
      <p class="adm-empty" data-noresults hidden>No images match your search.</p>
      <div class="media-grid" data-grid>
        {items.map((it) => (
          <figure class="media-card" data-card data-key={it.key}>
            <a class="media-thumb" href={it.url} target="_blank" rel="noopener">
              {isVideoKey(it.key) ? (
                <video class="media-video" src={`${it.url}#t=0.1`} muted playsinline preload="metadata"></video>
              ) : (
                <img src={it.url} alt="" loading="lazy" />
              )}
            </a>
            <figcaption class="media-body">
              <div class="media-name-row">
                <input class="media-name" value={basename(it.key)} data-name aria-label="Filename" />
                <button type="button" class="adm-btn adm-btn--tiny" data-rename>Rename</button>
              </div>
              <div class="media-meta">
                <span data-size>{fmtBytes(it.size)}</span>
                <span>·</span>
                <span>{fmtDate(it.uploaded)}</span>
                <span class={`media-folder media-folder--${folder(it.key) === 'events' ? 'events' : 'lib'}`}>
                  {folder(it.key)}/
                </span>
              </div>
              <div class="media-actions">
                <button type="button" class="adm-btn adm-btn--tiny" data-copy data-url={it.url}>Copy URL</button>
                <button type="button" class="adm-btn adm-btn--tiny adm-btn--danger" data-delete>Delete</button>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  </main>
</Layout>

<template id="media-card-template">
  <figure class="media-card" data-card>
    <a class="media-thumb" target="_blank" rel="noopener"><img alt="" loading="lazy" /></a>
    <figcaption class="media-body">
      <div class="media-name-row">
        <input class="media-name" data-name aria-label="Filename" />
        <button type="button" class="adm-btn adm-btn--tiny" data-rename>Rename</button>
      </div>
      <div class="media-meta">
        <span data-size></span>
        <span>·</span>
        <span data-date></span>
        <span class="media-folder media-folder--lib">library/</span>
      </div>
      <div class="media-actions">
        <button type="button" class="adm-btn adm-btn--tiny" data-copy>Copy URL</button>
        <button type="button" class="adm-btn adm-btn--tiny adm-btn--danger" data-delete>Delete</button>
      </div>
    </figcaption>
  </figure>
</template>

<script>
  import { optimizeImageFile, formatBytes } from '../../../scripts/image-optimize';
  import { ALLOWED_VIDEO_TYPES, MAX_VIDEO_BYTES, isVideoKey } from '../../../lib/media';

  type UploadedItem = { key: string; url: string; size: number; uploaded: string };
  type UploadResponse = { uploaded?: UploadedItem[]; error?: string; errors?: string[] };
  type RenameResponse = { key?: string; url?: string; error?: string };

  const dropzone = document.querySelector<HTMLElement>('[data-dropzone]');
  const fileInput = document.querySelector<HTMLInputElement>('[data-file-input]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const progress = document.querySelector<HTMLElement>('[data-progress]');
  const progressFill = document.querySelector<HTMLElement>('[data-progress-fill]');
  const progressText = document.querySelector<HTMLElement>('[data-progress-text]');
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
  const noResultsEl = document.querySelector<HTMLElement>('[data-noresults]');
  const searchEl = document.querySelector<HTMLInputElement>('[data-search]');
  const tmpl = document.querySelector<HTMLTemplateElement>('#media-card-template');

  function cardName(card: HTMLElement): string {
    const input = card.querySelector<HTMLInputElement>('[data-name]');
    const key = card.dataset.key || '';
    const base = key.slice(key.lastIndexOf('/') + 1);
    return (input?.value || base).toLowerCase();
  }

  // Live filter on filename. Also keeps the count and empty/no-match messages
  // in sync, so it doubles as the "something changed" refresh.
  function applyFilter() {
    if (!grid) return;
    const q = (searchEl?.value ?? '').trim().toLowerCase();
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-card]'));
    let shown = 0;
    for (const card of cards) {
      const match = !q || cardName(card).includes(q);
      card.style.display = match ? '' : 'none';
      if (match) shown += 1;
    }
    if (countEl) countEl.textContent = q ? `${shown} of ${cards.length}` : String(cards.length);
    if (emptyEl) emptyEl.hidden = cards.length > 0;
    if (noResultsEl) noResultsEl.hidden = !(q && cards.length > 0 && shown === 0);
  }

  searchEl?.addEventListener('input', applyFilter);

  function isVideoFile(f: File): boolean {
    return ALLOWED_VIDEO_TYPES.has(f.type);
  }

  // Update the status line and, when a fraction is given, the fill bar's width.
  function setProgress(text: string, fraction?: number) {
    if (progressText) progressText.textContent = text;
    if (progressFill && fraction != null) {
      progressFill.style.width = `${Math.max(0, Math.min(1, fraction)) * 100}%`;
    }
  }

  // POST via XMLHttpRequest (not fetch) so we get real upload-progress events —
  // fetch has no way to observe bytes sent, which matters once videos can run
  // to 150 MB and a bare "uploading…" label sits still for a long time.
  function uploadFormData(url: string, body: FormData, onProgress: (fraction: number) => void) {
    return new Promise<UploadResponse>((resolve, reject) => {
      const xhr = new XMLHttpRequest();
      xhr.open('POST', url);
      xhr.upload.addEventListener('progress', (e) => {
        if (e.lengthComputable) onProgress(e.loaded / e.total);
      });
      xhr.addEventListener('load', () => {
        let data: UploadResponse = {};
        try { data = JSON.parse(xhr.responseText || '{}'); } catch { /* leave data empty */ }
        if (xhr.status >= 200 && xhr.status < 300) resolve(data);
        else reject(new Error(data.error || `Upload failed (${xhr.status})`));
      });
      xhr.addEventListener('error', () => reject(new Error('Network error during upload')));
      xhr.send(body);
    });
  }

  // ---- Upload (drag-drop + click) ----
  async function uploadFiles(fileList: FileList | File[]) {
    const accepted = Array.from(fileList).filter(
      (f) => f.type.startsWith('image/') || isVideoFile(f),
    );
    // Reject oversized videos client-side so the user gets an instant reason
    // rather than a slow upload that the server bounces.
    const tooBig = accepted.filter((f) => isVideoFile(f) && f.size > MAX_VIDEO_BYTES);
    const files = accepted.filter((f) => !tooBig.includes(f));
    if (!progress) return;
    if (!files.length) {
      if (tooBig.length) {
        progress.hidden = false;
        setProgress(`Skipped ${tooBig.length} video${tooBig.length === 1 ? '' : 's'} over ${Math.round(MAX_VIDEO_BYTES / (1024 * 1024))} MB.`, 0);
        setTimeout(() => { if (progress) progress.hidden = true; }, 4000);
      }
      return;
    }
    progress.hidden = false;
    let done = 0;
    setProgress(`Optimising ${files.length} file${files.length === 1 ? '' : 's'}…`, 0);

    // Images with "email" in the name are stored as-is (no WebP re-encode):
    // many mail clients (Outlook etc.) can't render WebP, so email artwork
    // needs to stay JPEG/PNG. Videos are always passed through untouched.
    const optimised = await Promise.all(
      files.map((f) =>
        isVideoFile(f) || /email/i.test(f.name)
          ? Promise.resolve(f)
          : optimizeImageFile(f, { maxDim: 2000, quality: 0.84 }).catch(() => f),
      ),
    );

    const body = new FormData();
    for (const f of optimised) body.append('files', f, f.name);

    try {
      const data = await uploadFormData('/api/admin/media/upload', body, (fraction) => {
        setProgress(`Uploading… ${Math.round(fraction * 100)}%`, fraction);
      });
      for (const item of data.uploaded ?? []) {
        prependCard(item);
        done++;
      }
      const skipped = (data.errors?.length ?? 0) + tooBig.length;
      setProgress(
        `Uploaded ${done} file${done === 1 ? '' : 's'}.` +
          (skipped ? ` Skipped ${skipped} (${data.errors?.[0] ?? 'too large'}).` : ''),
        1,
      );
      applyFilter();
    } catch (err) {
      setProgress(`Upload failed: ${(err as Error).message}`, 0);
    }
    setTimeout(() => { if (progress) progress.hidden = true; }, 4000);
  }

  // Swap the card's <img> thumb for a <video> preview (first frame) when the
  // item is a clip. Used on upload and after a rename changes the URL.
  function setThumb(card: HTMLElement, key: string, url: string) {
    const thumb = card.querySelector('.media-thumb') as HTMLAnchorElement;
    thumb.href = url;
    if (isVideoKey(key)) {
      let video = thumb.querySelector('video');
      if (!video) {
        video = document.createElement('video');
        video.className = 'media-video';
        video.muted = true;
        video.playsInline = true;
        video.preload = 'metadata';
        thumb.replaceChildren(video);
      }
      video.src = `${url}#t=0.1`;
    } else {
      let img = thumb.querySelector('img');
      if (!img) {
        img = document.createElement('img');
        img.alt = '';
        img.loading = 'lazy';
        thumb.replaceChildren(img);
      }
      img.src = `${url}?t=${Date.now()}`;
    }
  }

  function prependCard(item: UploadedItem) {
    if (!tmpl || !grid) return;
    const node = tmpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    node.dataset.key = item.key;
    const base = item.key.slice(item.key.lastIndexOf('/') + 1);
    setThumb(node, item.key, item.url);
    (node.querySelector('[data-name]') as HTMLInputElement).value = base;
    (node.querySelector('[data-size]') as HTMLElement).textContent = formatBytes(item.size);
    (node.querySelector('[data-date]') as HTMLElement).textContent = 'just now';
    (node.querySelector('[data-copy]') as HTMLElement).dataset.url = item.url;
    wireCard(node);
    grid.insertBefore(node, grid.firstChild);
  }

  if (dropzone && fileInput) {
    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
    });
    fileInput.addEventListener('change', () => {
      if (fileInput.files?.length) uploadFiles(fileInput.files);
      fileInput.value = '';
    });
    ['dragenter', 'dragover'].forEach((ev) =>
      dropzone.addEventListener(ev, (e) => { e.preventDefault(); dropzone.classList.add('is-drop'); }),
    );
    ['dragleave', 'dragend', 'drop'].forEach((ev) =>
      dropzone.addEventListener(ev, () => dropzone.classList.remove('is-drop')),
    );
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      const files = (e as DragEvent).dataTransfer?.files;
      if (files?.length) uploadFiles(files);
    });
  }

  // ---- Per-card actions: copy / rename / delete ----
  function wireCard(card: HTMLElement) {
    const key = () => card.dataset.key || '';

    card.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLElement;
      const url = btn.dataset.url || '';
      try {
        await navigator.clipboard.writeText(url);
        const prev = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = prev; }, 1200);
      } catch {
        window.prompt('Copy this URL:', url);
      }
    });

    card.querySelector('[data-rename]')?.addEventListener('click', async () => {
      const nameInput = card.querySelector('[data-name]') as HTMLInputElement;
      const name = nameInput.value.trim();
      if (!name) return;
      const body = new FormData();
      body.append('key', key());
      body.append('name', name);
      const res = await fetch('/api/admin/media/rename', { method: 'POST', body });
      const data = (await res.json()) as RenameResponse;
      if (!res.ok || !data.key || !data.url) { alert(data?.error || 'Rename failed'); return; }
      card.dataset.key = data.key;
      nameInput.value = data.key.slice(data.key.lastIndexOf('/') + 1);
      setThumb(card, data.key, data.url);
      (card.querySelector('[data-copy]') as HTMLElement).dataset.url = data.url;
      applyFilter();
    });

    card.querySelector('[data-delete]')?.addEventListener('click', async () => {
      const base = key().slice(key().lastIndexOf('/') + 1);
      if (!confirm(`Delete "${base}"? This can't be undone.`)) return;
      const body = new FormData();
      body.append('key', key());
      const res = await fetch('/api/admin/media/delete', { method: 'POST', body });
      if (!res.ok) { alert('Delete failed'); return; }
      card.remove();
      applyFilter();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-card]').forEach(wireCard);
</script>
