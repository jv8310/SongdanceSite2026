---
import '../../styles/admin.css';
import Layout from '../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../lib/registrations/auth';

export const prerender = false;

const env = Astro.locals.runtime.env;
const authed = await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
if (!authed) {
  return Astro.redirect('/admin/login');
}

const flash = Astro.url.searchParams.get('flash');
const created = Astro.url.searchParams.get('created');
const skipped = Astro.url.searchParams.get('skipped');
const flashBanner =
  flash === 'cal_synced'
    ? { tone: 'ok' as const, text: `Calendar sync: ${created ?? 0} published, ${skipped ?? 0} skipped.` }
  : flash === 'cal_notconnected'
    ? { tone: 'warn' as const, text: 'Google Calendar isn’t connected yet — set it up in Settings → Calendar sync.' }
  : flash === 'cal_error'
    ? { tone: 'warn' as const, text: 'Calendar sync failed. Check Settings → Calendar sync.' }
  : null;
---

<Layout title="Admin — Songdance" description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <h1>Admin</h1>
        <p class="adm-sub">Registrations &amp; signups</p>
      </div>
      <div class="adm-actions">
        <form method="POST" action="/api/admin/workshops/calendar-sync">
          <input type="hidden" name="return" value="/admin" />
          <button class="adm-btn adm-btn--ghost adm-btn--nav" type="submit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>Calendar sync</span>
          </button>
        </form>
        <a class="adm-btn adm-btn--ghost adm-btn--nav" href="/admin/people">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>People</span>
        </a>
        <a class="adm-btn adm-btn--ghost adm-btn--nav" href="/admin/settings">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span>Settings</span>
        </a>
        <a class="adm-btn adm-btn--ghost adm-btn--nav" href="/admin/image-manager">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <span>Images</span>
        </a>
        <form method="POST" action="/api/admin/login?_method=DELETE">
          <input type="hidden" name="_method" value="DELETE" />
          <button class="adm-btn adm-btn--ghost adm-btn--nav" type="submit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>Sign out</span>
          </button>
        </form>
      </div>
    </header>

    {flashBanner && <div class={`adm-flash adm-flash--${flashBanner.tone === 'ok' ? 'ok' : 'warn'}`}>{flashBanner.text}</div>}

    <section class="adm-section">
      <h2>Orders</h2>
      <div class="adm-menu">
        <a href="/admin/orders">
          <strong>All orders</strong>
          <span>Every order across retreats, courses &amp; workshops — money, Drip &amp; Quaderno profiles, refunds</span>
        </a>
        <a href="/admin/courses/future-revenue">
          <strong>Future revenue</strong>
          <span>Expected income from installment plans by month, with a line graph &amp; a watch list of cancelled / unpaid / retrying plans</span>
        </a>
      </div>
    </section>

    <section class="adm-section">
      <h2>Workshops</h2>
      <div class="adm-menu">
        <a href="/admin/workshops">
          <strong>All workshops</strong>
          <span>Live online workshops — calendar, registrants, attendance &amp; statuses</span>
        </a>
        <a href="/admin/workshops/stats">
          <strong>Statistics &amp; ROAS</strong>
          <span>Net-of-tax income in EUR, bump &amp; course sales, Meta ad-spend ROAS</span>
        </a>
      </div>
    </section>

    <section class="adm-section">
      <h2>Retreats</h2>
      <div class="adm-menu">
        <a href="/admin/retreats">
          <strong>All retreats</strong>
          <span>Rooms, tiers, special roles, capacity</span>
        </a>
        <a href="/admin/intakes">
          <strong>All intake submissions</strong>
          <span>Pre-screening forms with Claude assessment &amp; classification</span>
        </a>
        <a href="/admin/intakes/retreats">
          <strong>Manage intake retreats</strong>
          <span>Add, rename, or deactivate retreats that accept an intake form</span>
        </a>
      </div>
    </section>

    <section class="adm-section">
      <h2>Events</h2>
      <div class="adm-menu">
        <a href="/admin/events">
          <strong>Events grid</strong>
          <span>Cards for /events, the homepage strip &amp; the retreat band — text, dates &amp; images</span>
        </a>
      </div>
    </section>

    <section class="adm-section">
      <h2>Courses</h2>
      <div class="adm-menu">
        <a href="/admin/courses">
          <strong>All courses</strong>
          <span>Digital course registrations &amp; Drip tagging</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
