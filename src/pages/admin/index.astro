---
import '../../styles/admin.css';
import Layout from '../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../lib/registrations/auth';

export const prerender = false;

const env = Astro.locals.runtime.env;
const authed = await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
if (!authed) {
  return Astro.redirect('/admin/login');
}
---

<Layout title="Admin — Songdance" description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <h1>Admin</h1>
        <p class="adm-sub">Registrations &amp; signups</p>
      </div>
      <div class="adm-actions">
        <a class="adm-btn adm-btn--ghost" href="/admin/image-manager">Images</a>
        <form method="POST" action="/api/admin/login?_method=DELETE">
          <input type="hidden" name="_method" value="DELETE" />
          <button class="adm-btn adm-btn--ghost" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <section class="adm-section">
      <h2>Retreats</h2>
      <div class="adm-menu">
        <a href="/admin/retreats">
          <strong>All retreats</strong>
          <span>Rooms, tiers, special roles, capacity</span>
        </a>
      </div>
    </section>

    <section class="adm-section">
      <h2>Events</h2>
      <div class="adm-menu">
        <a href="/admin/events">
          <strong>Events grid</strong>
          <span>Cards for /events, the homepage strip &amp; the retreat band — text, dates &amp; images</span>
        </a>
      </div>
    </section>

    <section class="adm-section">
      <h2>Courses</h2>
      <div class="adm-menu">
        <a href="/admin/courses">
          <strong>All courses</strong>
          <span>Digital course registrations &amp; Drip tagging</span>
        </a>
      </div>
    </section>

    <section class="adm-section">
      <h2>Workshops</h2>
      <div class="adm-menu">
        <a href="/admin/workshops">
          <strong>All workshops</strong>
          <span>Live online workshops — calendar, registrants, attendance &amp; statuses</span>
        </a>
        <a href="/admin/workshops/import-google">
          <strong>Import from Google Calendar</strong>
          <span>Find upcoming calendar events by title and add them as workshops</span>
        </a>
        <a href="/admin/workshops/stats">
          <strong>Statistics &amp; ROAS</strong>
          <span>Net-of-tax income in EUR, bump &amp; course sales, Meta ad-spend ROAS</span>
        </a>
      </div>
    </section>

    <section class="adm-section">
      <h2>Intakes</h2>
      <div class="adm-menu">
        <a href="/admin/intakes">
          <strong>All intake submissions</strong>
          <span>Pre-screening forms with Claude assessment &amp; classification</span>
        </a>
        <a href="/admin/intakes/retreats">
          <strong>Manage retreats</strong>
          <span>Add, rename, or deactivate retreats that accept an intake form</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
