---
import '../../../styles/admin.css';
import Layout from '../../../layouts/Layout.astro';
import { readCookie, verifySession } from '../../../lib/registrations/auth';
import {
  computeTierAvailability,
  getRoomsWithMode,
  getRegistrationsWithBalanceDue,
} from '../../../lib/registrations/db';

export const prerender = false;

const env = Astro.locals.runtime.env;
const authed = await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
if (!authed) {
  return Astro.redirect('/admin/login');
}

const productSlug = Astro.params.slug ?? '';
const statusFilter = Astro.url.searchParams.get('status') ?? '';
const returnTo = `/admin/retreats/${productSlug}${statusFilter ? `?status=${statusFilter}` : ''}`;

const product = await env.DB
  .prepare('SELECT id, name, starts_at, ends_at, currency, vat_rate FROM products WHERE slug = ? AND type = ?')
  .bind(productSlug, 'retreat')
  .first<{
    id: number;
    name: string;
    starts_at: string | null;
    ends_at: string | null;
    currency: string;
    vat_rate: number;
  }>();

if (!product) {
  return new Response('Retreat not found', { status: 404 });
}

type Row = {
  id: number;
  name: string;
  first_name: string | null;
  last_name: string | null;
  email: string;
  phone: string | null;
  phone_country: string | null;
  country: string | null;
  company_name: string | null;
  vat_number: string | null;
  tier_name: string;
  tier_slug: string;
  inventory_unit_name: string | null;
  status: string;
  amount_cents: number;
  currency: string;
  role: 'fire_keeper' | 'cook_help' | null;
  role_discount_cents: number;
  roommate_pref: string | null;
  dietary: string | null;
  notes: string | null;
  created_at: string;
  paid_at: string | null;
  cancelled_at: string | null;
  refunded_at: string | null;
  refunded_amount_cents: number;
  balance_due_cents: number;
  balance_invite_sent_at: string | null;
  balance_paid_at: string | null;
};

const where = ['r.product_id = ?'];
const binds: unknown[] = [product.id];
if (statusFilter) {
  where.push('r.status = ?');
  binds.push(statusFilter);
}
const q = await env.DB.prepare(
  `SELECT r.id, r.name, r.first_name, r.last_name, r.email,
          r.phone, r.phone_country, r.country, r.company_name, r.vat_number,
          r.status, r.amount_cents, r.currency,
          r.role, r.role_discount_cents,
          r.roommate_pref, r.dietary, r.notes,
          r.created_at, r.paid_at, r.cancelled_at,
          r.refunded_at, r.refunded_amount_cents,
          r.balance_due_cents, r.balance_invite_sent_at, r.balance_paid_at,
          t.name AS tier_name, t.slug AS tier_slug,
          iu.name AS inventory_unit_name
     FROM registrations r
     JOIN tiers t ON t.id = r.tier_id
     LEFT JOIN inventory_units iu ON iu.id = r.inventory_unit_id
    WHERE ${where.join(' AND ')}
    ORDER BY r.created_at DESC`,
)
  .bind(...binds)
  .all<Row>();
const rows: Row[] = q.results ?? [];

const ta = await computeTierAvailability(env.DB, product.id);

// Real bookings per tier — paying participants only (amount > 0 excludes
// pre-allocated host/cook seats); pending bookings count while their hold
// is still active, matching the room model's beds_sold semantics.
const bookedByTier = await env.DB.prepare(
  `SELECT r.tier_id, COUNT(*) AS c
     FROM registrations r
     JOIN tiers t ON t.id = r.tier_id
    WHERE t.product_id = ?
      AND r.status IN ('paid','pending')
      AND r.amount_cents > 0
      AND (r.status = 'paid'
           OR r.hold_expires_at IS NULL
           OR r.hold_expires_at > datetime('now'))
    GROUP BY r.tier_id`,
)
  .bind(product.id)
  .all<{ tier_id: number; c: number }>();
const bookedMap = new Map<number, number>();
for (const row of bookedByTier.results ?? []) {
  bookedMap.set(row.tier_id, row.c);
}

const tierSummary = ta.map(({ tier, remaining, capacity }) => ({
  tier_name: tier.name,
  capacity,
  booked: bookedMap.get(tier.id) ?? 0,
  remaining,
}));

// Real-bed availability: iterate rooms once, skip reserved/inactive AND the
// admin-test tier so the totals reflect the actual retreat.
const adminTier = await env.DB
  .prepare(
    "SELECT id FROM tiers WHERE slug = 'admin-test-1eur' AND product_id = ?",
  )
  .bind(product.id)
  .first<{ id: number }>();
const adminTierId = adminTier?.id ?? null;

let payingParticipants = 0;
let placesAvailable = 0;
let maxPeople = 0;

const roomsWithMode = await getRoomsWithMode(env.DB, product.id);
for (const r of roomsWithMode) {
  if (r.mode === 'inactive') continue;
  if (
    adminTierId != null &&
    (r.solo_tier_id === adminTierId || r.shared_tier_id === adminTierId)
  ) continue;
  // Skip truly-reserved (host/cook) rooms — those beds are non-paying. Keep
  // role-reserved rooms (fire keeper paviljoen, Room 5.2 cook help): they
  // are reserved for a *paying* special-role participant, so they count
  // toward the retreat ceiling.
  if (r.mode === 'reserved' && !r.role) continue;
  // Max retreat-wide capacity = every sellable bed (per-tier capacities
  // double-count multi-mode rooms, so summing tiers overcounts).
  maxPeople += r.capacity;
  if (r.mode === 'solo') {
    // Empty admin-pinned solo room still has 1 sellable bed; the rest are
    // held. For a real solo booking (beds_sold > 0), nothing more to sell.
    if (r.beds_sold === 0 && r.forced_mode === 'solo') placesAvailable += 1;
    continue;
  }
  placesAvailable += Math.max(0, r.capacity - r.beds_sold);
}

const paying = await env.DB
  .prepare(
    `SELECT COUNT(*) AS c
       FROM registrations
      WHERE product_id = ?
        AND status = 'paid'
        AND amount_cents > 0`,
  )
  .bind(product.id)
  .first<{ c: number }>();
payingParticipants = paying?.c ?? 0;

const rs = await env.DB.prepare(
  `SELECT iu.id, iu.name, iu.capacity, iu.status,
          t.name AS tier_name,
          (SELECT COUNT(*) FROM registrations r
            WHERE r.inventory_unit_id = iu.id
              AND r.status IN ('paid','pending')) AS assigned_count
     FROM inventory_units iu
     JOIN tiers t ON t.id = iu.tier_id
    WHERE t.product_id = ?
    ORDER BY t.sort_order, iu.sort_order`,
)
  .bind(product.id)
  .all<{
    id: number;
    name: string;
    tier_name: string;
    status: string;
    assigned_count: number;
    capacity: number;
  }>();
const rooms = rs.results ?? [];

const ev = await env.DB.prepare(
  `SELECT id, registration_id, kind, source, external_id, created_at,
          substr(COALESCE(payload_json, ''), 1, 220) AS payload_excerpt
     FROM events
    ORDER BY id DESC
    LIMIT 40`,
)
  .all<{
    id: number;
    registration_id: number | null;
    kind: string;
    source: string;
    external_id: string | null;
    created_at: string;
    payload_excerpt: string | null;
  }>();
const events = ev.results ?? [];

function eur(cents: number, currency: string) {
  return (cents / 100).toLocaleString('en-GB', {
    style: 'currency',
    currency: currency || 'EUR',
  });
}

function ymd(s: string | null) {
  if (!s) return '—';
  return s.slice(0, 16).replace('T', ' ');
}

function roleLabel(role: Row['role']) {
  if (role === 'fire_keeper') return 'Fire keeper';
  if (role === 'cook_help') return 'Kitchen help';
  return null;
}

function capacityTone(remaining: number): 'full' | 'low' | 'open' {
  if (remaining === 0) return 'full';
  if (remaining <= 3) return 'low';
  return 'open';
}

function parseRoomLabel(name: string): { code: string; where: string } {
  const m = name.match(/^(?:Room|Cabin)\s+([\w.]+)\s*[—–-]\s*(.+)$/);
  if (m) return { code: m[1], where: m[2] };
  if (/^Paviljoen/i.test(name)) {
    const rest = name.replace(/^Paviljoen\s*[—–-]\s*/i, '').trim();
    return { code: 'FK', where: rest ? `Paviljoen — ${rest}` : 'Paviljoen' };
  }
  return { code: name, where: '' };
}

// How a room is sold, independent of which tier/category it belongs to:
//   single — whole room, one booking locks it (solo and/or couple).
//   multi  — sold bed by bed (shared).
//   either — multi-mode: can go whole or bed-by-bed; the first booking decides.
type RoomType = 'private' | 'shared' | 'multi' | 'none';
function roomType(r: {
  solo_tier_id: number | null;
  couple_tier_id: number | null;
  shared_tier_id: number | null;
}): {
  type: RoomType;
  label: string;
} {
  const whole = r.solo_tier_id != null || r.couple_tier_id != null;
  if (whole && r.shared_tier_id != null) return { type: 'multi', label: 'Either' };
  if (whole) return { type: 'private', label: 'Single' };
  if (r.shared_tier_id != null) return { type: 'shared', label: 'Multi' };
  return { type: 'none', label: '—' };
}

type RoomState = 'open' | 'half' | 'taken' | 'reserved' | 'inactive' | 'locked';
function roomState(r: {
  status: 'available' | 'reserved' | 'inactive';
  beds_sold: number;
  capacity: number;
  mode: 'open' | 'solo' | 'shared' | 'reserved' | 'inactive';
  role: 'fire_keeper' | 'cook_help' | null;
}): { state: RoomState; label: string } {
  if (r.status === 'reserved') {
    if (r.role === 'fire_keeper') return { state: 'reserved', label: 'Reserved · fire keeper' };
    if (r.role === 'cook_help') return { state: 'reserved', label: 'Reserved · cook help' };
    return { state: 'reserved', label: 'Reserved' };
  }
  if (r.status === 'inactive') return { state: 'inactive', label: 'Inactive' };
  if (r.mode === 'solo' && r.capacity > 1) return { state: 'locked', label: 'Locked (private)' };
  if (r.beds_sold === 0) return { state: 'open', label: 'Open' };
  if (r.beds_sold >= r.capacity) return { state: 'taken', label: 'Taken' };
  return { state: 'half', label: 'Half booked' };
}

const stateTone: Record<RoomState, string> = {
  open: 'open',
  half: 'low',
  taken: 'full',
  reserved: 'cancelled',
  inactive: 'cancelled',
  locked: 'low',
};

// Active guests per room — paid + pending with valid hold. Used to show
// who's currently placed in each room. Pulled separately from `rows` so
// the names list isn't affected by the registrations status filter.
const guestsQ = await env.DB.prepare(
  `SELECT r.inventory_unit_id, r.name, r.first_name, r.last_name
     FROM registrations r
     JOIN tiers t ON t.id = r.tier_id
    WHERE t.product_id = ?
      AND r.inventory_unit_id IS NOT NULL
      AND r.status IN ('paid','pending')
      AND (r.status = 'paid'
           OR r.hold_expires_at IS NULL
           OR r.hold_expires_at > datetime('now'))
    ORDER BY r.first_name, r.last_name, r.name`,
)
  .bind(product.id)
  .all<{
    inventory_unit_id: number;
    name: string;
    first_name: string | null;
    last_name: string | null;
  }>();
const guestsByRoom = new Map<number, string[]>();
for (const g of guestsQ.results ?? []) {
  const display = (g.first_name || g.last_name)
    ? `${g.first_name ?? ''} ${g.last_name ?? ''}`.trim()
    : g.name;
  const list = guestsByRoom.get(g.inventory_unit_id) ?? [];
  list.push(display);
  guestsByRoom.set(g.inventory_unit_id, list);
}

// Category = the tier (price band) a room belongs to, by its current display
// name. Built from the same availability data the rest of the page uses.
const tierNameById = new Map<number, string>();
for (const { tier } of ta) tierNameById.set(tier.id, tier.name);

// Buildings sort in walking order; anything unmapped falls to the end.
const BUILDING_ORDER = ['Poorthuis', 'Theaterkamer', 'Balkonverblijf', 'Orangerie', 'Paviljoen'];
function buildingRank(b: string | null): number {
  const i = b ? BUILDING_ORDER.indexOf(b) : -1;
  return i === -1 ? BUILDING_ORDER.length : i;
}

const roomBreakdown = roomsWithMode
  .filter((r) =>
    adminTierId == null ||
    (r.solo_tier_id !== adminTierId && r.shared_tier_id !== adminTierId),
  )
  .map((r) => {
    const { code, where } = parseRoomLabel(r.name);
    const t = roomType(r);
    const s = roomState(r);
    const isBookable = r.status !== 'inactive';
    // Locked = solo booking on a multi-bed room; the remaining beds are
    // blocked by that private booking and not sellable, so show 0 here
    // (matches the placesAvailable footer in the capacity table).
    const locked = s.state === 'locked';
    const available = !isBookable || locked
      ? 0
      : Math.max(0, r.capacity - r.beds_sold);
    const isMulti = r.solo_tier_id != null && r.shared_tier_id != null;
    // Only multi rooms can be pinned, and only while still empty. Once a
    // bed is booked the mode is decided by that booking, so we just show
    // the locked label instead of a dropdown.
    const canPinMode = isMulti && r.status === 'available' && r.beds_sold === 0;
    const forcedMode: 'solo' | 'shared' | '' = r.forced_mode ?? '';
    return {
      id: r.id,
      building: r.building,
      sortOrder: r.sort_order,
      code,
      where,
      notes: r.notes,
      category: tierNameById.get(r.tier_id) ?? '—',
      type: t.type,
      typeLabel: t.label,
      isMulti,
      canPinMode,
      forcedMode,
      capacity: r.capacity,
      booked: r.beds_sold,
      available,
      state: s.state,
      stateLabel: s.label,
      showCounts: r.status !== 'inactive',
      guests: guestsByRoom.get(r.id) ?? [],
    };
  })
  .sort((a, b) => {
    const rank = buildingRank(a.building) - buildingRank(b.building);
    return rank !== 0 ? rank : a.sortOrder - b.sortOrder;
  });

// Group the sorted rooms by building so the overview can show a header per
// house. roomBreakdown is already in (building, sort_order) order.
const roomsByBuilding: { building: string; rooms: typeof roomBreakdown }[] = [];
for (const r of roomBreakdown) {
  const label = r.building ?? 'Other';
  const last = roomsByBuilding[roomsByBuilding.length - 1];
  if (last && last.building === label) last.rooms.push(r);
  else roomsByBuilding.push({ building: label, rooms: [r] });
}

const roomTotals = roomBreakdown.reduce(
  (acc, r) => {
    if (!r.showCounts) return acc;
    acc.booked += r.booked;
    acc.capacity += r.capacity;
    acc.available += r.available;
    return acc;
  },
  { booked: 0, capacity: 0, available: 0 },
);

// ─── Balance due (deposit-payers who still owe the remainder) ───
const balanceDue = await getRegistrationsWithBalanceDue(env.DB, product.id);
const balanceDueTotalCents = balanceDue.reduce((n, r) => n + (r.balance_due_cents ?? 0), 0);

// ─── Income (money received + still to come) ───
// Amounts are stored gross (VAT-inclusive — see the checkout tax note); when
// the product carries VAT we split each figure into ex-VAT and VAT below.
//   • Received  — cash actually collected: amount_cents on paid bookings
//     (a settled deposit-payer reads as the full amount, see markBalancePaid),
//     net of refunds on refunded bookings.
//   • Deposit outstanding — balances still owed on active (paid) bookings.
//   • Pending outstanding — committed-but-unpaid held bookings (e.g. an
//     offline "pay later" hold like a couple settling by transfer); a 30-min
//     checkout hold counts only while still live, matching the rooms view.
const currency = product.currency || 'EUR';
const vatRate = product.vat_rate ?? 0;
const hasVat = vatRate > 0;
const vatPct = Math.round(vatRate * 100);
const exVat = (cents: number) => Math.round(cents / (1 + vatRate));
const vatPart = (cents: number) => cents - exVat(cents);

const incomeAgg = await env.DB.prepare(
  `SELECT
     COALESCE(SUM(CASE WHEN status = 'paid'     THEN amount_cents
                       WHEN status = 'refunded' THEN amount_cents - refunded_amount_cents
                       ELSE 0 END), 0) AS received_cents,
     COALESCE(SUM(CASE WHEN status = 'paid' THEN balance_due_cents ELSE 0 END), 0) AS deposit_outstanding_cents,
     COALESCE(SUM(CASE WHEN status = 'pending' AND amount_cents > 0
                        AND (hold_expires_at IS NULL OR hold_expires_at > datetime('now'))
                   THEN amount_cents + balance_due_cents ELSE 0 END), 0) AS pending_outstanding_cents
     FROM registrations
    WHERE product_id = ?`,
)
  .bind(product.id)
  .first<{
    received_cents: number;
    deposit_outstanding_cents: number;
    pending_outstanding_cents: number;
  }>();

const receivedCents = incomeAgg?.received_cents ?? 0;
const depositOutstandingCents = incomeAgg?.deposit_outstanding_cents ?? 0;
const pendingOutstandingCents = incomeAgg?.pending_outstanding_cents ?? 0;
const toReceiveCents = depositOutstandingCents + pendingOutstandingCents;
const expectedTotalCents = receivedCents + toReceiveCents;

const incomeRows = [
  { label: 'Received', cents: receivedCents },
  { label: 'Still to receive', cents: toReceiveCents },
];

// Flash banner after a send action (set by the balance/* endpoints).
const flash = (() => {
  const p = Astro.url.searchParams;
  if (p.get('bal_bulk')) {
    return { tone: 'ok' as const, msg: `Balance emails sent: ${p.get('bal_sent') ?? '0'} · failed: ${p.get('bal_failed') ?? '0'}.` };
  }
  if (p.get('bal_sent')) return { tone: 'ok' as const, msg: 'Balance email sent.' };
  if (p.get('bal_failed')) return { tone: 'err' as const, msg: `Balance email failed${p.get('bal_error') ? `: ${p.get('bal_error')}` : ''}.` };
  return null;
})();
---

<Layout title={`Admin — ${product.name}`} description="">
  <main class="adm">
    <header class="adm-header">
      <div>
        <p class="adm-breadcrumbs">
          <a href="/admin">Admin</a>
          <span class="sep">/</span>
          <a href="/admin/retreats">Retreats</a>
          <span class="sep">/</span>
          {productSlug}
        </p>
        <h1>{product.name}</h1>
        {product.starts_at && (
          <p class="adm-sub">{product.starts_at}{product.ends_at ? ` → ${product.ends_at}` : ''}</p>
        )}
      </div>
      <div class="adm-actions">
        <a class="adm-btn" href={`/api/admin/registrations.csv?product=${productSlug}`}>Export CSV</a>
        <a class="adm-btn adm-btn--ghost" href="/admin/retreats">← All retreats</a>
        <form method="POST" action="/api/admin/login?_method=DELETE">
          <input type="hidden" name="_method" value="DELETE" />
          <button class="adm-btn adm-btn--ghost" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    {flash && (
      <div class={`adm-flash adm-flash--${flash.tone}`}>{flash.msg}</div>
    )}

    <!-- ─── Capacity ─── -->
    <section class="adm-section">
      <h2>Capacity</h2>
      <table class="adm-table adm-table--capacity">
        <thead>
          <tr>
            <th>Room option</th>
            <th class="num">Booked</th>
            <th class="num">Capacity</th>
            <th class="num">Remaining</th>
          </tr>
        </thead>
        <tbody>
          {tierSummary.map((t) => (
            <tr>
              <td>{t.tier_name}</td>
              <td class="num">{t.booked}</td>
              <td class="num">{t.capacity}</td>
              <td class="num"><span class={`adm-pill adm-pill--${capacityTone(t.remaining)}`}>{t.remaining}</span></td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr class="adm-row--total">
            <th scope="row">Total (paying)</th>
            <td class="num">{payingParticipants}</td>
            <td class="num">{maxPeople}</td>
            <td class="num"><span class={`adm-pill adm-pill--${capacityTone(placesAvailable)}`}>{placesAvailable}</span></td>
          </tr>
        </tfoot>
      </table>
      <p class="adm-table-note">All numbers are people, not rooms. Each registration is one person. Per-tier capacities <strong>overlap</strong> — the same bed in a multi-mode room (e.g. Room 1.2) counts toward both Private En-suite (sold solo) and Twin Bedroom (sold bed-by-bed), so summing tier capacities overcounts. The total row shows the real retreat ceiling: {maxPeople} sellable beds across all active rooms (hosts and cook excluded; fire keeper paviljoen and Room 5.2 cook help included since they're paying special-role seats). With current bookings, {placesAvailable} of those are still open; the rest are either booked or locked because a Private booking blocked the rest of a multi-mode room.</p>
    </section>

    <!-- ─── Income ─── -->
    <section class="adm-section">
      <h2>Income <small>(money received &amp; still to come)</small></h2>
      <table class="adm-table adm-table--income">
        <thead>
          <tr>
            <th>Money</th>
            {hasVat ? (
              <>
                <th class="num">Ex VAT</th>
                <th class="num">VAT ({vatPct}%)</th>
                <th class="num">Inc VAT</th>
              </>
            ) : (
              <th class="num">Amount</th>
            )}
          </tr>
        </thead>
        <tbody>
          {incomeRows.map((row) => (
            <tr>
              <td>{row.label}</td>
              {hasVat ? (
                <>
                  <td class="num">{eur(exVat(row.cents), currency)}</td>
                  <td class="num">{eur(vatPart(row.cents), currency)}</td>
                  <td class="num">{eur(row.cents, currency)}</td>
                </>
              ) : (
                <td class="num">{eur(row.cents, currency)}</td>
              )}
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr class="adm-row--total">
            <th scope="row">Expected total</th>
            {hasVat ? (
              <>
                <td class="num">{eur(exVat(expectedTotalCents), currency)}</td>
                <td class="num">{eur(vatPart(expectedTotalCents), currency)}</td>
                <td class="num">{eur(expectedTotalCents, currency)}</td>
              </>
            ) : (
              <td class="num">{eur(expectedTotalCents, currency)}</td>
            )}
          </tr>
        </tfoot>
      </table>
      <p class="adm-table-note">
        <strong>Received</strong> is cash actually collected — deposits and full payments, net of any refunds.
        <strong> Still to receive</strong> is {eur(depositOutstandingCents, currency)} in outstanding deposit balances{pendingOutstandingCents > 0 ? ` plus ${eur(pendingOutstandingCents, currency)} from unpaid held bookings` : ''}; <strong>Expected total</strong> is the two combined.
        {hasVat && ` Prices are VAT-inclusive — the Ex VAT and VAT columns split each figure at ${vatPct}%.`}
      </p>
    </section>

    <!-- ─── Rooms ─── -->
    <section class="adm-section">
      <h2>Rooms</h2>
      <table class="adm-table adm-table--rooms">
        <thead>
          <tr>
            <th>Room</th>
            <th>Category</th>
            <th>Sell as</th>
            <th class="num">Booked</th>
            <th class="num">Capacity</th>
            <th class="num">Available</th>
            <th>Status</th>
            <th>Guests</th>
          </tr>
        </thead>
        <tbody>
          {roomsByBuilding.map((group) => (
            <Fragment>
              <tr class="adm-row--group">
                <th scope="rowgroup" colspan="8">{group.building}</th>
              </tr>
              {group.rooms.map((r) => (
                <tr>
                  <td><strong>{r.code}</strong> {r.where}</td>
                  <td>{r.category}</td>
                  <td>
                    {r.canPinMode ? (
                      <form
                        method="POST"
                        action="/api/admin/set-room-mode"
                        class="adm-room-mode"
                      >
                        <input type="hidden" name="inventory_unit_id" value={r.id} />
                        <input type="hidden" name="return_to" value={returnTo} />
                        <label class="adm-room-mode-label">
                          <span class="vh">Sell as</span>
                          <select
                            name="forced_mode"
                            onchange="this.form.submit()"
                            aria-label={`Sell mode for ${r.code}`}
                          >
                            <option value="" selected={r.forcedMode === ''}>Either</option>
                            <option value="solo" selected={r.forcedMode === 'solo'}>Single only</option>
                            <option value="shared" selected={r.forcedMode === 'shared'}>Multi only</option>
                          </select>
                        </label>
                      </form>
                    ) : (
                      <span class={`adm-pill adm-pill--type-${r.type}`}>{r.typeLabel}</span>
                    )}
                  </td>
                  <td class="num">{r.showCounts ? r.booked : '—'}</td>
                  <td class="num">{r.showCounts ? r.capacity : '—'}</td>
                  <td class="num">{r.showCounts ? r.available : '—'}</td>
                  <td><span class={`adm-pill adm-pill--${stateTone[r.state]}`}>{r.stateLabel}</span></td>
                  <td class="adm-room-guests">
                    {r.guests.length === 0 ? '—' : r.guests.join(', ')}
                  </td>
                </tr>
              ))}
            </Fragment>
          ))}
        </tbody>
        <tfoot>
          <tr class="adm-row--total">
            <th scope="row" colspan="3">Total (active rooms)</th>
            <td class="num">{roomTotals.booked}</td>
            <td class="num">{roomTotals.capacity}</td>
            <td class="num"><span class={`adm-pill adm-pill--${capacityTone(roomTotals.available)}`}>{roomTotals.available}</span></td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      </table>
      <p class="adm-table-note">Rooms are grouped and sorted by building. <strong>Category</strong> is the price band (tier) the room is sold under. <strong>Sell as</strong>: <em>Single</em> — whole room, one booking locks it. <em>Multi</em> — sold bed by bed. <em>Either</em> — multi-mode; one whole-room booking locks the rest of the beds. Empty multi rooms show a dropdown: <em>Either</em> (auto), <em>Single only</em>, or <em>Multi only</em> — pin a mode to pre-decide how the room is offered on the public form. <strong>Booked</strong> counts active paid + pending registrations (incl. pre-allocated hosts/cook). <strong>Available</strong> is 0 for inactive rooms and for the empty beds in a locked whole-room booking; for a role-reserved bed it reflects whether the fire-keeper / cook-help seat is still open. The totals row sums beds across active rooms; the admin-test bed is hidden.</p>
    </section>

    <!-- ─── Balance due (deposit-payers) ─── -->
    <section class="adm-section">
      <h2>
        Balance due
        <small>(deposit-payers who still owe the remainder)</small>
      </h2>

      {balanceDue.length === 0 ? (
        <p class="adm-empty">No outstanding balances — everyone has paid in full.</p>
      ) : (
        <>
          <div class="adm-balance-bar">
            <span>
              <strong>{balanceDue.length}</strong> {balanceDue.length === 1 ? 'person owes' : 'people owe'} a balance ·
              total outstanding <strong>{eur(balanceDueTotalCents, 'EUR')}</strong>
            </span>
            <form method="POST" action="/api/admin/balance/send-bulk"
                  onsubmit={`return confirm('Email all ${balanceDue.length} deposit-payer(s) a Stripe link for their remaining balance?')`}>
              <input type="hidden" name="product_slug" value={productSlug} />
              <input type="hidden" name="return_to" value={returnTo} />
              <button type="submit" class="adm-btn adm-btn--solid">Email everyone a balance link</button>
            </form>
          </div>

          <table class="adm-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th class="num">Balance due</th>
                <th>Last invited</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {balanceDue.map((r) => {
                const displayName =
                  (r.first_name || r.last_name)
                    ? `${r.first_name ?? ''} ${r.last_name ?? ''}`.trim()
                    : r.name;
                return (
                  <tr>
                    <td>{displayName}</td>
                    <td><a href={`mailto:${r.email}`}>{r.email}</a></td>
                    <td class="num">{eur(r.balance_due_cents, r.currency)}</td>
                    <td>{r.balance_invite_sent_at ? ymd(r.balance_invite_sent_at) : '—'}</td>
                    <td>
                      <form method="POST" action="/api/admin/balance/send">
                        <input type="hidden" name="registration_id" value={r.id} />
                        <input type="hidden" name="return_to" value={returnTo} />
                        <button type="submit" class="adm-btn adm-btn--ghost">
                          {r.balance_invite_sent_at ? 'Resend link' : 'Send link'}
                        </button>
                      </form>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <p class="adm-table-note">Each link is a Stripe Checkout for that person's exact remaining balance. When they pay, the balance is cleared automatically (via the Stripe webhook) and they drop off this list. “Last invited” shows when the email was last sent — use <strong>Resend link</strong> for a reminder.</p>
        </>
      )}
    </section>

    <!-- ─── Registrations ─── -->
    <section class="adm-section">
      <h2>
        Registrations
        <span class="adm-filters">
          <a href={`/admin/retreats/${productSlug}`} class={statusFilter === '' ? 'is-on' : ''}>all</a>
          <a href={`/admin/retreats/${productSlug}?status=paid`} class={statusFilter === 'paid' ? 'is-on' : ''}>paid</a>
          <a href={`/admin/retreats/${productSlug}?status=pending`} class={statusFilter === 'pending' ? 'is-on' : ''}>pending</a>
          <a href={`/admin/retreats/${productSlug}?status=cancelled`} class={statusFilter === 'cancelled' ? 'is-on' : ''}>cancelled</a>
          <a href={`/admin/retreats/${productSlug}?status=refunded`} class={statusFilter === 'refunded' ? 'is-on' : ''}>refunded</a>
        </span>
      </h2>

      {rows.length === 0 && (
        <p class="adm-empty">No registrations yet.</p>
      )}

      <div class="adm-regs">
        {rows.map((r) => {
          const displayName =
            (r.first_name || r.last_name)
              ? `${r.first_name ?? ''} ${r.last_name ?? ''}`.trim()
              : r.name;
          const role = roleLabel(r.role);
          const phoneDisplay = r.phone
            ? r.phone_country ? `${r.phone} (${r.phone_country})` : r.phone
            : null;
          return (
            <article class={`adm-reg adm-reg--${r.status}`}>
              <div class="adm-reg-head">
                <div class="adm-reg-id">#{r.id}</div>
                <div class="adm-reg-name">
                  <strong>{displayName}</strong>
                  <a href={`mailto:${r.email}`}>{r.email}</a>
                </div>
                <div class="adm-reg-tier">
                  {r.tier_name}
                  {role && <span class="adm-pill adm-pill--role">{role}</span>}
                </div>
                <div class="adm-reg-amount">
                  {eur(r.amount_cents, r.currency)}
                  {r.role_discount_cents > 0 && (
                    <span class="adm-reg-discount">
                      −{eur(r.role_discount_cents, r.currency)}
                    </span>
                  )}
                  {r.refunded_amount_cents > 0 && (
                    <span class="adm-reg-discount">
                      −{eur(r.refunded_amount_cents, r.currency)} refunded
                    </span>
                  )}
                </div>
                <div class="adm-reg-status">
                  <span class={`adm-pill adm-pill--${r.status}`}>{r.status}</span>
                </div>
                <div class="adm-reg-dates">
                  <div><span>Created</span> {ymd(r.created_at)}</div>
                  <div><span>Paid</span> {ymd(r.paid_at)}</div>
                  {r.cancelled_at && (
                    <div><span>Cancelled</span> {ymd(r.cancelled_at)}</div>
                  )}
                  {r.refunded_at && (
                    <div><span>Refunded</span> {ymd(r.refunded_at)}</div>
                  )}
                </div>
              </div>

              <dl class="adm-reg-details">
                <div><dt>Room</dt><dd>{r.inventory_unit_name ?? '—'}</dd></div>
                <div><dt>Phone</dt><dd>{phoneDisplay ?? '—'}</dd></div>
                <div><dt>Country</dt><dd>{r.country ?? '—'}</dd></div>
                {r.company_name && (
                  <div><dt>Company</dt><dd>{r.company_name}</dd></div>
                )}
                {r.vat_number && (
                  <div><dt>VAT</dt><dd>{r.vat_number}</dd></div>
                )}
                {r.dietary && (
                  <div><dt>Diet</dt><dd>{r.dietary}</dd></div>
                )}
                {r.notes && (
                  <div class="adm-reg-detail--full"><dt>Notes</dt><dd>{r.notes}</dd></div>
                )}
                {r.roommate_pref && (
                  <div class="adm-reg-detail--full"><dt>Roommate pref</dt><dd>{r.roommate_pref}</dd></div>
                )}
                {r.balance_due_cents > 0 && !r.balance_paid_at && (
                  <div><dt>Balance due</dt><dd>{eur(r.balance_due_cents, r.currency)}{r.balance_invite_sent_at ? ` · invited ${ymd(r.balance_invite_sent_at)}` : ''}</dd></div>
                )}
                {r.balance_paid_at && (
                  <div><dt>Balance</dt><dd>Paid {ymd(r.balance_paid_at)}</dd></div>
                )}
              </dl>

              <div class="adm-reg-actions">
                <form method="POST" action="/api/admin/assign-room" class="adm-reg-assign">
                  <input type="hidden" name="registration_id" value={r.id} />
                  <input type="hidden" name="return_to" value={returnTo} />
                  <label>
                    <span>Assign room</span>
                    <select name="inventory_unit_id">
                      <option value="">— unassigned —</option>
                      {rooms.map((room) => (
                        <option value={room.id} selected={r.inventory_unit_name === room.name}>
                          {room.name} ({room.assigned_count}/{room.capacity})
                        </option>
                      ))}
                    </select>
                  </label>
                  <button type="submit">Save</button>
                </form>

                {(r.status === 'pending' || r.status === 'expired') && (
                  <form method="POST" action="/api/admin/mark-paid" class="adm-reg-markpaid"
                        onsubmit={`return confirm('Mark registration #${r.id} as paid and push to Drip?')`}>
                    <input type="hidden" name="registration_id" value={r.id} />
                    <input type="hidden" name="return_to" value={returnTo} />
                    <button type="submit" class="adm-btn adm-btn--solid">Mark paid + Drip</button>
                  </form>
                )}

                <form method="POST" action="/api/admin/delete-registration" class="adm-reg-delete"
                      onsubmit={`return confirm('Permanently delete registration #${r.id} (${r.name}, ${r.email})? This cannot be undone.')`}>
                  <input type="hidden" name="registration_id" value={r.id} />
                  <input type="hidden" name="return_to" value={returnTo} />
                  <button type="submit" class="adm-btn adm-btn--danger">Delete</button>
                </form>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- ─── Events log (newest 40) ─── -->
    <section class="adm-section">
      <h2>Recent events <small>(useful for diagnosing webhook delivery)</small></h2>
      <table class="adm-table adm-table--events">
        <thead>
          <tr>
            <th>When</th>
            <th>Source</th>
            <th>Kind</th>
            <th>Reg #</th>
            <th>External ID</th>
            <th>Payload (excerpt)</th>
          </tr>
        </thead>
        <tbody>
          {events.length === 0 && (
            <tr><td colspan="6" class="adm-empty-cell">No events logged yet.</td></tr>
          )}
          {events.map((e) => (
            <tr>
              <td class="adm-mono">{ymd(e.created_at)}</td>
              <td><span class={`adm-pill adm-pill--src-${e.source}`}>{e.source}</span></td>
              <td class="adm-mono">{e.kind}</td>
              <td class="num">{e.registration_id ?? '—'}</td>
              <td class="adm-mono adm-truncate" title={e.external_id ?? ''}>{e.external_id ?? '—'}</td>
              <td class="adm-mono adm-truncate" title={e.payload_excerpt ?? ''}>{e.payload_excerpt ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </main>
</Layout>
