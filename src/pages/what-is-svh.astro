---
import SiteLayout from '../components/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SoftCta from '../components/SoftCta.astro';
---

<SiteLayout
  title="What is Somatic Vocal Healing? — Songdance"
  description="A practice of meeting what you feel — and giving it sound. Sounding, not singing."
>
  <PageHero
    eyebrow="The practice"
    title='What is <span class="sd-italic">Somatic Vocal Healing?</span>'
    lede="A practice of meeting what you feel — and giving it sound."
  />
  <section class="sd-section sd-prose">
    <div class="sd-prose-inner">
      <p class="sd-scaffold-note">Scaffold page — full copy lands in the content pass (brief §5).</p>
      <p>
        It's called <strong>sounding</strong>, not singing. The difference is the whole thing.
        There's no melody to reach for and nothing to get right — the crack, the waver, the rough
        edge is the information.
      </p>
    </div>
  </section>
  <SoftCta />
</SiteLayout>
