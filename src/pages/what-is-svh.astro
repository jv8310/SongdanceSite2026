---
import SiteLayout from '../components/SiteLayout.astro';
import SoftCta from '../components/SoftCta.astro';

// Illustrated chapter set (R2 `library/svhgpt-*`) made for exactly these
// ideas — candle-lit, throat-lit, wholly on-brand. Real retreat photography
// lives elsewhere; here the illustration carries the inner experience.
// `iw`/`ih` are the intrinsic pixel sizes of the R2 originals (CLS hints);
// `pos` nudges the 5/4 crop when the subject isn't centered.
const chapters = [
  {
    n: '01',
    label: 'Where it went quiet',
    h: 'You arrived knowing how to do this',
    img: '/media/library/svhgpt-02-we-lost-the-voice.webp',
    imgAlt: 'A woman in profile, eyes closed; in her chest a small child sings out, glowing like an ember.',
    iw: 1122,
    ih: 1402,
    pos: '50% 33%',
    p: [
      'Watch a small child for an afternoon. Delight, protest, grief, wonder — all of it sounded the moment it arrives, with the whole body behind it. Nobody taught them that. It’s what a voice is for.',
      'Then come the other lessons: keep it down, keep it pleasant, keep it from saying too much. The full voice doesn’t disappear. It goes quiet and waits — and it’s still in there.',
    ],
  },
  {
    n: '02',
    label: 'Sounding, not singing',
    h: 'Sounding has a different intention',
    img: '/media/library/svhgpt-03-sounding-not-singing.webp',
    imgAlt: 'A profile in candlelight, mouth open, rings of sound moving outward.',
    iw: 1254,
    ih: 1254,
    flip: true,
    p: [
      'Singing reaches for melody — for something shaped and lovely, something to get right. Sounding reaches for none of that. There’s no tune to land and no wrong note to avoid.',
      'The crack, the waver, the rough edge — that’s not a mistake to fix. That’s the information. With sounding we welcome exactly what a performer would smooth away.',
    ],
    contrast: {
      a: { k: 'Singing', items: ['Reaches outward', 'Wants to sound good', 'A shape to get right'] },
      b: { k: 'Sounding', items: ['Turns inward', 'Brings you truth', 'Whatever is actually here'] },
    },
  },
  {
    n: '03',
    label: 'The sound of the moment',
    h: 'You begin where you are',
    img: '/media/library/svhgpt-04-sound-of-not-for.webp',
    imgAlt: 'A seated figure, chest glowing, sound radiating into a dark room.',
    iw: 1672,
    ih: 941,
    p: [
      'There’s no script. The only question is <em>what is the sound of this moment?</em> One tone — raw and tonal, not a song, not yet a story.',
      'You stay with it and let it run its course. Sometimes it shifts on its own: turns inward into a hum, opens into something rounder, dissolves. You don’t force it anywhere. You attend it.',
    ],
  },
  {
    n: '04',
    label: 'The body',
    h: 'Your body is on your side',
    img: '/media/library/svhgpt-05-the-cup-receiving.webp',
    imgAlt: 'Two cupped hands holding a small, warm light.',
    iw: 1122,
    ih: 1402,
    flip: true,
    p: [
      'We tend to treat the body as something that can fail us — the tension, the ache, the symptom that won’t quit.',
      'Somatic Vocal Healing starts from the opposite assumption. Your body has been cooperating the whole time, doing exactly what it believed it needed to do to protect you. The voice is simply the most direct way to hear what it’s been trying to say.',
    ],
  },
  {
    n: '05',
    label: 'Whose work it is',
    h: 'You are your own healer',
    img: '/media/library/svhgpt-06-holding-space.webp',
    imgAlt: 'Two people seated facing each other, a thread of light between them.',
    iw: 1448,
    ih: 1086,
    flip: true,
    p: [
      'No one can heal you — not a teacher, not a method, not a sound. Healing happens when the parts of you that split off come back together.',
      'That doesn’t mean you do it alone — we never stop needing each other. But what we give each other isn’t the healing; it’s the space where healing becomes possible. A guide holds that space. What rises in it is yours.',
    ],
  },
];

// Practical questions for the reader the poetry doesn't answer. Plain-text
// mirror goes into FAQPage JSON-LD below.
const faqs = [
  {
    q: 'Do I need to be able to sing?',
    a: 'No — and it matters that you can’t get this wrong. Sounding has no melody to hit and no audience to please. If you can sigh, groan or hum, you already have everything the practice requires.',
  },
  {
    q: 'What does it actually look like?',
    a: 'You land in the body first — breath, attention, settling. Then you’re guided toward one honest tone at a time, and you stay with it. In a group everyone sounds at once, so no one is listening to you. The room holds you; it doesn’t watch you.',
  },
  {
    q: 'How is it different from a sound bath?',
    a: 'In a sound bath the sound is made for you — you lie back and receive, and that can be lovely. Here the sound comes from you. You’re not bathing in someone else’s frequencies; you’re finally hearing your own.',
  },
  {
    q: 'Is this therapy?',
    a: 'No. Somatic Vocal Healing is a body-based practice, not a clinical treatment, and it isn’t a substitute for therapy or medical care. Many people practice it alongside therapy — the voice often reaches what words have been circling for years.',
  },
  {
    q: 'What if I’m embarrassed by the sounds I make?',
    a: 'Nearly everyone is, at first — that shyness is part of the material the practice works with. You can begin with a hum behind closed lips. Quiet counts. Honest matters more than loud.',
  },
  {
    q: 'Where do I start?',
    a: 'The simplest door is the <a href="/workshop">live online workshop</a> — one hour, 9€, no experience needed. You sound along from home and feel what this actually does in your own body.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---

<SiteLayout
  title="What is Somatic Vocal Healing? — Songdance"
  description="Somatic Vocal Healing is the body's most direct language: the honest sound of what you feel, made out loud until it's been heard. Not singing, not performance — meeting what's here and giving it sound."
  image="/media/library/svhgpt-01-hero-in-one-breath.webp"
>
  <!-- Hero -------------------------------------------------------------- -->
  <header class="wsv-hero">
    <img
      class="wsv-hero-bg"
      src="/media/library/svhgpt-01-hero-in-one-breath.webp"
      alt="A woman in candlelight, head tilted back, her throat lit from within as she sounds."
      width="1536"
      height="1024"
      fetchpriority="high"
    />
    <div class="wsv-hero-scrim"></div>
    <div class="wsv-hero-inner">
      <div class="wsv-hero-copy">
        <div class="wsv-eyebrow wsv-eyebrow--light">Somatic Vocal Healing</div>
        <h1 class="wsv-hero-title">
          What is <span class="wsv-italic">Somatic Vocal&nbsp;Healing?</span>
        </h1>
        <p class="wsv-hero-lede">A practice of meeting what you feel — and giving it sound.</p>
        <p class="wsv-hero-def">
          Not singing. Not performance. The honest sound of what’s here,
          made out loud until it’s been heard.
        </p>
        <div class="wsv-hero-actions">
          <a href="/workshop" class="wsv-btn wsv-btn--primary">Sit in on a live workshop — 9€</a>
          <a href="#practice" class="wsv-btn wsv-btn--ghost">See the practice ↓</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Opening shift ----------------------------------------------------- -->
  <section class="wsv-open" id="practice">
    <div class="wsv-open-inner wsv-reveal">
      <div class="wsv-eyebrow">The shift</div>
      <p class="wsv-lyric">
        Most sound work asks <em>how should this sound?</em><br />
        Somatic Vocal Healing asks<br />
        <em>what do you feel — and what is the sound of that?</em>
      </p>
      <p class="wsv-open-body">
        That’s the whole shift. The voice stops being something to manage —
        pleasant, in tune, never too much — and becomes what it has always been
        underneath: the body’s most direct language. The practice gives that
        language somewhere to go.
      </p>
    </div>
  </section>

  <!-- Chapters: the quieting / sounding / the moment --------------------- -->
  {chapters.slice(0, 3).map((c) => (
    <section class={'wsv-chapter' + (c.flip ? ' wsv-chapter--flip' : '')}>
      <div class="wsv-chapter-inner wsv-reveal">
        <figure class="wsv-chapter-fig">
          <img
            src={c.img}
            alt={c.imgAlt}
            width={c.iw}
            height={c.ih}
            loading="lazy"
            decoding="async"
            style={c.pos ? `object-position: ${c.pos}` : undefined}
          />
        </figure>
        <div class="wsv-chapter-text">
          <div class="wsv-chapter-head">
            <span class="wsv-chapter-n">{c.n}</span>
            <span class="wsv-chapter-rule"></span>
            <span class="wsv-chapter-label">{c.label}</span>
          </div>
          <h2 class="wsv-chapter-h">{c.h}</h2>
          {c.p.map((para) => <p set:html={para} />)}
          {c.contrast && (
            <div class="wsv-contrast">
              <div class="wsv-contrast-col">
                <span class="wsv-contrast-k">{c.contrast.a.k}</span>
                <ul>{c.contrast.a.items.map((i) => <li>{i}</li>)}</ul>
              </div>
              <div class="wsv-contrast-col wsv-contrast-col--accent">
                <span class="wsv-contrast-k">{c.contrast.b.k}</span>
                <ul>{c.contrast.b.items.map((i) => <li>{i}</li>)}</ul>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  ))}

  <!-- Wave band: in and out at once ------------------------------------- -->
  <section class="wsv-wave">
    <img
      class="wsv-wave-img"
      src="/media/library/svhgpt-08-oscillation-breath-rhythm.webp"
      alt=""
      width="1915"
      height="821"
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
    <div class="wsv-wave-inner wsv-reveal">
      <div class="wsv-eyebrow">In and out at once</div>
      <p class="wsv-wave-text">
        Sounding moves in two directions at once: outward into expression, so
        what you’ve been carrying finally leaves the body — and inward into
        listening, because the one who most needs to hear that sound is you.
        You sound what’s true, and at last you hear it yourself.
      </p>
    </div>
  </section>

  <!-- Body chapter ------------------------------------------------------ -->
  {chapters.slice(3, 4).map((c) => (
    <section class={'wsv-chapter' + (c.flip ? ' wsv-chapter--flip' : '')}>
      <div class="wsv-chapter-inner wsv-reveal">
        <figure class="wsv-chapter-fig">
          <img
            src={c.img}
            alt={c.imgAlt}
            width={c.iw}
            height={c.ih}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="wsv-chapter-text">
          <div class="wsv-chapter-head">
            <span class="wsv-chapter-n">{c.n}</span>
            <span class="wsv-chapter-rule"></span>
            <span class="wsv-chapter-label">{c.label}</span>
          </div>
          <h2 class="wsv-chapter-h">{c.h}</h2>
          {c.p.map((para) => <p set:html={para} />)}
        </div>
      </div>
    </section>
  ))}

  <!-- The honest part: pinned descent from surface to ember -------------- -->
  <section class="wsv-honest" id="honest">
    <div class="wsv-honest-sticky">
      <img
        class="wsv-honest-img"
        src="/media/library/svhgpt-07-below-deeper-earlier.webp"
        alt="A seated figure on the surface, roots descending to a glowing ember deep underground."
        width="941"
        height="1672"
        loading="lazy"
        decoding="async"
      />
      <div class="wsv-honest-veil" aria-hidden="true"></div>
      <div class="wsv-honest-step">
        <div class="wsv-eyebrow wsv-eyebrow--light">The honest part</div>
        <h2 class="wsv-honest-h">It doesn’t always feel better right away</h2>
      </div>
      <div class="wsv-honest-step">
        <p>
          Here’s the thing no brochure says: sometimes you feel worse before
          anything settles. If all you want is to feel nice for an hour, there are
          gentler tools — and they’re good ones.
        </p>
      </div>
      <div class="wsv-honest-step">
        <p>
          But if you’re willing to meet the parts that have been waiting — the
          grief, the anger, the old fear — what’s on the other side isn’t a quick
          lift. It’s a steadier kind of peace. More lasting. More structurally
          <span class="wsv-italic">yours.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Whose work it is -------------------------------------------------- -->
  {chapters.slice(4, 5).map((c) => (
    <section class={'wsv-chapter' + (c.flip ? ' wsv-chapter--flip' : '')}>
      <div class="wsv-chapter-inner wsv-reveal">
        <figure class="wsv-chapter-fig">
          <img
            src={c.img}
            alt={c.imgAlt}
            width={c.iw}
            height={c.ih}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="wsv-chapter-text">
          <div class="wsv-chapter-head">
            <span class="wsv-chapter-n">{c.n}</span>
            <span class="wsv-chapter-rule"></span>
            <span class="wsv-chapter-label">{c.label}</span>
          </div>
          <h2 class="wsv-chapter-h">{c.h}</h2>
          {c.p.map((para) => <p set:html={para} />)}
        </div>
      </div>
    </section>
  ))}

  <!-- Questions ----------------------------------------------------------- -->
  <section class="wsv-faq" id="questions">
    <div class="wsv-faq-inner wsv-reveal">
      <div class="wsv-faq-head">
        <div class="wsv-eyebrow">Questions</div>
        <h2 class="wsv-faq-h">Things people ask first</h2>
      </div>
      <div class="wsv-faq-list">
        {faqs.map((f) => (
          <details class="wsv-faq-item">
            <summary class="wsv-faq-q">
              <span>{f.q}</span>
              <span class="wsv-faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="wsv-faq-a">
              <p set:html={f.a} />
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Closing candle ---------------------------------------------------- -->
  <section class="wsv-close">
    <img
      class="wsv-close-bg"
      src="/media/library/svhgpt-09-closing-candle.webp"
      alt="A single lit candle in a dark room."
      width="1254"
      height="1254"
      loading="lazy"
      decoding="async"
    />
    <div class="wsv-close-scrim"></div>
    <div class="wsv-close-inner wsv-reveal">
      <p class="wsv-close-lyric">What is the sound of this&nbsp;moment?</p>
      <p class="wsv-close-sub">Begin there.</p>
    </div>
  </section>

  <SoftCta
    text="Curious how this actually feels?"
    ctaLabel="Sit in on a live workshop — 9€"
    ctaHref="/workshop"
    altLabel="About Jacob →"
    altHref="/about"
  />
</SiteLayout>

<style>
  /* ============================================================
     What is Somatic Vocal Healing — bespoke editorial layout.
     Reuses global tokens (tokens.css); scoped to this page.
     ============================================================ */

  .wsv-eyebrow {
    font-family: var(--font-body);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--ember-deep);
    font-weight: 500;
  }
  .wsv-eyebrow--light { color: var(--ember-soft); }

  .wsv-italic {
    font-family: var(--font-lyric);
    font-style: italic;
    font-weight: 400;
  }

  /* ---------- Hero ---------- */
  .wsv-hero {
    position: relative;
    min-height: clamp(560px, 88vh, 880px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--night-deep);
  }
  .wsv-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* keep her face in frame when narrow viewports crop horizontally */
    object-position: 40% 28%;
    filter: saturate(0.92) contrast(1.02);
  }
  .wsv-hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(15, 8, 14, 0.9) 0%, rgba(15, 8, 14, 0.5) 36%, rgba(15, 8, 14, 0.1) 68%, rgba(15, 8, 14, 0.32) 100%),
      radial-gradient(120% 95% at 78% 96%, rgba(26, 16, 24, 0.72), transparent 62%);
  }
  .wsv-hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--sd-max);
    width: 100%;
    margin: 0 auto;
    padding: var(--sp-9) var(--sp-7) var(--sp-8);
    /* copy lives in the open parchment to the right of her, not on her face */
    display: flex;
    justify-content: flex-end;
  }
  .wsv-hero-copy { max-width: 620px; }
  .wsv-hero-title {
    font-family: var(--font-display);
    font-size: clamp(42px, 5.6vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: var(--paper-soft);
    margin: var(--sp-4) 0 0;
    max-width: 16ch;
    text-wrap: balance;
  }
  .wsv-hero-title .wsv-italic { color: var(--ember-soft); }
  .wsv-hero-lede {
    font-family: var(--font-lyric);
    font-style: italic;
    font-size: clamp(22px, 2.8vw, 32px);
    line-height: 1.3;
    color: rgba(244, 245, 234, 0.94);
    margin: var(--sp-5) 0 0;
    max-width: 30ch;
  }
  .wsv-hero-def {
    font-family: var(--font-body);
    font-size: var(--t-body-lg);
    line-height: 1.6;
    color: rgba(244, 245, 234, 0.78);
    margin: var(--sp-4) 0 0;
    max-width: 46ch;
  }
  .wsv-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: var(--sp-6);
  }

  /* ---------- Buttons ---------- */
  .wsv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 14px 26px;
    border-radius: var(--r-pill);
    text-decoration: none;
    transition: transform var(--d-quick) var(--ease), background var(--d-base) var(--ease), border-color var(--d-base) var(--ease), color var(--d-base) var(--ease);
  }
  .wsv-btn--primary {
    background: var(--ember);
    color: #fff;
    box-shadow: var(--shadow-2);
  }
  .wsv-btn--primary:hover { background: var(--ember-deep); transform: translateY(-2px); }
  .wsv-btn--ghost {
    color: var(--paper-soft);
    border: 1px solid rgba(244, 245, 234, 0.5);
  }
  .wsv-btn--ghost:hover { border-color: var(--paper-soft); background: rgba(244, 245, 234, 0.08); }
  .wsv-btn:focus-visible { outline: 2px solid var(--ember); outline-offset: 3px; }

  /* ---------- Opening shift ---------- */
  .wsv-open {
    background: var(--paper-soft);
    padding: var(--sp-10) var(--sp-7);
    border-bottom: 1px solid var(--line);
  }
  .wsv-open-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .wsv-lyric {
    font-family: var(--font-lyric);
    font-style: italic;
    font-size: clamp(28px, 3.6vw, 46px);
    line-height: 1.28;
    color: var(--ink);
    letter-spacing: 0.005em;
    text-wrap: balance;
    margin: var(--sp-5) 0 0;
  }
  .wsv-lyric em { color: var(--ember-deep); font-style: italic; }
  .wsv-open-body {
    font-family: var(--font-body);
    font-size: var(--t-body-lg);
    line-height: var(--lh-prose);
    color: var(--ink-soft);
    max-width: 56ch;
    margin: var(--sp-7) auto 0;
  }

  /* ---------- Chapters (alternating) ---------- */
  .wsv-chapter { padding: var(--sp-9) var(--sp-7); background: var(--paper); }
  .wsv-chapter-inner {
    max-width: var(--sd-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-8);
    align-items: center;
  }
  .wsv-chapter--flip .wsv-chapter-fig { order: 2; }
  .wsv-chapter-fig {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-3);
    aspect-ratio: 5 / 4;
    background: var(--night-soft);
  }
  .wsv-chapter-fig img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: var(--sd-img-filter);
    transition: transform var(--d-slow) var(--ease);
  }
  .wsv-chapter-inner:hover .wsv-chapter-fig img { transform: scale(1.03); }

  .wsv-chapter-text { max-width: 46ch; }
  .wsv-chapter-head {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-5);
  }
  .wsv-chapter-n {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    color: var(--ember-deep);
  }
  .wsv-chapter-rule { width: 40px; height: 1px; background: var(--line-strong); }
  .wsv-chapter-label {
    font-family: var(--font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--ink-quiet);
    font-weight: 500;
  }
  .wsv-chapter-h {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1.12;
    letter-spacing: -0.012em;
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 var(--sp-5);
    text-wrap: balance;
  }
  .wsv-chapter-text p {
    font-family: var(--font-body);
    font-size: var(--t-body-lg);
    line-height: var(--lh-prose);
    color: var(--ink-soft);
    margin: 0 0 var(--sp-4);
  }
  .wsv-chapter-text p:last-child { margin-bottom: 0; }
  .wsv-chapter-text em { font-family: var(--font-lyric); font-style: italic; font-size: 1.08em; color: var(--ink); }

  /* Singing vs sounding contrast */
  .wsv-contrast {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }
  .wsv-contrast-col {
    padding: var(--sp-5);
    border-radius: var(--r-md);
    background: var(--paper-soft);
    border: 1px solid var(--line);
  }
  .wsv-contrast-col--accent {
    background: var(--ember-glow);
    border-color: var(--ember-soft);
  }
  .wsv-contrast-k {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ember-deep);
    font-weight: 600;
    margin-bottom: var(--sp-3);
  }
  .wsv-contrast-col ul { list-style: none; margin: 0; padding: 0; }
  .wsv-contrast-col li {
    font-family: var(--font-lyric);
    font-style: italic;
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .wsv-contrast-col--accent li { color: var(--ink); }

  /* ---------- Wave band ---------- */
  .wsv-wave {
    position: relative;
    background: var(--paper-deep);
    padding: var(--sp-10) var(--sp-7);
    overflow: hidden;
  }
  .wsv-wave-img {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 140%;
    max-width: 1600px;
    opacity: 0.5;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .wsv-wave-inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .wsv-wave-text {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.5;
    color: var(--ink);
    margin: var(--sp-5) 0 0;
    text-wrap: balance;
  }

  /* ---------- The honest part (pinned descent) ----------
     Static layout first: the whole illustration is visible — nothing
     crops the ember — with the text on plum below it. The scroll-driven
     descent only layers on under html.wsv-anim (JS + motion allowed). */
  .wsv-honest {
    background: var(--plum);
    color: var(--paper-soft);
    padding: var(--sp-8) 0 0;
  }
  .wsv-honest-img {
    display: block;
    margin: 0 auto;
    width: auto;
    max-width: 100%;
    max-height: 92vh;
    filter: saturate(0.9) contrast(1.02);
  }
  .wsv-honest-veil { display: none; }
  .wsv-honest-step {
    max-width: 620px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-5) 0;
    text-align: center;
  }
  .wsv-honest-step:last-child { padding-bottom: var(--sp-8); }
  .wsv-honest-h {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1.12;
    letter-spacing: -0.012em;
    font-weight: 400;
    color: var(--paper-soft);
    margin: var(--sp-4) 0 0;
    text-wrap: balance;
  }
  .wsv-honest-step p {
    font-family: var(--font-body);
    font-size: var(--t-body-lg);
    line-height: var(--lh-prose);
    color: rgba(244, 245, 234, 0.88);
    margin: 0;
    text-wrap: balance;
  }
  .wsv-honest-step .wsv-italic { color: var(--ember-soft); font-size: 1.35em; line-height: 1; }

  /* Pinned scene: the illustration pans from the figure on the surface
     down to the ember while the text beats fade through. */
  :global(html.wsv-anim) .wsv-honest {
    height: 340vh;
    padding: 0;
  }
  :global(html.wsv-anim) .wsv-honest-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: var(--plum);
  }
  :global(html.wsv-anim) .wsv-honest-img {
    position: absolute;
    top: 0;
    left: 50%;
    /* wide enough to cover any viewport AND tall enough (~183vh min,
       aspect 941:1672) that there is always vertical travel */
    width: max(100%, 103vh);
    max-width: none;
    max-height: none;
    height: auto;
    /* translateY % is the image's own height: p=0 → top of the
       illustration (the figure), p=1 → its bottom (the ember) */
    transform: translate(-50%, calc(var(--wsv-p, 0) * (100vh - 100%)));
    will-change: transform;
  }
  :global(html.wsv-anim) .wsv-honest-veil {
    display: block;
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(rgba(15, 8, 14, 0.16), rgba(15, 8, 14, 0.34)),
      radial-gradient(74% 58% at 50% 52%, rgba(15, 8, 14, 0.42), transparent 74%);
  }
  :global(html.wsv-anim) .wsv-honest-step {
    position: absolute;
    inset: 0;
    max-width: none;
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }
  :global(html.wsv-anim) .wsv-honest-step > * { max-width: 36rem; }
  :global(html.wsv-anim) .wsv-honest-step p {
    font-size: clamp(19px, 2.2vw, 24px);
    line-height: 1.65;
  }

  /* ---------- Questions ---------- */
  .wsv-faq {
    background: var(--paper-soft);
    border-top: 1px solid var(--line);
    padding: var(--sp-9) var(--sp-7);
  }
  .wsv-faq-inner { max-width: 720px; margin: 0 auto; }
  .wsv-faq-head { text-align: center; margin-bottom: var(--sp-6); }
  .wsv-faq-h {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1.12;
    letter-spacing: -0.012em;
    font-weight: 400;
    color: var(--ink);
    margin: var(--sp-4) 0 0;
    text-wrap: balance;
  }
  .wsv-faq-item { border-bottom: 1px solid var(--line); }
  .wsv-faq-item:first-of-type { border-top: 1px solid var(--line); }
  .wsv-faq-q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    list-style: none;
    cursor: pointer;
    padding: var(--sp-5) var(--sp-2);
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1.3;
    color: var(--ink);
  }
  .wsv-faq-q::-webkit-details-marker { display: none; }
  .wsv-faq-q:hover { color: var(--ember-deep); }
  .wsv-faq-q:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: 2px;
    border-radius: var(--r-sm);
  }
  .wsv-faq-icon {
    flex: none;
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 300;
    color: var(--ember-deep);
    transition: transform var(--d-base) var(--ease);
  }
  .wsv-faq-item[open] .wsv-faq-icon { transform: rotate(45deg); }
  .wsv-faq-a { padding: 0 var(--sp-2) var(--sp-5); }
  .wsv-faq-a p {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
    color: var(--ink-soft);
    max-width: 58ch;
    margin: 0;
  }

  /* ---------- Closing candle ---------- */
  .wsv-close {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--night-deep);
  }
  .wsv-close-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .wsv-close-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(80% 70% at 50% 55%, rgba(15, 8, 14, 0.25), rgba(15, 8, 14, 0.82) 80%);
  }
  .wsv-close-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: var(--sp-10) var(--sp-7);
  }
  .wsv-close-lyric {
    font-family: var(--font-lyric);
    font-style: italic;
    font-size: clamp(30px, 4.4vw, 54px);
    line-height: 1.2;
    color: var(--ember-glow);
    margin: 0;
    text-wrap: balance;
  }
  .wsv-close-sub {
    font-family: var(--font-body);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: rgba(244, 245, 234, 0.6);
    margin: var(--sp-5) 0 0;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .wsv-chapter-inner { grid-template-columns: 1fr; gap: var(--sp-5); }
    .wsv-chapter--flip .wsv-chapter-fig { order: 0; }
    .wsv-chapter-fig { aspect-ratio: 16 / 10; }
    .wsv-chapter-text { max-width: none; }
  }
  @media (max-width: 720px) {
    .wsv-hero-inner,
    .wsv-open,
    .wsv-chapter,
    .wsv-wave,
    .wsv-faq { padding-left: var(--sp-5); padding-right: var(--sp-5); }
    .wsv-chapter { padding-top: var(--sp-8); padding-bottom: var(--sp-8); }
    .wsv-contrast { grid-template-columns: 1fr; }
    .wsv-faq-q { font-size: 19px; }
  }

  /* ---------- Scroll reveal (progressive enhancement) ---------- */
  :global(html.wsv-anim) .wsv-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
    will-change: opacity, transform;
  }
  :global(html.wsv-anim) .wsv-reveal.is-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.wsv-anim) .wsv-reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script is:inline>
  // Reveal-on-scroll without pulling in GSAP (only the homepage loads that).
  // Content is visible by default; we only opt into the hidden→reveal dance
  // when JS + IntersectionObserver are present and motion is allowed.
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) return;
    document.documentElement.classList.add('wsv-anim');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
    );
    document.querySelectorAll('.wsv-reveal').forEach((el) => io.observe(el));

    // Pinned descent for the plum panel: --wsv-p (0→1) pans the
    // illustration from the figure on the surface down to the ember,
    // while the text beats fade through their scroll windows. Skipped
    // entirely under prefers-reduced-motion (early return above) — the
    // static CSS layout takes over.
    const panel = document.querySelector('.wsv-honest');
    if (!panel) return;
    const steps = Array.from(panel.querySelectorAll('.wsv-honest-step'));
    const windows = [
      [0, 0.36],
      [0.3, 0.7],
      [0.64, 1],
    ];
    let ticking = false;
    const render = () => {
      ticking = false;
      const vh = window.innerHeight;
      const r = panel.getBoundingClientRect();
      const total = r.height - vh;
      if (total <= 0) return;
      const p = Math.min(1, Math.max(0, -r.top / total));
      panel.style.setProperty('--wsv-p', p.toFixed(4));
      steps.forEach((el, i) => {
        const [s, e] = windows[i] || [0, 1];
        const t = Math.min(1, Math.max(0, (p - s) / (e - s)));
        // first beat is already on when the scene pins; last beat stays
        // on and exits with the panel
        const fadeIn = i === 0 ? 1 : t / 0.22;
        const fadeOut = i === steps.length - 1 ? 1 : (1 - t) / 0.22;
        el.style.opacity = Math.max(0, Math.min(1, fadeIn, fadeOut)).toFixed(3);
        el.style.transform = `translateY(${((0.5 - t) * 36).toFixed(1)}px)`;
      });
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    render();
  })();
</script>
