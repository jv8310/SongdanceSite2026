---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const sessionId = Astro.url.searchParams.get('session_id');
const paypalOrder = Astro.url.searchParams.get('paypal_order');
const env = Astro.locals.runtime.env;
// PayPal returns here with paypal_order after capture + fulfillment (covers the
// deposit/full retreat order and the balance order — both store the order id).
const lookup: [string, string] | null = sessionId
  ? ['r.stripe_session_id', sessionId]
  : paypalOrder
    ? ['r.paypal_order_id', paypalOrder]
    : null;

let reg: { name: string; status: string; product_name: string; tier_name: string; product_slug: string } | null = null;
if (lookup) {
  reg = await env.DB.prepare(
    `SELECT r.name, r.status, p.name AS product_name, t.name AS tier_name, p.slug AS product_slug
       FROM registrations r
       JOIN products p ON p.id = r.product_id
       JOIN tiers t    ON t.id = r.tier_id
      WHERE ${lookup[0]} = ?`,
  )
    .bind(lookup[1])
    .first<{ name: string; status: string; product_name: string; tier_name: string; product_slug: string }>();
}

// Map a product back to its landing page for the "back" link.
const RETREAT_PAGES: Record<string, string> = {
  'dolphin-and-sound-2026': '/retreats/dolphin-and-sound',
};
const backHref = reg ? (RETREAT_PAGES[reg.product_slug] ?? '/retreats/ritual-of-belonging') : '/events';
---

<Layout title="Thank you — Songdance" description="Booking confirmation">
  <main style="max-width: 640px; margin: 80px auto; padding: 0 24px; font-family: Georgia, serif; line-height: 1.6;">
    {reg ? (
      <>
        <h1 style="font-size: 2rem;">Thank you, {reg.name}.</h1>
        <p>Your place at <strong>{reg.product_name}</strong> ({reg.tier_name}) is being confirmed.</p>
        {reg.status === 'paid' ? (
          <p>Payment received. A confirmation email and invoice are coming soon.</p>
        ) : (
          <p>If you've just completed payment, this page will show that you are confirmed within a minute. You can safely close this window — we'll email you the moment it's confirmed.</p>
        )}
        <p style="margin-top: 32px;"><a href={backHref}>← back to the retreat page</a></p>
      </>
    ) : (
      <>
        <h1>Thank you.</h1>
        <p>If you've just completed payment, we'll contact you soon.</p>
        <p style="margin-top: 32px;"><a href={backHref}>← back to the events page</a></p>
      </>
    )}
  </main>
</Layout>
