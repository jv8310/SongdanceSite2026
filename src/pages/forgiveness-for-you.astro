---
import Layout from '../layouts/Layout.astro';
import ThreeLayersWalk from '../components/forgiveness-magnet/ThreeLayersWalk.jsx';
import '../styles/forgiveness-for-you.css';
---

<Layout
  title="A Personalized Forgiveness Prayer — Songdance"
  description="Five quiet questions shape a personalized forgiveness prayer, sent to your inbox."
  image="/media/library/forgiveness-foryou-twilight.webp"
  imageAlt="A woman at the water's edge in the quiet of twilight."
>
  <ThreeLayersWalk client:load />

  <footer class="tlw-footer-quiet">
    <img src="/brand/logo-wordmark.svg" alt="Songdance" />
    <p>© 2026 Songdance · Somatic Vocal Healing</p>
    <p class="tlw-footer-status"><a href="/system-check">system check</a></p>
  </footer>
</Layout>
