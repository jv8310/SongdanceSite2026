---
import '../styles/workshop-english.css';
import Layout from '../layouts/Layout.astro';
import PromoBanner from '../components/PromoBanner.astro';
import WENav from '../components/workshop-english/WENav.astro';
import WEHero from '../components/workshop-english/WEHero.astro';
import WEOpening from '../components/workshop-english/WEOpening.astro';
import WEWhat from '../components/workshop-english/WEWhat.astro';
import WELyric from '../components/workshop-english/WELyric.astro';
import WETestimonials from '../components/workshop-english/WETestimonials.astro';
import WEAbout from '../components/workshop-english/WEAbout.astro';
import WEQuiet from '../components/workshop-english/WEQuiet.astro';
import WEMasterclass from '../components/workshop-english/WEMasterclass.astro';
import WERegister from '../components/workshop-english/WERegister.astro';
import WEFooter from '../components/workshop-english/WEFooter.astro';
import DiscoverMore from '../components/DiscoverMore.astro';
import { buildCalendarItems, tzOptionsFor } from '../lib/workshops/calendar';
import { currencyForCountry } from '../lib/workshops/currency';
import { getRegistrationByAccessToken, getWorkshopById } from '../lib/workshops/db';

export const prerender = false;

const env = Astro.locals.runtime.env;
const cf = (Astro.locals.runtime as any)?.cf;

// Cloudflare edge geo/timezone — no external API (mirrors /w/[slug]).
let country: string = (cf?.country as string) || 'EU';
let detectedTz: string = (cf?.timezone as string) || 'Europe/Brussels';

// Resume from an abandoned-checkout email: ?resume=<access_token> restores the
// person's saved details and the date they'd chosen, so they land on #register
// with the form already filled in. Only an unguessable token rides the URL — no
// PII — and only carts that never paid ('prepared'/'failed') prefill, so a paid
// link just shows the normal page. Their saved country/timezone become the page
// defaults, keeping prices, times and the form fields consistent server-side.
let prefill: { firstName: string; lastName: string; email: string; slug: string } | null = null;
const resumeToken = (Astro.url.searchParams.get('resume') ?? '').trim();
if (resumeToken) {
  const reg = await getRegistrationByAccessToken(env.DB, resumeToken);
  if (reg && (reg.payment_status === 'prepared' || reg.payment_status === 'failed')) {
    const workshop = await getWorkshopById(env.DB, reg.workshop_id);
    const parts = (reg.name ?? '').trim().split(/\s+/).filter(Boolean);
    prefill = {
      firstName: parts.length ? parts[0] : '',
      lastName: parts.length > 1 ? parts.slice(1).join(' ') : '',
      email: reg.email,
      slug: workshop?.slug ?? '',
    };
    if (reg.country) country = reg.country;
    if (reg.timezone) detectedTz = reg.timezone;
  }
}

const currency = currencyForCountry(country === 'EU' ? null : country);

// Upcoming published workshops + masterclasses, priced in the visitor's
// currency (shared with /masterclass — see lib/workshops/calendar.ts). The
// list always shows every upcoming masterclass plus the 5 nearest workshops
// (capped in buildCalendarItems).
const items = await buildCalendarItems(env.DB, currency, detectedTz);
const hasMasterclass = items.some((it) => it.kind === 'masterclass');
const tzOptions = tzOptionsFor(detectedTz);
---

<Layout
  title="Somatic Vocal Healing Workshop — Sound as the Body's Language | Songdance"
  description="A one-hour live Somatic Vocal Healing workshop with Jacob Vermeulen. Not singing — sounding: one tone, the sound of what's there."
  image="/media/library/svh-retreat-singing-microphone-jacob.webp"
  imageAlt="Jacob sounding at the microphone during a workshop."
>
  <div class="we-site">
    <PromoBanner />
    <WENav />
    <WEHero />
    <WEOpening />
    <WEWhat />
    <WELyric />
    <WETestimonials />
    <WEAbout />
    <WEQuiet />
    <WEMasterclass hasMasterclass={hasMasterclass} />
    <WERegister
      items={items}
      country={country}
      currency={currency}
      detectedTz={detectedTz}
      tzOptions={tzOptions}
      prefill={prefill}
    />
    <DiscoverMore currentHref="/workshop" />
    <WEFooter />
  </div>
</Layout>

<script is:inline>
  // ── Personalization controller (§2) ──────────────────────────────────────
  // State = URL, read once on load. The door-set comes from ?audience=1,3 or a
  // ?campaign= alias — the on-page "Why are you here?" selector is gone (too
  // few people used it), so nothing writes the state back any more; ad and
  // email links carry it, and WERegister reads the same parameter at checkout
  // so a registration is still segmented by lens.
  //
  // The lead lens (priority 1→2→3) supplies H1 / sub / opening accent / reg
  // line + page title, and re-voices the "What you'll experience" cards.
  // Tailoring is a content swap, not a page swap: the masterclass section is
  // shown to everyone regardless of lens.
  (function () {
    var LENS = {
      neutral: {
        title: 'Somatic Vocal Healing Workshop — Sound as the Body’s Language | Songdance',
        h1: 'Your voice knows <em>more</em> than you think.',
        sub: 'A one-hour live workshop in <em>Somatic Vocal Healing</em> — for everything&nbsp;in&nbsp;you that never found a way out.',
        openHead: 'You can feel that something in you is <em>asking to be heard</em> —<br>and, at the same time, kept carefully quiet.',
        accent: '',
        reg: 'Come. One hour. Live.<br>You don’t need any skill, any preparation, anything to prove.<br>You just open your mouth<br>and see what happens.',
      },
      1: {
        title: 'What You’ve Carried Is Allowed to Be Heard — Somatic Vocal Healing | Songdance',
        h1: 'What you’ve carried is allowed <em>to be heard.</em>',
        sub: 'A one-hour live workshop in <em>Somatic Vocal Healing</em> — for the old feeling, the unsaid thing, the part of you that’s been waiting.',
        openHead: 'There’s an old feeling in you that has waited a long time —<br>and it’s <em>asking to be heard.</em>',
        accent: 'You don’t have to explain it, or even understand it. You just have to let it have a sound.',
        reg: 'Come as you are, with whatever you’ve been carrying. You don’t have to do anything with it but let it be heard.',
      },
      2: {
        title: 'What Would Your Voice Do If Nobody Was Judging It? — Somatic Vocal Healing | Songdance',
        h1: 'What would your voice do if <em>nobody was judging it?</em>',
        sub: 'A one-hour live workshop in <em>Somatic Vocal Healing</em> — for the held breath, the careful throat, the sound you hold back before it leaves you.',
        openHead: 'There’s a voice in you that you <em>hold back before it leaves</em> —<br>careful, managed, kept just within bounds.',
        accent: 'Most of us judge the sound before we make it. This is an hour with that judging switched off.',
        reg: 'Nothing to prepare, nothing to prove. Just an hour to hear what your voice does when you stop managing it.',
      },
      3: {
        title: 'Somatic Voice Work You Can Bring to Your Practice — Somatic Vocal Healing | Songdance',
        h1: 'Somatic voice work you can <em>bring to your own practice.</em>',
        sub: 'A one-hour live introduction to <em>Somatic Vocal Healing</em> — a coherent, teachable method that deepens the work you already do with clients and groups.',
        openHead: 'You hold space for other people’s process —<br>and somewhere in you, <em>your own is asking for the same&nbsp;space.</em>',
        accent: 'Maybe you’re here for the people you work with. Maybe, quietly, for yourself too. Both belong here.',
        reg: 'Come and feel the method from the inside first — it’s the only place this work can be taught from.',
      },
    };

    // The four experience beats, re-voiced per lead lens. Same structure for
    // everyone — only the framing shifts to what the visitor said they came for.
    // (Replaces the old single "For you" card: now the whole set speaks to them.)
    var CARDS = {
      neutral: [
        { t: 'An introduction to Somatic Vocal Healing',
          b: 'The method where sound becomes the language of the body — a closer connection to your body, your own sound, and whatever wants to show up underneath.' },
        { t: 'A somatic warm-up with live piano',
          b: 'So your nervous system can arrive before anything else happens — settling, breath widening, listening getting finer.' },
        { t: 'Guided sounding',
          b: 'A somatic practice for giving what’s here a sound — not describing it, sounding it. The healing is in the acknowledgment. And a little more trust in speaking your own truth, at home and at work.' },
        { t: 'A first tool for everyday life',
          b: 'Something to keep coming back to — when something in you is stuck, when your head is too loud, when the day has made you shut down. You can keep practising it on your own after.' },
      ],
      1: [
        { t: 'An introduction to Somatic Vocal Healing',
          b: 'The method where sound becomes a language for what you’ve carried — a gentler way to meet the old feeling than explaining it: you let it have a sound.' },
        { t: 'A somatic warm-up with live piano',
          b: 'So your nervous system can soften and feel safe before anything tender surfaces — settling, breath widening. Nothing is forced.' },
        { t: 'Guided sounding',
          b: 'A somatic practice for letting stuck emotion move through your voice — not by reliving the story, but by letting what’s underneath finally sound and be heard.' },
        { t: 'A first tool for everyday life',
          b: 'Something to come back to when the old feeling resurfaces — not to push it through, but to let it be heard. Acknowledged things leave on their own. Yours to keep practising after.' },
      ],
      2: [
        { t: 'An introduction to Somatic Vocal Healing',
          b: 'The method where sound becomes the language of the body — and the inner judge that manages your voice gets to switch off for an hour.' },
        { t: 'A somatic warm-up with live piano',
          b: 'So your throat can unclench and your breath can widen before you make a sound — the careful holding loosening, the listening getting finer.' },
        { t: 'Guided sounding',
          b: 'A somatic practice for hearing what your voice does when nobody’s judging it. The sound that surprises you is the one worth following.' },
        { t: 'A first tool for everyday life',
          b: 'Something to reach for when you catch yourself holding back — a quick way to stop judging and let your voice out. Yours to keep after.' },
      ],
      3: [
        { t: 'An introduction to Somatic Vocal Healing',
          b: 'A coherent, teachable method where sound becomes the body’s language — felt from the inside, so you know what you’d be offering your clients and groups.' },
        { t: 'A somatic warm-up with live piano',
          b: 'How to help a nervous system arrive before the work begins — the settling, the widening breath, the finer listening you can later hold for others.' },
        { t: 'Guided sounding',
          b: 'The core practice — giving what’s here a sound, not describing it. The healing is in the acknowledgment. Experienced in your own body first, so you can guide it cleanly in your practice.' },
        { t: 'A first tool for everyday life',
          b: 'A practice to keep for yourself — and a first way in you can begin to offer others. Yours to keep practising after.' },
      ],
    };

    var CAMPAIGN_MAP = { healing: [1], freedom: [2], pro: [3] };

    function parseState() {
      var p = new URLSearchParams(location.search);
      var aud = p.get('audience');
      if (aud) {
        return aud.split(',')
          .map(function (s) { return parseInt(s, 10); })
          .filter(function (d) { return d === 1 || d === 2 || d === 3; });
      }
      var camp = (p.get('campaign') || '').toLowerCase();
      if (CAMPAIGN_MAP[camp]) return CAMPAIGN_MAP[camp].slice();
      return [];
    }

    function leadLens(doors) {
      if (doors.indexOf(1) !== -1) return 1;
      if (doors.indexOf(2) !== -1) return 2;
      if (doors.indexOf(3) !== -1) return 3;
      return 'neutral';
    }

    function setSwap(id, html) {
      var el = document.getElementById(id);
      if (el) el.innerHTML = html;
    }

    function apply(doors) {
      // No parameter → the page as rendered already *is* the neutral lens, so
      // there is nothing to swap (and no flash for the visitors who arrive
      // without one, which is most of them).
      if (!doors.length) return;

      var lens = leadLens(doors);
      var data = LENS[lens] || LENS.neutral;

      setSwap('we-h1', data.h1);
      setSwap('we-hero-sub', data.sub);
      setSwap('we-opening-head', data.openHead);
      setSwap('we-opening-accent', data.accent);
      setSwap('we-reg-body', data.reg);
      document.title = data.title;

      // Card copy — every card is rewritten to the lead lens, so the whole
      // "What you'll experience" set speaks in the same voice as the headline.
      var cardSet = CARDS[lens] || CARDS.neutral;
      for (var i = 0; i < cardSet.length; i++) {
        setSwap('we-card-title-' + i, cardSet[i].t);
        setSwap('we-card-body-' + i, cardSet[i].b);
      }

      // The masterclass section itself is always in the page, for everyone.
      // Only its bridge line is lens-specific: it speaks to someone who came
      // through a personal door as well as the practitioner one.
      var bridge = document.getElementById('we-masterclass-bridge');
      var pro = doors.indexOf(3) !== -1;
      var personal = doors.indexOf(1) !== -1 || doors.indexOf(2) !== -1;
      if (bridge) bridge.hidden = !(pro && personal);
    }

    function init() {
      apply(parseState());
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
