---
import Sr26 from '../../../layouts/Sr26.astro';
import { isSr26Authed } from '../../../lib/sr26/gate';
import { SR26_DOCS_SORTED } from '../../../lib/sr26/docs';

export const prerender = false;

const env = Astro.locals.runtime.env;
if (!(await isSr26Authed(Astro.request, env))) {
  return Astro.redirect(`/sr26?next=${encodeURIComponent(Astro.url.pathname)}`);
}
---

<Sr26 title="Somatic Rising — Data room" description="Research and memo behind the concept.">
  <header class="sr26-shell sr26-topbar">
    <a class="sr26-wordmark" href="/sr26">Somatic Rising</a>
    <nav class="sr26-nav">
      <a class="sr26-pill" href="/sr26">← Concept</a>
      <a class="sr26-pill" href="/sr26/why">The case</a>
    </nav>
  </header>

  <main class="sr26-shell dr">
    <p class="dr-kicker">Data room</p>
    <h1 class="dr-title">The research behind the concept</h1>
    <p class="dr-intro">
      The memo tells the story; the three research reports are the evidence under
      it — market size, the competitive whitespace, and the funding and unit
      economics that decide whether the model works.
    </p>

    <div class="dr-list">
      {
        SR26_DOCS_SORTED.map((doc, i) => (
          <a class="dr-card" href={`/sr26/docs/${doc.slug}`}>
            <span class="dr-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="dr-body">
              <span class="dr-kind">{doc.kind}</span>
              <span class="dr-name">{doc.title}</span>
              <span class="dr-blurb">{doc.blurb}</span>
            </span>
            <span class="dr-arrow">→</span>
          </a>
        ))
      }
    </div>
  </main>
</Sr26>

<style>
  .dr {
    padding-top: 56px;
  }
  .dr-kicker {
    font-size: 11.5px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ember);
  }
  .dr-title {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(30px, 5vw, 44px);
    line-height: 1.18;
    margin: 16px 0 16px;
    max-width: 18ch;
  }
  .dr-intro {
    color: var(--cream-dim);
    font-size: 16px;
    line-height: 1.65;
    max-width: 56ch;
  }
  .dr-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 40px;
  }
  .dr-card {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 24px 26px;
    background: var(--ink-3);
    border: 1px solid var(--ink-line);
    border-radius: 18px;
    color: var(--cream);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }
  .dr-card:hover {
    border-color: rgba(217, 154, 108, 0.4);
    background: linear-gradient(150deg, #2c2240, #241b35 70%);
    transform: translateY(-2px);
  }
  .dr-num {
    font-family: var(--display);
    font-size: 15px;
    color: var(--cream-faint);
    padding-top: 3px;
    flex: none;
  }
  .dr-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }
  .dr-kind {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ember);
    opacity: 0.85;
  }
  .dr-name {
    font-family: var(--display);
    font-weight: 400;
    font-size: 21px;
    line-height: 1.25;
  }
  .dr-blurb {
    color: var(--cream-dim);
    font-size: 14px;
    line-height: 1.6;
    max-width: 60ch;
  }
  .dr-arrow {
    color: var(--ember);
    font-size: 18px;
    flex: none;
    padding-top: 2px;
  }
</style>
