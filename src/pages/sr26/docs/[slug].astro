---
import Sr26 from '../../../layouts/Sr26.astro';
import { isSr26Authed } from '../../../lib/sr26/gate';
import { getSr26Doc, SR26_DOCS_SORTED } from '../../../lib/sr26/docs';

export const prerender = false;

const env = Astro.locals.runtime.env;
if (!(await isSr26Authed(Astro.request, env))) {
  return Astro.redirect(`/sr26?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const slug = Astro.params.slug ?? '';
const doc = getSr26Doc(slug);
if (!doc) return Astro.redirect('/sr26/docs');

// All data-room markdown, compiled to components by Astro's markdown pipeline.
const modules = import.meta.glob('../../../data/sr26/*.md', { eager: true });
const entry = Object.entries(modules).find(([path]) =>
  path.endsWith('/' + doc.file),
);
if (!entry) return new Response('Document not found', { status: 404 });
const { Content } = entry[1] as { Content: any };

const idx = SR26_DOCS_SORTED.findIndex((d) => d.slug === slug);
const prev = idx > 0 ? SR26_DOCS_SORTED[idx - 1] : null;
const next =
  idx >= 0 && idx < SR26_DOCS_SORTED.length - 1
    ? SR26_DOCS_SORTED[idx + 1]
    : null;
---

<Sr26 title={`Somatic Rising — ${doc.title}`} description={doc.blurb}>
  <header class="sr26-shell sr26-topbar">
    <a class="sr26-wordmark" href="/sr26">Somatic Rising</a>
    <nav class="sr26-nav">
      <a class="sr26-pill" href="/sr26">Concept</a>
      <a class="sr26-pill" href="/sr26/why">The case</a>
      <a class="sr26-pill" href="/sr26/docs">← Data room</a>
    </nav>
  </header>

  <main class="sr26-shell">
    <p class="doc-kind">{doc.kind}</p>
    <article class="sr26-prose">
      <Content />
    </article>

    <nav class="doc-pager">
      {
        prev ? (
          <a class="doc-pager-link prev" href={`/sr26/docs/${prev.slug}`}>
            <span class="doc-pager-dir">← Previous</span>
            <span class="doc-pager-name">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="doc-pager-link next" href={`/sr26/docs/${next.slug}`}>
            <span class="doc-pager-dir">Next →</span>
            <span class="doc-pager-name">{next.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </main>
</Sr26>

<style>
  .doc-kind {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ember);
    opacity: 0.85;
    margin: 48px 0 0;
  }
  .doc-pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 26px;
    border-top: 1px solid var(--ink-line);
  }
  .doc-pager-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 46%;
  }
  .doc-pager-link.next {
    text-align: right;
    margin-left: auto;
  }
  .doc-pager-dir {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cream-faint);
  }
  .doc-pager-name {
    font-family: var(--display);
    font-size: 16px;
    color: var(--cream);
  }
</style>

<!-- Prose styling for rendered markdown. `is:global` (scoped under
     .sr26-prose) is required because <Content /> outputs raw elements that
     don't receive Astro's scoped-style hashes. -->
<style is:global>
  .sr26-prose {
    color: var(--cream-dim);
    font-size: 16px;
    line-height: 1.72;
    margin-top: 14px;
  }
  .sr26-prose > :first-child {
    margin-top: 0;
  }
  .sr26-prose h1 {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(30px, 5vw, 44px);
    line-height: 1.18;
    color: var(--cream);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .sr26-prose h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.25;
    color: var(--cream);
    margin: 48px 0 16px;
    padding-top: 24px;
    border-top: 1px solid var(--ink-line);
  }
  .sr26-prose h3 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.3;
    color: var(--cream);
    margin: 34px 0 12px;
  }
  .sr26-prose h4 {
    font-family: var(--ui);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ember);
    margin: 28px 0 10px;
  }
  .sr26-prose p {
    margin: 0 0 18px;
  }
  .sr26-prose a {
    color: var(--ember);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(217, 154, 108, 0.4);
  }
  .sr26-prose strong {
    color: var(--cream);
    font-weight: 600;
  }
  .sr26-prose em {
    font-style: italic;
  }
  .sr26-prose ul,
  .sr26-prose ol {
    margin: 0 0 18px;
    padding-left: 1.3em;
  }
  .sr26-prose li {
    margin: 0 0 8px;
  }
  .sr26-prose li::marker {
    color: var(--ember);
  }
  .sr26-prose blockquote {
    margin: 22px 0;
    padding: 4px 0 4px 20px;
    border-left: 2px solid var(--ember);
    font-family: var(--display);
    font-style: italic;
    font-size: 18px;
    color: var(--cream);
  }
  .sr26-prose hr {
    border: none;
    border-top: 1px solid var(--ink-line);
    margin: 40px 0;
  }
  .sr26-prose code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.86em;
    background: rgba(243, 236, 223, 0.07);
    border: 1px solid var(--ink-line);
    border-radius: 5px;
    padding: 1px 6px;
    color: var(--gold);
  }
  .sr26-prose pre {
    background: var(--ink-2);
    border: 1px solid var(--ink-line);
    border-radius: 12px;
    padding: 16px 18px;
    overflow-x: auto;
    margin: 0 0 18px;
  }
  .sr26-prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--cream-dim);
  }
  /* Tables — these reports are table-heavy. */
  .sr26-prose .sr26-table-wrap {
    overflow-x: auto;
    margin: 0 0 22px;
    border: 1px solid var(--ink-line);
    border-radius: 12px;
  }
  .sr26-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    line-height: 1.5;
  }
  .sr26-prose th,
  .sr26-prose td {
    text-align: left;
    padding: 11px 14px;
    border-bottom: 1px solid var(--ink-line);
    vertical-align: top;
  }
  .sr26-prose thead th {
    background: rgba(243, 236, 223, 0.04);
    color: var(--cream);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .sr26-prose tbody tr:last-child td {
    border-bottom: none;
  }
  .sr26-prose tbody tr:hover {
    background: rgba(243, 236, 223, 0.02);
  }
  .sr26-prose td strong {
    color: var(--cream);
  }
</style>

<script>
  // Wrap rendered markdown tables so they can scroll horizontally on narrow
  // screens without breaking the page layout.
  for (const table of document.querySelectorAll('.sr26-prose table')) {
    if (table.parentElement?.classList.contains('sr26-table-wrap')) continue;
    const wrap = document.createElement('div');
    wrap.className = 'sr26-table-wrap';
    table.replaceWith(wrap);
    wrap.appendChild(table);
  }
</script>
