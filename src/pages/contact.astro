---
import SiteLayout from '../components/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<SiteLayout
  title="Contact — Songdance"
  description="Questions are welcome. We read everything and answer like people."
>
  <PageHero
    eyebrow="Contact"
    title="Say hello"
    lede="Questions are welcome. We read everything and answer like people."
  />
  <section class="sd-section sd-prose">
    <div class="sd-prose-inner">
      <p>
        Email <a href="mailto:info@songdance.co">info@songdance.co</a>.
      </p>
      <p>
        Nothing here needs you to be ready. If you're not sure this is for you,
        that's a fine question to send.
      </p>
      <p>
        Songdance BV · Beaupréstraat 13 · 8310 Brugge · Belgium · BE0743575076
      </p>
    </div>
  </section>
</SiteLayout>
