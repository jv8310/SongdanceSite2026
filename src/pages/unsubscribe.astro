---
// Unsubscribe confirm page — the global "send nothing" switch. Linked from the
// footer of every marketing-flavoured lifecycle email (abandoned checkout,
// post-workshop sequences, downsell). GET shows a confirm button (so a
// link-prefetching mail client can't unsubscribe anyone by accident); the
// button POSTs back here. Broadcasts link to /email-preferences instead (topics
// or everything); the one-click List-Unsubscribe header points at
// /api/unsubscribe.
import SiteLayout from '../components/SiteLayout.astro';
import {
  isEmailSuppressed,
  unsubscribeEmail,
  unsubscribeSecret,
  verifyUnsubscribeToken,
} from '../lib/email/unsubscribe';

export const prerender = false;

const env = Astro.locals.runtime.env;
const secret = unsubscribeSecret(env);

let email = '';
let token = '';
let state: 'invalid' | 'confirm' | 'done' | 'already' = 'invalid';

if (Astro.request.method === 'POST') {
  let form: FormData | null = null;
  try {
    form = await Astro.request.formData();
  } catch {
    form = null;
  }
  email = String(form?.get('e') ?? '').trim().toLowerCase();
  token = String(form?.get('t') ?? '').trim();
  if (secret && (await verifyUnsubscribeToken(secret, email, token))) {
    await unsubscribeEmail(env, email, 'link');
    state = 'done';
  }
} else {
  email = (Astro.url.searchParams.get('e') ?? '').trim().toLowerCase();
  token = (Astro.url.searchParams.get('t') ?? '').trim();
  if (secret && (await verifyUnsubscribeToken(secret, email, token))) {
    let suppressed = false;
    try {
      suppressed = await isEmailSuppressed(env.DB, email);
    } catch {
      suppressed = false;
    }
    state = suppressed ? 'already' : 'confirm';
  }
}

const prefsHref = `/email-preferences?e=${encodeURIComponent(email)}&t=${encodeURIComponent(token)}`;
---

<SiteLayout title="Unsubscribe — Songdance" description="" newsletter={false} promo={false}>
  <main class="unsub">
    <section class="unsub-card">
      {state === 'confirm' && (
        <>
          <h1>One less email in your inbox</h1>
          <p>Stop newsletters, announcements and follow-ups to <strong>{email}</strong>?</p>
          <p class="unsub-note">Confirmations and reminders for anything you've booked still reach you.</p>
          <form method="post">
            <input type="hidden" name="e" value={email} />
            <input type="hidden" name="t" value={token} />
            <button type="submit">Unsubscribe me</button>
          </form>
          <p class="unsub-alt">Rather choose which emails you get? <a href={prefsHref}>Choose your topics</a></p>
        </>
      )}
      {(state === 'done' || state === 'already') && (
        <>
          <h1>{state === 'done' ? "Done — you won't hear from us" : "You're unsubscribed"}</h1>
          <p>
            <strong>{email}</strong> won't receive newsletters, announcements or follow-ups from Songdance.
            Confirmations and reminders for anything you've booked still arrive.
          </p>
          <p class="unsub-note">
            Want to hear from us again one day? Write to
            {' '}<a href="mailto:support@songdance.co">support@songdance.co</a> and we'll put you back on the list ourselves.
          </p>
        </>
      )}
      {state === 'invalid' && (
        <>
          <h1>This link looks incomplete</h1>
          <p>
            We couldn't verify the link. Try the link at the bottom of the email again, or write to
            {' '}<a href="mailto:support@songdance.co">support@songdance.co</a> and we'll sort it out for you ourselves.
          </p>
        </>
      )}
    </section>
  </main>
</SiteLayout>

<style>
  .unsub {
    min-height: 60vh;
    display: grid;
    place-items: center;
    padding: 64px 16px;
    background: var(--paper);
  }
  .unsub-card {
    width: 100%;
    max-width: 560px;
    box-sizing: border-box;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 36px 34px;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--ink-soft);
    line-height: 1.65;
  }
  @media (max-width: 520px) {
    .unsub-card { padding: 28px 20px; }
  }
  .unsub-card h1 {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.2;
    color: var(--ink);
  }
  .unsub-card p { margin: 0 0 14px; }
  .unsub-card strong { color: var(--ink); font-weight: 600; word-break: break-word; }
  .unsub-note, .unsub-alt { font-size: 14px; color: var(--ink-quiet); }
  .unsub-alt { margin: 18px 0 0; }
  .unsub-card button {
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 15px;
    border: 0;
    padding: 12px 24px;
    border-radius: 999px;
    cursor: pointer;
  }
  .unsub-card a { color: var(--ember-deep); }
</style>
