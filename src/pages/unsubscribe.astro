---
// Unsubscribe confirm page. Linked from the footer of every marketing-
// flavoured email (abandoned checkout, post-workshop sequences, downsell).
// GET shows a confirm button (so a link-prefetching mail client can't
// unsubscribe anyone by accident); the button POSTs back here.
// The one-click List-Unsubscribe header points at /api/unsubscribe instead.
import Layout from '../layouts/Layout.astro';
import {
  suppressEmail,
  unsubscribeSecret,
  verifyUnsubscribeToken,
} from '../lib/email/unsubscribe';

export const prerender = false;

const env = Astro.locals.runtime.env;
const secret = unsubscribeSecret(env);

let email = '';
let token = '';
let state: 'invalid' | 'confirm' | 'done' = 'invalid';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('e') ?? '').trim().toLowerCase();
  token = String(form.get('t') ?? '').trim();
  if (secret && (await verifyUnsubscribeToken(secret, email, token))) {
    await suppressEmail(env.DB, email, 'link');
    state = 'done';
  }
} else {
  email = (Astro.url.searchParams.get('e') ?? '').trim().toLowerCase();
  token = (Astro.url.searchParams.get('t') ?? '').trim();
  if (secret && (await verifyUnsubscribeToken(secret, email, token))) {
    state = 'confirm';
  }
}
---

<Layout title="Unsubscribe — Songdance" description="">
  <main class="unsub">
    <section class="unsub-card">
      {state === 'confirm' && (
        <>
          <h1>One tone less in your inbox</h1>
          <p>
            Stop the workshop follow-up emails to <strong>{email}</strong>?
          </p>
          <p class="unsub-note">
            Booking confirmations and session reminders for things you've
            registered for will still reach you.
          </p>
          <form method="post">
            <input type="hidden" name="e" value={email} />
            <input type="hidden" name="t" value={token} />
            <button type="submit">Unsubscribe me</button>
          </form>
        </>
      )}
      {state === 'done' && (
        <>
          <h1>Done — you won't hear from us</h1>
          <p>
            <strong>{email}</strong> won't receive any more emails like the one
            that brought you here. Booking confirmations and session reminders
            still arrive for anything you've registered for.
          </p>
          <p class="unsub-note">
            Changed your mind one day? Registering for any workshop puts you
            back in touch. The door doesn't disappear.
          </p>
        </>
      )}
      {state === 'invalid' && (
        <>
          <h1>This link looks incomplete</h1>
          <p>
            We couldn't verify the unsubscribe link. Try the link at the bottom
            of the email again, or write to
            <a href="mailto:info@songdance.co">info@songdance.co</a> and we'll
            take care of it by hand.
          </p>
        </>
      )}
    </section>
  </main>

  <style>
    .unsub {
      min-height: 60vh;
      display: grid;
      place-items: center;
      padding: 64px 16px;
      background: #f4ecdf;
    }
    .unsub-card {
      max-width: 480px;
      background: #fbf6ec;
      border: 1px solid rgba(161, 72, 38, 0.22);
      border-radius: 14px;
      padding: 36px 34px;
      font-family: Georgia, 'Times New Roman', serif;
      color: #4a3848;
      line-height: 1.65;
    }
    .unsub-card h1 {
      margin: 0 0 14px;
      font-weight: 400;
      font-size: 26px;
      line-height: 1.2;
      color: #2a1b2a;
    }
    .unsub-card p { margin: 0 0 14px; }
    .unsub-note { font-size: 14px; color: #6f5f6d; }
    .unsub-card button {
      background: #2a1b2a;
      color: #f4ecdf;
      font-family: Georgia, serif;
      font-size: 15px;
      border: 0;
      padding: 14px 26px;
      border-radius: 999px;
      cursor: pointer;
    }
    .unsub-card a { color: #a14826; }
  </style>
</Layout>
