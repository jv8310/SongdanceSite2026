---
import SiteLayout from '../components/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import WorkBlock from '../components/WorkBlock.astro';
import LyricBreak from '../components/LyricBreak.astro';
import OfferingsGrid from '../components/OfferingsGrid.astro';
import Gallery from '../components/Gallery.astro';
import LineageBlock from '../components/LineageBlock.astro';
import RetreatBand from '../components/RetreatBand.astro';
import SongdeckBand from '../components/SongdeckBand.astro';
import Upcoming from '../components/Upcoming.astro';
import ForgivenessBand from '../components/ForgivenessBand.astro';
import SoundSignatures from '../components/sound/SoundSignatures.astro';
---

<SiteLayout>
  <Hero />
  <WorkBlock />
  <!-- The answer to WorkBlock's question, drawn: the page's first dark moment. -->
  <SoundSignatures
    tone="plum"
    eyebrow="Reading the sound"
    heading="Patterns you can <em>hear</em>"
    link={{ href: '/what-is-svh#map', label: 'There is a map →' }}
    revealAttrs={{ 'data-anim': 'reveal' }}
  />
  <LyricBreak />
  <OfferingsGrid />
  <ForgivenessBand />
  <LyricBreak text="Nobody here will ask you to scream. Soft counts. Quiet people welcome." />
  <Gallery />
  <LineageBlock />
  <RetreatBand />
  <SongdeckBand />
  <Upcoming />
</SiteLayout>

<script>
  import '../scripts/animations.ts';
</script>
