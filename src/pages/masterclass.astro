---
import SiteLayout from '../components/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SoftCta from '../components/SoftCta.astro';

const takeaways = [
  'The core distinction — sounding vs. singing — and why it matters in a professional setting.',
  'How to bring voice and sound into one-on-one sessions, groups, and rooms that have gone tense.',
  'The space-holder stance: how to be present without taking on, fixing, or steering.',
  'Where this fits — and honestly where it doesn’t — alongside the work you already do.',
];
---

<SiteLayout
  title="Professional Masterclass — 29€ — Songdance"
  description="A masterclass for therapists, coaches, bodyworkers, facilitators, teachers, and leaders: what sound can do when words run out. 29€."
>
  <PageHero
    eyebrow="For professionals · 29€"
    title="Somatic Vocal Healing in your work"
    lede="A masterclass for therapists, coaches, bodyworkers, facilitators, teachers, and leaders."
    image="/media/library/svh-retreat-portrait-jacob-teaching.webp"
  >
    <div class="sd-pagehero-actions">
      <a href="/events?filter=online" class="sd-btn sd-btn-primary">Reserve a seat</a>
    </div>
  </PageHero>

  <section class="sd-section sd-prose">
    <div class="sd-prose-inner">
      <p>
        If you already hold space for other people, you know the moment a conversation stalls —
        when more words won’t move it, and the room needs something else. This masterclass is
        about what sound can do in exactly that moment.
      </p>
      <p>
        You’ll see how one question — <em>“what’s the sound of that?”</em> — can move a stuck
        process faster and more honestly than another round of talking. Not as a replacement for
        your training, but as something that sits underneath all of it: a way to let the body
        speak when the mind has run out of road.
      </p>
    </div>
  </section>

  <section class="sd-section sd-prose sd-prose--feature">
    <div class="sd-prose-inner">
      <h2 class="sd-prose-h">What you’ll take away</h2>
      <ul class="sd-prose-list">
        {takeaways.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="sd-section sd-prose">
    <div class="sd-prose-inner">
      <h2 class="sd-prose-h">Who it’s for</h2>
      <p>
        Psychotherapists, body and movement practitioners, yoga and meditation teachers, coaches,
        facilitators, and people who lead. Useful whether or not you ever intend to teach sounding
        formally.
      </p>
      <h2 class="sd-prose-h">Practical</h2>
      <p>29€ · online · live, with replay.</p>
    </div>
  </section>

  <SoftCta
    text="This is the doorway to the practitioner path."
    ctaLabel="Practitioner Training →"
    ctaHref="/certification-course"
    altLabel="Try a workshop first — 6€"
    altHref="/workshop"
  />
</SiteLayout>
