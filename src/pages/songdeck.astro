---
import SiteLayout from '../components/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SoftCta from '../components/SoftCta.astro';
---

<SiteLayout
  title="Songdeck — Songdance"
  description="The songs and mantras from the work, without guidance or words — just the music, to sound or sit with on your own."
>
  <PageHero
    eyebrow="Music"
    title="Songdeck"
    lede="The music and the mantras, nothing in the way."
  >
    <div class="sd-pagehero-actions">
      <a href="/contact" class="sd-btn sd-btn-primary">Ask about access</a>
    </div>
  </PageHero>

  <section class="sd-section sd-prose">
    <div class="sd-prose-inner">
      <p>
        The songs and mantras from the work, without guidance or words — just the music, to sound
        or sit with on your own. Where Authentic Singing guides you, Songdeck simply plays.
      </p>
    </div>
  </section>

  <SoftCta />
</SiteLayout>
