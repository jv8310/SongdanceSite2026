---
import SiteLayout from '../components/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SoftCta from '../components/SoftCta.astro';

// Anonymous quotes carry no avatar — a real face under anonymised words
// would defeat the anonymisation (copy book: consent before publishing).
const reviews = [
  ['Rebecca Lucy', 'USA', 'I came for the voice and left with something steadier underneath it.', '/media/library/ritual-rebecca.jpg'],
  ['Monike', 'Netherlands', 'The honesty of it is the point. Nothing here is performance.', ''],
  ['Dr. Karen Evans', 'USA', 'A rigorous, kind way of working that fits beside clinical practice.', '/media/library/workshop-karen.webp'],
  ['Gwenola Emilia Enciu', 'Romania', 'I finally have a practice I can return to on my own, for life.', '/media/library/workshop-gwenola.jpg'],
  ['Workshop participant', 'Belgium', 'An hour in, I made a sound I’d been holding for years. Then I could breathe.', ''],
  ['Course student', 'Germany', 'Since learning this, I catch myself the moment I’m not being fully honest — I hear it in my own voice.', ''],
];
---

<SiteLayout
  title="Reviews — Songdance"
  description="In their words. A few words from people who've done the work — and verified reviews on Trustpilot."
>
  <PageHero
    eyebrow="Reviews"
    title="In their words"
    lede="A few words from people who’ve done the work."
    image="/media/library/svh-retreat-circle-yurt-wide.webp"
  />

  <section class="sd-section sd-prose">
    <div class="sd-prose-inner">
      <div class="sd-quotes">
        {reviews.map(([name, place, quote, avatar]) => (
          <figure class="sd-quote-card">
            <blockquote>{quote}</blockquote>
            <figcaption>
              {avatar && <img class="sd-quote-avatar" src={avatar} alt={name} loading="lazy" width="44" height="44" />}
              <span class="sd-quote-who">{name} · <span>{place}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="sd-quotes-link">
        <a href="https://www.trustpilot.com/review/songdance.co" target="_blank" rel="noopener">
          Read verified reviews on Trustpilot →
        </a>
      </p>
    </div>
  </section>

  <section class="sd-section sd-about-quote">
    <div class="sd-eyebrow" style="text-align:center; margin-bottom: var(--sp-4);">No miracles, on purpose</div>
    <p class="t-lyric sd-about-quote-text">
      “You might first feel worse rather than better. What’s on the other end is a
      different flavor of peace — more lasting, more structurally embedded.”
    </p>
    <p class="sd-quotes-attrib">— Jacob</p>
  </section>

  <SoftCta />
</SiteLayout>
