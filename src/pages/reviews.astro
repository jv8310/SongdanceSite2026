---
import SiteLayout from '../components/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SoftCta from '../components/SoftCta.astro';

const reviews = [
  ['Rebecca Lucy', 'USA', 'I came for the voice and left with something steadier underneath it.', '/media/library/ritual-rebecca.webp'],
  ['Monike', 'Netherlands', 'The honesty of it is the point. Nothing here is performance.', '/media/library/workshop-anna.webp'],
  ['Dr. Karen Evans', 'USA', 'A rigorous, kind way of working that fits beside clinical practice.', '/media/library/workshop-karen.webp'],
  ['Gwenola Emilia Enciu', 'Romania', 'I finally have a practice I can return to on my own, for life.', '/media/library/workshop-gwenola.webp'],
  ['Workshop participant', 'Belgium', 'An hour in, I made a sound I’d been holding for years. Then I could breathe.', '/media/library/workshop-isabelle.webp'],
  ['Course student', 'Germany', 'Not a quick lift — a steadier kind of peace. More lasting.', '/media/library/workshop-olena.webp'],
];
---

<SiteLayout
  title="Reviews — Songdance"
  description="In their words. A few notes from people who've done the work — and verified reviews on Trustpilot."
>
  <PageHero
    eyebrow="Reviews"
    title="In their words"
    lede="A few notes from people who’ve done the work."
    image="/media/library/svh-retreat-circle-yurt-wide.webp"
  />

  <section class="sd-section sd-prose">
    <div class="sd-prose-inner">
      <div class="sd-quotes">
        {reviews.map(([name, place, quote, avatar]) => (
          <figure class="sd-quote-card">
            <blockquote>{quote}</blockquote>
            <figcaption>
              {avatar && <img class="sd-quote-avatar" src={avatar} alt={name} loading="lazy" width="44" height="44" />}
              <span class="sd-quote-who">{name} · <span>{place}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="sd-quotes-link">
        <a href="https://www.trustpilot.com/review/songdance.co" target="_blank" rel="noopener">
          Read verified reviews on Trustpilot →
        </a>
      </p>
    </div>
  </section>

  <SoftCta />
</SiteLayout>
