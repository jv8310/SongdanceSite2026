---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import '../styles/intake.css';

import { resolveEventWithDb } from '../lib/intake/events';
import { resolveLocale, SHARED, STEP_COPY } from '../lib/intake/copy';
import { STEPS } from '../lib/intake/steps';
import { getInvitationByToken } from '../lib/intake/invitations';
import { getRetreat } from '../lib/intake/retreats-db';
import {
  intakeStepsWithTransport,
  transportOnlySteps,
} from '../lib/intake/transport';
import { transportSectionForIntake } from '../lib/intake/send';
import { readCookie, verifySession } from '../lib/registrations/auth';

const url = new URL(Astro.request.url);
const rawEvent = url.searchParams.get('event');
const rawLocale = url.searchParams.get('taal') ?? url.searchParams.get('lang');
const rawToken = url.searchParams.get('inv');
// ?only=transport — the retreat's travel questions on their own, for a guest
// who already sent the intake (the "travel questions" email links here).
const rawOnly = url.searchParams.get('only');
// ?preview=draft — an admin trying the unpublished travel questions Claude
// drafted on the retreat page. Only with a valid admin session; nothing is
// saved (the client never posts in preview).
const wantsDraft = url.searchParams.get('preview') === 'draft';

const db = Astro.locals.runtime?.env?.DB as D1Database | undefined;

// If a token is present and valid, we let the invitation drive the
// event + locale (and prefill the email / name). The invite locale on
// the retreat trumps the URL ?taal parameter so the invitee always
// reaches the form in the language we sent them.
let inviteToken: string | null = null;
let prefill: { email?: string; full_name?: string } = {};
let invitationEventCode: string | null = null;
let invitationLocale: 'nl' | 'en' | null = null;

if (rawToken && db) {
  const invitation = await getInvitationByToken(db, rawToken).catch(() => null);
  if (invitation) {
    inviteToken = invitation.token;
    invitationEventCode = invitation.retreat_slug;
    // The whole name when the invitation came from a booking (migration
    // 0085), else the first name it was pasted with.
    const prefillName = invitation.full_name || invitation.first_name;
    prefill = {
      email: invitation.email,
      ...(prefillName ? { full_name: prefillName } : {}),
    };
    const retreat = await getRetreat(db, invitation.retreat_slug).catch(() => null);
    if (retreat) {
      invitationLocale = retreat.invite_locale === 'en' ? 'en' : 'nl';
    }
  }
}

const eventCodeForResolve = invitationEventCode ?? rawEvent;
const event = await resolveEventWithDb(db, eventCodeForResolve);
const locale = invitationLocale ?? resolveLocale(rawLocale);
const otherLocale = locale === 'nl' ? 'en' : 'nl';

const shared = SHARED[locale];

// The retreat's own travel questions (lib/intake/transport.ts), if it has any:
// spliced into the intake, or — with ?only=transport — the whole form.
const runtimeEnv = Astro.locals.runtime?.env;
const previewDraft =
  wantsDraft && runtimeEnv
    ? await verifySession(runtimeEnv.ADMIN_SESSION_SECRET, readCookie(Astro.request)).catch(() => false)
    : false;
const transport = db
  ? await transportSectionForIntake(db, event.code, { draft: !!previewDraft })
  : null;
const mode: 'full' | 'transport' = rawOnly === 'transport' && transport ? 'transport' : 'full';
const { steps, copy } =
  mode === 'transport' && transport
    ? transportOnlySteps(STEPS, STEP_COPY[locale], transport, locale)
    : intakeStepsWithTransport(STEPS, STEP_COPY[locale], transport, locale);

const eventLabel = event.label[locale];

// Build the URL for the language toggle, preserving event + token + mode.
const langSwitchParams = new URLSearchParams();
if (rawEvent) langSwitchParams.set('event', rawEvent);
if (rawToken) langSwitchParams.set('inv', rawToken);
if (mode === 'transport') langSwitchParams.set('only', 'transport');
if (previewDraft) langSwitchParams.set('preview', 'draft');
langSwitchParams.set('taal', otherLocale);
const langSwitchUrl = `/intake?${langSwitchParams.toString()}`;

const prefilledKeys = Object.entries(prefill)
  .filter(([, v]) => typeof v === 'string' && v.trim() !== '')
  .map(([k]) => k);

// Config blob the client script will read on boot.
const config = {
  locale,
  mode,
  preview: !!previewDraft,
  eventCode: event.code,
  eventLabel,
  inviteToken,
  prefill,
  prefilledKeys,
  shared: {
    // progressOf is recreated client-side — JSON can't carry functions.
    brand: shared.brand,
    navHome: shared.navHome,
    langSwitchTo: shared.langSwitchTo,
    next: shared.next,
    back: shared.back,
    submit: shared.submit,
    required: shared.required,
    emailInvalid: shared.emailInvalid,
    numberInvalid: shared.numberInvalid,
    selectOne: shared.selectOne,
    consentRequired: shared.consentRequired,
    submittingTitle: shared.submittingTitle,
    submittingBody: shared.submittingBody,
    errorTitle: shared.errorTitle,
    errorBody: shared.errorBody,
    errorRetry: shared.errorRetry,
    forEventLabel: shared.forEventLabel,
    optional: shared.optional,
    crisisNote: shared.crisisNote,
  },
  steps,
  copy: previewDraft
    ? {
        ...copy,
        done: {
          title: locale === 'nl' ? 'Voorbeeld — er is niets verstuurd.' : 'Preview — nothing was sent.',
          body:
            locale === 'nl'
              ? 'Dit is het ontwerp van de reisvragen. Gasten zien het pas wanneer het op de retraitepagina gepubliceerd is.'
              : 'This is the draft of the travel questions. Guests only see it once it is published on the retreat page.',
        },
      }
    : copy,
  apiUrl: '/api/intake/submit',
  homeUrl: 'https://songdance.co',
  langSwitchUrl,
};

const pageTitle =
  mode === 'transport'
    ? locale === 'nl'
      ? `Reisgegevens — ${eventLabel} — Songdance`
      : `Travel details — ${eventLabel} — Songdance`
    : `Intake — ${eventLabel} — Songdance`;
const pageDescription =
  mode === 'transport'
    ? locale === 'nl'
      ? 'Een paar praktische vragen over je reis. Een paar minuten.'
      : 'A few practical questions about your journey. A couple of minutes.'
    : locale === 'nl'
      ? 'Een eerste kennismaking voor je deelname. Vijftien minuten, zorgvuldig gelezen.'
      : 'A first meeting before you join. Fifteen minutes, read with care.';
const headerLabel =
  mode === 'transport'
    ? locale === 'nl' ? 'Reisgegevens voor' : 'Travel details for'
    : shared.forEventLabel;
// The server-rendered first screen, before the client takes over.
const firstScreen = copy[steps[0]?.key ?? 'welcome'] ?? copy.welcome;
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="in-shell" lang={locale}>
    <header class="in-header">
      <a class="in-header-brand" href={config.homeUrl}>{shared.brand}</a>
      <span class="in-header-event">{headerLabel}: {eventLabel}</span>
      <a class="in-header-lang" href={langSwitchUrl} aria-label={shared.langSwitchTo}>
        {shared.langSwitchTo}
      </a>
    </header>

    {previewDraft && (
      <p class="in-preview-banner">
        Draft preview — these are the unpublished travel questions. Nothing you enter here is saved.
      </p>
    )}

    <div class="in-progress-wrap">
      <div class="in-progress-track" aria-hidden="true">
        <div class="in-progress-fill" id="intake-progress-fill" style="width: 0%"></div>
      </div>
      <div class="in-progress-label" id="intake-progress-label"></div>
    </div>

    <main class="in-main">
      <div id="intake-step-root">
        <!-- Server-rendered skeleton: the welcome screen. Client takes over. -->
        <div class="in-step">
          <h1>{firstScreen?.title}</h1>
          <p class="in-body">{firstScreen?.body}</p>
        </div>
      </div>
    </main>

    <footer class="in-footer" id="intake-footer"></footer>
  </div>

  <script
    type="application/json"
    id="intake-config"
    set:html={JSON.stringify(config)}
  />
  <script>
    import '../scripts/intake-form';
  </script>
</Layout>
