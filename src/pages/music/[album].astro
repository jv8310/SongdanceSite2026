---
import SiteLayout from '../../components/SiteLayout.astro';
import { readCookie, verifySession } from '../../lib/registrations/auth';
import {
  hasAlbumAccess,
  readListenerCookie,
  signedStreamUrl,
  verifyListener,
} from '../../lib/music/access';
import {
  albumCoverUrl,
  formatDuration,
  getAlbum,
  listTracks,
  type MusicTrackRow,
} from '../../lib/music/db';
import { albumCurrencyForCountry, albumPriceLabel } from '../../lib/music/product';
import { paypalConfigured } from '../../lib/payments/paypal';
import { COUNTRIES } from '../../lib/countries';
import { edgeCountry } from '../../lib/geo';

export const prerender = false;

// The buyer-only album player. Access is the email used at checkout — the
// buyer carries the album's Drip tag, so the gate below checks the tag and
// sets the signed sd_music cookie (see src/lib/music/access.ts). Admins are
// always let in (and are the only ones who can see an unpublished album).
const env = Astro.locals.runtime.env;
const slug = Astro.params.album ?? '';
const album = await getAlbum(env.DB, slug);

const isAdmin = await verifySession(env.ADMIN_SESSION_SECRET, readCookie(Astro.request));
if (!album || (album.published !== 1 && !isAdmin)) {
  return new Response('Not found', { status: 404 });
}

const listenerEmail = await verifyListener(
  env.ADMIN_SESSION_SECRET,
  readListenerCookie(Astro.request),
);
const granted =
  isAdmin || (listenerEmail ? await hasAlbumAccess(env, env.DB, listenerEmail, album) : false);

// Purchasable? (price set in admin). The buyer's edge-detected country picks
// the opening currency; the checkout form's own country select re-derives it
// client-side from the same ratios, and the server derives it a third time at
// charge — all through albumPriceCents, so the three can never disagree.
// `?welcome=1` is the return leg from a successful checkout: the page then
// leads with "payment received — enter the email you paid with" (the paid
// registration row grants instantly, no Drip round-trip needed).
const priceEurCents = album.price_eur_cents ?? 0;
const forSale = priceEurCents > 0;
const geoCountry = edgeCountry(Astro.locals);
const currency = albumCurrencyForCountry(geoCountry);
const priceLabel = forSale ? albumPriceLabel(priceEurCents, currency) : null;
const welcome = Astro.url.searchParams.get('welcome') === '1';
const paypalOk = paypalConfigured(env) && env.PAYPAL_ENABLED === 'true';

const cover = albumCoverUrl(album);
// Track titles show to everyone (the sales page lists them as the contents of
// the album); the signed stream URLs — the actual audio — only mint for
// entitled listeners.
const tracks: MusicTrackRow[] = await listTracks(env.DB, album.id);
let payload: Array<{ id: string; title: string; duration: number | null; url: string }> = [];
if (granted) {
  payload = await Promise.all(
    tracks.map(async (t) => ({
      id: t.id,
      title: t.title,
      duration: t.duration_seconds,
      url: await signedStreamUrl(env.ADMIN_SESSION_SECRET, t.id),
    })),
  );
}

const totalSeconds = tracks.reduce((sum, t) => sum + (t.duration_seconds ?? 0), 0);
const totalLabel =
  totalSeconds > 0
    ? totalSeconds >= 3600
      ? `${Math.floor(totalSeconds / 3600)} h ${Math.round((totalSeconds % 3600) / 60)} min`
      : `${Math.round(totalSeconds / 60)} min`
    : '';
---

<SiteLayout
  title={`${album.title} — Songdance`}
  description={
    granted
      ? 'Your album, ready to play.'
      : album.description ??
        `${album.title} — original music from the practice, streaming on any device.`
  }
  image={cover ?? undefined}
  newsletter={false}
  promo={false}
>
  {granted ? (
    <Fragment>
    <section class="mp sd-section">
      {isAdmin && album.published !== 1 && (
        <p class="mp-adminnote">Hidden album — only admins can see this page right now.</p>
      )}
      {isAdmin && !listenerEmail && (
        <p class="mp-adminnote">Admin preview — buyers see exactly this once their email carries the album's tag.</p>
      )}
      <header class="mp-head">
        {cover && <img class="mp-cover" src={cover} alt={`${album.title} — cover`} />}
        <div class="mp-head-text">
          <p class="mp-eyebrow">Album</p>
          <h1 class="mp-title">{album.title}</h1>
          {album.description && <p class="mp-desc">{album.description}</p>}
          <p class="mp-facts">
            {tracks.length} track{tracks.length === 1 ? '' : 's'}{totalLabel && ` · ${totalLabel}`}
          </p>
          <button type="button" class="sd-btn sd-btn-primary mp-playall" data-play-all disabled={tracks.length === 0}>
            <i class="ph-light ph-play"></i>
            Play
          </button>
        </div>
      </header>

      {tracks.length === 0 ? (
        <p class="mp-empty">The tracks are still on their way — check back shortly.</p>
      ) : (
        <ol class="mp-list" data-list>
          {tracks.map((t, i) => (
            <li>
              <button type="button" class="mp-row" data-row data-index={i}>
                <span class="mp-row-n" data-row-n>{i + 1}</span>
                <span class="mp-row-play" aria-hidden="true">
                  <i class="ph-light ph-play" data-row-icon></i>
                </span>
                <span class="mp-row-title">{t.title}</span>
                <span class="mp-row-time" data-row-time>{formatDuration(t.duration_seconds)}</span>
              </button>
            </li>
          ))}
        </ol>
      )}

      <p class="mp-note">
        This page is yours — it opens with the email you used at checkout, on any device.
      </p>
    </section>

    <div class="mp-bar" data-bar hidden>
      <div class="mp-bar-inner">
        <div class="mp-bar-meta">
          {cover && <img src={cover} alt="" class="mp-bar-cover" />}
          <span class="mp-bar-title" data-bar-title></span>
        </div>
        <div class="mp-bar-controls">
          <button type="button" class="mp-ctl" data-prev aria-label="Previous track">
            <i class="ph-light ph-skip-back"></i>
          </button>
          <button type="button" class="mp-ctl mp-ctl-play" data-toggle aria-label="Play or pause">
            <i class="ph-light ph-play" data-toggle-icon></i>
          </button>
          <button type="button" class="mp-ctl" data-next aria-label="Next track">
            <i class="ph-light ph-skip-forward"></i>
          </button>
        </div>
        <div class="mp-bar-seek">
          <span class="mp-time" data-time-now>0:00</span>
          <input
            type="range"
            class="mp-seek"
            data-seek
            min="0"
            max="1000"
            value="0"
            step="1"
            aria-label="Seek"
          />
          <span class="mp-time" data-time-total>0:00</span>
        </div>
      </div>
    </div>

    <script
      type="application/json"
      id="mp-data"
      set:html={JSON.stringify({ title: album.title, cover, tracks: payload }).replace(/</g, '\\u003c')}
    />
    </Fragment>
  ) : forSale && !welcome ? (
    <Fragment>
    <section class="ms sd-section" data-price-eur={priceEurCents}>
      <!-- Hero: the album as a product -->
      <header class="ms-hero">
        {cover && <img class="ms-cover" src={cover} alt={`${album.title} — cover`} />}
        <div class="ms-hero-text">
          <p class="mp-eyebrow">Album</p>
          <h1 class="ms-title">{album.title}</h1>
          {album.description && <p class="ms-desc">{album.description}</p>}
          <p class="ms-facts">
            {tracks.length} track{tracks.length === 1 ? '' : 's'}{totalLabel && ` · ${totalLabel}`}
            · streaming, on any device · yours to keep
          </p>
          <div class="ms-hero-buy">
            <span class="ms-price" data-price-current>{priceLabel}</span>
            <a class="sd-btn sd-btn-primary" href="#get">
              Get the album
              <i class="ph-light ph-arrow-down"></i>
            </a>
          </div>
          <p class="ms-own-hint">
            Already own this album? <a href="#open">Open it with your email</a>
          </p>
        </div>
      </header>

      <!-- The tracks -->
      {tracks.length > 0 && (
        <div class="ms-tracks">
          <h2 class="ms-h2">On this album</h2>
          <ol class="ms-tracklist">
            {tracks.map((t, i) => (
              <li class="ms-track">
                <span class="ms-track-n">{i + 1}</span>
                <span class="ms-track-title">{t.title}</span>
                <span class="ms-track-time">{formatDuration(t.duration_seconds)}</span>
              </li>
            ))}
          </ol>
        </div>
      )}

      <!-- Checkout -->
      <div class="ms-checkout" id="get">
        <div class="ms-checkout-card">
          <p class="mp-eyebrow">Get the album</p>
          <h2 class="ms-checkout-title">
            {album.title} — <span data-price-current>{priceLabel}</span>
          </h2>
          <ul class="ms-points">
            <li><i class="ph-light ph-device-mobile-speaker"></i> Stream it anywhere — phone, tablet, computer</li>
            <li><i class="ph-light ph-infinity"></i> Yours to keep, no subscription</li>
            <li><i class="ph-light ph-envelope-simple"></i> Opens with your email right after payment</li>
          </ul>
          <form class="mp-buy-form" data-buy-form>
            <div class="mp-buy-grid">
              <input type="text" name="first_name" placeholder="First name" autocomplete="given-name" required maxlength="100" />
              <input type="text" name="last_name" placeholder="Last name" autocomplete="family-name" required maxlength="100" />
              <input type="email" name="email" placeholder="you@somewhere" autocomplete="email" required maxlength="254" class="mp-buy-span" />
              <select name="country" required class="mp-buy-span" aria-label="Country" data-buy-country>
                <option value="" disabled selected={!geoCountry}>Your country</option>
                {COUNTRIES.map((c) => (
                  <option value={c.code} selected={c.code === geoCountry}>{c.name}</option>
                ))}
              </select>
            </div>
            <label class="mp-buy-terms">
              <input type="checkbox" name="consent_terms" required />
              <span>
                I agree to the <a href="/terms" target="_blank" rel="noopener">terms</a> &amp;{' '}
                <a href="/privacy" target="_blank" rel="noopener">privacy policy</a>.
              </span>
            </label>
            <div class="mp-buy-actions">
              <button type="submit" class="sd-btn sd-btn-primary" data-buy-submit data-provider="stripe">
                <span>Pay by card — <span data-price-current>{priceLabel}</span></span>
                <i class="ph-light ph-arrow-right"></i>
              </button>
              {paypalOk && (
                <button type="submit" class="sd-btn mp-buy-paypal" data-buy-submit data-provider="paypal">
                  Pay with PayPal
                </button>
              )}
            </div>
            <p class="ms-currency-note">
              Charged in your local currency — pick your country above and the price follows.
            </p>
            <p class="mp-gate-error" hidden role="alert" data-buy-error></p>
          </form>
        </div>
      </div>

      <!-- Already own it -->
      <div class="ms-own" id="open">
        <h2 class="ms-h2">Already own this album?</h2>
        <p class="ms-own-p">
          It opens with the email from your order — nothing else needed.
        </p>
        <form class="mp-gate-form ms-own-form" data-gate-form>
          <input type="text" name="hp" class="mp-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="mp-gate-row">
            <input
              type="email"
              name="email"
              class="mp-gate-input"
              placeholder="you@somewhere"
              aria-label="Email address"
              autocomplete="email"
              required
            />
            <button type="submit" class="sd-btn sd-btn-primary" data-gate-submit>
              <span data-gate-label>Open the album</span>
              <i class="ph-light ph-arrow-right"></i>
            </button>
          </div>
          <p class="mp-gate-error" hidden role="alert" data-gate-error></p>
        </form>
        <p class="mp-gate-help">
          Not opening? Try the email you used at checkout — or write to
          <a href="mailto:support@songdance.co">support@songdance.co</a> and we'll help you personally.
        </p>
      </div>
    </section>
    </Fragment>
  ) : (
    <section class="mp-gate sd-section">
      <div class="mp-gate-card">
        {cover && <img class="mp-gate-cover" src={cover} alt={`${album.title} — cover`} />}
        <p class="mp-eyebrow">{welcome ? 'Payment received' : 'Your album'}</p>
        <h1 class="mp-gate-title">{album.title}</h1>
        {welcome ? (
          <p class="mp-gate-p">
            Thank you — the album is yours. Enter the email you just paid with and it opens
            right here.
          </p>
        ) : (
          <p class="mp-gate-p">
            Already yours? Enter the email you used at checkout and the album opens right here.
          </p>
        )}
        <form class="mp-gate-form" data-gate-form>
          <input type="text" name="hp" class="mp-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="mp-gate-row">
            <input
              type="email"
              name="email"
              class="mp-gate-input"
              placeholder="you@somewhere"
              aria-label="Email address"
              autocomplete="email"
              required
            />
            <button type="submit" class="sd-btn sd-btn-primary" data-gate-submit>
              <span data-gate-label>Open the album</span>
              <i class="ph-light ph-arrow-right"></i>
            </button>
          </div>
          <p class="mp-gate-error" hidden role="alert" data-gate-error></p>
        </form>
        <p class="mp-gate-help">
          Not opening? Try the email you used at checkout — or write to
          <a href="mailto:support@songdance.co">support@songdance.co</a> and we'll help you personally.
        </p>
      </div>

    </section>
  )}
</SiteLayout>

<style>
  /* ---------- Player ---------- */
  .mp { max-width: 760px; margin: 0 auto; padding-bottom: 120px; }
  .mp-adminnote {
    font-size: var(--t-body-sm);
    color: var(--ember-deep);
    background: var(--ember-glow);
    border: 1px solid var(--ember-soft);
    border-radius: var(--r-md);
    padding: 10px 14px;
    margin: 0 0 var(--sp-5);
  }
  .mp-head {
    display: flex;
    gap: var(--sp-6);
    align-items: flex-end;
    margin-bottom: var(--sp-7);
  }
  @media (max-width: 640px) {
    .mp-head { flex-direction: column; align-items: flex-start; gap: var(--sp-5); }
  }
  .mp-cover {
    width: 220px;
    height: 220px;
    object-fit: cover;
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-2);
    flex: 0 0 auto;
  }
  .mp-eyebrow {
    font-family: var(--font-body);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--ember-deep);
    font-weight: 500;
    margin: 0 0 var(--sp-2);
  }
  .mp-title {
    font-family: var(--font-display);
    font-size: var(--t-h1, var(--t-h2));
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    color: var(--ink);
    font-weight: 400;
    margin: 0 0 var(--sp-3);
  }
  .mp-desc { color: var(--ink-soft); margin: 0 0 var(--sp-3); max-width: 52ch; }
  .mp-facts { color: var(--ink-quiet); font-size: var(--t-body-sm); margin: 0 0 var(--sp-4); }
  .mp-playall { gap: 8px; }

  .mp-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .mp-row {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    width: 100%;
    padding: 14px var(--sp-5);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-lg, var(--r-md));
    cursor: pointer;
    font: inherit;
    text-align: left;
    color: var(--ink);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .mp-row:hover { border-color: var(--ember); }
  .mp-row.is-current { border-color: var(--ember); background: var(--ember-glow); }
  .mp-row-n {
    flex: 0 0 22px;
    text-align: right;
    color: var(--ink-quiet);
    font-size: var(--t-body-sm);
    font-variant-numeric: tabular-nums;
  }
  .mp-row-play {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--line-strong, var(--line));
    color: var(--ember-deep);
    background: var(--paper);
  }
  .mp-row.is-current .mp-row-play { background: var(--ember); color: #fff; border-color: var(--ember); }
  .mp-row-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mp-row-time { color: var(--ink-quiet); font-size: var(--t-body-sm); font-variant-numeric: tabular-nums; }
  .mp-empty { color: var(--ink-soft); }
  .mp-note {
    color: var(--ink-quiet);
    font-size: var(--t-body-sm);
    margin: var(--sp-6) 0 0;
    text-align: center;
  }

  /* ---------- Sticky player bar ---------- */
  .mp-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--paper-soft) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
  }
  .mp-bar-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 10px var(--sp-5) calc(10px + env(safe-area-inset-bottom));
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--sp-4);
  }
  @media (max-width: 640px) {
    .mp-bar-inner { grid-template-columns: 1fr auto; }
    .mp-bar-seek { grid-column: 1 / -1; }
  }
  .mp-bar-meta { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .mp-bar-cover { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; }
  .mp-bar-title {
    font-size: var(--t-body-sm);
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mp-bar-controls { display: flex; align-items: center; gap: 6px; }
  .mp-ctl {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--line-strong, var(--line));
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    font-size: 18px;
  }
  .mp-ctl:hover { border-color: var(--ember); color: var(--ember-deep); }
  .mp-ctl-play {
    width: 48px;
    height: 48px;
    background: var(--ember);
    border-color: var(--ember);
    color: #fff;
    font-size: 22px;
  }
  .mp-ctl-play:hover { background: var(--ember-deep); color: #fff; }
  .mp-bar-seek { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .mp-time {
    font-size: 12px;
    color: var(--ink-quiet);
    font-variant-numeric: tabular-nums;
    flex: 0 0 auto;
  }
  .mp-seek {
    flex: 1;
    min-width: 0;
    accent-color: var(--ember);
    height: 4px;
    cursor: pointer;
  }

  /* ---------- Email gate ---------- */
  .mp-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }
  .mp-gate-card {
    max-width: 520px;
    width: 100%;
    padding: var(--sp-7) var(--sp-6);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-2);
    text-align: center;
  }
  .mp-gate-cover {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: var(--r-lg, var(--r-md));
    box-shadow: var(--shadow-1);
    margin: 0 auto var(--sp-5);
    display: block;
  }
  .mp-gate-title {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    color: var(--ink);
    font-weight: 400;
    margin: 0 0 var(--sp-3);
  }
  .mp-gate-p { color: var(--ink-soft); margin: 0 0 var(--sp-5); }
  .mp-gate-row { display: flex; gap: var(--sp-3); }
  @media (max-width: 480px) {
    .mp-gate-row { flex-direction: column; }
  }
  .mp-gate-input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    padding: 13px 16px;
    border: 1px solid var(--line-strong, var(--line));
    border-radius: var(--r-md);
    background: var(--paper);
    color: var(--ink);
  }
  .mp-gate-input:focus { outline: none; border-color: var(--ember); box-shadow: var(--shadow-glow); }
  .mp-gate-row .sd-btn { justify-content: center; white-space: nowrap; }
  .mp-gate-error { color: var(--ember-deep); font-size: var(--t-body-sm); margin: var(--sp-3) 0 0; }
  .mp-gate-help { color: var(--ink-quiet); font-size: var(--t-body-sm); margin: var(--sp-5) 0 0; }
  .mp-gate-help a { color: var(--ember-deep); }
  .mp-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  /* ---------- Sales page (priced album, not yet owned) ---------- */
  .ms { max-width: 880px; margin: 0 auto; }
  .ms-hero {
    display: flex;
    gap: var(--sp-7);
    align-items: center;
    margin-bottom: var(--sp-8);
  }
  @media (max-width: 700px) {
    .ms-hero { flex-direction: column; align-items: flex-start; gap: var(--sp-5); }
  }
  .ms-cover {
    width: 300px;
    height: 300px;
    object-fit: cover;
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-2);
    flex: 0 0 auto;
  }
  @media (max-width: 700px) {
    .ms-cover { width: 220px; height: 220px; }
  }
  .ms-hero-text { min-width: 0; }
  .ms-title {
    font-family: var(--font-display);
    font-size: var(--t-h1, var(--t-h2));
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    color: var(--ink);
    font-weight: 400;
    margin: 0 0 var(--sp-3);
  }
  .ms-desc { color: var(--ink-soft); margin: 0 0 var(--sp-3); max-width: 52ch; }
  .ms-facts { color: var(--ink-quiet); font-size: var(--t-body-sm); margin: 0 0 var(--sp-5); }
  .ms-hero-buy { display: flex; align-items: center; gap: var(--sp-5); flex-wrap: wrap; }
  .ms-price {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    color: var(--ink);
  }
  .ms-own-hint { margin: var(--sp-4) 0 0; font-size: var(--t-body-sm); color: var(--ink-quiet); }
  .ms-own-hint a { color: var(--ember-deep); }

  .ms-h2 {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    color: var(--ink);
    font-weight: 400;
    margin: 0 0 var(--sp-4);
  }
  .ms-tracks { margin-bottom: var(--sp-8); }
  .ms-tracklist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .ms-track {
    display: flex;
    gap: var(--sp-4);
    align-items: baseline;
    padding: 13px var(--sp-5);
