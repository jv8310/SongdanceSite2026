  .ms-track-title { flex: 1; min-width: 0; color: var(--ink); }
  .ms-track-time { color: var(--ink-quiet); font-size: var(--t-body-sm); font-variant-numeric: tabular-nums; }

  .ms-checkout { display: flex; justify-content: center; margin-bottom: var(--sp-8); scroll-margin-top: 90px; }
  .ms-checkout-card {
    max-width: 560px;
    width: 100%;
    padding: var(--sp-7) var(--sp-6);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-2);
  }
  .ms-checkout-title {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    color: var(--ink);
    font-weight: 400;
    margin: 0 0 var(--sp-4);
  }
  .ms-points {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--ink-soft);
    font-size: var(--t-body-sm);
  }
  .ms-points i { color: var(--ember-deep); margin-right: 8px; }
  .ms-currency-note { color: var(--ink-quiet); font-size: 12.5px; margin: var(--sp-3) 0 0; }

  .ms-own {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    padding-top: var(--sp-6);
    border-top: 1px solid var(--line);
    scroll-margin-top: 90px;
  }
  .ms-own-p { color: var(--ink-soft); margin: 0 0 var(--sp-4); }
  .ms-own-form { text-align: left; }

  /* ---------- Buy card ---------- */
  .mp-buy-title {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    color: var(--ink);
    font-weight: 400;
    margin: 0 0 var(--sp-3);
  }
  .mp-buy-form { text-align: left; }
  .mp-buy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }
  @media (max-width: 480px) {
    .mp-buy-grid { grid-template-columns: 1fr; }
    .mp-buy-span { grid-column: auto; }
  }
  .mp-buy-span { grid-column: 1 / -1; }
  .mp-buy-grid input,
  .mp-buy-grid select {
    font-family: var(--font-body);
    font-size: var(--t-body);
    padding: 13px 16px;
    border: 1px solid var(--line-strong, var(--line));
    border-radius: var(--r-md);
    background: var(--paper);
    color: var(--ink);
    min-width: 0;
    width: 100%;
  }
  .mp-buy-grid input:focus,
  .mp-buy-grid select:focus { outline: none; border-color: var(--ember); box-shadow: var(--shadow-glow); }
  .mp-buy-terms {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: var(--t-body-sm);
    color: var(--ink-soft);
    margin-bottom: var(--sp-4);
    cursor: pointer;
  }
  .mp-buy-terms input { margin-top: 3px; accent-color: var(--ember); }
  .mp-buy-terms a { color: var(--ember-deep); }
  .mp-buy-actions { display: flex; flex-direction: column; gap: var(--sp-3); }
  .mp-buy-actions .sd-btn { justify-content: center; }
  .mp-buy-paypal {
    background: transparent;
    border: 1px solid var(--line-strong, var(--line));
    color: var(--ink);
  }
  .mp-buy-paypal:hover { border-color: var(--ember); color: var(--ember-deep); }
</style>

<script>
  // ---------- Email gate ----------
  const gateForm = document.querySelector<HTMLFormElement>('[data-gate-form]');
  if (gateForm) {
    const label = document.querySelector<HTMLElement>('[data-gate-label]');
    const errEl = document.querySelector<HTMLElement>('[data-gate-error]');
    const albumId = location.pathname.split('/').pop() ?? '';
    gateForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errEl) errEl.hidden = true;
      const fd = new FormData(gateForm);
      const email = String(fd.get('email') ?? '').trim();
      if (!email) return;
      const btn = gateForm.querySelector<HTMLButtonElement>('[data-gate-submit]');
      const original = label?.textContent ?? 'Open the album';
      if (btn) btn.disabled = true;
      if (label) label.textContent = 'Checking…';
      try {
        const res = await fetch('/api/music/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ album: albumId, email, hp: String(fd.get('hp') ?? '') }),
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; granted?: boolean };
        if (!res.ok || !data?.ok) throw new Error('failed');
        if (data.granted) {
          location.reload();
          return;
        }
        if (errEl) {
          errEl.textContent =
            "We couldn't find this album under that address. Try the email you used at checkout — or write to support@songdance.co.";
          errEl.hidden = false;
        }
      } catch {
        if (errEl) {
          errEl.textContent = "That didn't go through — please try again in a moment.";
          errEl.hidden = false;
        }
      } finally {
        if (btn) btn.disabled = false;
        if (label) label.textContent = original;
      }
    });
  }

  // ---------- Buy form → checkout ----------
  import { albumCurrencyForCountry, albumPriceCents } from '../../lib/music/product';
  import { formatMoney } from '../../lib/workshops/currency';

  const buyForm = document.querySelector<HTMLFormElement>('[data-buy-form]');
  if (buyForm) {
    // Live multi-currency: the buyer's country choice re-derives the price from
    // the same ratio table the server charges with, and repaints every price on
    // the page (hero, checkout title, pay button).
    const priceEur = Number(
      document.querySelector<HTMLElement>('[data-price-eur]')?.dataset.priceEur ?? 0,
    );
    const countrySel = buyForm.querySelector<HTMLSelectElement>('[data-buy-country]');
    const priceEls = Array.from(document.querySelectorAll<HTMLElement>('[data-price-current]'));
    const repaintPrice = () => {
      if (!priceEur || !countrySel?.value) return;
      const cur = albumCurrencyForCountry(countrySel.value);
      const label = formatMoney(albumPriceCents(priceEur, cur), cur);
      priceEls.forEach((el) => { el.textContent = label; });
    };
    countrySel?.addEventListener('change', repaintPrice);
    repaintPrice();

    const errEl = buyForm.querySelector<HTMLElement>('[data-buy-error]');
    const buttons = Array.from(buyForm.querySelectorAll<HTMLButtonElement>('[data-buy-submit]'));
    const albumId = location.pathname.split('/').pop() ?? '';
    // Two submit buttons, one per provider — remember which one was pressed.
    let provider: 'stripe' | 'paypal' = 'stripe';
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        provider = b.dataset.provider === 'paypal' ? 'paypal' : 'stripe';
      }),
    );
    buyForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errEl) errEl.hidden = true;
      const fd = new FormData(buyForm);
      buttons.forEach((b) => { b.disabled = true; });
      try {
        const res = await fetch('/api/music/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            album: albumId,
            first_name: String(fd.get('first_name') ?? '').trim(),
            last_name: String(fd.get('last_name') ?? '').trim(),
            email: String(fd.get('email') ?? '').trim(),
            country: String(fd.get('country') ?? '').trim(),
            consent_terms: fd.get('consent_terms') === 'on',
            provider,
          }),
        });
        const data = (await res.json().catch(() => ({}))) as {
          checkout_url?: string;
          error?: string;
        };
        if (!res.ok || !data.checkout_url) {
          throw new Error(data.error || 'Could not start checkout.');
        }
        location.href = data.checkout_url;
      } catch (err) {
        if (errEl) {
          errEl.textContent = (err as Error).message || 'Could not start checkout — please try again.';
          errEl.hidden = false;
        }
        buttons.forEach((b) => { b.disabled = false; });
      }
    });
  }

  // ---------- Player ----------
  type Track = { id: string; title: string; duration: number | null; url: string };
  const dataEl = document.getElementById('mp-data');
  if (dataEl) {
    const data = JSON.parse(dataEl.textContent || '{}') as {
      title: string;
      cover: string | null;
      tracks: Track[];
    };
    const tracks = data.tracks ?? [];

    const rows = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-row]'));
    const bar = document.querySelector<HTMLElement>('[data-bar]');
    const barTitle = document.querySelector<HTMLElement>('[data-bar-title]');
    const toggleBtn = document.querySelector<HTMLButtonElement>('[data-toggle]');
    const toggleIcon = document.querySelector<HTMLElement>('[data-toggle-icon]');
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-next]');
    const seek = document.querySelector<HTMLInputElement>('[data-seek]');
    const timeNow = document.querySelector<HTMLElement>('[data-time-now]');
    const timeTotal = document.querySelector<HTMLElement>('[data-time-total]');
    const playAll = document.querySelector<HTMLButtonElement>('[data-play-all]');

    const audio = new Audio();
    audio.preload = 'metadata';
    let current = -1;
    let scrubbing = false;

    const fmt = (s: number): string => {
      if (!Number.isFinite(s) || s < 0) return '0:00';
      const t = Math.round(s);
      return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
    };
    const trackDuration = (): number =>
      Number.isFinite(audio.duration) && audio.duration > 0
        ? audio.duration
        : (tracks[current]?.duration ?? 0);

    function paintRows() {
      rows.forEach((row, i) => {
        const isCurrent = i === current;
        row.classList.toggle('is-current', isCurrent);
        const icon = row.querySelector<HTMLElement>('[data-row-icon]');
        if (icon) {
          icon.className =
            isCurrent && !audio.paused ? 'ph-light ph-pause' : 'ph-light ph-play';
        }
      });
      if (toggleIcon) {
        toggleIcon.className = audio.paused ? 'ph-light ph-play' : 'ph-light ph-pause';
      }
    }

    function load(i: number, autoplay = true) {
      if (i < 0 || i >= tracks.length) return;
      current = i;
      audio.src = tracks[i].url;
      if (bar) bar.hidden = false;
      if (barTitle) barTitle.textContent = tracks[i].title;
      if (timeTotal) timeTotal.textContent = fmt(tracks[i].duration ?? 0);
      if (timeNow) timeNow.textContent = '0:00';
      if (seek) seek.value = '0';
      if (autoplay) void audio.play().catch(() => {});
      paintRows();
      // Lock-screen / notification metadata on phones — where a mantra album
      // is most likely to be playing.
      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: tracks[i].title,
          artist: 'Songdance',
          album: data.title,
          artwork: data.cover ? [{ src: data.cover, sizes: '512x512' }] : [],
        });
      }
    }

    const next = () => load(current + 1 < tracks.length ? current + 1 : -1);
    const prev = () => {
      // Standard player behaviour: restart the track unless we're at its start.
      if (audio.currentTime > 3) {
        audio.currentTime = 0;
        return;
      }
      if (current > 0) load(current - 1);
      else audio.currentTime = 0;
    };
    const toggle = () => {
      if (current < 0) { load(0); return; }
      if (audio.paused) void audio.play().catch(() => {});
      else audio.pause();
    };

    rows.forEach((row, i) =>
      row.addEventListener('click', () => {
        if (i === current) toggle();
        else load(i);
      }),
    );
    playAll?.addEventListener('click', () => {
      if (current < 0) load(0);
      else toggle();
    });
    toggleBtn?.addEventListener('click', toggle);
    nextBtn?.addEventListener('click', () => { if (current + 1 < tracks.length) next(); });
    prevBtn?.addEventListener('click', prev);

    audio.addEventListener('play', paintRows);
    audio.addEventListener('pause', paintRows);
    audio.addEventListener('ended', next);
    audio.addEventListener('loadedmetadata', () => {
      if (timeTotal) timeTotal.textContent = fmt(trackDuration());
    });
    audio.addEventListener('timeupdate', () => {
      if (scrubbing) return;
      if (timeNow) timeNow.textContent = fmt(audio.currentTime);
      const d = trackDuration();
      if (seek && d > 0) seek.value = String(Math.round((audio.currentTime / d) * 1000));
    });

    seek?.addEventListener('input', () => {
      scrubbing = true;
      const d = trackDuration();
      if (timeNow && d > 0) timeNow.textContent = fmt((Number(seek.value) / 1000) * d);
    });
    seek?.addEventListener('change', () => {
      const d = trackDuration();
      if (d > 0) audio.currentTime = (Number(seek.value) / 1000) * d;
      scrubbing = false;
    });

    if ('mediaSession' in navigator) {
      navigator.mediaSession.setActionHandler('play', () => void audio.play().catch(() => {}));
      navigator.mediaSession.setActionHandler('pause', () => audio.pause());
      navigator.mediaSession.setActionHandler('previoustrack', prev);
      navigator.mediaSession.setActionHandler('nexttrack', () => {
        if (current + 1 < tracks.length) next();
      });
    }
  }
</script>
