---
import SiteLayout from '../../components/SiteLayout.astro';
import GriefRegister from '../../components/grief/GriefRegister.astro';
import { listLibrary, type MediaItem } from '../../lib/media';
import '../../styles/grief.css';

export const prerender = false;

// Pull the grief imagery straight from the R2 media library at render time, so
// the page reflects whatever has been uploaded under library/grief…. Roles are
// matched by keyword (in priority order) so you can re-curate by renaming in
// /admin/image-manager:
//   • "hero" / "sounding"          → full-bleed hero (a person in a landscape)
//   • "band" / "quote"             → mid-page quote band (wide, warm frame)
//   • "closing" / "sea" / "water"  → closing band ("these waters")
//   • "daniela" / "guide"          → the guides portrait
//   • everything else              → the gallery (wide frames lead the layout)
const env = Astro.locals.runtime.env;
let library: MediaItem[] = [];
try {
  library = await listLibrary(env.MEDIA);
} catch {
  library = [];
}

const grief = library
  .filter((i) => i.key.toLowerCase().startsWith('library/grief'))
  .sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));

const used = new Set<string>();
// Claim the first unused image matching any of the patterns, in priority order.
function pick(...patterns: RegExp[]): MediaItem | undefined {
  for (const re of patterns) {
    const hit = grief.find((i) => !used.has(i.key) && re.test(i.key.toLowerCase()));
    if (hit) {
      used.add(hit.key);
      return hit;
    }
  }
  return undefined;
}
function pickNext(): MediaItem | undefined {
  const hit = grief.find((i) => !used.has(i.key));
  if (hit) used.add(hit.key);
  return hit;
}

// Reserve the feature slots first, then let the gallery take what's left — so a
// strong landscape photo carries the hero instead of a soft background graphic,
// and the bands get wide, atmospheric frames with room for their quotes.
const heroImg = pick(/hero/, /sounding/, /landscape|field|walk/) ?? pickNext();
const guidesImg = pick(/daniela|guide|portrait|teacher/, /jacob/);
const bandImg = pick(/band|quote/, /pale-background/, /feather/, /hand/) ?? pickNext();
const closingImg =
  pick(/closing|end|light|dawn|sunrise/, /losing-a-partner|sea|water|ocean/, /two-people/, /hand/) ??
  pickNext();

// Gallery — fill from what remains, leading with the soft, wide frames (the
// first tile spans two columns) and dropping the near-duplicate of the band.
function galleryRank(key: string): number {
  const k = key.toLowerCase();
  if (/lotus/.test(k)) return 0;
  if (/feather/.test(k)) return 1;
  if (/vertical/.test(k)) return 2;
  if (/two-people/.test(k)) return 3;
  if (/child/.test(k)) return 4;
  if (/letting-go/.test(k)) return 9; // near-duplicate of the quote band → last
  return 5;
}
const gallery = grief
  .filter((i) => !used.has(i.key))
  .sort((a, b) => galleryRank(a.key) - galleryRank(b.key))
  .slice(0, 5);

const steps: [string, string][] = [
  [
    'Understanding',
    'Grief as a process rather than an isolated feeling. Together we debunk the myths and misconceptions — because allowing the process begins with understanding what grief is, and what it is not.',
  ],
  [
    'Meeting the mind',
    'Meeting the beliefs and emotions wrapped around the loss. Guilt and regret can single-handedly stop the natural flow of grief — truly acknowledging these thoughts and feelings is the key to getting it flowing again.',
  ],
  [
    'Somatic Vocal Healing',
    'Somatic voice work connects you with your body in an accessible, reliable way. The body and the nervous system hold the keys to flowing easefully with grief — and new somatic tools give you a fresh way to express it.',
  ],
  [
    'Integration',
    'Through conscious integration you are empowered to weave the new insights and practices into your life — continuing your grief journey in your own unique way, knowing it is okay to embrace and allow the process.',
  ],
];

const forms = [
  'A loved one',
  'A beloved pet',
  'A divorce',
  'The end of a friendship',
  'A job, or a calling',
  'Disconnection from community',
  'An empty nest',
  'A life you imagined',
];

const includes: [string, string][] = [
  ['ph-waveform', '4 live sessions of 120 minutes each, to walk in your own time'],
  ['ph-infinity', 'Lifetime access to all the course material'],
  ['ph-microphone-stage', 'Powerful teachings, practices and journeys to support and transform your grief'],
  ['ph-users-three', 'Held by two educators in grief, death and loss, with decades of experience'],
];
---

<SiteLayout
  title="The Grief Course — Online Intensive with Daniela Hess & Jacob — Songdance"
  description="Because no one taught you how to grieve. Learn the foundational tools and practices to be with your grief in a conscious, healthy way — with Daniela Hess and Jacob Vermeulen. 4 sessions, lifetime access, €99."
  newsletter={false}
>
  <div class="gr">
    <!-- ── Hero ───────────────────────────────────────────── -->
    <header class={`gr-hero${heroImg ? '' : ' gr-hero--noimg'}`}>
      {heroImg && (
        <img class="gr-hero-bg" src={heroImg.url} alt="" loading="eager" decoding="async" />
      )}
      <div class="gr-hero-inner">
        <p class="gr-hero-eyebrow">An online intensive with Daniela Hess &amp; Jacob</p>
        <h1 class="gr-hero-title">Because no one taught you how to grieve.</h1>
        <p class="gr-hero-lede">
          Learn the foundational tools and practices to be with your grief — in a conscious, healthy way.
        </p>
        <div class="gr-hero-actions">
          <a href="#register" class="gr-btn gr-btn--primary">Start now — €99</a>
          <a href="#video" class="gr-btn gr-btn--ghost">
            <i class="ph-light ph-play-circle"></i> Watch the 1-minute intro
          </a>
        </div>
        <p class="gr-hero-meta">4 sessions · 120 minutes each · lifetime access</p>
      </div>
    </header>

    <!-- ── Opening ────────────────────────────────────────── -->
    <section class="gr-section gr-opening">
      <div class="gr-inner gr-narrow">
        <p class="gr-eyebrow">An invitation</p>
        <p class="gr-lede">
          The pain of grief is inevitable. The unnecessary suffering can be optional.
        </p>
        <p class="gr-p">
          Grief is a universal experience, touching each of us at some point in our lives — yet
          many of us struggle to navigate this profound emotion. When we don't know how to grieve,
          we typically reach for whatever numbs: we isolate, over-eat, seek highs, become sedentary,
          or distract ourselves in countless ways. These unconscious patterns become habits, and the
          habits become a cycle of pain and avoidance. But what if there were a way to break free?
        </p>
        <p class="gr-p">
          In the Grief Course we guide you through an intentional process, bringing knowledge, tools,
          guidance and support to move through your own journey of grief. Grief is rocky, mysterious
          terrain — these are waters you really want to cross with a skillful, trustworthy guide.
        </p>
        <p class="gr-p">
          Grief isn't something we strive to "heal" from — that's one of the myths we'll help you set
          down. Grief is about honouring, integrating, and ultimately living your aliveness.
        </p>
      </div>
    </section>

    <!-- ── Video ──────────────────────────────────────────── -->
    <section class="gr-section gr-video" id="video">
      <div class="gr-inner gr-narrow">
        <p class="gr-eyebrow gr-eyebrow--center">Watch first</p>
        <div class="gr-video-frame">
          <iframe
            src="https://player.vimeo.com/video/976571800?title=0&byline=0&portrait=0"
            title="Daniela & Jacob introduce the Grief Course"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <p class="gr-video-cap">Daniela &amp; Jacob introduce the Grief Course — one minute.</p>
      </div>
    </section>

    <!-- ── Quote band (image) ─────────────────────────────── -->
    {bandImg && (
      <section class="gr-band">
        <img class="gr-band-bg" src={bandImg.url} alt="" loading="lazy" decoding="async" />
        <div class="gr-band-inner">
          <p class="gr-band-quote">
            Where there is change, there is grief.
            <span class="gr-band-cite">The Grief Course</span>
          </p>
        </div>
      </section>
    )}

    <!-- ── Process ────────────────────────────────────────── -->
    <section class="gr-section">
      <div class="gr-inner">
        <p class="gr-eyebrow">The path</p>
        <h2 class="gr-h2">A reliable four-step process</h2>
        <p class="gr-p">
          Four sessions that move from understanding, through the mind's quiet objections, into the
          body and the voice, and finally into your own integration.
        </p>
        <ol class="gr-steps">
          {steps.map(([t, d], i) => (
            <li class="gr-step">
              <span class="gr-step-n">{['I', 'II', 'III', 'IV'][i]}</span>
              <div>
                <h3 class="gr-step-t">{t}</h3>
                <p class="gr-step-d">{d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── Gallery ────────────────────────────────────────── -->
    {gallery.length > 0 && (
      <section class="gr-section" style="padding-top:0;">
        <div class="gr-inner">
          <div class="gr-gallery">
            {gallery.map((img, i) => (
              <figure class={`gr-gallery-item${i === 0 && gallery.length >= 3 ? ' gr-gallery-item--wide' : ''}`}>
                <img src={img.url} alt="" loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Many forms ─────────────────────────────────────── -->
    <section class="gr-section gr-opening">
      <div class="gr-inner gr-narrow">
        <p class="gr-eyebrow">Who it's for</p>
        <h2 class="gr-h2">Grief comes in many forms — big "G" and small "g".</h2>
        <p class="gr-p">
          Whether you're mourning a loved one or a beloved pet, facing a divorce, the end of a
          friendship, a job loss, disconnection from community, or children leaving the nest — this
          course is for you. We teach the principles of the grief process that apply to all of it,
          whether life-altering or "everyday". You'll learn how to <em>allow, attend, accept and
          release</em>, and to move through the sadness and worry that grief carries.
        </p>
        <ul class="gr-forms">
          {forms.map((f) => (
            <li class="gr-form">{f}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Guides ─────────────────────────────────────────── -->
    <section class="gr-section gr-guides">
      <div class="gr-inner">
        <div class="gr-guides-grid">
          {guidesImg && (
            <div class="gr-guides-photo">
              <img src={guidesImg.url} alt="Daniela Hess and Jacob Vermeulen" loading="lazy" decoding="async" />
            </div>
          )}
          <div>
            <p class="gr-eyebrow">Your guides &amp; educators</p>
            <h2 class="gr-h2">Daniela Hess &amp; Jacob Vermeulen</h2>
            <p class="gr-p">
              <strong>Daniela Hess</strong> has served as an educational and spiritual mentor to
              thousands of students and clients over the past 25 years. She has led many group grief
              courses and worked 1:1 with the bereaved, helping people around the world navigate the
              complex terrain of grief — a dynamic, insightful and compassionate guide who catalyses
              ripples of transformation across her students' lives.
            </p>
            <p class="gr-p">
              <strong>Jacob Vermeulen</strong> is an international educator who has held space for
              thousands moving through deep inner work, blending the psychology of emotional wellbeing
              with spirituality. A gifted pianist and singer, he explores the healing effects of music
              with a special focus on the human voice. Navigating his own grief, he developed a unique
              somatic protocol for meeting the stuck energy of grief in the body and letting it move.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── What's included ────────────────────────────────── -->
    <section class="gr-section">
      <div class="gr-inner gr-narrow">
        <p class="gr-eyebrow">Start right away</p>
        <h2 class="gr-h2">Everything you need to begin</h2>
        <ul class="gr-includes">
          {includes.map(([icon, text]) => (
            <li class="gr-include">
              <i class={`ph-light ${icon}`}></i>
              <span>{text}</span>
            </li>
          ))}
        </ul>
        <p class="gr-trust">
          <i class="ph-light ph-star"></i>
          Every review of Songdance on
          <a href="https://www.trustpilot.com/review/songdance.co" target="_blank" rel="noopener">Trustpilot</a>
          is five stars.
        </p>
      </div>
    </section>

    <!-- ── Closing band (image) ───────────────────────────── -->
    {closingImg && (
      <section class="gr-band">
        <img class="gr-band-bg" src={closingImg.url} alt="" loading="lazy" decoding="async" />
        <div class="gr-band-inner">
          <p class="gr-band-quote">
            You don't have to cross these waters alone.
            <span class="gr-band-cite">Begin when you're ready</span>
          </p>
        </div>
      </section>
    )}

    <!-- ── Register ───────────────────────────────────────── -->
    <GriefRegister />
  </div>
</SiteLayout>
