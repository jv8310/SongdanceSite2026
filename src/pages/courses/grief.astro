---
import SiteLayout from '../../components/SiteLayout.astro';
import GriefRegister from '../../components/grief/GriefRegister.astro';
import { listLibrary, type MediaItem } from '../../lib/media';
import '../../styles/grief.css';

export const prerender = false;

// Images are pulled from the R2 media library at render time, but assigned to
// explicit slots by hand (after reviewing each file) rather than fuzzy keyword
// matching — that auto-picker mis-placed images and chose soft background
// graphics for feature slots. Pulling from R2 still means a removed/renamed
// image simply doesn't render (no broken <img>); to re-curate, swap the key.
const env = Astro.locals.runtime.env;
let library: MediaItem[] = [];
try {
  library = await listLibrary(env.MEDIA);
} catch {
  library = [];
}

const byKey = (name: string): MediaItem | undefined => {
  const want = `library/${name}.webp`.toLowerCase();
  return (
    library.find((i) => i.key.toLowerCase() === want) ??
    library.find((i) => i.key.toLowerCase().includes(name.toLowerCase()))
  );
};

// Curated slots.
//   hero      — Jacob sounding outward in an open field (the hero, left as-is)
//   daniela   — Daniela's portrait        ┐ both guides pictured + named
//   jacob     — Jacob's portrait          ┘
//   band      — four hands reaching upward (the mid-page quote band)
//   forms     — adult + child hands, B&W (the "many forms" editorial image)
//   closing   — a figure at the sea, dusk (the closing band)
const heroImg = byKey('grief-jacob-letting-go-sounding');
const danielaImg = byKey('grief-daniela');
const jacobImg = byKey('grief-jacob-letting-go-sounding');
const bandImg = byKey('grief-hands-vertical');
const formsImg = byKey('grief-hands-child-loss');
const closingImg = byKey('grief-letting-go-losing-a-partner');

const steps: [string, string][] = [
  [
    'Understanding',
    'Grief as a process rather than an isolated feeling. Together we clear up the myths and misunderstandings — because allowing the process begins with understanding what grief is, and what it is not.',
  ],
  [
    'Meeting the mind',
    'Meeting the beliefs and emotions wrapped around the loss. Guilt and regret can, all on their own, stop the natural flow of grief — truly acknowledging these thoughts and feelings is the key to getting it flowing again.',
  ],
  [
    'Somatic Vocal Healing',
    'Somatic voice work connects you with your body in an accessible, reliable way. The body and the nervous system hold the keys to flowing with grief — and new somatic tools give you a fresh way to express it.',
  ],
  [
    'Integration',
    'Through conscious integration you weave the new insights and practices into your life — continuing your grief journey in your own unique way, knowing it is okay to embrace and allow the process.',
  ],
];

const forms = [
  'A loved one',
  'A beloved pet',
  'A divorce',
  'The end of a friendship',
  "A job, or a life's purpose",
  'Disconnection from community',
  'A home grown quiet',
  'A life you imagined',
];

const includes: [string, string][] = [
  ['ph-waveform', '4 live sessions of 120 minutes each, to walk in your own time'],
  ['ph-infinity', 'Lifetime access to all the course material'],
  ['ph-microphone-stage', 'Powerful teachings, practices and journeys to support and transform your grief'],
  ['ph-users-three', 'Held by two educators in grief, death and loss, with decades of experience'],
];
---

<SiteLayout
  title="The Grief Course — Online Intensive with Daniela Hess & Jacob — Songdance"
  description="Because no one taught you how to grieve. Learn the foundational tools and practices to be with your grief in a conscious, healthy way — with Daniela Hess and Jacob Vermeulen. 4 sessions, lifetime access."
  newsletter={false}
>
  <div class="gr">
    <!-- ── Hero ───────────────────────────────────────────── -->
    <header class={`gr-hero${heroImg ? '' : ' gr-hero--noimg'}`}>
      {heroImg && (
        <img class="gr-hero-bg" src={heroImg.url} alt="" loading="eager" decoding="async" />
      )}
      <div class="gr-hero-inner">
        <p class="gr-hero-eyebrow">An online intensive with Daniela Hess &amp; Jacob</p>
        <h1 class="gr-hero-title">Because no one taught you how to grieve.</h1>
        <p class="gr-hero-lede">
          Learn the foundational tools and practices to be with your grief — in a conscious, healthy way.
        </p>
        <div class="gr-hero-actions">
          <a href="#register" class="gr-btn gr-btn--primary">Start now — €99</a>
          <a href="#video" class="gr-btn gr-btn--ghost">
            <i class="ph-light ph-play-circle"></i> Watch the 1-minute intro
          </a>
        </div>
        <p class="gr-hero-meta">4 sessions · 120 minutes each · lifetime access</p>
      </div>
    </header>

    <!-- ── Opening ────────────────────────────────────────── -->
    <section class="gr-section gr-opening">
      <div class="gr-inner gr-narrow">
        <p class="gr-eyebrow">An invitation</p>
        <p class="gr-lede">
          The pain of grief is inevitable. The unnecessary suffering can be optional.
        </p>
        <p class="gr-p">
          Grief is a universal experience, touching each of us at some point in our lives — yet
          many of us struggle to navigate this profound emotion. When we don't know how to grieve,
          we typically reach for whatever numbs: we isolate, over-eat, seek highs, become sedentary,
          or distract ourselves in countless ways. These unconscious patterns become habits, and the
          habits become a cycle of pain and avoidance. But grief was never the trap. Grief is the
          river, not the knot — and the river can be learned.
        </p>
        <p class="gr-p">
          In the Grief Course we guide you through an intentional process, bringing knowledge, tools,
          guidance and support to move through your own journey of grief. Grief is unfamiliar ground
          for most of us. It helps to cross it with someone beside you — and with someone who knows the way.
        </p>
        <p class="gr-p">
          Grief isn't something we strive to "heal" from — that's one of the myths we'll help you put
          down. Grief is about honouring, integrating, and ultimately living fully alive.
        </p>
        <blockquote class="gr-lede" style="margin: var(--sp-6) 0 0;">
          Grief is not the pain. It is the process that helps you move through it.
          <span class="gr-eyebrow" style="display: block; margin: var(--sp-4) 0 0;">— Jacob</span>
        </blockquote>
      </div>
    </section>

    <!-- ── Video ──────────────────────────────────────────── -->
    <section class="gr-section gr-video" id="video">
      <div class="gr-inner gr-narrow">
        <p class="gr-eyebrow gr-eyebrow--center">Watch first</p>
        <div class="gr-video-frame">
          <iframe
            src="https://player.vimeo.com/video/976571800?title=0&byline=0&portrait=0"
            title="Daniela & Jacob introduce the Grief Course"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <p class="gr-video-cap">Daniela &amp; Jacob introduce the Grief Course — one minute.</p>
      </div>
    </section>

    <!-- ── Quote band (image) ─────────────────────────────── -->
    {bandImg && (
      <section class="gr-band">
        <img class="gr-band-bg" src={bandImg.url} alt="" loading="lazy" decoding="async" />
        <div class="gr-band-inner">
          <p class="gr-band-quote">
            Where there is change, there is grief.
            <span class="gr-band-cite">The Grief Course</span>
          </p>
        </div>
      </section>
    )}

    <!-- ── Process ────────────────────────────────────────── -->
    <section class="gr-section">
      <div class="gr-inner">
        <p class="gr-eyebrow">The path</p>
        <h2 class="gr-h2">A four-step path</h2>
        <p class="gr-p">
          Four sessions that move from understanding, through the mind's quiet objections, into the
          body and the voice, and finally into your own integration.
        </p>
        <ol class="gr-steps">
          {steps.map(([t, d], i) => (
            <li class="gr-step">
              <span class="gr-step-n">{['I', 'II', 'III', 'IV'][i]}</span>
              <div>
                <h3 class="gr-step-t">{t}</h3>
                <p class="gr-step-d">{d}</p>
                {i === 2 && (
                  <p class="gr-step-d"><em>Lift the head, relax the shoulders, sound the grief outward.</em></p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── Many forms ─────────────────────────────────────── -->
    <section class="gr-section gr-opening gr-forms-section">
      <div class="gr-inner gr-forms-grid">
        {formsImg && (
          <figure class="gr-forms-photo">
            <img src={formsImg.url} alt="" loading="lazy" decoding="async" />
          </figure>
        )}
        <div class="gr-forms-copy">
          <p class="gr-eyebrow">Who it's for</p>
          <h2 class="gr-h2">Grief comes in many forms — the great griefs and the everyday ones.</h2>
          <p class="gr-p">
            Whether you're mourning a loved one or a beloved pet, facing a divorce, the end of a
            friendship, a job loss, disconnection from community, or children growing up and moving out — this
            course is for you. We teach the principles of the grief process that apply to all of it,
            whether life-altering or "everyday". You'll learn how to <em>allow, attend, acknowledge
            and integrate</em> — and to move through the sadness and worry that grief carries.
          </p>
          <ul class="gr-forms">
            {forms.map((f) => (
              <li class="gr-form">{f}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Guides ─────────────────────────────────────────── -->
    <section class="gr-section gr-guides">
      <div class="gr-inner">
        <p class="gr-eyebrow gr-eyebrow--center">Your guides &amp; educators</p>
        <h2 class="gr-h2 gr-guides-title">Daniela Hess &amp; Jacob Vermeulen</h2>
        <div class="gr-guides-grid">
          <article class="gr-guide">
            {danielaImg && (
              <div class="gr-guide-photo">
                <img src={danielaImg.url} alt="Daniela Hess" loading="lazy" decoding="async" />
              </div>
            )}
            <h3 class="gr-guide-name">Daniela Hess</h3>
            <p class="gr-guide-bio">
              Daniela has served as an educational and spiritual mentor to thousands of students and
              clients over the past 25 years. She has led many group grief courses and worked 1:1 with
              the bereaved, helping people around the world navigate the complex terrain of grief — a
              dynamic, insightful and compassionate guide.
            </p>
          </article>
          <article class="gr-guide">
            {jacobImg && (
              <div class="gr-guide-photo gr-guide-photo--jacob">
                <img src={jacobImg.url} alt="Jacob Vermeulen" loading="lazy" decoding="async" />
              </div>
            )}
            <h3 class="gr-guide-name">Jacob Vermeulen</h3>
            <p class="gr-guide-bio">
              Jacob is an international educator who has held space for thousands moving through deep
              inner work, blending the psychology of emotional wellbeing with spirituality. A gifted
              pianist and singer, he explores the healing effects of music with a special focus on the
              human voice. Navigating his own grief, he developed a somatic way of meeting the stuck
              energy of grief in the body, so it can move again.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ── What's included ────────────────────────────────── -->
    <section class="gr-section">
      <div class="gr-inner gr-narrow">
        <p class="gr-eyebrow">Start right away</p>
        <h2 class="gr-h2">Everything you need to begin</h2>
        <ul class="gr-includes">
          {includes.map(([icon, text]) => (
            <li class="gr-include">
              <i class={`ph-light ${icon}`}></i>
              <span>{text}</span>
            </li>
          ))}
        </ul>
        <p class="gr-trust">
          <i class="ph-light ph-star"></i>
          Every review of Songdance on
          <a href="https://www.trustpilot.com/review/songdance.co" target="_blank" rel="noopener">Trustpilot</a>
          is five stars.
        </p>
      </div>
    </section>

    <!-- ── An honest note ─────────────────────────────────── -->
    <section class="gr-section gr-opening">
      <div class="gr-inner gr-narrow">
        <p class="gr-eyebrow">An honest note</p>
        <p class="gr-p">
          This is not therapy, and it doesn't replace it — it will always remain valuable to have
          someone who knows you. And it won't always feel good first. If you're willing to meet
          what's been waiting, what's on the other side is a different kind of peace.
        </p>
      </div>
    </section>

    <!-- ── Closing band (image) ───────────────────────────── -->
    {closingImg && (
      <section class="gr-band gr-band--tall">
        <img class="gr-band-bg" src={closingImg.url} alt="" loading="lazy" decoding="async" />
        <div class="gr-band-inner">
          <p class="gr-band-quote">
            You don't have to cross these waters alone.
            <span class="gr-band-cite">Begin when you're ready</span>
          </p>
        </div>
      </section>
    )}

    <!-- ── Register ───────────────────────────────────────── -->
    <GriefRegister />
  </div>
</SiteLayout>
