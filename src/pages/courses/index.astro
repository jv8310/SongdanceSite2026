---
import SiteLayout from '../../components/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SoftCta from '../../components/SoftCta.astro';
import { coursesJsonLd } from '../../lib/seo';
import { EUR_COPY_LABEL, hasCompareStrike, type MarketingProduct } from '../../lib/workshops/marketing-prices';

interface CourseItem {
  label: string;
  href: string;
  img: string;
  desc: string;
  note: string;
  price?: MarketingProduct; // opts into client-side currency localization + promo strike
  pos?: string; // object-position override when the 3:2 crop would clip the subject
}
interface CourseGroup {
  title: string;
  lede: string;
  items: CourseItem[];
}

// Each card carries its own picture from the R2 library (served at /media/…),
// a one-line description, and a price line. Cards with a price get their figure
// wrapped in its own chip (see priceParts) so PriceSync can localize the
// currency AND — while the launch promo is live — strike the normal price and
// show the discounted one. Every figure matches what's charged at checkout.
// Certification shows its cert-only line with the €797 sticker struck
// permanently (hasCompareStrike); Forgiveness (not on sale yet) shows no figure.
const groups: CourseGroup[] = [
  {
    title: 'Somatic Vocal Healing',
    lede: 'The practice itself — not singing but sounding, the sound of what’s there. Start with an hour, or go all the way to holding space for others.',
    items: [
      {
        label: 'Vocal Healing Workshop',
        href: '/workshop',
        img: '/media/library/svh-retreat-sounding-blue.webp',
        desc: 'One live hour to meet the practice — one honest tone, and what it opens.',
        note: '22€ · one live hour',
        price: 'ticket',
      },
      {
        label: '12-Week Course',
        href: '/courses/12-week',
        img: '/media/library/svhgpt-01-hero-in-one-breath.webp',
        desc: 'Twelve weeks to learn the practice for yourself — guided modules and live weekly Q&A, until you can hold it alone.',
        note: '€550 · live Q&A',
        price: 'twelve-week',
      },
      {
        label: 'Practitioner Training',
        href: '/courses/certification',
        img: '/media/library/svh-retreat-circle-sunset-group-jacob-central.webp',
        desc: 'Go fully in with your own voice — and learn to hold space for another’s. Self-paced, with live Q&As and monthly deepening sessions through 2026.',
        note: '€797 · self-paced',
        price: 'cert',
      },
      {
        label: 'Professional Masterclass',
        href: '/courses/masterclass',
        img: '/media/library/jacob-teaching.webp',
        desc: 'A 100-minute live masterclass for therapists, coaches and facilitators — when words can’t reach it, sound can.',
        note: '44€ · 100-min live',
        price: 'masterclass',
        pos: 'center 20%', // tall portrait — bias the crop up so his head isn't clipped
      },
    ],
  },
  {
    title: 'Courses by Theme',
    lede: 'Live, themed intensives with Daniela Hess & Jacob — and lifetime access to every session.',
    items: [
      {
        label: 'Grief Course',
        href: '/courses/grief',
        img: '/media/library/grief-jacob-letting-go-sounding.webp',
        desc: 'Four live sessions for the grief no one taught you how to carry — held gently, sounded together.',
        note: 'with Daniela · €99',
        price: 'grief',
      },
      {
        label: 'Forgiveness Course',
        href: '/courses/forgiveness',
        img: '/media/library/forgiveness-sunflowers-sunset.webp',
        desc: 'When forgiveness feels impossible, come anyway. Four live sessions honoring what the words alone never reached.',
        note: 'with Daniela · Fall 2026',
      },
    ],
  },
  {
    title: 'Guided Musical Journeys',
    lede: 'Self-paced sessions of music, mantra and movement — to do at home, in your own time.',
    items: [
      {
        label: 'Authentic Singing Journey',
        href: '/courses/authentic-singing',
        img: '/media/library/singing-lights-woman.webp',
        desc: 'Forty weeks of mantras and music — made to free the voice you already have, not train it into something else.',
        note: '€150 · 40 sessions',
        price: 'asj',
      },
      {
        label: 'Magical Movement Journey',
        href: '/courses/magical-movement',
        img: '/media/library/movement.webp',
        desc: 'Guided movement you can do in your own room — standing, or seated in a chair. No steps to learn.',
        note: '€49 · self-paced',
        price: 'mmj',
      },
      {
        label: 'Inner Child Healing Journey',
        href: '/courses/inner-child',
        img: '/media/library/inner-child-glow.webp',
        desc: 'Five gentle sessions of music and mantra — to sing the child you were what they never got to hear.',
        note: '€29 · 5 sessions',
        price: 'inner-child',
      },
    ],
  },
];

// Split a note around its EUR price token so the price lives in its own chip —
// currency-localized, and struck-through + discounted by PriceSync while the
// launch promo runs. Returns null for cards with no price.
function priceParts(note: string, price?: MarketingProduct) {
  if (!price) return null;
  const token = EUR_COPY_LABEL[price];
  const at = note.indexOf(token);
  if (at < 0) return null;
  return { pre: note.slice(0, at), token, post: note.slice(at + token.length) };
}

// Course structured data — one Course per card (name + description + provider,
// plus a price Offer where the note carries one). Helps Google course rich
// results and AI answer engines enumerate what Songdance offers.
const coursesLd = coursesJsonLd(
  groups.flatMap((g) =>
    g.items.map((it) => ({ name: it.label, description: it.desc, href: it.href, price: it.note })),
  ),
);
---

<SiteLayout
  title="Courses — Songdance"
  description="One practice, many doorways. Start with an hour, or commit to twelve weeks — workshops, themed courses, and self-paced guided journeys."
  image="/media/library/svh-retreat-group-indoor.webp"
  imageAlt="A Songdance circle gathered indoors for sounding practice."
>
  <PageHero
    eyebrow="Courses"
    title="One practice, many doorways"
    lede="Start with an hour, or commit to twelve weeks — wherever you are is a fine place to begin."
  />
  <section class="sd-section sd-courses">
    <div class="sd-courses-inner">
      {groups.map((g) => (
        <div class="sd-course-group">
          <h2 class="sd-course-group-title">{g.title}</h2>
          <p class="sd-course-group-lede">{g.lede}</p>
          <div class="sd-course-cards">
            {g.items.map((it) => {
              const pp = priceParts(it.note, it.price);
              const compareStrike = !!it.price && hasCompareStrike(it.price);
              return (
              <a class="sd-course-card sd-course-card--media" href={it.href}>
                <span class="sd-course-card-media">
                  <img src={it.img} alt="" loading="lazy" decoding="async" style={it.pos ? `object-position:${it.pos}` : undefined} />
                </span>
                <span class="sd-course-card-body">
                  <span class="sd-course-card-label">{it.label}</span>
                  <span class="sd-course-card-desc">{it.desc}</span>
                  <span class="sd-course-card-note">
                    {pp ? (
                      <Fragment>{pp.pre}<span class="sd-price" data-sd-price={it.price} data-sd-promo-price data-sd-compare={compareStrike ? '' : undefined}>{pp.token}</span>{pp.post}</Fragment>
                    ) : it.note}
                  </span>
                </span>
              </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
  <SoftCta />

  <script type="application/ld+json" set:html={JSON.stringify(coursesLd)} />
</SiteLayout>

<style>
  /* A sub-lede under each group heading (group title margin-bottom is sp-5). */
  .sd-course-group-lede {
    margin: calc(-1 * var(--sp-4)) 0 var(--sp-5);
    max-width: 60ch;
    font-size: var(--t-body-sm);
    color: var(--ink-quiet);
  }

  /* Every course card now carries a picture: a column with a full-bleed image
     on top, then the label / description / price stacked beneath. */
  .sd-course-card--media {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    padding: 0 0 var(--sp-4);
    gap: 0;
    overflow: hidden;
  }
  .sd-course-card-media {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--paper-deep);
  }
  .sd-course-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .sd-course-card--media:hover .sd-course-card-media img {
    transform: scale(1.04);
  }
  .sd-course-card-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--sp-4) var(--sp-4) 0;
  }
  .sd-course-card-desc {
    font-family: var(--font-body);
    font-size: var(--t-body-sm);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .sd-course-card--media .sd-course-card-note {
    white-space: normal;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ember);
  }
</style>
