---
import SiteLayout from '../../components/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SoftCta from '../../components/SoftCta.astro';
import { coursesJsonLd } from '../../lib/seo';
import { EUR_COPY_LABEL, hasCompareStrike, type MarketingProduct } from '../../lib/workshops/marketing-prices';

interface CourseItem {
  label: string;
  href: string;
  img: string;
  desc: string;
  facts: string[]; // short, literal facts about the format — never a claim the page can't back
  price: MarketingProduct; // the price chip: currency-localized + struck while a promo runs
  flag?: string; // a small ribbon over the picture ("Registrations now open")
  pos?: string; // object-position override when the 3:2 crop would clip the subject
}
interface CourseGroup {
  title: string;
  lede: string;
  items: CourseItem[];
}

// Each card carries its own picture from the R2 library (served at /media/…),
// a one-line description, a few literal facts about the format, and a footer
// with the price. The price chip is localized by PriceSync and — while a site
// sale runs — struck through with the sale price beside it. Certification
// shows its €797 sticker struck permanently (hasCompareStrike). Every figure
// matches what's charged at checkout.
const groups: CourseGroup[] = [
  {
    title: 'Somatic Vocal Healing',
    lede: 'The practice itself — not singing but sounding, the sound of what’s there. Start with seventy minutes, or go all the way to holding space for others.',
    items: [
      {
        label: 'Vocal Healing Workshop',
        href: '/workshop',
        img: '/media/library/svh-retreat-sounding-blue.webp',
        desc: 'Seventy live minutes to meet the practice — one honest tone, and what it opens.',
        facts: ['70 minutes', 'Live on Zoom'],
        price: 'ticket',
      },
      {
        label: '12-Week Course',
        href: '/courses/12-week',
        img: '/media/library/svhgpt-01-hero-in-one-breath.webp',
        desc: 'Twelve weeks to learn the practice for yourself — guided modules and live weekly Q&A, until you can hold it alone.',
        facts: ['Self-paced modules, yours for life', 'Weekly live Q&A for 12 weeks'],
        price: 'twelve-week',
      },
      {
        label: 'Practitioner Training',
        href: '/courses/certification',
        img: '/media/library/svh-retreat-circle-sunset-group-jacob-central.webp',
        desc: 'Go fully in with your own voice — and learn to hold space for another’s. Self-paced, with weekly live Q&As and monthly two-hour deepening sessions for nine months.',
        facts: ['Class library + manuals, instant access', 'Weekly Q&A + monthly deepening, 9 months'],
        price: 'cert',
      },
      {
        label: 'Professional Masterclass',
        href: '/courses/masterclass',
        img: '/media/library/jacob-teaching.webp',
        desc: 'A 100-minute live masterclass for therapists, coaches and facilitators — when words can’t reach it, sound can.',
        facts: ['100 minutes', 'Live on Zoom', 'For practitioners'],
        price: 'masterclass',
        pos: 'center 20%', // tall portrait — bias the crop up so his head isn't clipped
      },
    ],
  },
  {
    title: 'Courses by Theme',
    lede: 'Live, themed intensives with Daniela Hess & Jacob — and lifetime access to every session.',
    items: [
      {
        label: 'Grief Course',
        href: '/courses/grief',
        img: '/media/library/grief-jacob-letting-go-sounding.webp',
        desc: 'Four live sessions for the grief no one taught you how to carry — held gently, sounded together.',
        facts: ['With Daniela Hess', '4 sessions'],
        price: 'grief',
      },
      {
        label: 'Forgiveness Course',
        href: '/courses/forgiveness',
        img: '/media/library/forgiveness-sunflowers-sunset.webp',
        desc: 'When forgiveness feels impossible, come anyway. Four live sessions honoring what the words alone never reached.',
        facts: ['With Daniela Hess', '4 live sessions, 6–16 Dec'],
        price: 'forgiveness',
        flag: 'Registrations now open',
      },
    ],
  },
  {
    title: 'Guided Musical Journeys',
    lede: 'Self-paced sessions of music, mantra and movement — to do at home, in your own time.',
    items: [
      {
        label: 'Authentic Singing Journey',
        href: '/courses/authentic-singing',
        img: '/media/library/singing-lights-woman.webp',
        desc: 'Forty weeks of mantras and music — made to free the voice you already have, not train it into something else.',
        facts: ['40 weekly sessions'],
        price: 'asj',
      },
      {
        label: 'Magical Movement Journey',
        href: '/courses/magical-movement',
        img: '/media/library/movement.webp',
        desc: 'Guided movement you can do in your own room — standing, or seated in a chair. No steps to learn.',
        facts: ['Self-paced', 'Standing or seated'],
        price: 'mmj',
      },
      {
        label: 'Inner Child Healing Journey',
        href: '/courses/inner-child',
        img: '/media/library/inner-child-glow.webp',
        desc: 'Five gentle sessions of music and mantra — to sing the child you were what they never got to hear.',
        facts: ['5 sessions', 'Self-paced'],
        price: 'inner-child',
      },
    ],
  },
];

// Course structured data — one Course per card (name + description + provider,
// plus its EUR price as an Offer). Helps Google course rich
// results and AI answer engines enumerate what Songdance offers.
const coursesLd = coursesJsonLd(
  groups.flatMap((g) =>
    g.items.map((it) => ({ name: it.label, description: it.desc, href: it.href, price: EUR_COPY_LABEL[it.price] })),
  ),
);
---

<SiteLayout
  title="Courses — Songdance"
  description="One practice, many doorways. Start with seventy minutes, or commit to twelve weeks — workshops, themed courses, and self-paced guided journeys."
  image="/media/library/svh-retreat-group-indoor.webp"
  imageAlt="A Songdance circle gathered indoors for sounding practice."
>
  <PageHero
    eyebrow="Courses"
    title="One practice, many doorways"
    lede="Start with seventy minutes, or commit to twelve weeks — wherever you are is a fine place to begin."
  />
  <section class="sd-section sd-courses">
    <div class="sd-courses-inner">
      {groups.map((g) => (
        <div class="sd-course-group">
          <h2 class="sd-course-group-title">{g.title}</h2>
          <p class="sd-course-group-lede">{g.lede}</p>
          <div class:list={['sd-course-cards', g.items.length % 3 !== 0 && 'sd-course-cards--two']}>
            {g.items.map((it) => (
              <a class="sd-course-card sd-course-card--media" href={it.href}>
                <span class="sd-course-card-media">
                  <img src={it.img} alt="" loading="lazy" decoding="async" style={it.pos ? `object-position:${it.pos}` : undefined} />
                  {it.flag && <span class="sd-course-card-flag">{it.flag}</span>}
                </span>
                <span class="sd-course-card-body">
                  <span class="sd-course-card-label">{it.label}</span>
                  <span class="sd-course-card-desc">{it.desc}</span>
                  <span class="sd-course-card-facts">
                    {it.facts.map((f) => <span class="sd-course-card-fact">{f}</span>)}
                  </span>
                </span>
                <span class="sd-course-card-foot">
                  <span class="sd-course-card-price">
                    <span class="sd-price" data-sd-price={it.price} data-sd-promo-price data-sd-compare={hasCompareStrike(it.price) ? '' : undefined}>{EUR_COPY_LABEL[it.price]}</span>
                  </span>
                  <span class="sd-course-card-go" aria-hidden="true">Explore <span class="sd-course-card-arrow">→</span></span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
  <SoftCta />

  <script type="application/ld+json" set:html={JSON.stringify(coursesLd)} />
</SiteLayout>

<style>
  /* A sub-lede under each group heading (group title margin-bottom is sp-5). */
  .sd-course-group-lede {
    margin: calc(-1 * var(--sp-4)) 0 var(--sp-5);
    max-width: 60ch;
    font-size: var(--t-body-sm);
    color: var(--ink-quiet);
  }

  /* Four or two cards sit two to a row, so no card is left alone on a row. */
  .sd-course-cards--two { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 560px) { .sd-course-cards--two { grid-template-columns: 1fr; } }

  /* A card: the picture full-bleed on top, then label / description / facts,
     and a footer with the price pinned to the bottom so the prices of a row
     line up whatever the length of the text above them. */
  .sd-course-card--media {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    padding: 0;
    gap: 0;
    overflow: hidden;
    background: var(--paper-soft);
    transition:
      border-color var(--d-base) var(--ease),
      box-shadow var(--d-base) var(--ease),
      transform var(--d-base) var(--ease);
  }
  .sd-course-card--media:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -18px rgba(42, 27, 42, 0.35);
  }
  .sd-course-card-media {
    display: block;
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--paper-deep);
  }
  .sd-course-cards--two .sd-course-card-media { aspect-ratio: 16 / 9; }
  .sd-course-card-flag {
    position: absolute;
    left: var(--sp-3);
    top: var(--sp-3);
    padding: 5px 11px;
    border-radius: var(--r-pill);
    background: var(--ember);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .sd-course-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .sd-course-card--media:hover .sd-course-card-media img {
    transform: scale(1.04);
  }
  .sd-course-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: var(--sp-5) var(--sp-5) var(--sp-4);
  }
  .sd-course-card--media .sd-course-card-label {
    font-size: clamp(1.35rem, 1.2rem + 0.5vw, 1.6rem);
    font-weight: 400;
    line-height: 1.2;
  }
  .sd-course-card-desc {
    font-family: var(--font-body);
    font-size: var(--t-body-sm);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 52ch;
  }
  .sd-course-card-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .sd-course-card-fact {
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--paper);
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--ink-soft);
  }
  .sd-course-card-foot {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-5) var(--sp-4);
    border-top: 1px solid var(--line);
  }
  .sd-course-card-price {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--ink);
  }
  .sd-course-card-price :global(.sd-now) { color: var(--ember); font-weight: 500; }
  .sd-course-card-price :global(.sd-was) { font-size: 0.8em; }
  .sd-course-card-go {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--ember);
    white-space: nowrap;
  }
  .sd-course-card-arrow {
    display: inline-block;
    transition: transform var(--d-base) var(--ease);
  }
  .sd-course-card--media:hover .sd-course-card-arrow { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    .sd-course-card--media,
    .sd-course-card--media:hover,
    .sd-course-card--media:hover .sd-course-card-media img,
    .sd-course-card--media:hover .sd-course-card-arrow { transform: none; }
  }
</style>
