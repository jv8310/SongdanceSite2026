---
import '../../styles/svh-twelve-week.css';
import Layout from '../../layouts/Layout.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import TWNav from '../../components/svh-twelve-week/TWNav.astro';
import TWHero from '../../components/svh-twelve-week/TWHero.astro';
import TWOpening from '../../components/svh-twelve-week/TWOpening.astro';
import TWSounding from '../../components/svh-twelve-week/TWSounding.astro';
import TWHonest from '../../components/svh-twelve-week/TWHonest.astro';
import TWOverview from '../../components/svh-twelve-week/TWOverview.astro';
import TWModules from '../../components/svh-twelve-week/TWModules.astro';
import TWWave from '../../components/svh-twelve-week/TWWave.astro';
import TWIntuition from '../../components/svh-twelve-week/TWIntuition.astro';
import TWWho from '../../components/svh-twelve-week/TWWho.astro';
import TWMoments from '../../components/svh-twelve-week/TWMoments.astro';
import TWPhilosophy from '../../components/svh-twelve-week/TWPhilosophy.astro';
import TWTestimonials from '../../components/svh-twelve-week/TWTestimonials.astro';
import TWJacob from '../../components/svh-twelve-week/TWJacob.astro';
import TWPractitioner from '../../components/svh-twelve-week/TWPractitioner.astro';
import TWFaq from '../../components/svh-twelve-week/TWFaq.astro';
import TWRegister from '../../components/svh-twelve-week/TWRegister.astro';
import TWFooter from '../../components/svh-twelve-week/TWFooter.astro';
import DiscoverMore from '../../components/DiscoverMore.astro';
import MetaProductView from '../../components/MetaProductView.astro';
import { catalogItemById } from '../../lib/catalog/products';

export const prerender = false;

const env = Astro.locals.runtime.env;
const product = catalogItemById('svh-12week');
---

<Layout
  title="Somatic Vocal Healing — The 12-Week Course | Songdance"
  description="Twelve weeks to learn the practice of Somatic Vocal Healing — until you can hold it yourself. A self-paced video course with live weekly Q&A: 12 modules, 18+ hours of guided practice, and lifetime access."
  image="/media/library/svh-retreat-circle-sunset-group-jacob-central.webp"
  imageAlt="A small group sounding together in a field at sunset."
>
  <MetaProductView
    pixelId={env.META_PIXEL_ID}
    contentId={product.id}
    contentName={product.title}
    value={product.priceEur}
  />
  <div class="tw-site">
    <PromoBanner />
    <TWNav />
    <TWHero />
    <TWOpening />
    <TWSounding />
    <TWHonest />
    <TWOverview />
    <TWModules />
    <TWWave />
    <TWIntuition />
    <TWWho />
    <TWMoments />
    <TWPhilosophy />
    <TWTestimonials />
    <TWJacob />
    <TWPractitioner />
    <TWFaq />
    <TWRegister />
    <DiscoverMore currentHref="/courses/12-week" />
    <TWFooter />
  </div>
</Layout>

<script>
  // Reveal-on-scroll + gentle in-page smooth scrolling. Self-contained,
  // progressive-enhancement only: if anything is unavailable, content shows.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
    );
    items.forEach((el) => io.observe(el));
    // Safety net: anything still hidden after load (e.g. very short pages) shows.
    window.addEventListener('load', () => {
      items.forEach((el) => {
        if (!el.classList.contains('is-visible')) {
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight) el.classList.add('is-visible');
        }
      });
    });

    document.documentElement.style.scrollBehavior = 'smooth';
  }
</script>
