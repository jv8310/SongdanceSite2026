---
// Bespoke landing page for the Professional Masterclass — the practitioner-
// facing sibling of /workshop. Same candle-lit build (workshop-english.css)
// with masterclass deltas in masterclass.css; copy per docs/svh-copy-book.md.
//
// This is the "missing tool" door (Somatic Vocal Healing in your work with
// clients). The same event has a second door at /courses/heal-the-healer —
// the practice for the space holder themselves — sharing this page's chrome
// (hero, path, FAQ, register …) through slots/props. Same seat, same checkout.
//
// This page is deliberately self-contained: no body links into other courses
// (owner's call, Aug 2026 — DiscoverMore removed, MCPath's certification link
// dropped). The slide-in SiteMenu keeps the full site reachable. Note:
// PromoBanner links /courses whenever a launch promo window is live — inert
// today; reconsider here if a promo is ever reopened.
import '../../styles/workshop-english.css';
import '../../styles/masterclass.css';
import Layout from '../../layouts/Layout.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import MCNav from '../../components/masterclass/MCNav.astro';
import MCHero from '../../components/masterclass/MCHero.astro';
import MCVideo from '../../components/masterclass/MCVideo.astro';
import MCOpening from '../../components/masterclass/MCOpening.astro';
import MCMoments from '../../components/masterclass/MCMoments.astro';
import MCWhat from '../../components/masterclass/MCWhat.astro';
import MCBenefits from '../../components/masterclass/MCBenefits.astro';
import MCWho from '../../components/masterclass/MCWho.astro';
import MCLyric from '../../components/masterclass/MCLyric.astro';
import MCTestimonials from '../../components/masterclass/MCTestimonials.astro';
import MCAbout from '../../components/masterclass/MCAbout.astro';
import MCPath from '../../components/masterclass/MCPath.astro';
import MCFaq from '../../components/masterclass/MCFaq.astro';
import MCRegister from '../../components/masterclass/MCRegister.astro';
import WEFooter from '../../components/workshop-english/WEFooter.astro';
import { buildCalendarItems, tzOptionsFor } from '../../lib/workshops/calendar';
import { currencyForCountry } from '../../lib/workshops/currency';
import MetaProductView from '../../components/MetaProductView.astro';
import { catalogItemById } from '../../lib/catalog/products';

export const prerender = false;

const env = Astro.locals.runtime.env;
const cf = (Astro.locals.runtime as any)?.cf;

// Cloudflare edge geo/timezone — no external API (mirrors /workshop).
const country: string = (cf?.country as string) || 'EU';
const detectedTz: string = (cf?.timezone as string) || 'Europe/Brussels';
const currency = currencyForCountry(country === 'EU' ? null : country);

// Upcoming published masterclasses + workshops, priced in the visitor's
// currency (shared with /workshop — see lib/workshops/calendar.ts). The
// register section leads with the masterclass dates and offers the workshop
// dates (incl. the instant-access replay) as the schedule-friendly fallback.
const items = await buildCalendarItems(env.DB, currency, detectedTz);
const tzOptions = tzOptionsFor(detectedTz);

// The next live masterclass, for the hero's date line (none → no line).
const nextMc = items.find((it) => it.kind === 'masterclass' && !it.isReplay) ?? null;

const product = catalogItemById('masterclass');
---

<Layout
  title="Professional Masterclass — Somatic Vocal Healing in Your Work | Songdance"
  description="A 100-minute live masterclass for therapists, coaches, bodyworkers, facilitators, teachers, and leaders — when words can't reach it, sound can. €44, online, with replay."
  image="/media/library/jacob-teaching.webp"
  imageAlt="Jacob teaching a Somatic Vocal Healing session."
>
  <div class="we-site">
    <PromoBanner />
    <MCNav />
    <MCHero nextWhen={nextMc?.whenLocal ?? null} nextStartsAt={nextMc?.startsAtUtc ?? null} />
    <MCVideo />
    <MCOpening />
    <MCMoments />
    <MCWhat />
    <MCBenefits />
    <MCWho />
    <MCLyric />
    <MCTestimonials />
    <MCAbout />
    <MCPath />
    <MCFaq />
    <MCRegister
      items={items}
      country={country}
      currency={currency}
      detectedTz={detectedTz}
      tzOptions={tzOptions}
    />
    <WEFooter />
  </div>
  <MetaProductView
    pixelId={env.META_PIXEL_ID}
    contentId={product.id}
    contentName={product.title}
    value={product.priceEur}
    loadPixel={false}
  />
</Layout>
