---
// The live pass: the weekly Q&As and the monthly deepening session, as a
// number of sessions (src/lib/courses/live-pass.ts). Reached mostly from the member app (a
// locked Q&A or deepening session) and the SVH app ("Apply for Certification",
// with ?extend=1), both of which put the member's address in ?email= (and their
// name in ?first_name= / ?last_name=) — so the page arrives filled in: the name
// and country from the link or from what the site holds for that address, the
// day their pass would start, the certification-window add-on only for a 9-month
// student it would help, and for a 12-week student the way on to the 9-month
// certification course.
//
// The order is the sell (October 2026): what the pass is and what it opens,
// then — for a 12-week student only — the certification course, then the
// prices and the checkout.
//
// Beside the three passes, the monthly (October 2026): €52 the first month, then
// €44 a month, renews until cancelled, every session while it runs (live-pass.ts,
// "The monthly's price"). ?months=monthly picks
// it; an address that already has one running sees "Manage my monthly pass" instead,
// which emails the manage link to that address (never shown on screen).
import SiteLayout from '../../components/SiteLayout.astro';
import { COUNTRIES, findCountry } from '../../lib/countries';
import { edgeCountry } from '../../lib/geo';
import { paypalConfigured } from '../../lib/payments/paypal';
import { SUPPORTED_CURRENCIES, formatMoney } from '../../lib/workshops/currency';
import { albumCurrencyForCountry } from '../../lib/music/product';
import {
  CERT_EXTENSION_PERCENT,
  LIVE_PASS_MONTHS,
  livePassContents,
  livePassMonthlyFirstCents,
  livePassMonthlyRenewalCents,
  livePassOffer,
  livePassSessions,
  parseLivePassMonths,
  type LivePassMonths,
} from '../../lib/courses/live-pass';
import { loadBuyerDetails, planLivePass } from '../../lib/courses/live-pass-plan';
import { findRunningMonthly } from '../../lib/courses/live-pass-monthly';

export const prerender = false;

const env = Astro.locals.runtime.env;
const params = Astro.url.searchParams;
const welcome = params.get('welcome') === '1';
const welcomeMonthly = params.get('welcome') === 'monthly';
const emailParam = (params.get('email') ?? '').trim().toLowerCase();
const emailPrefill = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailParam) ? emailParam : '';
const wantsExtension = params.get('extend') === '1';
const chosenMonthly = params.get('months') === 'monthly';
const chosenMonths: LivePassMonths = parseLivePassMonths(params.get('months')) ?? 3;
const nameParam = (k: string) => (params.get(k) ?? '').trim().slice(0, 100);

// With the address in the link, the page arrives answered: the same status the
// form asks for when an address is typed (/api/courses/live-pass-status).
let initialStatus: Record<string, unknown> | null = null;
let details = { firstName: null as string | null, lastName: null as string | null, country: null as string | null };
if (emailPrefill) {
  try {
    const [plan, d, monthly] = await Promise.all([
      planLivePass(env.DB, emailPrefill),
      loadBuyerDetails(env.DB, emailPrefill),
      findRunningMonthly(env.DB, emailPrefill),
    ]);
    details = d;
    initialStatus = {
      live_until: plan.liveUntil,
      pass_running: plan.passRunning,
      monthly_running: !!monthly,
      monthly_until: plan.monthlyUntil,
      periods: plan.periods,
      certification: {
        holds_course: plan.window.holdsCourse,
        may_certify: plan.window.mayCertify,
        ends_on: plan.window.endsOn,
        open: plan.window.open,
      },
      twelve_week: { holds: plan.twelveWeek.holds, live_until: plan.twelveWeek.liveUntil },
    };
  } catch {
    /* the form asks again from the browser */
  }
}
const firstNamePrefill = nameParam('first_name') || details.firstName || '';
const lastNamePrefill = nameParam('last_name') || details.lastName || '';
const certInitial = initialStatus?.certification as { holds_course?: boolean } | undefined;
const showAddon = !!certInitial?.holds_course;
const twelveInitial = initialStatus?.twelve_week as { holds?: boolean } | undefined;
const showUpgrade = !!twelveInitial?.holds && !certInitial?.holds_course;

// The day a pass starts, said before the options when their course (or a
// pass) still runs: it never begins inside live weeks they already have.
// Same words as the browser's showLiveUntil().
const fmtDay = (day: string) =>
  new Date(`${day}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const initialPeriods = initialStatus?.periods as Record<string, { startsOn: string }> | undefined;
const monthlyRunning = !!initialStatus?.monthly_running;
const startMonthly = chosenMonthly && !monthlyRunning;
const startNotice = startNoticeText(
  initialStatus?.live_until as string | null | undefined,
  !!initialStatus?.pass_running,
  initialPeriods?.[String(chosenMonths)]?.startsOn ?? null,
  startMonthly,
  (initialStatus?.monthly_until as string | null | undefined) ?? null,
  monthlyRunning,
);
function startNoticeText(
  liveUntil: string | null | undefined,
  passRunning: boolean,
  startsOn: string | null,
  monthly: boolean,
  monthlyUntil: string | null,
  monthlyRuns: boolean,
): string {
  const lines: string[] = [];
  if (monthlyUntil && !monthly) {
    lines.push(
      `Your monthly has paid for the sessions until ${fmtDay(monthlyUntil)}, so a pass starts the day after${startsOn ? `, on ${fmtDay(startsOn)}` : ''}.${monthlyRuns ? ' If you are switching to a pass, cancel the monthly under “Manage my monthly pass”, or it keeps renewing.' : ''}`,
    );
  }
  if (liveUntil) {
    lines.push(
      monthly
        ? `Your course gives you the live sessions until ${fmtDay(liveUntil)}. A monthly starts the day you take it, alongside them — a pass waits until they end.`
        : `Your course gives you the live sessions until ${fmtDay(liveUntil)}, so a pass only starts when they end${startsOn ? `, on ${fmtDay(startsOn)}` : ''}. You never pay for a session you already have.`,
    );
  }
  if (passRunning) {
    lines.push(
      monthly
        ? 'You have a pass running. A monthly starts the day you take it, alongside it — a new pass would wait for the one you have.'
        : 'Your current pass comes first: a new one continues with the session after its last.',
    );
  }
  return lines.join(' ');
}

const geoCountry = details.country ?? edgeCountry(Astro.locals);
const geoCountryMatch = geoCountry ? findCountry(geoCountry) : undefined;
const currency = albumCurrencyForCountry(geoCountry);
const paypalOk = paypalConfigured(env) && env.PAYPAL_ENABLED === 'true';

// Every price in every market, so the country field can repaint without a
// round trip. The server prices the charge with the same function.
const prices = Object.fromEntries(
  SUPPORTED_CURRENCIES.map((cur) => [
    cur,
    Object.fromEntries(LIVE_PASS_MONTHS.map((m) => [m, livePassOffer(m, cur)])),
  ]),
);
const offers = LIVE_PASS_MONTHS.map((m) => livePassOffer(m, currency));
// The monthly: the first month at the full price, every month after it less.
const monthlyPrices = Object.fromEntries(
  SUPPORTED_CURRENCIES.map((cur) => [cur, { first: livePassMonthlyFirstCents(cur), then: livePassMonthlyRenewalCents(cur) }]),
);
const monthlyFirstCents = livePassMonthlyFirstCents(currency);
const monthlyCents = livePassMonthlyRenewalCents(currency);
const monthlyTotal = (first: string, then: string) => `${first}, then ${then} a month`;
const certPageHref = `/courses/certification${emailPrefill ? `?email=${encodeURIComponent(emailPrefill)}` : ''}`;
const money = (cents: number) => formatMoney(cents, currency);
const aboutLabel = (m: number) => `About ${m} month${m === 1 ? '' : 's'}`;
// What a pass comes to a month, rounded up to a whole unit so it never reads
// cheaper than it is. The browser repaints it with the same sum.
const perMonthCents = (o: { price_cents: number; months: number }) => Math.ceil(o.price_cents / o.months / 100) * 100;

// The page sells first; a 12-week student then sees the certification course,
// just before the prices.
const features: { icon: string; title: string; body: string }[] = [
  {
    icon: 'ph-chats-circle',
    title: 'A live Q&A, every week',
    body: 'A live hour with Jacob — and on the calls he is not on, with Karen Evans. Bring your questions, a sound that surprised you, whatever came up in your practice.',
  },
  {
    icon: 'ph-moon-stars',
    title: 'Two hours deeper, every month',
    body: 'Once a month, alumni and current students take the work wider with Jacob — into questions that don’t fit a single class, and the practice as it lives now.',
  },
  {
    icon: 'ph-play-circle',
    title: 'Replays for 2 months',
    body: 'Can’t make the time? The replay of every session in your pass stays for 2 months, so you can catch up when your day allows.',
  },
  {
    icon: 'ph-ticket',
    title: 'Counted by the session',
    body: 'A pass holds the next Q&As and deepening sessions on the calendar. A week without a Q&A costs you nothing — your pass simply holds the next one.',
  },
  {
    icon: 'ph-calendar-plus',
    title: 'Never pay twice',
    body: 'Still have live sessions from your course? Your pass starts the day after they end, so it always adds to what you have.',
  },
  {
    icon: 'ph-video-camera',
    title: 'Live on Zoom, from the CiRCLE',
    body: 'Every session is under Events in the CiRCLE. Sign in with the address you use for your courses and join from there, wherever you are.',
  },
];

// What the 9 months add, for a 12-week student (same points as before the
// redesign).
const upgradeBenefits: { icon: string; lead: string; rest: string }[] = [
  { icon: 'ph-books', lead: 'The full class library', rest: ', every module with a written manual, self-paced and yours to keep.' },
  { icon: 'ph-calendar-check', lead: 'Weekly Q&As and the monthly two-hour deepening session', rest: ' for nine months, with no pass to buy.' },
  { icon: 'ph-hand-heart', lead: 'Practice Together', rest: ': give and receive with your peers, where you learn to hold space for someone else.' },
  { icon: 'ph-device-mobile', lead: 'The Somatic Vocal Healing app', rest: ': record and tag your own sounds, train your ear with quizzes and training rounds, ask SVH AI about everything taught in the Q&As, and find someone to practise with, live.' },
  { icon: 'ph-seal-check', lead: 'The path to becoming a certified practitioner', rest: ', if you choose to walk it.' },
  { icon: 'ph-clock-countdown', lead: 'Nothing overlaps.', rest: ' Join while your 12 weeks are still running and your nine months begin when they are over.' },
];

const faq: { q: string; a: string }[] = [
  {
    q: 'How long does a pass last?',
    a: 'As long as its sessions: 4, 12 or 24 Q&As and 1, 3 or 6 deepening sessions — the next ones on the calendar from the day it starts. A week without a Q&A costs you nothing: your pass simply holds the next one. It ends after the last of its sessions, and you keep their replays for 2 months.',
  },
  {
    q: 'When does my pass start?',
    a: 'The day you buy it — unless your course still gives you the live sessions: then it starts the day after they end, so you never pay twice for the same session. If you already have a pass, the new one continues with the session after its last. Fill in your email above and the start date shows before you pay.',
  },
  {
    q: 'I’m in the 12-week course',
    a: 'A pass continues your Q&As once your 12 weeks are over: it starts the day after they end, and brings the monthly deepening session with it. Or go on to the 9-month certification course, which carries the Q&As and the deepening sessions for nine months, with no pass to buy.',
  },
  {
    q: 'Where are the sessions?',
    a: 'Under Events in the CiRCLE, where you’ll also find the replays from your pass.',
  },
  {
    q: 'Is it a subscription?',
    a: 'A pass isn’t: you pay once, and it ends after its last session. We’ll let you know by email when 1 session is left, so you can add another whenever you like. The monthly is: it opens every session while it runs and renews on the same day each month, so there is nothing to remember.',
  },
  {
    q: 'How do I cancel the monthly?',
    a: 'Any time, in two clicks, from the link in its confirmation email (or ask for the link under “Manage my monthly pass” above). Nothing more is charged, and the sessions stay open until the end of the month you have already paid for.',
  },
];
---

<SiteLayout
  title="Live pass — the weekly Q&As and monthly deepening sessions"
  description="Sound with us live: 4, 12 or 24 Q&As and 1, 3 or 6 deepening sessions, or monthly until you cancel. For anyone whose course no longer includes the live sessions, or never did."
>
  <main class="lp">
    {welcome && (
      <section class="lp-narrow lp-card lp-welcome" role="status">
        <p class="lp-eyebrow">Payment received</p>
        <h2 class="lp-h3">Thank you — your pass is on its way into your account</h2>
        <p>
          A confirmation is on its way by email, with the day your pass starts. You'll find the
          sessions under <strong>Events</strong> in the CiRCLE from that day, with the
          same email address you paid with. Your receipt and invoice arrive by email too.
        </p>
      </section>
    )}
    {welcomeMonthly && (
      <section class="lp-narrow lp-card lp-welcome" role="status">
        <p class="lp-eyebrow">Payment received</p>
        <h2 class="lp-h3">Thank you — your monthly live pass is starting</h2>
        <p>
          A confirmation is on its way by email. You'll find every session under <strong>Events</strong>
          in the CiRCLE, with the same email address you paid with. It renews on the same day each
          month; the link in that email is how you cancel, any time.
        </p>
      </section>
    )}

    {/* 1 — The sell: what the pass is and what it opens. */}
    <section class="lp-hero">
      <div class="lp-hero-text">
        <p class="lp-eyebrow">The live pass</p>
        <h1 class="lp-title">Keep sounding with us, <em>live</em></h1>
        <p class="lp-lede">
          Every week a live Q&amp;A with Jacob, and once a month a two-hour deepening session —
          alumni and current students together. For anyone whose course no longer includes the
          live sessions, or never did.
        </p>
        <ul class="lp-hero-meta">
          <li><i class="ph-light ph-chats-circle" aria-hidden="true"></i> A live Q&amp;A every week</li>
          <li><i class="ph-light ph-moon-stars" aria-hidden="true"></i> A 2-hour deepening session every month</li>
          <li><i class="ph-light ph-play-circle" aria-hidden="true"></i> Replays for 2 months</li>
        </ul>
        <div class="lp-hero-actions">
          <a class="sd-btn sd-btn-primary" href="#get">
            <span>Choose your pass</span>
            <i class="ph-light ph-arrow-down" aria-hidden="true"></i>
          </a>
          <a class="lp-quiet-link" href="#inside">What's inside</a>
        </div>
      </div>
      <figure class="lp-hero-photo">
        <img
          src="/media/library/svh-retreat-teaching-jacob-laughing.webp"
          alt="Jacob laughing at the microphone, in the middle of answering a question"
          width="1333"
          height="2000"
          decoding="async"
          fetchpriority="high"
        />
        <span class="lp-live"><span class="lp-live-dot" aria-hidden="true"></span> Live, every week</span>
      </figure>
    </section>

    <section class="lp-for" aria-labelledby="lp-for-title">
      <h2 class="lp-for-title" id="lp-for-title">The pass is for you when</h2>
      <ul class="lp-for-list">
        <li><i class="ph-light ph-graduation-cap" aria-hidden="true"></i> Your nine months of certification are over</li>
        <li><i class="ph-light ph-hourglass-medium" aria-hidden="true"></i> Your 12 weeks have come to an end</li>
        <li><i class="ph-light ph-books" aria-hidden="true"></i> Your course never came with live sessions</li>
      </ul>
    </section>

    <section class="lp-inside" id="inside" aria-labelledby="lp-inside-title">
      <div class="lp-section-head">
        <p class="lp-eyebrow">What the pass opens</p>
        <h2 class="lp-h2" id="lp-inside-title">Every week a Q&amp;A.<br /> Every month, <em>two hours deeper.</em></h2>
      </div>
      <div class="lp-features">
        {features.map((f) => (
          <article class="lp-feature">
            <span class="lp-feature-icon" aria-hidden="true"><i class={`ph-light ${f.icon}`}></i></span>
            <h3 class="lp-feature-title">{f.title}</h3>
            <p class="lp-feature-body">{f.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="lp-quote" aria-label="Sounding together">
      <p class="lp-quote-eyebrow">Witnessed, not watched</p>
      <p class="lp-quote-text">
        Sounding alone is one thing. Sounding where others can hear you is another.
      </p>
      <p class="lp-quote-sub">
        Something happens in a circle that doesn't happen alone: being heard changes what dares to
        come out.
      </p>
    </section>

    {/* For a 12-week student not (yet) on the 9 months: the way on, between
        the sell and the prices — shown once the address says so. Under the
        checkout it was easy to miss. */}
    <section class="lp-upgrade" data-lp-upgrade hidden={!showUpgrade} aria-labelledby="lp-upgrade-title">
      <div class="lp-upgrade-intro">
        <p class="lp-eyebrow lp-eyebrow--on-night">From the 12 weeks</p>
        <h2 class="lp-upgrade-title" id="lp-upgrade-title">Or go further: the 9-month <em>certification course</em></h2>
        <p class="lp-upgrade-body">
          A pass keeps your Q&amp;As going. The certification course continues the work the 12 weeks
          began — and brings the live sessions with it for nine months, with no pass to buy.
        </p>
        <a class="sd-btn sd-btn-on-night lp-upgrade-btn" href={certPageHref} data-lp-upgrade-link>
          <span>See the certification course</span>
          <i class="ph-light ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
      <ul class="lp-benefits">
        {upgradeBenefits.map((b) => (
          <li>
            <i class={`ph-light ${b.icon}`} aria-hidden="true"></i>
            <span><strong>{b.lead}</strong>{b.rest}</span>
          </li>
        ))}
      </ul>
    </section>

    {/* 2 — The prices, and the checkout. */}
    <section class="lp-buy" id="get" aria-labelledby="lp-buy-title">
      <div class="lp-section-head">
        <p class="lp-eyebrow">Choose your pass</p>
        <h2 class="lp-h2" id="lp-buy-title">Pay once, <em>or go monthly</em></h2>
        <p class="lp-section-lede">
          The longer the pass, the less each session costs. Or take the monthly, and cancel any
          time. Prices follow your country.
        </p>
      </div>

      <div class="lp-card lp-buy-card">
        <form
          class="lp-form"
          data-lp-form
          novalidate
          data-prices={JSON.stringify(prices)}
          data-monthly-prices={JSON.stringify(monthlyPrices)}
          data-status={initialStatus ? JSON.stringify(initialStatus) : undefined}
        >
          <p class="lp-status" data-lp-status role="status" hidden={!startNotice}>{startNotice}</p>

          <fieldset class="lp-options">
            <legend class="lp-sr">Choose your pass</legend>
            <div class="lp-plans">
              {offers.map((o) => {
                const s = livePassSessions(o.months);
                return (
                  <label class:list={['lp-plan', o.months === 6 && 'lp-plan--best']}>
                    <input
                      type="radio"
                      name="months"
                      value={o.months}
                      checked={!startMonthly && o.months === chosenMonths}
                      data-lp-contents={livePassContents(o.months)}
                    />
                    {o.months === 6 && <span class="lp-ribbon">Best value</span>}
                    <span class="lp-plan-check" aria-hidden="true"><i class="ph-light ph-check"></i></span>
                    <span class="lp-plan-len">{aboutLabel(o.months)}</span>
                    <span class="lp-plan-price">
                      <strong data-lp-price={o.months}>{money(o.price_cents)}</strong>
                      {o.discount_percent > 0 && <s class="lp-was" data-lp-was={o.months}>{money(o.full_cents)}</s>}
                    </span>
                    <span class="lp-plan-per">
                      <span><span data-lp-per={o.months}>{money(perMonthCents(o))}</span> a month</span>
                      {o.discount_percent > 0 && <span class="lp-save">{o.discount_percent}% off</span>}
                    </span>
                    <span class="lp-plan-holds">
                      <span><i class="ph-light ph-chats-circle" aria-hidden="true"></i> {s.qa} Q&amp;As</span>
                      <span><i class="ph-light ph-moon-stars" aria-hidden="true"></i> {s.deepening} deepening session{s.deepening === 1 ? '' : 's'}</span>
                    </span>
                    <span class="lp-plan-dates" data-lp-dates={o.months} hidden></span>
                  </label>
                );
              })}
            </div>

            <p class="lp-or"><span>or</span></p>

            <label class="lp-plan lp-plan--monthly" data-lp-monthly-option>
              <input type="radio" name="months" value="monthly" checked={startMonthly} disabled={monthlyRunning} />
              <span class="lp-plan-check" aria-hidden="true"><i class="ph-light ph-check"></i></span>
              <span class="lp-monthly-icon" aria-hidden="true"><i class="ph-light ph-repeat"></i></span>
              <span class="lp-monthly-main">
                <span class="lp-plan-len">Monthly <span class="lp-save lp-save--plain">Cancel any time</span></span>
                <span class="lp-monthly-desc">Every Q&amp;A and deepening session while it runs. Renews each month until you cancel.</span>
                <span class="lp-plan-dates" data-lp-monthly-note hidden={!monthlyRunning}>
                  {monthlyRunning ? 'You already have a monthly running — manage it below.' : ''}
                </span>
              </span>
              {/* Leads with what it costs a month; the first month's higher price sits under it. */}
              <span class="lp-monthly-price">
                <span class="lp-monthly-rate"><strong data-lp-monthly-price>{money(monthlyCents)}</strong> <span class="lp-per">a month</span></span>
                <span class="lp-monthly-first">First month <span data-lp-monthly-first>{money(monthlyFirstCents)}</span></span>
              </span>
            </label>
          </fieldset>

          {/* Only for a 9-month (certification) student; shown once the address says so. */}
          <label class="lp-addon" data-lp-addon hidden={!showAddon || startMonthly}>
            <input type="checkbox" name="cert_extension" checked={wantsExtension && showAddon} />
            <span>
              <span class="lp-addon-head">
                <span><i class="ph-light ph-seal-check" aria-hidden="true"></i> Extend my certification window</span>
                <span class="lp-addon-price">+<span data-lp-ext>{money(offers.find((o) => o.months === chosenMonths)!.extension_cents)}</span></span>
              </span>
              <span class="lp-addon-body">
                Keeps your window to apply for certification open for the months of your pass (1, 3
                or 6, from the day it starts). For certification students whose window has closed.
                Adds {CERT_EXTENSION_PERCENT}% to the pass.
              </span>
              <span class="lp-addon-note" data-lp-addon-note hidden></span>
            </span>
          </label>

          <h3 class="lp-step">Your details</h3>
          <div class="lp-fields">
            <label class="lp-field">
              <span>First name</span>
              <input
                type="text"
                name="first_name"
                autocomplete="given-name"
                required
                maxlength="100"
                value={firstNamePrefill || undefined}
              />
            </label>
            <label class="lp-field">
              <span>Last name</span>
              <input
                type="text"
                name="last_name"
                autocomplete="family-name"
                required
                maxlength="100"
                value={lastNamePrefill || undefined}
              />
            </label>
            <label class="lp-field lp-field--full">
              <span>Email <span class="lp-hint">— the address you use for your courses</span></span>
              <input
                type="email"
                name="email"
                autocomplete="email"
                required
                maxlength="254"
                value={emailPrefill || undefined}
                data-lp-email
              />
            </label>
            <label class="lp-field lp-field--full">
              <span>Country</span>
              <input
                type="text"
                name="country_search"
                list="lp-country-list"
                autocomplete="country-name"
                placeholder="Start typing…"
                required
                value={geoCountryMatch?.name ?? ''}
                data-lp-country-search
              />
              <input type="hidden" name="country" value={geoCountryMatch?.code ?? ''} data-lp-country />
            </label>
          </div>

          <label class="lp-terms">
            <input type="checkbox" name="consent_terms" required />
            <span>
              I agree to the <a href="/terms" target="_blank" rel="noopener">terms</a> &amp;{' '}
              <a href="/privacy" target="_blank" rel="noopener">privacy policy</a>.
            </span>
          </label>

          <div class="lp-summary">
            <span data-lp-summary-label>{startMonthly ? 'Live pass · monthly' : `Live pass · ${livePassContents(chosenMonths)}`}</span>
            <strong data-lp-total>{startMonthly ? monthlyTotal(money(monthlyFirstCents), money(monthlyCents)) : money(offers.find((o) => o.months === chosenMonths)!.price_cents)}</strong>
          </div>

          <div class="lp-actions">
            <button type="submit" class="sd-btn sd-btn-primary" data-lp-submit data-provider="stripe">
              <span>Pay by card</span>
              <i class="ph-light ph-arrow-right" aria-hidden="true"></i>
            </button>
            {paypalOk && (
              <button type="submit" class="sd-btn lp-paypal" data-lp-submit data-provider="paypal">
                Pay with <strong>PayPal</strong>
              </button>
            )}
          </div>
          <p class="lp-note" data-lp-note-pass hidden={startMonthly}>
            <i class="ph-light ph-lock-simple" aria-hidden="true"></i>
            One payment, no subscription. Charged in your local currency — the price follows your country.
          </p>
          <p class="lp-note" data-lp-note-monthly hidden={!startMonthly}>
            <i class="ph-light ph-lock-simple" aria-hidden="true"></i>
            The first month is charged today, and every month after it, at the lower price, on the
            same day each month until you cancel — any time, from the link in your confirmation
            email. Charged in your local currency.
          </p>
          <p class="lp-error" role="alert" data-lp-error hidden></p>
        </form>
        <datalist id="lp-country-list">
          {COUNTRIES.map((c) => (
            <option value={c.name} data-code={c.code}>{c.flag} {c.name}</option>
          ))}
        </datalist>
      </div>
    </section>

    <section class="lp-narrow lp-card lp-manage" id="manage" aria-labelledby="lp-manage-title">
      <h2 class="lp-h3" id="lp-manage-title"><i class="ph-light ph-repeat" aria-hidden="true"></i> Manage my monthly pass</h2>
      <p>
        To see when your monthly renews, or to cancel it, use the link in its confirmation email.
        Lost it? Enter the address you pay with and we'll send it there again.
      </p>
      <form class="lp-manage-form" data-lp-manage novalidate>
        <input
          type="email"
          name="email"
          autocomplete="email"
          required
          maxlength="254"
          placeholder="you@example.com"
          aria-label="Your email address"
          value={emailPrefill || undefined}
        />
        <button type="submit" class="sd-btn sd-btn-primary">Send me the link</button>
      </form>
      <p class="lp-manage-msg" role="status" data-lp-manage-msg hidden></p>
    </section>

    <section class="lp-narrow lp-faq" aria-labelledby="lp-faq-title">
      <h2 class="lp-h2" id="lp-faq-title">Good to know</h2>
      {faq.map((q) => (
        <details class="lp-faq-item">
          <summary>{q.q}<i class="ph-light ph-plus" aria-hidden="true"></i></summary>
          <p>{q.a}</p>
        </details>
      ))}
    </section>
  </main>
</SiteLayout>

<script>
  import { albumCurrencyForCountry } from '../../lib/music/product';
  import { formatMoney } from '../../lib/workshops/currency';
  import { COUNTRIES } from '../../lib/countries';

  type Offer = { price_cents: number; full_cents: number; extension_cents: number };
  type Period = { startsOn: string; endsOn: string; extensionHelps: boolean };
  type Status = {
    live_until: string | null;
    pass_running?: boolean;
    monthly_running?: boolean;
    monthly_until?: string | null;
    periods: Record<string, Period>;
    certification: { holds_course: boolean; may_certify: boolean; ends_on: string | null; open: boolean };
    twelve_week?: { holds: boolean; live_until: string | null };
    details?: { first_name: string | null; last_name: string | null; country: string | null };
  };

  const form = document.querySelector<HTMLFormElement>('[data-lp-form]');
  if (form) {
    const prices = JSON.parse(form.dataset.prices || '{}') as Record<string, Record<string, Offer>>;
    const monthlyPrices = JSON.parse(form.dataset.monthlyPrices || '{}') as Record<string, { first: number; then: number }>;
    const monthlyInput = form.querySelector<HTMLInputElement>('[name="months"][value="monthly"]')!;
    const monthlyFirstEl = form.querySelector<HTMLElement>('[data-lp-monthly-first]')!;
    const monthlyPriceEl = form.querySelector<HTMLElement>('[data-lp-monthly-price]')!;
    const monthlyNote = form.querySelector<HTMLElement>('[data-lp-monthly-note]')!;
    const notePass = form.querySelector<HTMLElement>('[data-lp-note-pass]')!;
    const noteMonthly = form.querySelector<HTMLElement>('[data-lp-note-monthly]')!;
    const countrySearch = form.querySelector<HTMLInputElement>('[data-lp-country-search]')!;
    const countryHidden = form.querySelector<HTMLInputElement>('[data-lp-country]')!;
    const emailInput = form.querySelector<HTMLInputElement>('[data-lp-email]')!;
    const statusEl = form.querySelector<HTMLElement>('[data-lp-status]')!;
    const addonLabel = form.querySelector<HTMLElement>('[data-lp-addon]')!;
    const addonInput = form.querySelector<HTMLInputElement>('[name="cert_extension"]')!;
    const addonNote = form.querySelector<HTMLElement>('[data-lp-addon-note]')!;
    const upgradeEl = document.querySelector<HTMLElement>('[data-lp-upgrade]');
    const upgradeLink = document.querySelector<HTMLAnchorElement>('[data-lp-upgrade-link]');
    const wantsExtension = new URLSearchParams(location.search).get('extend') === '1';
    const totalEl = form.querySelector<HTMLElement>('[data-lp-total]')!;
    const summaryLabel = form.querySelector<HTMLElement>('[data-lp-summary-label]')!;
    const extEl = form.querySelector<HTMLElement>('[data-lp-ext]')!;
    const errEl = form.querySelector<HTMLElement>('[data-lp-error]')!;
    const buttons = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-lp-submit]'));
    let status: Status | null = form.dataset.status ? (JSON.parse(form.dataset.status) as Status) : null;
    let countryTouched = false;

    const fmtDay = (day: string) =>
      new Date(`${day}T12:00:00Z`).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      });
    const isMonthly = () => monthlyInput.checked;
    // The chosen pass length; 3 while the monthly is chosen (only the pass
    // pieces read it then).
    const months = () => {
      const v = form.querySelector<HTMLInputElement>('[name="months"]:checked')?.value;
      return v && v !== 'monthly' ? Number(v) : 3;
    };
    const currency = () => albumCurrencyForCountry(countryHidden.value || null);

    function repaint() {
      const cur = currency();
      const table = prices[cur] ?? prices.EUR;
      for (const [m, o] of Object.entries(table)) {
        const price = form!.querySelector<HTMLElement>(`[data-lp-price="${m}"]`);
        const was = form!.querySelector<HTMLElement>(`[data-lp-was="${m}"]`);
        const per = form!.querySelector<HTMLElement>(`[data-lp-per="${m}"]`);
        if (price) price.textContent = formatMoney(o.price_cents, cur);
        if (was) was.textContent = formatMoney(o.full_cents, cur);
        // Same sum as the server's perMonthCents: rounded up to a whole unit.
        if (per) per.textContent = formatMoney(Math.ceil(o.price_cents / Number(m) / 100) * 100, cur);
      }
      const monthlyCents = monthlyPrices[cur] ?? monthlyPrices.EUR;
      monthlyFirstEl.textContent = formatMoney(monthlyCents.first, cur);
      monthlyPriceEl.textContent = formatMoney(monthlyCents.then, cur);
      const m = months();
      const o = table[m];
      extEl.textContent = formatMoney(o.extension_cents, cur);
      const monthly = isMonthly();
      // No certification-window add-on with the monthly: it is sold with a pass.
      if (monthly) addonInput.checked = false;
      const ext = addonInput.checked ? o.extension_cents : 0;
      if (monthly) {
        totalEl.textContent = `${formatMoney(monthlyCents.first, cur)}, then ${formatMoney(monthlyCents.then, cur)} a month`;
        summaryLabel.textContent = 'Live pass · monthly';
      } else {
        totalEl.textContent = formatMoney(o.price_cents + ext, cur);
        const contents = form!.querySelector<HTMLInputElement>('[name="months"]:checked')?.dataset.lpContents ?? '';
        summaryLabel.textContent = `Live pass · ${contents}${ext ? ' + certification window' : ''}`;
      }
      notePass.hidden = monthly;
      noteMonthly.hidden = !monthly;

      // One monthly per address: with one running, the option steps aside.
      const running = !!status?.monthly_running;
      monthlyInput.disabled = running;
      if (running && monthly) {
        monthlyInput.checked = false;
        form!.querySelector<HTMLInputElement>('[name="months"][value="3"]')!.checked = true;
      }
      monthlyNote.hidden = !running;
      monthlyNote.textContent = running ? 'You already have a monthly running — manage it below.' : '';

      // The day each pass would start, and the add-on's verdict, once the
      // address is known. No end date: a pass ends with its last session.
      for (const [key, p] of Object.entries(status?.periods ?? {})) {
        const el = form!.querySelector<HTMLElement>(`[data-lp-dates="${key}"]`);
        if (!el) continue;
        el.hidden = false;
        el.textContent = `From ${fmtDay(p.startsOn)}`;
      }
      // The add-on is for 9-month students only; the 12-week card for 12-week
      // students who are not (yet) on the 9 months.
      const c = status?.certification;
      addonLabel.hidden = !c?.holds_course || isMonthly();
      if (!c?.holds_course) addonInput.checked = false;
      if (upgradeEl) upgradeEl.hidden = !(status?.twelve_week?.holds && !c?.holds_course);
      if (status && c?.holds_course) {
        const p = status.periods[String(m)];
        addonNote.hidden = false;
        if (!p?.extensionHelps && c.ends_on) {
          addonNote.textContent = `Your certification window already runs until ${fmtDay(c.ends_on)}, past the end of this pass.`;
        } else if (!c.may_certify) {
          addonNote.textContent = `With the extension you may apply for certification until ${fmtDay(p.endsOn)}.`;
        } else if (c.ends_on) {
          addonNote.textContent = `${c.open ? 'Your window is open until' : 'Your window closed on'} ${fmtDay(c.ends_on)}. With the extension it stays open until ${fmtDay(p.endsOn)}.`;
        }
        const helps = !!p?.extensionHelps;
        addonInput.disabled = !helps;
        if (!helps) addonInput.checked = false;
      }
    }

    // Fill what is still empty with what the site holds for this address; a
    // country only replaces the guess from where the visitor is, never a choice.
    function fillDetails(d: Status['details']) {
      if (!d) return;
      const first = form!.querySelector<HTMLInputElement>('[name="first_name"]')!;
      const last = form!.querySelector<HTMLInputElement>('[name="last_name"]')!;
      if (!first.value && d.first_name) first.value = d.first_name;
      if (!last.value && d.last_name) last.value = d.last_name;
      if (!countryTouched && d.country) {
        const match = COUNTRIES.find((c) => c.code === d.country);
        if (match) {
          countrySearch.value = match.name;
          countryHidden.value = match.code;
        }
      }
    }

    // Same words as the server's startNoticeText(), with the chosen length's day.
    function showLiveUntil() {
      const lines: string[] = [];
      const monthly = isMonthly();
      if (status?.monthly_until && !monthly) {
        const startsOn = status.periods?.[String(months())]?.startsOn;
        lines.push(
          `Your monthly has paid for the sessions until ${fmtDay(status.monthly_until)}, so a pass starts the day after${startsOn ? `, on ${fmtDay(startsOn)}` : ''}.${status.monthly_running ? ' If you are switching to a pass, cancel the monthly under “Manage my monthly pass”, or it keeps renewing.' : ''}`,
        );
      }
      if (status?.live_until) {
        const startsOn = status.periods?.[String(months())]?.startsOn;
        lines.push(
          monthly
            ? `Your course gives you the live sessions until ${fmtDay(status.live_until)}. A monthly starts the day you take it, alongside them — a pass waits until they end.`
            : `Your course gives you the live sessions until ${fmtDay(status.live_until)}, so a pass only starts when they end${startsOn ? `, on ${fmtDay(startsOn)}` : ''}. You never pay for a session you already have.`,
        );
      }
      if (status?.pass_running) {
        lines.push(
          monthly
            ? 'You have a pass running. A monthly starts the day you take it, alongside it — a new pass would wait for the one you have.'
            : 'Your current pass comes first: a new one continues with the session after its last.',
        );
      }
      statusEl.hidden = lines.length === 0;
      statusEl.textContent = lines.join(' ');
    }

    async function lookUp() {
      const email = emailInput.value.trim().toLowerCase();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return;
      try {
        const res = await fetch('/api/courses/live-pass-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) return;
        const fresh = (await res.json()) as Status;
        const wasCertStudent = !!status?.certification.holds_course;
        status = fresh;
        fillDetails(fresh.details);
        // Arrived with ?extend=1 and the address only now known: tick it for them.
        if (wantsExtension && !wasCertStudent && fresh.certification.holds_course) addonInput.checked = true;
        if (upgradeLink) upgradeLink.href = `/courses/certification?email=${encodeURIComponent(email)}`;
        showLiveUntil();
        repaint();
      } catch {
        /* the page works without it; the checkout checks again */
      }
    }

    const resolveCountry = () => {
      const typed = countrySearch.value.trim().toLowerCase();
      const match = COUNTRIES.find((c) => c.name.toLowerCase() === typed || c.code.toLowerCase() === typed);
      countryHidden.value = match?.code ?? '';
      repaint();
    };
    (['input', 'change', 'blur'] as const).forEach((ev) => countrySearch.addEventListener(ev, resolveCountry));
    countrySearch.addEventListener('input', () => (countryTouched = true));
    form.querySelectorAll<HTMLInputElement>('[name="months"]').forEach((r) =>
      r.addEventListener('change', () => {
        showLiveUntil();
        repaint();
      }),
    );
    addonInput.addEventListener('change', repaint);
    emailInput.addEventListener('change', lookUp);
    emailInput.addEventListener('blur', lookUp);
    showLiveUntil();
    repaint();
    // Answered on the server when the address came in the link; asked here otherwise.
    if (emailInput.value && !status) void lookUp();

    let provider: 'stripe' | 'paypal' = 'stripe';
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        provider = b.dataset.provider === 'paypal' ? 'paypal' : 'stripe';
      }),
    );

    const fail = (msg: string) => {
      errEl.textContent = msg;
      errEl.hidden = false;
      buttons.forEach((b) => (b.disabled = false));
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.hidden = true;
      const fd = new FormData(form);
      const get = (k: string) => String(fd.get(k) ?? '').trim();
      if (!get('first_name') || !get('last_name')) return fail('Please add your first and last name.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(get('email'))) return fail('Please enter a valid email address.');
      if (!get('country')) return fail('Please pick your country from the list.');
      if (fd.get('consent_terms') !== 'on') return fail('Please agree to the terms to continue.');
      buttons.forEach((b) => (b.disabled = true));
      try {
        const res = await fetch('/api/courses/live-pass-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            months: isMonthly() ? 'monthly' : months(),
            cert_extension: !isMonthly() && addonInput.checked,
            first_name: get('first_name'),
            last_name: get('last_name'),
            email: get('email'),
            country: get('country'),
            consent_terms: true,
            provider,
          }),
        });
        const data = (await res.json().catch(() => ({}))) as { checkout_url?: string; error?: string };
        if (!res.ok || !data.checkout_url) return fail(data.error || 'Could not start checkout — please try again.');
        location.href = data.checkout_url;
      } catch {
        fail('We could not reach the server. Please try again.');
      }
    });
  }

  // "Manage my monthly pass": the link goes to the inbox on the order, never on screen.
  const manage = document.querySelector<HTMLFormElement>('[data-lp-manage]');
  const manageMsg = document.querySelector<HTMLElement>('[data-lp-manage-msg]');
  if (manage && manageMsg) {
    manage.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = manage.querySelector<HTMLInputElement>('[name="email"]')!;
      const button = manage.querySelector<HTMLButtonElement>('button')!;
      const email = input.value.trim().toLowerCase();
      const say = (text: string) => {
        manageMsg.textContent = text;
        manageMsg.hidden = false;
      };
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return say('Please enter a valid email address.');
      button.disabled = true;
      try {
        const res = await fetch('/api/courses/live-pass-manage-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = (await res.json().catch(() => ({}))) as { message?: string; error?: string };
        say(data.message || data.error || 'Please try again in a minute.');
      } catch {
        say('We could not reach the server. Please try again.');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .lp { max-width: 1120px; margin: 0 auto; padding: 48px 20px 96px; color: var(--ink); font-family: var(--font-body); }
  /* Several pieces carry their own display; hidden must still hide them. */
  .lp [hidden] { display: none !important; }
  .lp-narrow { max-width: 760px; margin-left: auto; margin-right: auto; }
  .lp-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .lp-eyebrow {
    font-size: 12px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--ember-deep); margin: 0 0 12px;
  }
  .lp-eyebrow--on-night { color: var(--ember-soft); }
  .lp-h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 3.6vw, 40px); line-height: 1.15; margin: 0; }
  .lp-h3 { font-family: var(--font-display); font-weight: 400; font-size: 24px; line-height: 1.25; margin: 0 0 10px; }
  /* Cormorant inside a Spectral heading reads small: size it up. */
  .lp-title em, .lp-h2 em, .lp-upgrade-title em { font-family: var(--font-lyric); font-style: italic; font-size: 1.05em; color: var(--plum); }
  .lp-card { background: var(--paper-soft); border: 1px solid var(--line); border-radius: 20px; padding: 28px; }
  .lp-welcome { border-color: var(--moss); margin-bottom: 36px; }
  .lp-welcome p:last-child { margin: 0; line-height: 1.6; }

  /* ── 1. The sell ─────────────────────────────────────────────────────── */
  .lp-hero { display: grid; gap: 32px; align-items: center; margin-bottom: 40px; }
  .lp-title {
    font-family: var(--font-display); font-weight: 400; font-size: clamp(38px, 6vw, 64px);
    line-height: 1.05; letter-spacing: -0.01em; margin: 0 0 18px;
  }
  .lp-title, .lp-h2, .lp-upgrade-title, .lp-quote-text { text-wrap: balance; }
  .lp-lede { font-size: 19px; line-height: 1.6; color: var(--ink-soft); margin: 0 0 24px; max-width: 34em; }
  .lp-hero-meta { list-style: none; padding: 0; margin: 0 0 30px; display: grid; gap: 10px; }
  .lp-hero-meta li { display: flex; align-items: center; gap: 12px; font-size: 16px; }
  .lp-hero-meta i { flex: none; font-size: 22px; color: var(--ember); }
  .lp-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .lp-quiet-link { font-size: 15px; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--ember); padding-bottom: 2px; }
  .lp-quiet-link:hover { color: var(--ember-deep); }
  .lp-hero-photo {
    position: relative; margin: 0; border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 3;
    background: var(--paper-deep); box-shadow: 0 28px 60px -34px rgba(42, 27, 42, 0.55);
  }
  .lp-hero-photo img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 55% 42%; }
  .lp-live {
    position: absolute; left: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; border-radius: 999px; background: rgba(250, 245, 234, 0.92); color: var(--ink);
    font-size: 13px; font-weight: 500;
  }
  .lp-live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ember); animation: lp-pulse 2s ease-out infinite; }
  @keyframes lp-pulse {
    0% { box-shadow: 0 0 0 0 rgba(201, 96, 58, 0.5); }
    100% { box-shadow: 0 0 0 10px rgba(201, 96, 58, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .lp-live-dot { animation: none; } }
  @media (min-width: 880px) {
    .lp-hero { grid-template-columns: 1.15fr 0.85fr; gap: 56px; margin-bottom: 48px; }
    .lp-hero-photo { aspect-ratio: 4 / 5; }
  }

  .lp-for {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding: 16px 20px;
    border-radius: 16px; background: var(--paper-deep); margin-bottom: 80px;
  }
  .lp-for-title { font-family: var(--font-body); font-size: 14px; font-weight: 600; margin: 0; }
  .lp-for-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lp-for-list li {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px;
    background: var(--paper-soft); border: 1px solid var(--line); font-size: 14px;
  }
  .lp-for-list i { font-size: 18px; color: var(--plum); }

  .lp-section-head { text-align: center; max-width: 680px; margin: 0 auto 36px; }
  .lp-section-lede { font-size: 17px; line-height: 1.6; color: var(--ink-soft); margin: 14px 0 0; }

  .lp-inside { margin-bottom: 72px; scroll-margin-top: 96px; }
  .lp-features { display: grid; gap: 16px; }
  .lp-feature { background: var(--paper-soft); border: 1px solid var(--line); border-radius: 18px; padding: 24px; }
  .lp-feature-icon {
    display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 14px;
    background: var(--ember-glow); color: var(--ember-deep); font-size: 26px; margin-bottom: 16px;
  }
  .lp-feature-title { font-family: var(--font-display); font-weight: 400; font-size: 21px; line-height: 1.25; margin: 0 0 8px; }
  .lp-feature-body { font-size: 15.5px; line-height: 1.6; color: var(--ink-soft); margin: 0; }
  @media (min-width: 640px) { .lp-features { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .lp-features { grid-template-columns: repeat(3, 1fr); } }

  .lp-quote { text-align: center; max-width: 760px; margin: 0 auto 80px; }
  .lp-quote-eyebrow { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-quiet); margin: 0 0 14px; }
  .lp-quote-text { font-family: var(--font-lyric); font-style: italic; font-size: clamp(28px, 4vw, 40px); line-height: 1.25; color: var(--plum); margin: 0 0 14px; }
  .lp-quote-sub { font-size: 16px; line-height: 1.6; color: var(--ink-quiet); margin: 0; }

  /* ── 2. The prices ───────────────────────────────────────────────────── */
  .lp-buy { margin-bottom: 64px; scroll-margin-top: 96px; }
