---
// "Stop these emails" — the page behind the button on every course sequence
// email (the weekly Authentic Singing Journey sessions, the 12-week and
// certification onboarding notes). See src/lib/courses/emails/stop-link.ts.
//
// GET only shows where the series stands and one button; the button POSTs back
// here — so an inbox scanner prefetching the link can never stop anyone's
// journey. Once stopped, the same page offers to start it again, from the step
// it stopped at. A stop is this one series only: no unsubscribe from
// Songdance, and the course itself is untouched.
import Layout from '../../layouts/Layout.astro';
import { verifySequenceToken } from '../../lib/courses/emails/stop-link';
import {
  SEQUENCES,
  getEnrolment,
  isSequenceKey,
  resumeEnrolment,
  stopEnrolment,
  type EnrolmentRow,
  type SequenceKey,
} from '../../lib/courses/emails/sequences';

export const prerender = false;

const env = Astro.locals.runtime.env;
const secret = env.ADMIN_SESSION_SECRET;

let token = '';
let action = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  token = String(form.get('t') ?? '').trim();
  action = String(form.get('action') ?? '').trim();
} else {
  token = (Astro.url.searchParams.get('t') ?? '').trim();
}

const id = secret ? await verifySequenceToken(secret, token) : null;
let row: EnrolmentRow | null = id ? await getEnrolment(env.DB, id) : null;
let justChanged: 'stopped' | 'resumed' | null = null;

if (row && Astro.request.method === 'POST') {
  if (action === 'stop' && !row.stopped_at && !row.completed_at) {
    if (await stopEnrolment(env.DB, row.id, 'link')) justChanged = 'stopped';
  } else if (action === 'resume' && row.stopped_at && !row.completed_at) {
    if (await resumeEnrolment(env.DB, row.id)) justChanged = 'resumed';
  }
  row = await getEnrolment(env.DB, row.id);
}

// The page speaks the series' own language: the Dutch weekly series (Authentiek
// Zingen) gets a Dutch page, everything else English.
type Copy = {
  pageTitle: string;
  confirmTitle: string;
  resumedTitle: string;
  resumedA: string;
  nextUp: string;
  confirmA: string;
  nextWould: string;
  note: string;
  stopBtn: string;
  stoppedJustTitle: string;
  stoppedTitle: string;
  stopped: string;
  changedMind: string;
  resumeBtn: string;
  completeTitle: string;
  complete: string;
};

function copyFor(key: SequenceKey): Copy {
  if (key === 'asj-weekly-nl') {
    const series = 'de wekelijkse mails van Authentiek Zingen';
    const keep = 'Alle veertig sessies blijven van jou';
    return {
      pageTitle: 'Je mails — Songdance',
      confirmTitle: 'Deze mails stoppen?',
      resumedTitle: 'Ze komen weer',
      resumedA: `Je ontvangt ${series} weer`,
      nextUp: 'de volgende:',
      confirmA: `Dit stopt ${series} naar`,
      nextWould: 'De volgende zou zijn:',
      note: `${keep} hoe dan ook — in de Songdance CiRCLE, zolang je ze hebt. Dit stopt alleen deze mails.`,
      stopBtn: 'Stop deze mails',
      stoppedJustTitle: 'Klaar — ze zijn gestopt',
      stoppedTitle: 'Deze mails zijn gestopt',
      stopped: `Je ontvangt ${series} niet meer. ${keep}, net als voorheen — verder verandert er niets.`,
      changedMind: 'Toch van gedacht veranderd? Je kunt ze weer laten komen, vanaf waar ze stopten.',
      resumeBtn: 'Laat ze weer komen',
      completeTitle: 'Deze reeks is afgerond',
      complete: `Alle wekelijkse mails van Authentiek Zingen zijn al verstuurd — er is niets meer om te stoppen. ${keep} in de Songdance CiRCLE.`,
    };
  }
  const series =
    key === 'asj-weekly'
      ? 'the weekly Authentic Singing Journey emails'
      : key === 'twelve-week'
        ? 'the 12-Week Course emails'
        : 'the Certification Course emails';
  const keep = key === 'asj-weekly' ? 'All forty sessions stay yours' : 'The course stays yours';
  return {
    pageTitle: 'Course emails — Songdance',
    confirmTitle: 'Stop these emails?',
    resumedTitle: 'They’re back on',
    resumedA: `You’ll receive ${series} again`,
    nextUp: 'next up:',
    confirmA: `This stops ${series} to`,
    nextWould: 'The next one would be',
    note: `${keep} either way — in the Songdance CiRCLE, for as long as you have it. This only stops these emails.`,
    stopBtn: 'Stop these emails',
    stoppedJustTitle: 'Done — they’ve stopped',
    stoppedTitle: 'These emails are stopped',
    stopped: `You won’t receive ${series} any more. ${keep}, exactly as before — nothing else changes.`,
    changedMind: 'Changed your mind? You can pick them up again, from where they stopped.',
    resumeBtn: 'Start them again',
    completeTitle: 'That series is complete',
    complete: `Every one of ${series} has already gone out — there’s nothing left to stop. ${keep} in the Songdance CiRCLE.`,
  };
}

const key = row && isSequenceKey(row.sequence) ? row.sequence : null;
const t = key ? copyFor(key) : null;
const nextLabel =
  row && key && !row.completed_at
    ? SEQUENCES[key].steps.find((s) => s.n === row!.next_step)?.label ?? null
    : null;
const state: 'invalid' | 'active' | 'stopped' | 'completed' = !row || !t
  ? 'invalid'
  : row.completed_at
    ? 'completed'
    : row.stopped_at
      ? 'stopped'
      : 'active';
---

<Layout title={t?.pageTitle ?? 'Course emails — Songdance'} description="">
  <main class="seq">
    <section class="seq-card">
      {state === 'active' && t && (
        <>
          <h1>{justChanged === 'resumed' ? t.resumedTitle : t.confirmTitle}</h1>
          {justChanged === 'resumed' ? (
            <p>
              {t.resumedA}{nextLabel ? <> — {t.nextUp} <strong>{nextLabel}</strong></> : ''}.
            </p>
          ) : (
            <>
              <p>
                {t.confirmA} <strong>{row!.email}</strong>.
                {nextLabel && <> {t.nextWould} <strong>{nextLabel}</strong>.</>}
              </p>
              <p class="seq-note">{t.note}</p>
              <form method="post">
                <input type="hidden" name="t" value={token} />
                <input type="hidden" name="action" value="stop" />
                <button type="submit">{t.stopBtn}</button>
              </form>
            </>
          )}
        </>
      )}
      {state === 'stopped' && t && (
        <>
          <h1>{justChanged === 'stopped' ? t.stoppedJustTitle : t.stoppedTitle}</h1>
          <p>{t.stopped}</p>
          <p class="seq-note">{t.changedMind}</p>
          <form method="post">
            <input type="hidden" name="t" value={token} />
            <input type="hidden" name="action" value="resume" />
            <button type="submit" class="seq-ghost">{t.resumeBtn}</button>
          </form>
        </>
      )}
      {state === 'completed' && t && (
        <>
          <h1>{t.completeTitle}</h1>
          <p>{t.complete}</p>
        </>
      )}
      {state === 'invalid' && (
        <>
          <h1>This link looks incomplete</h1>
          <p>
            We couldn’t verify it. Try the button in the email again, or write to
            <a href="mailto:support@songdance.co">support@songdance.co</a> and we’ll stop
            the emails for you ourselves.
          </p>
        </>
      )}
    </section>
  </main>

  <style>
    .seq {
      min-height: 60vh;
      display: grid;
      place-items: center;
      padding: 64px 16px;
      background: #f4ecdf;
    }
    .seq-card {
      max-width: 480px;
      width: 100%;
      background: #fbf6ec;
      border: 1px solid rgba(161, 72, 38, 0.22);
      border-radius: 14px;
      padding: 36px 34px;
      font-family: Georgia, 'Times New Roman', serif;
      color: #4a3848;
      line-height: 1.65;
    }
    .seq-card h1 {
      margin: 0 0 14px;
      font-weight: 400;
      font-size: 26px;
      line-height: 1.2;
      color: #2a1b2a;
    }
    .seq-card p { margin: 0 0 14px; }
    .seq-note { font-size: 14px; color: #6f5f6d; }
    .seq-card button {
      background: #2a1b2a;
      color: #f4ecdf;
      font-family: Georgia, serif;
      font-size: 15px;
      border: 1px solid #2a1b2a;
      padding: 14px 26px;
      border-radius: 999px;
      cursor: pointer;
    }
    .seq-card button.seq-ghost {
      background: transparent;
      color: #2a1b2a;
    }
    .seq-card a { color: #a14826; }
  </style>
</Layout>
