---
import '../../styles/certification-course.css';
import Layout from '../../layouts/Layout.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import CCNav from '../../components/certification-course/CCNav.astro';
import CCHero from '../../components/certification-course/CCHero.astro';
import CCRegisterTeaser from '../../components/certification-course/CCRegisterTeaser.astro';
import CCOpening from '../../components/certification-course/CCOpening.astro';
import CCName from '../../components/certification-course/CCName.astro';
import CCFoundation from '../../components/certification-course/CCFoundation.astro';
import CCLearn from '../../components/certification-course/CCLearn.astro';
import CCIntuition from '../../components/certification-course/CCIntuition.astro';
import CCStructure from '../../components/certification-course/CCStructure.astro';
import CCClasses from '../../components/certification-course/CCClasses.astro';
import CCCeee from '../../components/certification-course/CCCeee.astro';
import CCApp from '../../components/certification-course/CCApp.astro';
import CCQandA from '../../components/certification-course/CCQandA.astro';
import CCForWhom from '../../components/certification-course/CCForWhom.astro';
import CCDoubt from '../../components/certification-course/CCDoubt.astro';
import CCTestimonials from '../../components/certification-course/CCTestimonials.astro';
import CCIncludes from '../../components/certification-course/CCIncludes.astro';
import CCCertification from '../../components/certification-course/CCCertification.astro';
import CCAboutJacob from '../../components/certification-course/CCAboutJacob.astro';
import CCStillUnsure from '../../components/certification-course/CCStillUnsure.astro';
import CCRegister from '../../components/certification-course/CCRegister.astro';
import CCFooter from '../../components/certification-course/CCFooter.astro';
import DiscoverMore from '../../components/DiscoverMore.astro';
import MetaProductView from '../../components/MetaProductView.astro';
import { catalogItemById } from '../../lib/catalog/products';

export const prerender = false;

const env = Astro.locals.runtime.env;
const product = catalogItemById('cc-cert');
---

<Layout
  title="The Somatic Vocal Healing Certification Course — Songdance"
  description="A deepening journey with Jacob Vermeulen. Fully self-paced — instant access to the class library with written manuals — with weekly live Q&As, hosted practice sessions and monthly live deepening sessions through the end of 2026, the Somatic Vocal Healing app, and a global community of people walking it together. Become a certified Somatic Vocal Healing practitioner — or simply go fully in with your own voice."
  image="/media/library/svh-retreat-facilitator-jacob-seated.webp"
  imageAlt="Jacob holding space at a Somatic Vocal Healing retreat."
>
  <MetaProductView
    pixelId={env.META_PIXEL_ID}
    contentId={product.id}
    contentName={product.title}
    value={product.priceEur}
  />
  <div class="cc-site">
    <PromoBanner />
    <CCNav />
    <CCHero />
    <CCRegisterTeaser />
    <CCOpening />
    <CCName />
    <CCFoundation />
    <CCLearn />
    <CCIntuition />
    <CCStructure />
    <CCClasses />
    <CCCeee />
    <CCApp />
    <CCQandA />
    <CCForWhom />
    <CCDoubt />
    <CCTestimonials />
    <CCIncludes />
    <CCCertification />
    <CCAboutJacob />
    <CCStillUnsure />
    <CCRegister />
    <DiscoverMore currentHref="/courses/certification" />
    <CCFooter />
  </div>
</Layout>
