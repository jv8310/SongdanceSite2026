---
import SiteLayout from '../../components/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SoftCta from '../../components/SoftCta.astro';
---

<SiteLayout
  title="Inner Child Healing Journey — Songdance"
  description="A guided journey to meet, hear, and tend the younger parts of you — through sound, and gently."
>
  <PageHero
    eyebrow="Guided journey"
    title="Inner Child Healing Journey"
    lede="It’s never too late to restore the voice of your inner child."
    image="/media/library/svh-retreat-walk-tree-sunset.webp"
  >
    <div class="sd-pagehero-actions">
      <a href="/contact" class="sd-btn sd-btn-primary">Begin</a>
    </div>
  </PageHero>

  <section class="sd-section sd-prose">
    <div class="sd-prose-inner">
      <p>
        A guided journey to meet, hear, and tend the younger parts of you — through sound, and
        gently. You go at your own pace, with your own voice, and nothing is forced.
      </p>
    </div>
  </section>

  <SoftCta />
</SiteLayout>
