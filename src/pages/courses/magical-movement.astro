---
import '../../styles/journeys.css';
import Layout from '../../layouts/Layout.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import JourneyRegister from '../../components/journeys/JourneyRegister.astro';
import JourneyCrossPromo from '../../components/journeys/JourneyCrossPromo.astro';
import MMJSessions from '../../components/journeys/MMJSessions.astro';
import MMJReels from '../../components/journeys/MMJReels.astro';
import DiscoverMore from '../../components/DiscoverMore.astro';
import MetaProductView from '../../components/MetaProductView.astro';
import { catalogItemById } from '../../lib/catalog/products';
import SiteMenu from '../../components/SiteMenu.astro';

export const prerender = false;

const env = Astro.locals.runtime.env;
const product = catalogItemById('mmj');

const testimonials = [
  {
    body: 'I always said I can’t dance. Turns out I just couldn’t be watched. Alone in my own room, it’s another story entirely.',
    who: 'Margreet',
  },
  {
    body: 'I do it from my chair most mornings now. No one had ever told me a body like mine was allowed to dance.',
    who: 'Pieter',
  },
  {
    body: 'I’d forgotten my body could feel like this — light, a little silly, completely mine.',
    who: 'Aïcha',
  },
  {
    body: 'Halfway through one session I caught myself laughing. I hadn’t moved like that since I was a kid in the kitchen.',
    who: 'Sam',
  },
];
---

<Layout
  title="The Magical Movement Journey — Songdance"
  description="Guided movement sessions you can do in your own room — standing or seated. No steps to learn, no floor to be good enough for. For every body."
  image="/media/library/movement.webp"
>
  <MetaProductView
    pixelId={env.META_PIXEL_ID}
    contentId={product.id}
    contentName={product.title}
    value={product.priceEur}
  />
  <div class="jr-site jr-theme-movement">
    <PromoBanner />
    <!-- Nav -->
    <nav class="jr-nav">
      <div class="jr-nav-inner">
        <a href="/" class="jr-nav-mark" aria-label="Songdance">
          <img src="/brand/logo-wordmark.svg" alt="Songdance" />
        </a>
        <div class="jr-nav-spacer"></div>
        <div class="jr-nav-meta">
          <span>Guided sessions</span>
          <span class="dot"></span>
          <span>Standing or seated</span>
        </div>
        <a href="#register" class="jr-nav-cta">Begin · €49</a>
        <button class="sm-trigger" data-sm-trigger aria-label="Open menu" aria-expanded="false">
          <i class="ph-light ph-list"></i>
        </button>
      </div>
    </nav>
    <SiteMenu />

    <!-- Hero -->
    <header class="jr-hero">
      <div class="jr-hero-bg" aria-hidden="true">
        <img src="/media/library/movement.webp" alt="" />
      </div>
      <div class="jr-hero-inner">
        <img class="jr-hero-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
        <div class="jr-hero-eyebrow">Magical Movement Journey</div>
        <h1 class="jr-hero-head">Dancing, with <em>no one watching</em> and nothing to get right.</h1>
        <p class="jr-hero-sub">
          Guided movement sessions you can do in your own room — standing, or seated in a chair. No
          steps to learn. No floor to be good enough for.
        </p>
        <a href="#register" class="jr-hero-cta">
          Begin the journey <i class="ph-light ph-arrow-right"></i>
        </a>
        <p class="jr-hero-micro">One payment · lifetime access · begin anytime.</p>
        <div class="jr-hero-meta">
          <span>Guided sessions</span>
          <span class="dot"></span>
          <span>Standing or seated</span>
          <span class="dot"></span>
          <span>Self-paced</span>
        </div>
      </div>
    </header>

    <!-- What it is -->
    <section class="jr-section jr-opening">
      <div class="jr-opening-inner">
        <div class="jr-eyebrow" style="justify-content:center;">What it is</div>
        <h2 class="jr-opening-head">A way <em>back.</em></h2>
        <p class="jr-prose-body">
          Most of us danced freely once. As children we moved because the music moved us — no one
          taught us, no one judged it. Then, somewhere, we learned to hold still: too old, too big,
          too stiff, two left feet. The body that was made to move went quiet.
        </p>
        <p class="jr-prose-body">
          The Magical Movement Journey is a way back. A set of guided sessions, each carried by its
          own music, with just enough gentle direction to keep you company and all the room in the
          world to move how you like. There's no choreography. Nothing to get right.
        </p>
      </div>
    </section>

    <!-- Accessibility -->
    <section class="jr-section jr-split">
      <div class="jr-split-inner">
        <figure class="jr-split-figure">
          <img src="/media/library/dancing-body2.webp" alt="A woman dancing barefoot in her sunlit living room" loading="lazy" />
        </figure>
        <div class="jr-split-text">
          <div class="jr-eyebrow">For every body</div>
          <h2 class="jr-h2" style="margin-bottom: var(--sp-5);">Built to fit <em>any body.</em></h2>
          <p>
            It's built to fit any body. You can dance it standing, or sitting in a chair if that's
            what your body needs today. Age, size, fitness, experience — none of it is the entry fee.
          </p>
          <p>
            <em>If you can move something, you can do this.</em>
          </p>
        </div>
      </div>
    </section>

    <!-- A quiet note on what it touches -->
    <section class="jr-section jr-note">
      <div class="jr-note-inner">
        <div class="jr-eyebrow">A quiet note</div>
        <p>
          For a lot of us, what shut the door on moving freely was shame — being laughed at, told to
          settle down, made to feel like too much.
        </p>
        <p>
          This isn't about forcing past that. It's about meeting the body again, kindly, at whatever
          pace it trusts.
        </p>
      </div>
    </section>

    <!-- The ten sessions -->
    <MMJSessions />

    <!-- Origin — set apart as a tinted band to break the page -->
    <section class="jr-section mmj-origin">
      <div class="mmj-origin-inner">
        <img class="mmj-origin-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
        <div class="jr-eyebrow" style="justify-content:center;">Where it came from</div>
        <h2 class="jr-opening-head">It grew on real <em>dance floors.</em></h2>
        <p class="jr-prose-body">
          It grew out of years on real dance floors — retreats and rooms full of ordinary people, not
          dancers — and out of one plain observation: when someone stops performing and lets the music
          move them, something opens. You can watch it happen. This is a way to make that moment
          available at home.
        </p>
      </div>
    </section>

    <!-- See the music in action — South Africa, 2021 -->
    <MMJReels />

    <!-- Mid-page CTA -->
    <section class="jr-midcta">
      <div class="jr-midcta-inner">
        <p class="jr-midcta-line">Push the furniture back — or don't — and move how you like.</p>
        <a href="#register" class="jr-midcta-btn">Begin the journey <i class="ph-light ph-arrow-right"></i></a>
        <p class="jr-midcta-note">Standing or seated · self-paced · €49</p>
      </div>
    </section>

    <!-- How deep it goes — full-screen parallax -->
    <section class="jr-deep" style="background-image:url('/media/library/movement-beach.webp'); background-position: center 38%;">
      <div class="jr-deep-inner">
        <div class="jr-eyebrow">Why it works</div>
        <h2 class="jr-deep-head">The body knew <em>first.</em></h2>
        <p class="jr-deep-body">
          Long before you learned the steps — before you learned to hold still — the body knew how to
          move what it felt. This doesn't teach it anything new. It gives the body permission to
          remember, and lets what's been held still begin to move through.
        </p>
        <p class="jr-deep-lyric">Let the body lead. It still knows the way.</p>
      </div>
    </section>

    <!-- Mid-page CTA -->
    <section class="jr-midcta">
      <div class="jr-midcta-inner">
        <p class="jr-midcta-line">Let the body remember how — one session is all it takes to start.</p>
        <a href="#register" class="jr-midcta-btn">Begin the journey <i class="ph-light ph-arrow-right"></i></a>
        <p class="jr-midcta-note">Lifetime access · for every body · €49</p>
      </div>
    </section>

    <!-- Lyric break -->
    <section class="jr-lyric">
      <div class="jr-lyric-bg" aria-hidden="true">
        <img src="/media/library/movement-stillness.webp" alt="" />
      </div>
      <div class="jr-lyric-inner">
        <img class="jr-lyric-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
        <p class="jr-lyric-text">The body remembers how.</p>
        <div class="jr-lyric-by">Magical Movement Journey</div>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="jr-section jr-whom">
      <div class="jr-whom-inner">
        <div class="jr-whom-head">
          <div class="jr-eyebrow" style="justify-content:center;">Who it's for</div>
          <h2 class="jr-h2">For anyone who used to dance in the kitchen — and <em>stopped.</em></h2>
        </div>
        <div class="jr-whom-body">
          <figure class="jr-whom-figure">
            <img src="/media/library/movement2.webp" alt="A woman dancing freely in her living room" loading="lazy" />
          </figure>
          <div class="jr-whom-listwrap">
            <ul class="jr-whom-list">
              <li>For anyone who used to dance in the kitchen and stopped.</li>
              <li>For anyone who's sure they <em>can't dance</em> — that one's especially welcome here.</li>
              <li>You don't need to be fit, flexible, or coordinated.</li>
              <li>You don't need a studio, or to be alone in one.</li>
              <li>You need a little space and a willingness to be moved.</li>
            </ul>
            <p class="jr-whom-foot">No one's keeping score.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="jr-section jr-testimonials">
      <div class="jr-testimonials-inner">
        <div class="jr-testimonials-head">
          <div class="jr-eyebrow">Voices from the journey</div>
          <h2 class="jr-h2">What it has been for others.</h2>
        </div>
        <div class="jr-testimonials-grid">
          {testimonials.map((t) => (
            <article class="jr-testimonial">
              <div class="jr-testimonial-stars" aria-label="5 out of 5">
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
              </div>
              <p class="jr-testimonial-body">“{t.body}”</p>
              <div class="jr-testimonial-by"><span class="who">{t.who}</span></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Register / buy (dark, integrated) -->
    <JourneyRegister
      course="mmj"
      heroImg="/media/library/movement.webp"
      lede="Put on one session, push the furniture back — or don't — and move how you like, with no one keeping score. Choose your way in below."
      bullets={[
        'Guided movement sessions with original music',
        'Do-at-home — standing, or seated in a chair',
        'No steps, no choreography, nothing to get right',
        'Lifetime access — return anytime',
      ]}
    />

    <!-- More journeys -->
    <JourneyCrossPromo current="mmj" />

    <DiscoverMore currentHref="/courses/magical-movement" />

    <!-- Footer -->
    <footer class="jr-footer">
      <div class="jr-footer-inner">
        <div class="jr-footer-top">
          <div>
            <img class="jr-footer-mark" src="/brand/logo-wordmark.svg" alt="Songdance" />
            <p class="jr-footer-lyric">The body remembers how.</p>
          </div>
          <div class="jr-footer-links">
            <a href="/courses">All courses &amp; journeys</a>
            <a href="/what-is-svh">What is Somatic Vocal Healing?</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
        <div class="jr-footer-base">
          <span>© 2026 Songdance</span>
          <span>Sound that comes from you.</span>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  /* The origin moment, set apart from the cream sections around it: a soft
     moss band (the movement theme's own green) with the brand mark, so the
     page has a visual breath before the South-Africa clips. */
  .mmj-origin {
    background: linear-gradient(180deg, var(--jr-accent-glow) 0%, var(--jr-accent-soft) 100%);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .mmj-origin-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .mmj-origin-mark {
    width: 46px;
    height: 46px;
    display: block;
    margin: 0 auto var(--sp-5);
    opacity: 0.9;
  }
  .mmj-origin .jr-prose-body {
    color: var(--ink-soft);
  }
</style>
