---
import SiteLayout from '../../components/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SoftCta from '../../components/SoftCta.astro';
---

<SiteLayout
  title="Magical Movement Journey — Songdance"
  description="Ten guided musical journeys that move sound into the body through movement."
>
  <PageHero
    eyebrow="Guided journeys · music"
    title="Magical Movement Journey"
    lede="10 guided musical journeys."
    image="/media/library/svh-retreat-sounding-green-shirt.webp"
  >
    <div class="sd-pagehero-actions">
      <a href="/contact" class="sd-btn sd-btn-primary">Ask about this journey</a>
    </div>
  </PageHero>

  <section class="sd-section sd-prose">
    <div class="sd-prose-inner">
      <p>
        Ten guided journeys that move sound into the body through movement — a gentle, playful way
        to let the voice and the body find each other.
      </p>
    </div>
  </section>

  <SoftCta />
</SiteLayout>
