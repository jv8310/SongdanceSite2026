---
import '../../styles/journeys.css';
import Layout from '../../layouts/Layout.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import JourneyVideo from '../../components/journeys/JourneyVideo.astro';
import JourneyRegister from '../../components/journeys/JourneyRegister.astro';
import JourneyCrossPromo from '../../components/journeys/JourneyCrossPromo.astro';
import MetaProductView from '../../components/MetaProductView.astro';
import { catalogItemById } from '../../lib/catalog/products';
import SiteMenu from '../../components/SiteMenu.astro';

export const prerender = false;

const env = Astro.locals.runtime.env;
const product = catalogItemById('asj');

const testimonials = [
  {
    body: 'I feel an opening up, a stronger voice on many levels — like someone holding my hand, showing me new ways.',
    who: 'Frances',
  },
  {
    body: 'By the end I felt like I was engaged in an act of worship. What a beautiful gift the voice is.',
    who: 'Bridie',
  },
  {
    body: 'What a powerful practice — to acknowledge the place of tension, and to befriend it rather than push it away or try to fix it.',
    who: 'Lorenz',
  },
  {
    body: 'I noticed how strong my fear of being heard is. The session helped me move through it — and opened a little doorway into how I hold myself back elsewhere in life.',
    who: 'Kitty',
  },
];
---

<Layout
  title="The Authentic Singing Journey — Songdance"
  description="Forty weeks of mantras and music, made to free the voice you already have. Self-paced, at home. No range, no experience, no performance required."
  image="/media/library/singing-lights-woman.webp"
>
  <MetaProductView
    pixelId={env.META_PIXEL_ID}
    contentId={product.id}
    contentName={product.title}
    value={product.priceEur}
  />
  <div class="jr-site jr-theme-singing">
    <PromoBanner />
    <!-- Nav -->
    <nav class="jr-nav">
      <div class="jr-nav-inner">
        <a href="/" class="jr-nav-mark" aria-label="Songdance">
          <img src="/brand/logo-wordmark.svg" alt="Songdance" />
        </a>
        <div class="jr-nav-spacer"></div>
        <div class="jr-nav-meta">
          <span>40 sessions</span>
          <span class="dot"></span>
          <span>Self-paced · at home</span>
        </div>
        <a href="#register" class="jr-nav-cta">Begin · €99</a>
        <button class="sm-trigger" data-sm-trigger aria-label="Open menu" aria-expanded="false">
          <i class="ph-light ph-list"></i>
        </button>
      </div>
    </nav>
    <SiteMenu />

    <!-- Hero -->
    <header class="jr-hero">
      <div class="jr-hero-bg" aria-hidden="true">
        <img src="/media/library/singing-lights-woman.webp" alt="" />
      </div>
      <div class="jr-hero-inner">
        <img class="jr-hero-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
        <div class="jr-hero-eyebrow">Authentic Singing Journey · the course Songdance began with</div>
        <h1 class="jr-hero-head">Singing, with <em>nothing to prove.</em></h1>
        <p class="jr-hero-sub">
          Forty weeks of mantras and music — made to free the voice you already have, not to train it
          into something else.
        </p>
        <a href="#register" class="jr-hero-cta">
          Begin the journey <i class="ph-light ph-arrow-right"></i>
        </a>
        <p class="jr-hero-micro">One payment · lifetime access · begin anytime.</p>
        <div class="jr-hero-meta">
          <span>40 weekly sessions</span>
          <span class="dot"></span>
          <span>Self-paced</span>
          <span class="dot"></span>
          <span><strong>3,500+ voices freed</strong></span>
        </div>
      </div>
    </header>

    <!-- What it is -->
    <section class="jr-section jr-opening">
      <div class="jr-opening-inner">
        <div class="jr-eyebrow" style="justify-content:center;">What it is</div>
        <h2 class="jr-opening-head">The course Songdance <em>started with.</em></h2>
        <p class="jr-prose-body">
          Forty weekly sessions, each one a piece of music and a mantra, recorded to be done at home —
          eyes closed if you like, no screen required. You sing along. That's the whole of it.
        </p>
        <p class="jr-prose-body">
          It is singing, but not the kind that asks you to be good at it. No right notes. No audition.
          No one listening but you. You're not here to learn technique — you're here to let a voice
          that's been kept quiet make some sound again.
        </p>
      </div>
    </section>

    <!-- Stat -->
    <section class="jr-section jr-stat">
      <div class="jr-stat-inner">
        <div class="jr-stat-num">3,500<span>+</span></div>
        <p class="jr-stat-label">voices freed, and counting.</p>
        <p class="jr-stat-note">Since the very first session went out</p>
      </div>
    </section>

    <!-- Origin -->
    <section class="jr-section jr-split jr-split--rev">
      <div class="jr-split-inner">
        <figure class="jr-split-figure">
          <img src="/media/library/jacob-upala-on-rock.webp" alt="Jacob and Upala, facing one another by a river" loading="lazy" />
          <figcaption>Jacob &amp; Upala — where the work began</figcaption>
        </figure>
        <div class="jr-split-text">
          <div class="jr-eyebrow">Where it came from</div>
          <h2 class="jr-h2" style="margin-bottom: var(--sp-5);">Made one week at a time.</h2>
          <p>
            The sessions weren't written at a desk. They were made one week at a time, in a difficult
            season, by two people using the practice on themselves before anyone else heard it.
          </p>
          <p>
            When something worked for them, it tended to work for others too. <em>That is still the only
            test the work trusts.</em>
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="jr-section jr-opening">
      <div class="jr-opening-inner">
        <div class="jr-eyebrow" style="justify-content:center;">How it works</div>
        <h2 class="jr-opening-head">One session a week. <em>Forty weeks.</em></h2>
        <p class="jr-prose-body">
          One session a week for forty weeks — or at whatever pace suits you. Each week travels
          somewhere different: another rhythm, another landscape, another mood. You never quite know
          what's coming, and that's the point. The mind can't rehearse, so you arrive in the present
          and sing from there.
        </p>
        <p class="jr-prose-body">
          Some weeks are joyful. Some are quiet. Some go to the harder feelings and give them a tune
          to ride out on. You sing all of it — not to get rid of anything, but to let it be heard.
        </p>
      </div>
    </section>

    <!-- How deep it goes — full-screen ocean parallax -->
    <section class="jr-deep" style="background-image:url('/media/library/singing-water.webp')">
      <div class="jr-deep-inner">
        <div class="jr-eyebrow">How deep it goes</div>
        <h2 class="jr-deep-head">It isn't really about the <em>voice.</em></h2>
        <p class="jr-deep-body">
          Sing from yourself for long enough and you notice the singing was never quite the point.
          Something underneath gets a hearing — the parts that learned, early, to stay quiet. The
          voice just happens to be the way in: it goes below the floor where words are kept, and
          reaches what talking circles for years.
        </p>
        <p class="jr-deep-lyric">The voice was there before the words. It still knows the way.</p>
      </div>
    </section>

    <!-- Video glimpse — custom square player -->
    <JourneyVideo
      src="/media/library/jacob-upala-singing.mov"
      poster="/media/library/jacob-upala-singing.webp"
      label="A glimpse"
      title="Jacob and Upala, <em>singing.</em>"
      sub="A few minutes of the voice doing what this whole journey is for — sounding from itself, with nothing to prove."
    />

    <!-- Lyric break -->
    <section class="jr-lyric">
      <div class="jr-lyric-bg" aria-hidden="true">
        <img src="/media/library/singing-nature.webp" alt="" />
      </div>
      <div class="jr-lyric-inner">
        <img class="jr-lyric-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
        <p class="jr-lyric-text">Perfect for the moment. Not perfect for the radio.</p>
        <div class="jr-lyric-by">Authentic Singing Journey</div>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="jr-section jr-whom">
      <div class="jr-whom-inner">
        <div class="jr-whom-head">
          <div class="jr-eyebrow" style="justify-content:center;">Who it's for</div>
          <h2 class="jr-h2">For anyone who loves to sing and rarely <em>lets themselves.</em></h2>
        </div>
        <div class="jr-whom-body">
          <figure class="jr-whom-figure">
            <img src="/media/library/singing-statue.webp" alt="A sculpted figure, head tilted, listening" loading="lazy" />
          </figure>
          <div class="jr-whom-listwrap">
            <ul class="jr-whom-list">
              <li>For anyone who loves to sing and rarely lets themselves.</li>
              <li>For anyone who was told once that they <em>couldn't</em> — and believed it.</li>
              <li>You don't need experience.</li>
              <li>You don't need a range.</li>
              <li>You need a little privacy and the willingness to make some sound.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="jr-section jr-testimonials">
      <div class="jr-testimonials-inner">
        <div class="jr-testimonials-head">
          <div class="jr-eyebrow">Voices from the journey</div>
          <h2 class="jr-h2">What it has been for others.</h2>
        </div>
        <div class="jr-testimonials-grid">
          {testimonials.map((t) => (
            <article class="jr-testimonial">
              <div class="jr-testimonial-stars" aria-label="5 out of 5">
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
              </div>
              <p class="jr-testimonial-body">“{t.body}”</p>
              <div class="jr-testimonial-by"><span class="who">{t.who}</span></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Register / buy (dark, integrated) -->
    <JourneyRegister
      course="asj"
      heroImg="/media/library/singing-lights-woman.webp"
      lede="Forty weeks with your own voice — most people find it's the best company they've kept in years. Choose your way in below."
      bullets={[
        '40 self-paced audio sessions — music + a mantra each',
        'Do-at-home — eyes closed if you like, no screen',
        'Lifetime access — go at your own pace',
        'Optional PRO mantra pack, licensed for facilitators',
      ]}
    />

    <!-- More journeys -->
    <JourneyCrossPromo current="asj" />

    <!-- Footer -->
    <footer class="jr-footer">
      <div class="jr-footer-inner">
        <div class="jr-footer-top">
          <div>
            <img class="jr-footer-mark" src="/brand/logo-wordmark.svg" alt="Songdance" />
            <p class="jr-footer-lyric">First the truth. Then the tune.</p>
          </div>
          <div class="jr-footer-links">
            <a href="/courses">All courses &amp; journeys</a>
            <a href="/what-is-svh">What is Somatic Vocal Healing?</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
        <div class="jr-footer-base">
          <span>© 2026 Songdance</span>
          <span>Sound that comes from you.</span>
        </div>
      </div>
    </footer>
  </div>
</Layout>
