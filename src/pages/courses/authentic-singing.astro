---
import '../../styles/journeys.css';
import Layout from '../../layouts/Layout.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import JourneyVideo from '../../components/journeys/JourneyVideo.astro';
import JourneyRegister from '../../components/journeys/JourneyRegister.astro';
import JourneyCrossPromo from '../../components/journeys/JourneyCrossPromo.astro';
import DiscoverMore from '../../components/DiscoverMore.astro';
import MetaProductView from '../../components/MetaProductView.astro';
import { catalogItemById } from '../../lib/catalog/products';
import SiteMenu from '../../components/SiteMenu.astro';

export const prerender = false;

const env = Astro.locals.runtime.env;
const product = catalogItemById('asj');

// The forty session thumbnails (ASJ-WeekX in the R2 library). Week 29 is the
// English-edition file, hence the -en suffix; every other week is asj-weekN.
const sessionThumbs = Array.from({ length: 40 }, (_, i) => {
  const n = i + 1;
  const key = n === 29 ? 'asj-week29en' : `asj-week${n}`;
  return `/media/library/${key}.webp`;
});

const testimonials = [
  {
    body: 'I feel an opening up, a stronger voice on many levels — like someone holding my hand, showing me new ways.',
    who: 'Frances',
  },
  {
    body: 'By the end I felt like I was engaged in an act of worship. What a beautiful gift the voice is.',
    who: 'Bridie',
  },
  {
    body: 'What a powerful practice — to acknowledge the place of tension, and to befriend it rather than push it away or try to fix it.',
    who: 'Lorenz',
  },
  {
    body: 'I noticed how strong my fear of being heard is. The session helped me move through it — and opened a little doorway into how I hold myself back elsewhere in life.',
    who: 'Kitty',
  },
];
---

<Layout
  title="The Authentic Singing Journey — Songdance"
  description="Forty weeks of mantras and music, made to free the voice you already have. Self-paced, at home. No range, no experience, no performance required."
  image="/media/library/singing-lights-woman.webp"
>
  <MetaProductView
    pixelId={env.META_PIXEL_ID}
    contentId={product.id}
    contentName={product.title}
    value={product.priceEur}
  />
  <div class="jr-site jr-theme-singing">
    <PromoBanner />
    <!-- Nav -->
    <nav class="jr-nav">
      <div class="jr-nav-inner">
        <a href="/" class="jr-nav-mark" aria-label="Songdance">
          <img src="/brand/logo-wordmark.svg" alt="Songdance" />
        </a>
        <div class="jr-nav-spacer"></div>
        <div class="jr-nav-meta">
          <span>40 sessions</span>
          <span class="dot"></span>
          <span>Self-paced · at home</span>
        </div>
        <a href="#register" class="jr-nav-cta">Begin · €150</a>
        <button class="sm-trigger" data-sm-trigger aria-label="Open menu" aria-expanded="false">
          <i class="ph-light ph-list"></i>
        </button>
      </div>
    </nav>
    <SiteMenu />

    <!-- Hero -->
    <header class="jr-hero">
      <div class="jr-hero-bg" aria-hidden="true">
        <img src="/media/library/singing-lights-woman.webp" alt="" />
      </div>
      <div class="jr-hero-inner">
        <img class="jr-hero-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
        <div class="jr-hero-eyebrow">Authentic Singing Journey · the course Songdance began with</div>
        <h1 class="jr-hero-head">Singing, with <em>nothing to prove.</em></h1>
        <p class="jr-hero-sub">
          Forty weeks of mantras and music — made to free the voice you already have, not to train it
          into something else.
        </p>
        <a href="#register" class="jr-hero-cta">
          Begin the journey <i class="ph-light ph-arrow-right"></i>
        </a>
        <p class="jr-hero-micro">One payment · lifetime access · begin anytime.</p>
        <div class="jr-hero-meta">
          <span>40 weekly sessions</span>
          <span class="dot"></span>
          <span>Self-paced</span>
          <span class="dot"></span>
          <span><strong>3,500+ voices freed</strong></span>
        </div>
      </div>
    </header>

    <!-- What it is -->
    <section class="jr-section jr-opening">
      <div class="jr-opening-inner">
        <div class="jr-eyebrow" style="justify-content:center;">What it is</div>
        <h2 class="jr-opening-head">Music, a mantra, and <em>your own voice.</em></h2>
        <p class="jr-prose-body">
          Forty weekly sessions, recorded to be done at home — eyes closed if you like, no screen
          required. You sing along. That's the whole of it.
        </p>
        <p class="jr-prose-body">
          It is singing, but not the kind that asks you to be good at it. No right notes. No audition.
          No one listening but you. You're not here to learn technique — you're here to let a voice
          that's been kept quiet make some sound again.
        </p>
      </div>
    </section>

    <!-- Stat -->
    <section class="jr-section jr-stat">
      <div class="jr-stat-inner">
        <div class="jr-stat-num">3,500<span>+</span></div>
        <p class="jr-stat-label">voices freed, and counting.</p>
        <p class="jr-stat-note">Since the very first session went out</p>
      </div>
    </section>

    <!-- Origin -->
    <section class="jr-section jr-split jr-split--rev">
      <div class="jr-split-inner">
        <figure class="jr-split-figure">
          <img src="/media/library/jacob-upala-on-rock.webp" alt="Jacob and Upala, facing one another by a river" loading="lazy" />
          <figcaption>Jacob &amp; Upala — where the work began</figcaption>
        </figure>
        <div class="jr-split-text">
          <div class="jr-eyebrow">Where it came from</div>
          <h2 class="jr-h2" style="margin-bottom: var(--sp-5);">Made one week at a time.</h2>
          <p>
            The sessions weren't written at a desk. They were made one week at a time, in a difficult
            season, by two people using the practice on themselves before anyone else heard it.
          </p>
          <p>
            When something worked for them, it tended to work for others too. <em>That is still the only
            test the work trusts.</em>
          </p>
          <a href="/blog/before-there-was-upala" class="jr-link-cta">
            Read more about the history of how this course came about
            <i class="ph-light ph-arrow-right"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Mid-page CTA -->
    <section class="jr-midcta">
      <div class="jr-midcta-inner">
        <p class="jr-midcta-line">The same test, for you: try a week and see what your voice does.</p>
        <a href="#register" class="jr-midcta-btn">Begin the journey <i class="ph-light ph-arrow-right"></i></a>
        <p class="jr-midcta-note">One payment · lifetime access · €150</p>
      </div>
    </section>

    <!-- How it works — the scroll-scrubbed session deck -->
    <section class="jr-forty" aria-labelledby="jr-forty-head" data-jr-forty>
      <div class="jr-forty-pin" data-forty-pin>
        <div class="jr-forty-head">
          <div class="jr-eyebrow" style="justify-content:center;">How it works</div>
          <h2 class="jr-forty-title" id="jr-forty-head">One session a week. <em>Forty worlds.</em></h2>
          <p class="jr-forty-lead">
            Each week travels somewhere different — another rhythm, another landscape, another
            mood. You sing all of it.
          </p>
        </div>
        <div class="jr-forty-stage" data-forty-stage>
          {sessionThumbs.map((src) => (
            <figure class="jr-forty-card" data-forty-card>
              <img src={src} alt="" loading="lazy" decoding="async" width="591" height="591" />
            </figure>
          ))}
        </div>
        <div class="jr-forty-counter" data-forty-counter aria-hidden="true">
          <span data-forty-week>Week 1</span>&nbsp;/&nbsp;40
        </div>
      </div>
    </section>

    <!-- How deep it goes — full-screen ocean parallax -->
    <section class="jr-deep" style="background-image:url('/media/library/singing-water.webp'); background-position: 72% center;">
      <div class="jr-deep-inner">
        <div class="jr-eyebrow">How deep it goes</div>
        <h2 class="jr-deep-head">It isn't really about the <em>voice.</em></h2>
        <p class="jr-deep-body">
          Sing from yourself for long enough and you notice the singing was never quite the point.
          Something underneath gets a hearing — the parts that learned, early, to stay quiet. The
          voice just happens to be the way in: it goes below the floor where words are kept, and
          reaches what talking circles for years.
        </p>
        <p class="jr-deep-lyric">The voice was there before the words. It still knows the way.</p>
      </div>
    </section>

    <!-- Video glimpse — custom square player -->
    <JourneyVideo
      src="/media/library/jacob-upala-singing.mov"
      poster="/media/library/jacob-upala-singing.webp"
      label="A glimpse"
      title="Jacob and Upala, <em>singing.</em>"
      sub="A few minutes of the voice doing what this whole journey is for — sounding from itself, with nothing to prove."
    />

    <!-- Mid-page CTA -->
    <section class="jr-midcta">
      <div class="jr-midcta-inner">
        <p class="jr-midcta-line">You were loud once. It's still in there.</p>
        <a href="#register" class="jr-midcta-btn">Begin the journey <i class="ph-light ph-arrow-right"></i></a>
        <p class="jr-midcta-note">40 sessions · self-paced · €150</p>
      </div>
    </section>

    <!-- Lyric break -->
    <section class="jr-lyric">
      <div class="jr-lyric-bg" aria-hidden="true">
        <img src="/media/library/singing-nature.webp" alt="" />
      </div>
      <div class="jr-lyric-inner">
        <img class="jr-lyric-mark" src="/brand/symbol-orange.png" alt="" aria-hidden="true" />
        <p class="jr-lyric-text">Perfect for the moment. Not perfect for the radio.</p>
        <div class="jr-lyric-by">Authentic Singing Journey</div>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="jr-section jr-whom">
      <div class="jr-whom-inner">
        <div class="jr-whom-head">
          <div class="jr-eyebrow" style="justify-content:center;">Who it's for</div>
          <h2 class="jr-h2">For anyone who loves to sing and rarely <em>lets themselves.</em></h2>
        </div>
        <div class="jr-whom-body">
          <figure class="jr-whom-figure">
            <img src="/media/library/singing-statue.webp" alt="A sculpted figure, head tilted, listening" loading="lazy" />
          </figure>
          <div class="jr-whom-listwrap">
            <ul class="jr-whom-list">
              <li>For anyone who loves to sing and rarely lets themselves.</li>
              <li>For anyone who was told once that they <em>couldn't</em> — and believed it.</li>
              <li>You don't need experience.</li>
              <li>You don't need a range.</li>
              <li>You need a little privacy and the willingness to make some sound.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="jr-section jr-testimonials">
      <div class="jr-testimonials-inner">
        <div class="jr-testimonials-head">
          <div class="jr-eyebrow">Voices from the journey</div>
          <h2 class="jr-h2">What it has been for others.</h2>
        </div>
        <div class="jr-testimonials-grid">
          {testimonials.map((t) => (
            <article class="jr-testimonial">
              <div class="jr-testimonial-stars" aria-label="5 out of 5">
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
                <i class="ph-fill ph-star"></i>
              </div>
              <p class="jr-testimonial-body">“{t.body}”</p>
              <div class="jr-testimonial-by"><span class="who">{t.who}</span></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Register / buy (dark, integrated) -->
    <JourneyRegister
      course="asj"
      heroImg="/media/library/singing-lights-woman.webp"
      lede="Forty weeks with your own voice — most people find it's the best company they've kept in years. Choose your way in below."
      bullets={[
        '40 self-paced audio sessions — music + a mantra each',
        'Do-at-home — eyes closed if you like, no screen',
        'Lifetime access — go at your own pace',
        'Optional PRO mantra pack, licensed for facilitators',
      ]}
    />

    <!-- More journeys -->
    <JourneyCrossPromo current="asj" />

    <DiscoverMore currentHref="/courses/authentic-singing" />

    <!-- Footer -->
    <footer class="jr-footer">
      <div class="jr-footer-inner">
        <div class="jr-footer-top">
          <div>
            <img class="jr-footer-mark" src="/brand/logo-wordmark.svg" alt="Songdance" />
            <p class="jr-footer-lyric">First the truth. Then the tune.</p>
          </div>
          <div class="jr-footer-links">
            <a href="/courses">All courses &amp; journeys</a>
            <a href="/what-is-svh">What is Somatic Vocal Healing?</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
        <div class="jr-footer-base">
          <span>© 2026 Songdance</span>
          <span>Sound that comes from you.</span>
        </div>
      </div>
    </footer>
  </div>

  <script>
    // "One journey. Forty worlds." — a scroll-scrubbed deck of the 40 session
    // thumbnails. The section pins; scrolling riffles through the deck: each
    // card lifts off the pile, pops large for a beat (a Week N / 40 counter
    // ticks along), then settles into its slot in an ordered mosaic — ending
    // with all forty on one screen. Bounded scroll (~3 viewports). Baseline
    // (no-JS / reduced-motion) is a static contact sheet; the scrub is a
    // transform-only, rAF-driven enhancement.
    (function () {
      const section = document.querySelector<HTMLElement>('[data-jr-forty]');
      if (!section) return;
      const pin = section.querySelector<HTMLElement>('[data-forty-pin]');
      const stage = section.querySelector<HTMLElement>('[data-forty-stage]');
      const head = section.querySelector<HTMLElement>('.jr-forty-head');
      const counter = section.querySelector<HTMLElement>('[data-forty-counter]');
      const weekEl = section.querySelector<HTMLElement>('[data-forty-week]');
      const title = section.querySelector<HTMLElement>('.jr-forty-title');
      const lead = section.querySelector<HTMLElement>('.jr-forty-lead');
      const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-forty-card]'));
      if (!pin || !stage || !head || !title || !counter || !weekEl || !cards.length) return;

      const N = cards.length;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      // Scrub timeline: cards fly between P0..P1; each card's flight lasts L
      // (so ~6 are airborne at once); the first T1 of a flight is the "pop".
      const P0 = 0.06, P1 = 0.94, T1 = 0.4;
      const L = (P1 - P0) * 0.13;
      const step = (P1 - P0 - L) / (N - 1);

      let S = 140;                              // pile card size (px)
      let gScale = 0.6, fScale = 2.2, lift = 48;
      let pileBig = 1.6, pileScale = 1;         // intro: pile starts big, shrinks by P0
      let slots: Array<[number, number]> = [];
      let cx = 0, cy = 0;
      let lastWeek = 0;
      let on = false, active = false, ticking = false;

      const easeIO = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      // Deterministic per-card pile jitter (a hand-stacked deck, same every visit).
      const rot = (i: number) => (((i * 47) % 21) - 10) * 0.55;
      const jx = (i: number) => (((i * 31) % 13) - 6) * 0.9;
      const jy = (i: number) => (((i * 53) % 11) - 5) * 0.9;

      function layout() {
        const W = pin!.clientWidth;
        const H = pin!.clientHeight;
        const small = W < 640;
        // On mobile the lead fades out as the riffle begins, so the grid may
        // claim its height — measure the header only down to the title.
        const headB = small
          ? head!.offsetTop + title!.offsetTop + title!.offsetHeight
          : head!.offsetTop + head!.offsetHeight;
        const pad = small ? 14 : 28;
        const top = headB + (small ? 12 : 18);
        const bottom = H - (small ? 34 : 84);
        const availH = Math.max(160, bottom - top);
        const availW = Math.min(W - pad * 2, 1240);
        // 10x4 / 8x5 / 5x8 — always full rows, so the mosaic ends symmetric.
        const cols = W >= 900 ? 10 : W >= 640 ? 8 : 5;
        const rows = Math.ceil(N / cols);
        const gap = small ? 5 : 10;
        const cell = Math.min((availW - gap * (cols - 1)) / cols, (availH - gap * (rows - 1)) / rows);
        const gw = cols * cell + (cols - 1) * gap;
        const gh = rows * cell + (rows - 1) * gap;
        const gx0 = (W - gw) / 2;
        const gy0 = top + (availH - gh) / 2;
        slots = cards.map((_, i) => {
          const r = Math.floor(i / cols);
          const inRow = r === rows - 1 ? N - (rows - 1) * cols : cols;
          const c = i % cols;
          // centre a short final row instead of leaving it ragged-left
          const rowShift = ((cols - inRow) * (cell + gap)) / 2;
          return [gx0 + rowShift + c * (cell + gap) + cell / 2, gy0 + r * (cell + gap) + cell / 2];
        });
        cx = W / 2;
        cy = top + availH / 2;
        S = Math.max(110, Math.min(170, cell * 1.5));
        gScale = cell / S;
        fScale = Math.min(availH * 0.72, W * 0.6, 460) / S;
        pileBig = Math.max(1.6, fScale * 0.75);
        lift = Math.min(availH * 0.12, 60);
        stage!.style.setProperty('--forty-s', S.toFixed(1) + 'px');
      }

      function pose(i: number, p: number) {
        const t = Math.min(1, Math.max(0, (p - (P0 + step * i)) / L));
        // featured cards alternate slightly left/right so consecutive pops don't stack
        const fx = cx + (i % 2 ? 1 : -1) * Math.min(28, cx * 0.06);
        let x: number, y: number, sc: number, r: number, z: number;
        if (t <= 0) {
          x = cx + jx(i); y = cy + jy(i); sc = pileScale; r = rot(i); z = 400 - i;
        } else if (t < T1) {
          const k = easeIO(t / T1);
          x = cx + jx(i) * (1 - k) + (fx - cx) * k;
          y = cy + jy(i) * (1 - k) - lift * k;
          sc = 1 + (fScale - 1) * k; r = rot(i) * (1 - k); z = 900 + i;
        } else if (t < 1) {
          const k = easeIO((t - T1) / (1 - T1));
          x = fx + (slots[i][0] - fx) * k;
          y = cy - lift + (slots[i][1] - (cy - lift)) * k;
          sc = fScale + (gScale - fScale) * k; r = 0; z = 900 + i;
        } else {
          x = slots[i][0]; y = slots[i][1]; sc = gScale; r = 0; z = 10 + i;
        }
        const card = cards[i];
        card.style.zIndex = String(z);
        card.style.transform =
          'translate3d(' + (x - S / 2).toFixed(2) + 'px,' + (y - S / 2).toFixed(2) + 'px,0)' +
          ' scale(' + sc.toFixed(4) + ')' + (r ? ' rotate(' + r.toFixed(2) + 'deg)' : '');
      }

      function progress() {
        const rect = section!.getBoundingClientRect();
        const total = rect.height - pin!.clientHeight;
        return total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      }

      function apply() {
        const p = progress();
        // The pile opens large and condenses to flight size just as the
        // riffle begins (continuous at p = P0, where flights start at 1).
        pileScale = p < P0 ? 1 + (pileBig - 1) * (1 - easeIO(p / P0)) : 1;
        for (let i = 0; i < N; i++) pose(i, p);
        // Fade the lead out as the riffle takes over (mobile reclaims its room).
        if (lead) lead.style.opacity = window.innerWidth < 640
          ? String(Math.max(0, Math.min(1, (0.14 - p) / 0.14)))
          : '';
        const wk = Math.min(N, Math.max(1, Math.round((p - P0 - L * T1) / step) + 1));
        if (wk !== lastWeek) { lastWeek = wk; weekEl!.textContent = 'Week ' + wk; }
        counter!.classList.toggle('is-on', p > 0.03 && p < 0.985);
      }

      function onScroll() {
        if (!on || !active || ticking) return;
        ticking = true;
        requestAnimationFrame(() => { apply(); ticking = false; });
      }

      function setup() {
        if (reduce.matches) {
          if (!on) return;
          on = false;
          section!.classList.remove('is-scrub');
          cards.forEach((c) => { c.style.transform = ''; c.style.zIndex = ''; });
          counter!.classList.remove('is-on');
          return;
        }
        if (!on) { on = true; section!.classList.add('is-scrub'); }
        layout();
        apply();
      }

      let rt: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(setup, 150); });
      window.addEventListener('scroll', onScroll, { passive: true });
      if (reduce.addEventListener) reduce.addEventListener('change', setup);

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          active = entries[0].isIntersecting;
          if (active) onScroll();
        }, { rootMargin: '200px 0px' });
        io.observe(section);
      } else {
        active = true;
      }

      setup();
    })();
  </script>
</Layout>
