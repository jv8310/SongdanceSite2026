---
import SiteLayout from '../components/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';

// Account / product-access landing. Two paths: people who've already activated
// their products step straight into the Songdance CiRCLE; people who are
// missing products request activation, which tags them `prod_access` in Drip
// (via /api/access-products) and triggers the activation email. The "activate"
// button opens an email popup rather than navigating away.
const CIRCLE_URL = 'https://circle.songdance.co/feed';
---

<SiteLayout
  title="Log in & access your products"
  description="All our Songdance products live on the Songdance CiRCLE. Step inside if you're already set up, or activate your products if anything is missing."
>
  <PageHero
    eyebrow="Your account"
    title="Log in &amp; access your&nbsp;products"
    lede="Everything you hold with Songdance lives in one place — the Songdance CiRCLE. Here's how to get to it."
  />

  <section class="sd-section access-paths">
    <div class="access-grid">
      <article class="access-card">
        <span class="access-step">Already set up</span>
        <h2 class="access-card-h">You're in — step inside.</h2>
        <p class="access-card-p">
          If you already have an account and have activated your products in the
          Songdance CiRCLE, everything is waiting for you there.
        </p>
        <a
          href={CIRCLE_URL}
          class="sd-btn sd-btn-primary"
          target="_blank"
          rel="noopener"
        >
          Open the Songdance CiRCLE
          <i class="ph-light ph-arrow-up-right"></i>
        </a>
      </article>

      <article class="access-card">
        <span class="access-step">Missing products</span>
        <h2 class="access-card-h">Something's not there yet?</h2>
        <p class="access-card-p">
          If products are missing from your Songdance CiRCLE, they need to be
          activated first. We'll email you the steps to set everything up.
        </p>
        <button type="button" class="sd-btn sd-btn-primary" data-access-open>
          Activate all my products
          <i class="ph-light ph-envelope-simple"></i>
        </button>
      </article>
    </div>

    <p class="access-fallback">
      Still missing something after that? Do reach out — write to
      <a href="mailto:support@songdance.co">support@songdance.co</a> and we'll
      help you personally.
    </p>
  </section>

  <!-- Activation email popup -->
  <dialog class="access-modal" data-access-modal aria-labelledby="access-modal-title">
    <button type="button" class="access-modal-close" aria-label="Close" data-access-close>
      <i class="ph-light ph-x"></i>
    </button>

    <div class="access-modal-body" data-access-form-wrap>
      <h2 class="access-modal-h" id="access-modal-title">Activate your products</h2>
      <p class="access-modal-p">
        Pop in the email you used with Songdance and we'll send you the steps to
        activate everything in your CiRCLE.
      </p>
      <form class="access-form" data-access-form>
        <input
          type="text"
          name="hp"
          class="access-hp"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <input
          type="email"
          name="email"
          class="access-input"
          placeholder="you@somewhere"
          aria-label="Email address"
          autocomplete="email"
          required
        />
        <button type="submit" class="sd-btn sd-btn-primary" data-access-submit>
          <span data-access-label>Send me the steps</span>
          <i class="ph-light ph-arrow-right"></i>
        </button>
      </form>
      <p class="access-error" hidden role="alert" data-access-error></p>
    </div>

    <div class="access-modal-body" hidden data-access-thanks>
      <div class="access-thanks-mark"><i class="ph-light ph-envelope-open"></i></div>
      <h2 class="access-modal-h">Please check your email</h2>
      <p class="access-modal-p">
        We've sent you a message with the steps to follow. Open it and activate
        your products — then everything will be waiting in your Songdance CiRCLE.
      </p>
    </div>
  </dialog>
</SiteLayout>

<style>
  .access-paths { max-width: var(--sd-max); margin: 0 auto; }

  .access-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-5);
    align-items: stretch;
  }
  @media (max-width: 760px) {
    .access-grid { grid-template-columns: 1fr; }
  }

  .access-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-7) var(--sp-6);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-2);
  }
  .access-step {
    font-family: var(--font-body);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--ember-deep);
    font-weight: 500;
  }
  .access-card-h {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    color: var(--ink);
    font-weight: 400;
  }
  .access-card-p {
    color: var(--ink-soft);
    margin: 0;
    max-width: 42ch;
  }
  .access-card .sd-btn { margin-top: var(--sp-3); }

  .access-fallback {
    text-align: center;
    color: var(--ink-quiet);
    font-size: var(--t-body-sm);
    margin: var(--sp-7) auto 0;
    max-width: 52ch;
  }

  /* ---------- Email popup ---------- */
  .access-modal {
    border: none;
    border-radius: var(--r-xl);
    padding: var(--sp-8) var(--sp-7);
    width: min(480px, calc(100vw - 32px));
    background: var(--paper-soft);
    color: var(--ink);
    box-shadow: var(--shadow-3);
    position: relative;
    overflow: visible;
  }
  .access-modal::backdrop {
    background: rgba(26, 16, 24, 0.55);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .access-modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: none;
    border: none;
    font-size: 22px;
    line-height: 1;
    color: var(--ink-quiet);
    cursor: pointer;
    transition: color var(--d-quick) var(--ease);
  }
  .access-modal-close:hover { color: var(--ink); }

  .access-modal-h {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-snug);
    color: var(--ink);
    font-weight: 400;
    margin: 0 0 var(--sp-3);
  }
  .access-modal-p {
    color: var(--ink-soft);
    margin: 0 0 var(--sp-5);
  }

  .access-form { display: flex; flex-direction: column; gap: var(--sp-3); }
  .access-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .access-input {
    font-family: var(--font-body);
    font-size: var(--t-body);
    padding: 13px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--paper);
    color: var(--ink);
  }
  .access-input:focus {
    outline: none;
    border-color: var(--ember);
    box-shadow: var(--shadow-glow);
  }
  .access-form .sd-btn { justify-content: center; }

  .access-error {
    color: var(--ember-deep);
    font-size: var(--t-body-sm);
    margin: var(--sp-3) 0 0;
  }

  .access-thanks-mark {
    font-size: 40px;
    line-height: 1;
    color: var(--ember-deep);
    margin-bottom: var(--sp-4);
  }
</style>

<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-access-modal]');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-access-open]');
  const form = document.querySelector<HTMLFormElement>('[data-access-form]');
  const formWrap = document.querySelector<HTMLElement>('[data-access-form-wrap]');
  const thanks = document.querySelector<HTMLElement>('[data-access-thanks]');
  const errorEl = document.querySelector<HTMLElement>('[data-access-error]');
  const label = document.querySelector<HTMLElement>('[data-access-label]');

  const open = () => {
    if (!modal) return;
    // Reset to the form view each time it opens.
    if (formWrap) formWrap.hidden = false;
    if (thanks) thanks.hidden = true;
    if (errorEl) errorEl.hidden = true;
    if (typeof modal.showModal === 'function') modal.showModal();
    else modal.setAttribute('open', '');
    modal.querySelector<HTMLInputElement>('.access-input')?.focus();
  };
  const close = () => {
    if (!modal) return;
    if (typeof modal.close === 'function') modal.close();
    else modal.removeAttribute('open');
  };

  openers.forEach((b) => b.addEventListener('click', open));
  modal?.querySelectorAll('[data-access-close]').forEach((el) =>
    el.addEventListener('click', close),
  );
  // Click on the backdrop (outside the dialog box) closes it.
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errorEl) errorEl.hidden = true;

    const data = new FormData(form);
    const email = String(data.get('email') ?? '').trim();
    if (!email) return;

    const btn = form.querySelector<HTMLButtonElement>('[data-access-submit]');
    const original = label?.textContent ?? 'Send me the steps';
    if (btn) btn.disabled = true;
    if (label) label.textContent = 'Sending…';

    try {
      const res = await fetch('/api/access-products', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, hp: String(data.get('hp') ?? '') }),
      });
      const payload = (await res.json().catch(() => ({}))) as { ok?: boolean };
      if (res.ok && payload?.ok) {
        if (formWrap) formWrap.hidden = true;
        if (thanks) thanks.hidden = false;
        return;
      }
      throw new Error('request-failed');
    } catch {
      if (btn) btn.disabled = false;
      if (label) label.textContent = original;
      if (errorEl) {
        errorEl.textContent =
          "That didn't go through. Please check the address and try again.";
        errorEl.hidden = false;
      }
    }
  });
</script>
