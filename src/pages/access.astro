---
import SiteLayout from '../components/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';

// Pre-purchase account lookup + product access. You enter the email you used
// with Songdance and we run a check (see /api/access-lookup):
//   • Live sessions — any workshop/masterclass seat you hold gets a direct link
//     to its countdown page, so you can step back into it.
//   • Music albums — gated album players (src/lib/music/) the email's Drip tags
//     hold; the lookup also sets the listener cookie so each link plays at once.
//   • Where you are in the 12-week course — the week counter
//     (src/lib/courses/week-progress.ts). Someone inside weeks 1-12 who also
//     holds the certification can open it right here: the button posts to
//     /api/courses/activate-now and the counter becomes "Ongoing Certification".
//   • CiRCLE products — if you hold anything that lives in the Songdance CiRCLE
//     (courses, journeys, …) we show the two paths: step inside if you're set
//     up, or request activation (tags you `prod_access` in Drip via
//     /api/access-products, which triggers the activation email).
// If we find nothing under the address we still offer activation, so nobody is
// left stuck.
const CIRCLE_URL = 'https://circle.songdance.co/feed';
---

<SiteLayout
  title="Log in & access your products"
  description="Enter your email to find your Songdance workshops, masterclasses and the products waiting for you in the Songdance CiRCLE."
>
  <PageHero
    eyebrow="Your account"
    title="Log in &amp; access your&nbsp;products"
    lede="Pop in the email you used with Songdance and we'll show you what's waiting — your live sessions, your music, and everything held for you in the Songdance CiRCLE."
  />

  <section class="sd-section access-paths">
    <!-- Step 1 — the email lookup -->
    <div class="access-lookup" data-lookup>
      <form class="access-form access-form-lg" data-lookup-form>
        <input
          type="text"
          name="hp"
          class="access-hp"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <label class="access-label" for="access-email">The email you used with Songdance</label>
        <div class="access-field-row">
          <input
            type="email"
            id="access-email"
            name="email"
            class="access-input"
            placeholder="you@somewhere"
            aria-label="Email address"
            autocomplete="email"
            required
          />
          <button type="submit" class="sd-btn sd-btn-primary" data-lookup-submit>
            <span data-lookup-label>Find my account</span>
            <i class="ph-light ph-arrow-right"></i>
          </button>
        </div>
        <p class="access-error" hidden role="alert" data-lookup-error></p>
      </form>
    </div>

    <!-- Step 2 — results, populated by JS -->
    <div class="access-results" hidden data-results>
      <p class="access-greeting" data-greeting hidden></p>

      <!-- Where you are in the 12-week course (and, if it's yours, the door
           into the certification course) -->
      <div class="access-block" hidden data-progress-block>
        <h2 class="access-block-h">Your course</h2>
        <div class="access-progress">
          <div class="access-progress-head">
            <span class="access-session-kind" data-progress-kind>12-week course</span>
            <p class="access-progress-week" data-progress-label></p>
            <p class="access-progress-when" data-progress-note></p>
          </div>
          <!-- Twelve segments, filled client-side (see renderProgress) -->
          <div class="access-progress-bar" data-progress-bar hidden aria-hidden="true"></div>

          <div class="access-progress-activate" hidden data-progress-activate>
            <p class="access-block-p" data-cert-intro>
              You also hold the certification course. You're welcome to walk the
              foundation to the end first — or step into the certification now,
              whenever you're ready.
            </p>
            <button type="button" class="sd-btn sd-btn-primary" data-cert-activate>
              <span>Activate the certification course now</span>
              <i class="ph-light ph-arrow-right"></i>
            </button>
            <div class="access-progress-confirm" hidden data-cert-confirm>
              <p class="access-block-p" data-cert-confirm-body></p>
              <div class="access-progress-confirm-actions">
                <button type="button" class="sd-btn sd-btn-primary" data-cert-confirm-yes>
                  <span>Yes, activate</span>
                  <i class="ph-light ph-arrow-right"></i>
                </button>
                <button type="button" class="access-progress-cancel" data-cert-confirm-no>
                  Not yet
                </button>
              </div>
            </div>
            <p class="access-activated" hidden data-cert-done>
              <i class="ph-light ph-check-circle"></i>
              Activated — your course now reads
              <strong>Ongoing Certification</strong>. Everything is waiting for
              you in the Songdance CiRCLE.
            </p>
            <p class="access-error" hidden role="alert" data-cert-error></p>
          </div>
        </div>
      </div>

      <!-- Live sessions (workshops / masterclasses) -->
      <div class="access-block" hidden data-live-block>
        <h2 class="access-block-h">Your sessions</h2>
        <p class="access-block-p">
          Step into an upcoming countdown, restart a replay — or, for a date
          you've missed, watch the replay or move onto a new one for free.
        </p>
        <div class="access-sessions" data-live-list></div>
      </div>

      <!-- Gated music albums (the player pages open with this same email) -->
      <div class="access-block" hidden data-music-block>
        <h2 class="access-block-h">Your music</h2>
        <p class="access-block-p">
          Albums that came with your orders — press play right where you are.
        </p>
        <div class="access-sessions" data-music-list></div>
      </div>

      <!-- Products in the Songdance CiRCLE -->
      <div class="access-block" hidden data-circle-block>
        <h2 class="access-block-h">Your Songdance CiRCLE</h2>
        <p class="access-block-p" data-circle-list hidden></p>
        <div class="access-grid">
          <article class="access-card">
            <span class="access-step">Already set up</span>
            <h3 class="access-card-h">You're in — step inside.</h3>
            <p class="access-card-p">
              If you've already activated your products in the Songdance CiRCLE,
              everything is waiting for you there.
            </p>
            <a
              href={CIRCLE_URL}
              class="sd-btn sd-btn-primary"
              target="_blank"
              rel="noopener"
            >
              Open the Songdance CiRCLE
              <i class="ph-light ph-arrow-up-right"></i>
            </a>
          </article>

          <article class="access-card" data-activate-card>
            <span class="access-step">Missing products</span>
            <h3 class="access-card-h">Something's not there yet?</h3>
            <p class="access-card-p">
              If products are missing from your Songdance CiRCLE, they need to be
              activated first. We'll email you the steps to set everything up.
            </p>
            <button type="button" class="sd-btn sd-btn-primary" data-activate>
              <span data-activate-label>Activate all my products</span>
              <i class="ph-light ph-envelope-simple"></i>
            </button>
            <p class="access-activated" hidden data-activated>
              <i class="ph-light ph-envelope-open"></i>
              Sent — check your email for the steps to activate everything.
            </p>
            <p class="access-error" hidden role="alert" data-activate-error></p>
          </article>
        </div>
      </div>

      <!-- Nothing found under this address -->
      <div class="access-block" hidden data-none-block>
        <h2 class="access-block-h">We couldn't find anything under that email</h2>
        <p class="access-block-p">
          Double-check the address, or — if you've bought with us before — we can
          send you the steps to activate your products in the Songdance CiRCLE.
        </p>
        <div class="access-none-actions">
          <button type="button" class="sd-btn sd-btn-primary" data-activate>
            <span data-activate-label>Email me the activation steps</span>
            <i class="ph-light ph-envelope-simple"></i>
          </button>
          <p class="access-activated" hidden data-activated>
            <i class="ph-light ph-envelope-open"></i>
            Sent — check your email for the steps to activate everything.
          </p>
          <p class="access-error" hidden role="alert" data-activate-error></p>
        </div>
      </div>

      <p class="access-reset">
        Not you? <a href="#" data-reset>Use a different email</a>
      </p>
    </div>

    <p class="access-fallback">
      Still missing something? Do reach out — write to
      <a href="mailto:support@songdance.co">support@songdance.co</a> and we'll
      help you personally.
    </p>
  </section>
</SiteLayout>

<style>
  .access-paths { max-width: var(--sd-max); margin: 0 auto; }

  /* ---------- Step 1: email lookup ---------- */
  .access-lookup {
    max-width: 560px;
    margin: 0 auto;
    padding: var(--sp-7) var(--sp-6);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-2);
  }
  .access-label {
    display: block;
    font-family: var(--font-body);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--ember-deep);
    font-weight: 500;
    margin-bottom: var(--sp-3);
  }
  .access-field-row { display: flex; gap: var(--sp-3); align-items: stretch; }
  @media (max-width: 560px) {
    .access-field-row { flex-direction: column; }
  }
  .access-field-row .access-input { flex: 1; min-width: 0; }
  .access-field-row .sd-btn { justify-content: center; white-space: nowrap; }

  .access-input {
    font-family: var(--font-body);
    font-size: var(--t-body);
    padding: 13px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--paper);
    color: var(--ink);
  }
  .access-input:focus {
    outline: none;
    border-color: var(--ember);
    box-shadow: var(--shadow-glow);
  }
  .access-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  /* ---------- Step 2: results ---------- */
  .access-results { max-width: var(--sd-max); margin: 0 auto; }
  .access-greeting {
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--t-h3);
    color: var(--ink);
    font-weight: 400;
    margin: 0 0 var(--sp-6);
  }
  .access-block { margin-bottom: var(--sp-8); }
  .access-block-h {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    color: var(--ink);
    font-weight: 400;
    margin: 0 0 var(--sp-2);
  }
  .access-block-p { color: var(--ink-soft); margin: 0 0 var(--sp-5); max-width: 52ch; }

  /* Live-session + music-album rows are rendered client-side (innerHTML in
     the <script> below), so they never receive Astro's scoping attribute —
     every rule that styles them has to be :global() or it silently no-ops
     (the bug behind the oversized, unstyled album cover). */
  .access-sessions { display: flex; flex-direction: column; gap: var(--sp-4); }
  :global(.access-session) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-5) var(--sp-6);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-1);
  }
  :global(.access-session-meta) { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  :global(.access-session-kind) {
    font-family: var(--font-body);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--ember-deep);
    font-weight: 500;
  }
  :global(.access-session-title) {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-snug);
    color: var(--ink);
    font-weight: 400;
    margin: 0;
  }
  :global(.access-session-when) { color: var(--ink-soft); font-size: var(--t-body-sm); margin: 0; }
  :global(.access-session-note) { color: var(--ember-deep); font-size: var(--t-body-sm); margin: 4px 0 0; }
  :global(.access-session.is-missed) { border-style: dashed; }
  :global(.access-session .sd-btn) { white-space: nowrap; }

  /* ---------- The 12-week counter ---------- */
  .access-progress {
    padding: var(--sp-6);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-1);
  }
  .access-progress-head { display: flex; flex-direction: column; gap: 6px; }
  .access-progress-week {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-snug);
    color: var(--ink);
    font-weight: 400;
    margin: 0;
  }
  .access-progress-when { color: var(--ink-soft); font-size: var(--t-body-sm); margin: 0; }

  .access-progress-bar {
    display: flex;
    gap: 4px;
    margin-top: var(--sp-4);
  }
  /* The week segments are injected client-side, so they never carry Astro's
     scoping attribute — these rules must be :global() or they silently no-op
     (the same trap as the album rows below). */
  :global(.access-progress-bar span) {
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: var(--line);
  }
  :global(.access-progress-bar span[data-done]) { background: var(--ember); }

  .access-progress-activate {
    margin-top: var(--sp-5);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
  }
  .access-progress-activate .access-block-p { margin-bottom: var(--sp-4); }
  .access-progress-confirm { margin-top: var(--sp-4); }
  .access-progress-confirm-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
  .access-progress-cancel {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-body);
    font-size: var(--t-body-sm);
    color: var(--ink-quiet);
    text-decoration: underline;
    cursor: pointer;
  }

  /* Music album rows reuse the session-card frame, plus a cover thumb. */
  :global(.access-album-cover) {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-1);
  }
  :global(.access-session-meta.has-cover) { flex-direction: row; align-items: center; gap: var(--sp-4); }

  /* CiRCLE two-card grid (unchanged layout) */
  .access-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-5);
    align-items: stretch;
  }
  @media (max-width: 760px) {
    .access-grid { grid-template-columns: 1fr; }
  }
  .access-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-7) var(--sp-6);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-2);
  }
  .access-step {
    font-family: var(--font-body);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--ember-deep);
    font-weight: 500;
  }
  .access-card-h {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-display);
    color: var(--ink);
    font-weight: 400;
  }
  .access-card-p { color: var(--ink-soft); margin: 0; max-width: 42ch; }
  .access-card .sd-btn { margin-top: var(--sp-3); }
  .access-none-actions { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-3); }

  .access-activated {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ember-deep);
    font-size: var(--t-body-sm);
    margin: var(--sp-3) 0 0;
  }
  .access-error {
    color: var(--ember-deep);
    font-size: var(--t-body-sm);
    margin: var(--sp-3) 0 0;
  }

  .access-reset {
    text-align: center;
    font-size: var(--t-body-sm);
    color: var(--ink-quiet);
    margin: var(--sp-6) 0 0;
  }
  .access-reset a { color: var(--ember-deep); }

  .access-fallback {
    text-align: center;
    color: var(--ink-quiet);
    font-size: var(--t-body-sm);
    margin: var(--sp-8) auto 0;
    max-width: 52ch;
  }
</style>

<script>
  type Session = {
    title: string;
    kind: 'Workshop' | 'Masterclass';
    when: string;
    url: string;
    status: 'upcoming' | 'replay' | 'missed';
  };
  type MusicAlbum = { title: string; url: string; cover: string | null };
  // Where they are in the 12-week course. `can_activate_cert` is the server's
  // decision (inside weeks 1-12 AND holds the certification) — the page never
  // infers it, and /api/courses/activate-now re-checks it before moving anyone.
  type Progress = {
    state: 'twelve_week' | 'completed' | 'certification';
    week: number | null;
    total_weeks: number;
    label: string;
    can_activate_cert: boolean;
  };
  type LookupResult = {
    ok?: boolean;
    email?: string;
    first_name?: string;
    sessions?: Session[];
    circle?: { has?: boolean; products?: string[] };
    music?: MusicAlbum[];
    progress?: Progress | null;
  };

  const lookupWrap = document.querySelector<HTMLElement>('[data-lookup]');
  const lookupForm = document.querySelector<HTMLFormElement>('[data-lookup-form]');
  const lookupLabel = document.querySelector<HTMLElement>('[data-lookup-label]');
  const lookupError = document.querySelector<HTMLElement>('[data-lookup-error]');
  const results = document.querySelector<HTMLElement>('[data-results]');
  const greeting = document.querySelector<HTMLElement>('[data-greeting]');
  const liveBlock = document.querySelector<HTMLElement>('[data-live-block]');
  const liveList = document.querySelector<HTMLElement>('[data-live-list]');
  const circleBlock = document.querySelector<HTMLElement>('[data-circle-block]');
  const circleList = document.querySelector<HTMLElement>('[data-circle-list]');
  const musicBlock = document.querySelector<HTMLElement>('[data-music-block]');
  const musicList = document.querySelector<HTMLElement>('[data-music-list]');
  const noneBlock = document.querySelector<HTMLElement>('[data-none-block]');
  const progressBlock = document.querySelector<HTMLElement>('[data-progress-block]');
  const progressKind = document.querySelector<HTMLElement>('[data-progress-kind]');
  const progressLabel = document.querySelector<HTMLElement>('[data-progress-label]');
  const progressNote = document.querySelector<HTMLElement>('[data-progress-note]');
  const progressBar = document.querySelector<HTMLElement>('[data-progress-bar]');
  const certActivate = document.querySelector<HTMLElement>('[data-progress-activate]');
  const certBtn = document.querySelector<HTMLButtonElement>('[data-cert-activate]');
  const certConfirm = document.querySelector<HTMLElement>('[data-cert-confirm]');
  const certConfirmBody = document.querySelector<HTMLElement>('[data-cert-confirm-body]');
  const certConfirmYes = document.querySelector<HTMLButtonElement>('[data-cert-confirm-yes]');
  const certConfirmNo = document.querySelector<HTMLButtonElement>('[data-cert-confirm-no]');
  const certIntro = document.querySelector<HTMLElement>('[data-cert-intro]');
  const certDone = document.querySelector<HTMLElement>('[data-cert-done]');
  const certError = document.querySelector<HTMLElement>('[data-cert-error]');

  // The looked-up email, reused for the activation request.
  let currentEmail = '';

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c,
    );

  function renderSessions(sessions: Session[]) {
    if (!liveList) return;
    liveList.innerHTML = sessions
      .map((s) => {
        const cta =
          s.status === 'replay'
            ? 'Watch now'
            : s.status === 'missed'
              ? 'Replay or new date'
              : 'Go to your countdown';
        // A missed date gets an extra line so it's clear why it's still here.
        const note =
          s.status === 'missed'
            ? `<p class="access-session-note">This date has passed — watch the replay or pick a new one.</p>`
            : '';
        return `
          <div class="access-session${s.status === 'missed' ? ' is-missed' : ''}">
            <div class="access-session-meta">
              <span class="access-session-kind">${esc(s.kind)}</span>
              <h3 class="access-session-title">${esc(s.title)}</h3>
              <p class="access-session-when">${esc(s.when)}</p>
              ${note}
            </div>
            <a class="sd-btn sd-btn-primary" href="${esc(s.url)}">
              ${cta}
              <i class="ph-light ph-arrow-right"></i>
            </a>
          </div>`;
      })
      .join('');
  }

  function renderMusic(albums: MusicAlbum[]) {
    if (!musicList) return;
    musicList.innerHTML = albums
      .map(
        (a) => `
          <div class="access-session">
            <div class="access-session-meta${a.cover ? ' has-cover' : ''}">
              ${a.cover ? `<img class="access-album-cover" src="${esc(a.cover)}" alt="" loading="lazy" />` : ''}
              <div>
                <span class="access-session-kind">Album</span>
                <h3 class="access-session-title">${esc(a.title)}</h3>
              </div>
            </div>
            <a class="sd-btn sd-btn-primary" href="${esc(a.url)}">
              Open the album
              <i class="ph-light ph-play"></i>
            </a>
          </div>`,
      )
      .join('');
  }

  // The counter: a headline ("Week 3 of 12" / "Ongoing Certification"), a
  // twelve-segment bar while the foundation runs, and — only when the server
  // says so — the door into the certification course.
  function renderProgress(p: Progress | null | undefined) {
    if (!progressBlock) return;
    if (!p) {
      progressBlock.hidden = true;
      return;
    }
    progressBlock.hidden = false;

    const onCert = p.state === 'certification';
    if (progressKind) {
      progressKind.textContent = onCert ? 'Certification course' : '12-week course';
    }
    if (progressLabel) progressLabel.textContent = p.label;
    if (progressNote) {
      progressNote.textContent = onCert
        ? 'Your certification course is open — everything lives in the Songdance CiRCLE.'
        : p.state === 'completed'
          ? 'You walked the whole foundation. The materials stay yours.'
          : 'Your own pace. The materials are there whenever you come to them.';
    }

    // Twelve segments, one per week, filled up to where they are.
    if (progressBar) {
      const show = p.state === 'twelve_week' && p.week != null;
      progressBar.hidden = !show;
      if (show) {
        const total = p.total_weeks || 12;
        progressBar.innerHTML = Array.from({ length: total }, (_, i) =>
          i < (p.week ?? 0) ? '<span data-done></span>' : '<span></span>',
        ).join('');
      }
    }

    // Reset the activation UI for this lookup.
    if (certConfirm) certConfirm.hidden = true;
    if (certIntro) certIntro.hidden = false;
    if (certDone) certDone.hidden = true;
    if (certError) certError.hidden = true;
    if (certBtn) certBtn.hidden = false;
    if (certBtn) certBtn.disabled = false;
    if (certActivate) certActivate.hidden = !p.can_activate_cert;
    if (certConfirmBody) {
      certConfirmBody.textContent = p.week
        ? `You're in week ${p.week} of ${p.total_weeks}. Activating moves you on to the certification course — your foundation materials stay yours either way. Ready?`
        : 'Activating moves you on to the certification course — your foundation materials stay yours either way. Ready?';
    }
  }

  function renderResults(data: LookupResult) {
    const sessions = data.sessions ?? [];
    const circle = data.circle ?? { has: false, products: [] };
    const music = data.music ?? [];
    currentEmail = data.email ?? currentEmail;

    // Greeting
    if (greeting) {
      if (data.first_name) {
        greeting.textContent = `Welcome back, ${data.first_name}.`;
        greeting.hidden = false;
      } else {
        greeting.hidden = true;
      }
    }

    // Live sessions
    const hasSessions = sessions.length > 0;
    if (hasSessions) renderSessions(sessions);
    if (liveBlock) liveBlock.hidden = !hasSessions;

    // Music albums
    const hasMusic = music.length > 0;
    if (hasMusic) renderMusic(music);
    if (musicBlock) musicBlock.hidden = !hasMusic;

    // Where they are in the 12-week course
    const progress = data.progress ?? null;
    renderProgress(progress);

    // CiRCLE products
    const hasCircle = !!circle.has;
    if (circleBlock) circleBlock.hidden = !hasCircle;
    if (circleList) {
      const products = circle.products ?? [];
      if (hasCircle && products.length) {
        circleList.textContent = `We found: ${products.join(' · ')}.`;
        circleList.hidden = false;
      } else {
        circleList.hidden = true;
      }
    }

    // Nothing at all
    if (noneBlock) noneBlock.hidden = hasSessions || hasCircle || hasMusic || !!progress;

    // Reset any activation states from a previous lookup.
    document.querySelectorAll<HTMLElement>('[data-activated]').forEach((el) => (el.hidden = true));
    document.querySelectorAll<HTMLElement>('[data-activate-error]').forEach((el) => (el.hidden = true));
    document.querySelectorAll<HTMLButtonElement>('[data-activate]').forEach((b) => {
      b.disabled = false;
      b.hidden = false;
      const lbl = b.querySelector<HTMLElement>('[data-activate-label]');
      if (lbl && lbl.dataset.original) lbl.textContent = lbl.dataset.original;
    });

    if (lookupWrap) lookupWrap.hidden = true;
    if (results) results.hidden = false;
  }

  function resetToLookup() {
    if (results) results.hidden = true;
    if (lookupWrap) lookupWrap.hidden = false;
    if (lookupError) lookupError.hidden = true;
    lookupForm?.reset();
    lookupForm?.querySelector<HTMLInputElement>('.access-input')?.focus();
  }

  lookupForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (lookupError) lookupError.hidden = true;

    const fd = new FormData(lookupForm);
    const email = String(fd.get('email') ?? '').trim();
    if (!email) return;

    const btn = lookupForm.querySelector<HTMLButtonElement>('[data-lookup-submit]');
    const original = lookupLabel?.textContent ?? 'Find my account';
    if (btn) btn.disabled = true;
    if (lookupLabel) lookupLabel.textContent = 'Checking…';

    try {
      const res = await fetch('/api/access-lookup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, hp: String(fd.get('hp') ?? '') }),
      });
      const payload = (await res.json().catch(() => ({}))) as LookupResult;
      if (!res.ok || !payload?.ok) throw new Error('lookup-failed');
      renderResults(payload);
    } catch {
      if (lookupError) {
        lookupError.textContent =
          "That didn't go through. Please check the address and try again.";
        lookupError.hidden = false;
      }
    } finally {
      if (btn) btn.disabled = false;
      if (lookupLabel) lookupLabel.textContent = original;
    }
  });

  // Activation — reuses the already-entered email, so no second prompt. Wired on
  // every [data-activate] button (the CiRCLE card + the nothing-found block).
  document.querySelectorAll<HTMLButtonElement>('[data-activate]').forEach((btn) => {
    const scope = btn.closest('[data-activate-card], .access-none-actions') ?? document;
    const label = btn.querySelector<HTMLElement>('[data-activate-label]');
    if (label) label.dataset.original = label.textContent ?? 'Activate all my products';
    const done = scope.querySelector<HTMLElement>('[data-activated]');
    const errEl = scope.querySelector<HTMLElement>('[data-activate-error]');

    btn.addEventListener('click', async () => {
      if (!currentEmail) return;
      if (errEl) errEl.hidden = true;
      btn.disabled = true;
      if (label) label.textContent = 'Sending…';
      try {
        const res = await fetch('/api/access-products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: currentEmail, hp: '' }),
        });
        const payload = (await res.json().catch(() => ({}))) as { ok?: boolean };
        if (!res.ok || !payload?.ok) throw new Error('request-failed');
        btn.hidden = true;
        if (done) done.hidden = false;
      } catch {
        btn.disabled = false;
        if (label && label.dataset.original) label.textContent = label.dataset.original;
        if (errEl) {
          errEl.textContent = "That didn't go through — please try again in a moment.";
          errEl.hidden = false;
        }
      }
    });
  });

  // Activating the certification course from here. Two steps — the move is
  // one-way, so it asks first. The server re-checks that the course is
  // theirs and that they're still inside the 12 weeks.
  certBtn?.addEventListener('click', () => {
    if (certError) certError.hidden = true;
    if (certConfirm) certConfirm.hidden = false;
    certBtn.hidden = true;
    certConfirmYes?.focus();
  });

  certConfirmNo?.addEventListener('click', () => {
    if (certConfirm) certConfirm.hidden = true;
    if (certBtn) certBtn.hidden = false;
  });

  certConfirmYes?.addEventListener('click', async () => {
    if (!currentEmail) return;
    if (certError) certError.hidden = true;
    certConfirmYes.disabled = true;
    const original = certConfirmYes.innerHTML;
    certConfirmYes.innerHTML = '<span>Activating…</span>';
    try {
      const res = await fetch('/api/courses/activate-now', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: currentEmail }),
      });
      const payload = (await res.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
        progress?: { label?: string } | null;
      };
      if (!res.ok || !payload?.ok) throw new Error(payload?.error || 'activate-failed');
      if (certConfirm) certConfirm.hidden = true;
      if (certIntro) certIntro.hidden = true;
      if (certDone) certDone.hidden = false;
      // The counter now reads "Ongoing Certification" — say so where the week was.
      if (progressKind) progressKind.textContent = 'Certification course';
      if (progressLabel) {
        progressLabel.textContent = payload.progress?.label || 'Ongoing Certification';
      }
      if (progressNote) {
        progressNote.textContent =
          'Your certification course is open — everything lives in the Songdance CiRCLE.';
      }
      if (progressBar) progressBar.hidden = true;
    } catch (err) {
      if (certConfirm) certConfirm.hidden = true;
      if (certBtn) certBtn.hidden = false;
      if (certError) {
        const msg = err instanceof Error ? err.message : '';
        certError.textContent =
          msg && msg !== 'activate-failed'
            ? msg
            : "That didn't go through — please try again in a moment, or write to support@songdance.co.";
        certError.hidden = false;
      }
    } finally {
      certConfirmYes.disabled = false;
      certConfirmYes.innerHTML = original;
    }
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-reset]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      resetToLookup();
    }),
  );
</script>
