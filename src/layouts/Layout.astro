---
import '../styles/tokens.css';
import '../styles/site.css';
import PriceSync from '../components/PriceSync.astro';
import AdminTopBar from '../components/admin/AdminTopBar.astro';
import { launchPromoPayload } from '../lib/promo';

// Launch-promo facts, exposed to inline (non-bundled) scripts via a global. The
// `active` flag is derived client-side from the deadline so the promo (and its
// price strikes) switch off automatically when the window closes — no rebuild.
const promoPayload = launchPromoPayload();

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
}

const {
  title = 'Songdance — sound that comes from you',
  description = "Somatic Vocal Healing — the honest sound of what you feel, until it's been heard. Sound that comes from you, not toward you.",
  image = '/brand/symbol-orange.png',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).href;

// The persistent admin nav shows on every /admin page except the (pre-auth)
// login screen, which doesn't load the admin styles.
const path = Astro.url.pathname;
const showAdminBar = (path === '/admin' || path.startsWith('/admin/')) && !path.startsWith('/admin/login');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/light/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline define:vars={{ promoPayload }}>
      window.__SD_PROMO__ = promoPayload;
      window.__SD_PROMO__.active = Date.now() < promoPayload.endsAtMs;
    </script>
    <!-- Review aid: highlights the June-2026 copy-pass changes when the URL
         has ?changes. No-op otherwise. Remove with public/preview-changes.js
         after the review round. -->
    <script src="/preview-changes.js" defer></script>
  </head>
  <body>
    <div class="sd-site">
      {showAdminBar && <AdminTopBar />}
      <slot />
    </div>
    <PriceSync />
  </body>
</html>
