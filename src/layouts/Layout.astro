---
import '../styles/tokens.css';
import '../styles/site.css';
import PriceSync from '../components/PriceSync.astro';
import AdminTopBar from '../components/admin/AdminTopBar.astro';
import { launchPromoPayload } from '../lib/promo';
import { masterclassPromoPayload } from '../lib/masterclass-promo';
import { organizationSchema } from '../lib/seo';

// Launch-promo facts, exposed to inline (non-bundled) scripts via a global. The
// `active` flag is derived client-side from the deadline so the promo (and its
// price strikes) switch off automatically when the window closes — no rebuild.
const promoPayload = launchPromoPayload();

// The standalone masterclass launch offer, exposed the same way. Only the
// masterclass + workshop register scripts read it (to keep the masterclass
// ticket at 50% after the launch sale closes); everything else ignores it, so
// the grid/nav prices still revert with the launch sale. Same self-expiry.
const mcPromoPayload = masterclassPromoPayload();

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  lang?: string; // 'en' (default) | 'de' | 'nl' — set on the language twins
}

const {
  title = 'Songdance — sound that comes from you',
  description = "Somatic Vocal Healing — the honest sound of what you feel, until it's been heard. Sound that comes from you, not toward you.",
  // A real photo, not the bare logo — so shares render as a rich card. Pass a
  // page-specific `image` to override.
  image = '/media/library/svhgpt-01-hero-in-one-breath.webp',
  imageAlt = 'Somatic Vocal Healing — the honest sound of what you feel.',
  ogType = 'website',
  lang = 'en',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).href;

const OG_LOCALE: Record<string, string> = { en: 'en_US', de: 'de_DE', nl: 'nl_BE' };
const ogLocale = OG_LOCALE[lang] ?? 'en_US';
const orgLd = JSON.stringify(organizationSchema());

// The persistent admin nav shows on every /admin page except the (pre-auth)
// login screen, which doesn't load the admin styles.
const path = Astro.url.pathname;
const showAdminBar = (path === '/admin' || path.startsWith('/admin/')) && !path.startsWith('/admin/login');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Fonts: preconnect + a single stylesheet link (not a render-blocking
         CSS @import) so the browser can fetch them on its own connection. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Cormorant+Garamond:ital,wght@0,400;1,400;1,500&family=Figtree:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
    />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/light/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Songdance" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={orgLd} />
    <title>{title}</title>
    <script is:inline define:vars={{ promoPayload, mcPromoPayload }}>
      window.__SD_PROMO__ = promoPayload;
      window.__SD_PROMO__.active = Date.now() < promoPayload.endsAtMs;
      window.__SD_MC_PROMO__ = mcPromoPayload;
      window.__SD_MC_PROMO__.active = Date.now() < mcPromoPayload.endsAtMs;
    </script>
    <!-- Review aid: highlights the June-2026 copy-pass changes when the URL
         has ?changes. No-op otherwise. Remove with public/preview-changes.js
         after the review round. -->
    <script src="/preview-changes.js" defer></script>
  </head>
  <body>
    <div class="sd-site">
      {showAdminBar && <AdminTopBar />}
      <slot />
    </div>
    <PriceSync />
  </body>
</html>
